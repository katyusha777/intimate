{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intimate",
  // Main account: Contact@optiweb.dev (migrated 2026-08-02 from the personal
  // account — old workers left in place there until confirmed dead).
  "account_id": "ac521dc0e1abd98133a8f565daa46294",
  "main": "@astrojs/cloudflare/entrypoints/server",
  // Production domains — zone routes, NOT custom domains: the zone's existing
  // proxied DNS records (which point at a dummy/prohibited IP) block the
  // custom-domain API, but routes ride on top of them — the worker answers
  // before Cloudflare ever dials the origin. www is claimed only so we control
  // it — middleware 301s it to the apex (one canonical host).
  "routes": [
    // Custom domains (2026-08-09): the old dummy-IP proxied records vanished
    // during the admin-subdomain experiment (apex outage). Custom domains
    // recreate DNS + attach the worker in one step — simpler than the old
    // route-over-dummy-record setup, same behavior.
    { "pattern": "intimate.nl", "custom_domain": true },
    { "pattern": "www.intimate.nl", "custom_domain": true }
  ],
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  // Close the workers.dev + preview-URL back doors: the worker answers ONLY on
  // the custom domains above. Otherwise intimate.<account>.workers.dev serves
  // the same worker and routes AROUND the Cloudflare Access wall that is scoped
  // to the intimate.nl/admin PATH — turning admin into a single-password door
  // (SECURITY.md admin section). Both must stay false.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "placement": { "mode": "smart" },
  "observability": { "enabled": true },
  // Deploy id → folded into the page-cache key so every deploy auto-invalidates
  // cached profile HTML (no manual purge, no stale-after-redeploy window).
  "version_metadata": { "binding": "CF_VERSION" },
  // ponytail: single-tier — one hosted Supabase project is THE database until
  // the project proves itself (INFRASTRUCTURE §1); split tiers/ids then.
  // In `bun run dev` the binding connects via the
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE env var (.env).
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "542bb0bee7fa44148f4e6ae3e0129ae7" }
  ],
  "kv_namespaces": [
    { "binding": "SESSION", "id": "147037dee79949c2bed21ef6a60d7e00" }
  ],
  // Profile media store (R2 — free egress, no per-view delivery fee; served
  // through the /media route with edge caching). Verification docs get their
  // own private bucket later (hard rule 3). Transforms via the IMAGES binding.
  // MEDIA = public profile photos. VERIFICATION = toxic-waste ID docs (hard rule
  // 3): a SEPARATE private EU-jurisdiction bucket, admin-only via signed URLs,
  // every read audit-logged, auto-purged after retention. Never public.
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "intimate-media" },
    { "binding": "VERIFICATION", "bucket_name": "intimate-verification", "jurisdiction": "eu" }
  ],
  "images": { "binding": "IMAGES" },
  "vars": {
    // prod values — replace when the prod Supabase project exists (INFRASTRUCTURE §7)
    "PUBLIC_SUPABASE_URL": "https://jqrfzqbuvekhcptqcpda.supabase.co",
    "PUBLIC_SUPABASE_KEY": "sb_publishable_jzpgxggUIg8-uodVAaT1SA_KZxO34fe",
    // OneSignal app id is public (baked into the SDK init); the REST key is a
    // Worker secret (ONESIGNAL_API_KEY), never here.
    "PUBLIC_ONESIGNAL_APP_ID": "33308041-5873-497c-8a28-d20f2d29181d",
    // Absolute origin for outbound links (push deep links) — per-env.
    "PUBLIC_SITE_ORIGIN": "https://intimate.nl",
    // Outbound mail (lib/email.ts): SMTP2GO relay over workerd sockets.
    // SMTP_USER / SMTP_PASS are Worker secrets, never here.
    "SMTP_HOST": "mail-eu.smtp2go.com",
    "SMTP_PORT": "587",
    "EMAIL_FROM": "hi@intimate.nl",
    "ADMIN_EMAIL": "admin@intimate.nl",
    // Sentry DSN (public by design — browser SDKs ship the same value).
    "SENTRY_DSN": "https://c5eb19f34df9569f265caf38269e577d@o4509691654045696.ingest.de.sentry.io/4511883308367952"
  }
}
