{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Standalone retention-purge cron — NOT the app worker. See purge-worker.ts.
  // Top level = production; `--env staging` = staging (mirrors the app config).
  // Deploy: bunx wrangler deploy --config workers/purge/wrangler.jsonc [--env staging]
  // Owner steps: set PURGE_SECRET on BOTH this worker and the app worker,
  //   same value per tier (bunx wrangler secret put PURGE_SECRET ...).
  "name": "intimate-purge",
  "main": "purge-worker.ts",
  "compatibility_date": "2026-07-01",
  // Daily at 03:17 (off the hour to avoid contention with the warm sweeps).
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  // In-process call into the main worker — no DNS, no self-fetch, no 522.
  "services": [
    { "binding": "SITE", "service": "intimate" }
  ],
  "vars": { "ORIGIN": "https://intimate.nl" },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "intimate-purge-staging",
      "triggers": {
        "crons": ["17 3 * * *"]
      },
      "services": [
        { "binding": "SITE", "service": "intimate-staging" }
      ],
      "vars": { "ORIGIN": "https://staging.intimate.nl" },
      "observability": {
        "enabled": true
      }
    }
  }
}
