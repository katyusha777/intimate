{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Standalone cache-warm cron — NOT the app worker. See warm-worker.ts.
  // Top level = production; `--env staging` = staging (mirrors the app config).
  // Deploy: bunx wrangler deploy --config workers/warm/wrangler.jsonc [--env staging]
  "name": "intimate-warm",
  "main": "warm-worker.ts",
  "compatibility_date": "2026-07-01",
  // Every 6h (24h cache TTL leaves ample margin). This is THE warm schedule now
  // that the GitHub Actions cron is retired.
  "triggers": {
    "crons": ["0 */6 * * *", "*/4 * * * *"] // full sweep 6-hourly; homepages every 4 min (short HOME_TTL_S)
  },
  // In-process call into the main worker — no DNS, no self-fetch, no 522.
  "services": [
    { "binding": "SITE", "service": "intimate" }
  ],
  "vars": { "ORIGIN": "https://intimate.nl" },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "intimate-warm-staging",
      "triggers": {
        "crons": ["0 */6 * * *", "*/4 * * * *"]
      },
      "services": [
        { "binding": "SITE", "service": "intimate-staging" }
      ],
      "vars": { "ORIGIN": "https://staging.intimate.nl" },
      "observability": {
        "enabled": true
      }
    }
  }
}
