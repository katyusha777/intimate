---
/**
 * Article reader (full SEO treatment — hard rule 8). Content is markdown from
 * the `articles` collection; the hero renders directly (brand-safe editorial
 * image, not gated through SafeImage's NSFW toggle).
 */
import { render } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import * as m from '@/paraglide/messages';
import { isLocale, localizePath, samePathAlternates } from '@/lib/i18n';
import { articleBySlug } from '@/lib/articles';
import { articleJsonLd, breadcrumbJsonLd } from '@/lib/seo';

const { locale, slug } = Astro.params;
if (!isLocale(locale) || !slug) return new Response(null, { status: 404 });

const entry = await articleBySlug(locale, slug);
if (!entry) return new Response(null, { status: 404 });

const { data } = entry;
const { Content } = await render(entry);

const url = new URL(`/${locale}/blog/${data.slug}/`, Astro.url.origin).href;
const title = `${data.seoTitle ?? data.title} | Intimate`;
const description = data.seoDescription ?? data.excerpt;
const heroAbs = new URL(data.hero.src, Astro.url.origin).href;
const published = new Intl.DateTimeFormat(locale, {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(data.publishedAt);

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Intimate', url: `${Astro.url.origin}/${locale}/` },
    { name: m.section_articles(), url: `${Astro.url.origin}/${locale}/blog/` },
    { name: data.title, url },
  ]),
  articleJsonLd({
    url,
    title: data.title,
    description,
    image: heroAbs,
    publishedAt: data.publishedAt,
    locale,
  }),
];
---

<Layout
  {title}
  {description}
  canonical={url}
  alternates={samePathAlternates(Astro.url.origin, `/blog/${data.slug}/`)}
  {jsonLd}
>
  <article class="mx-auto max-w-2xl px-4 py-8 md:px-6 md:py-12">
    <a
      href={localizePath('/blog/')}
      class="eyebrow text-sm font-semibold text-muted-foreground hover:text-brand"
    >
      ← {m.to_blog()}
    </a>

    <p class="eyebrow mt-6 text-2xs font-mono font-semibold text-brand">
      {data.minutes} {m.min_read()} · {published}
    </p>
    <h1 class="display mt-2 text-3xl md:text-4xl">{data.title}</h1>
    <p class="mt-3 text-lg leading-relaxed text-muted-foreground">{data.excerpt}</p>

    <img
      src={data.hero.src}
      width={data.hero.width}
      height={data.hero.height}
      alt={data.heroAlt}
      class="mt-6 aspect-[16/10] w-full rounded-lg object-cover"
      loading="eager"
      decoding="async"
    />

    <div class="article-body mt-8">
      <Content />
    </div>
  </article>
</Layout>

<style>
  /* Editorial prose — no typography plugin; scoped to the article body and
     keyed off the design tokens (DESIGN §2). */
  .article-body :global(p) {
    margin-top: 1.1rem;
    line-height: 1.7;
    color: hsl(var(--foreground) / 0.85);
  }
  .article-body :global(h2) {
    margin-top: 2.25rem;
    margin-bottom: 0.25rem;
    font-family: var(--font-condensed, inherit);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .article-body :global(ul) {
    margin-top: 1rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .article-body :global(li) {
    margin-top: 0.4rem;
    line-height: 1.6;
    color: hsl(var(--foreground) / 0.85);
  }
  .article-body :global(strong) {
    font-weight: 600;
    color: hsl(var(--foreground));
  }
  .article-body :global(a) {
    color: hsl(var(--brand));
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
