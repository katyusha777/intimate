---
/**
 * The /agencies closer page (PRE-LAUNCH-GRANT-CARDONE.md §12) — the campaign's
 * one conversion surface: an agency owner, on a phone, mid-call, submits the
 * consent form. Bare layout (corridor rule §12.2: no nav into the site; the
 * pre-launch host allow-list in lib/prelaunch.ts seals the dead-ends). The
 * demo grid is the REAL product: live ProfileCards + the real ProfileSheet
 * modal that Layout always ships. Zero islands; the form is a plain HTML POST.
 *
 * Editing rules live in the doc §14: every copy change runs the §8 four-question
 * test; friction only goes down; the page never grows.
 */
import { actions } from 'astro:actions';
import Layout from '@/layouts/Layout.astro';
import * as m from '@/paraglide/messages';
import { isLocale, localizePath, samePathAlternates } from '@/lib/i18n';
import ProfileCard from '@/components/organisms/profile/ProfileCard.astro';
import Button from '@/components/atoms/Button.astro';
import SlabField from '@/components/molecules/SlabField.astro';
import SupportChips from '@/components/molecules/SupportChips.astro';
import { profilesApi } from '@/app/api/profiles';

const locale = Astro.params.locale;
if (!isLocale(locale)) return new Response(null, { status: 404 });

const result = Astro.getActionResult(actions.agencies.join);
const done = result && !result.error;

/* The demo grid: the same real profiles the home leads with (owner decision:
 * reuse the shelf for now; a branded demo roster can replace it later). */
let { items: demo } = await profilesApi.list({ featuredOnly: true, limit: 4 });
if (demo.length < 4) demo = (await profilesApi.list({ sort: 'newest', limit: 4 })).items;
demo = demo.slice(0, 4);

const alternates = samePathAlternates(Astro.url.origin, '/agencies/');

// Why we built it — the two shifts (AI-first, phone-first) framed as what they
// MEAN for the agency, never as features. Two beats, each with a mark.
const WHY = [
  {
    icon: '<path d="m12 3 1.9 5.8L20 10l-6.1 1.2L12 17l-1.9-5.8L4 10l6.1-1.2z"/><path d="M18 3v3.5M19.75 4.75h-3.5"/>',
    lead: m.agencies_why_ai_lead(),
    body: m.agencies_why_ai_body(),
  },
  {
    icon: '<rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/>',
    lead: m.agencies_why_mobile_lead(),
    body: m.agencies_why_mobile_body(),
  },
];
// The offer terms, each with a mark so the section scans in a glance.
const TERMS = [
  { icon: '<path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r=".5"/>', lead: m.agencies_term_free_lead(), body: m.agencies_term_free_body() },
  { icon: '<path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/><path d="M8 16H3v5"/>', lead: m.agencies_term_sync_lead(), body: m.agencies_term_sync_body() },
  { icon: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.4-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/>', lead: m.agencies_term_direct_lead(), body: m.agencies_term_direct_body() },
  { icon: '<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/>', lead: m.agencies_term_leave_lead(), body: m.agencies_term_leave_body() },
];
---

<Layout
  title={m.agencies_meta_title()}
  description={m.agencies_meta_desc()}
  canonical={new URL(`/${locale}/agencies/`, Astro.url.origin).href}
  {alternates}
  bare
>
  <div class="mx-auto max-w-xl px-4 pb-28">
    <!-- Top strip: logo + NL⇄EN. The only chrome the corridor allows. -->
    <div class="flex items-center justify-between pt-5">
      <span class="flex items-center">
        <img src="/img/logo-dark.svg" alt={m.app_name()} width="1242" height="597" class="h-6 w-auto dark:hidden md:h-7" />
        <img src="/img/logo-light.svg" alt={m.app_name()} width="1242" height="597" class="hidden h-6 w-auto dark:block md:h-7" />
      </span>
      <p class="text-sm font-semibold">
        <a
          href="/nl/agencies/"
          class={locale === 'nl' ? 'text-foreground' : 'text-muted-foreground hover:text-foreground'}>NL</a
        ><span class="px-1.5 text-foreground/30" aria-hidden="true">/</span><a
          href="/en/agencies/"
          class={locale === 'en' ? 'text-foreground' : 'text-muted-foreground hover:text-foreground'}>EN</a
        >
      </p>
    </div>

    <!-- Hero: the plain offer + early-mover scarcity. Declaration, not intro. -->
    <header class="pt-8 md:pt-12">
      <p class="eyebrow flex items-center gap-2 font-condensed text-sm font-bold uppercase tracking-wide text-brand">
        <span class="size-1.5 rounded-full bg-online" aria-hidden="true"></span>
        {m.agencies_hero_eyebrow()}
      </p>
      <h1 class="display mt-3 text-4xl md:text-5xl">{m.agencies_hero_title()}</h1>
      <p class="mt-4 text-lg leading-relaxed text-muted-foreground">{m.agencies_hero_sub()}</p>
      <div class="mt-6">
        <Button as="a" href="#join">{m.agencies_hero_cta()}</Button>
      </div>
    </header>

    <!-- The demo: a live taste of the real product (real cards + real modal).
         Title + plain explanation up top, then the grid. -->
    <section class="pt-10 md:pt-14">
      <h2 class="display text-2xl">{m.agencies_demo_title()}</h2>
      <p class="mt-3 flex items-start gap-2 leading-relaxed text-muted-foreground">
        <svg class="mt-1 size-4 flex-none text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 9 5 12 1.8-5.2L21 14Z"/><path d="M7.2 2.2 8 5.1"/><path d="m5.1 8-2.9-.8"/><path d="M14 4.1 12 6"/><path d="m6 12-1.9 2"/></svg>
        {m.agencies_demo_frame()}
      </p>
      <div class="mt-5 grid grid-cols-2 gap-4">
        {demo.map((p, i) => <ProfileCard profile={p} loading={i < 2 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />)}
      </div>
    </section>

    <!-- Why now: the two shifts (AI-first, phone-first) as what they MEAN for
         the agency — the reason joining pays, not a feature list. -->
    <section class="pt-10 md:pt-14">
      <h2 class="display text-2xl">{m.agencies_why_title()}</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        {
          WHY.map((pt) => (
            <div class="border border-foreground/10 p-5">
              <svg class="size-6 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={pt.icon} />
              <p class="mt-3 font-condensed text-base font-bold uppercase tracking-wide">{pt.lead}</p>
              <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{pt.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- The offer terms — each with a mark so the section scans in a glance. -->
    <section class="pt-10 md:pt-14">
      <h2 class="display text-2xl">{m.agencies_terms_title()}</h2>
      <dl class="mt-3 divide-y divide-foreground/10">
        {
          TERMS.map((t) => (
            <div class="flex gap-4 py-4">
              <span class="grid size-10 flex-none place-items-center border border-foreground/15 text-brand">
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={t.icon} />
              </span>
              <div>
                <dt class="font-condensed text-lg font-bold uppercase tracking-wide">{t.lead}</dt>
                <dd class="mt-1 leading-relaxed text-muted-foreground">{t.body}</dd>
              </div>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- §12.5 What's the catch? Agree first, then the zero-waste close. -->
    <section class="pt-10 md:pt-14">
      <!-- No .display: its ::after period would trail the question mark. -->
      <h2 class="font-condensed text-2xl font-bold uppercase tracking-tight">{m.agencies_catch_title()}</h2>
      <p class="mt-3 leading-relaxed text-muted-foreground">{m.agencies_catch_body()}</p>
      <div class="ink-slab mt-6 bg-foreground p-6 text-background">
        <p class="font-condensed text-xl font-bold uppercase tracking-wide">{m.agencies_catch_worst_lead()}</p>
        <p class="mt-2 leading-relaxed text-background/80">{m.agencies_catch_worst_body()}</p>
      </div>
      <p class="mt-4 text-sm text-muted-foreground">{m.agencies_catch_small()}</p>
    </section>

    <!-- §12.6 How it works: three steps ending in control. -->
    <section class="pt-10 md:pt-14">
      <h2 class="display text-2xl">{m.agencies_how_title()}</h2>
      <ol class="mt-2">
        {
          [
            [m.agencies_how_1_lead(), m.agencies_how_1_body()],
            [m.agencies_how_2_lead(), m.agencies_how_2_body()],
            [m.agencies_how_3_lead(), m.agencies_how_3_body()],
          ].map(([lead, body], i) => (
            <li class="flex gap-4 py-3">
              <span class="display text-3xl text-brand" aria-hidden="true">
                {i + 1}
              </span>
              <div>
                <p class="font-condensed text-lg font-bold uppercase tracking-wide">{lead}</p>
                <p class="mt-1 leading-relaxed text-muted-foreground">{body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- The form: the consent artifact, in its own panel so the one action on
         the page reads as separate and clear. 30s, four fields, one box. -->
    <section id="join" class="scroll-mt-6 pt-10 md:pt-14">
      <div class="border border-foreground/15 bg-muted p-6 md:p-8">
        {
          done ? (
            <div tabindex="-1" class="outline-none">
              <p class="display text-3xl">{m.agencies_form_done_title()}</p>
              <p class="mt-3 leading-relaxed text-muted-foreground">{m.agencies_form_done_body()}</p>
            </div>
          ) : (
            <>
              {/* Revealed in place on a JS submit — no reload, so no scroll jump.
                  When JS is off, the native POST re-renders the `done` branch. */}
              <div data-agency-confirm hidden tabindex="-1" class="outline-none">
                <p class="display text-3xl">{m.agencies_form_done_title()}</p>
                <p class="mt-3 leading-relaxed text-muted-foreground">{m.agencies_form_done_body()}</p>
              </div>
              <div data-agency-formwrap>
                <h2 class="display text-2xl">{m.agencies_form_title()}</h2>
                <form method="POST" action={actions.agencies.join} data-agency-form class="mt-5 space-y-5">
                  <p data-agency-error class:list={['text-sm font-medium text-destructive', !result?.error && 'hidden']}>{m.agencies_form_error()}</p>
                  <SlabField label={m.agencies_form_name()} name="name" required autocomplete="organization" />
                  <SlabField
                    label={m.agencies_form_site()}
                    name="siteUrl"
                    type="text"
                    inputmode="text"
                    placeholder="youragency.nl"
                    required
                    autocomplete="url"
                  />
                  <SlabField label={m.agencies_form_email()} name="email" type="email" inputmode="email" required autocomplete="email" />
                  <SlabField label={m.agencies_form_phone()} name="phone" type="tel" inputmode="tel" required autocomplete="tel" />
                  <label class="flex cursor-pointer items-start gap-3">
                    <input type="checkbox" name="consent" required class="cbx-box mt-0.5 flex-none cursor-pointer" />
                    <span class="text-sm leading-relaxed text-muted-foreground">{m.agencies_form_consent()}</span>
                  </label>
                  <input type="hidden" name="locale" value={locale} />
                  <div>
                    <Button type="submit" size="lg" class="block w-full">
                      {m.agencies_form_submit()}
                    </Button>
                    <p class="mt-2.5 text-center text-xs text-muted-foreground">{m.agencies_form_fine()}</p>
                  </div>
                </form>
              </div>
            </>
          )
        }
      </div>
      <SupportChips class="mt-8" />
    </section>
  </div>

  <!-- §12.8 Sticky CTA: one tap from the yes — but it slides away once the real
       form is on screen, so the page never shows two competing CTAs. -->
  {
    !done && (
      <div class="agencies-cta glass fixed inset-x-0 bottom-0 z-40 border-t px-4 pt-3" data-sticky-cta>
        <div class="mx-auto flex max-w-xl justify-center">
          <Button as="a" href="#join" size="lg">
            {m.agencies_sticky_cta()}
          </Button>
        </div>
      </div>
    )
  }

  <script>
    import { actions } from 'astro:actions';

    // Progressive enhancement: submit without a page reload and reveal the
    // confirmation in place. A native POST reloads the page (resets scroll to
    // the top) — that's the whole reason it jumped; here nothing navigates.
    function initAgencyForm() {
      const form = document.querySelector<HTMLFormElement>('[data-agency-form]');
      if (!form || form.dataset.init) return;
      form.dataset.init = '1';
      const err = form.querySelector<HTMLElement>('[data-agency-error]');
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (form.dataset.loading || !form.reportValidity()) return;
        form.dataset.loading = '1';
        err?.classList.add('hidden');
        let ok = false;
        try {
          const res = await actions.agencies.join(new FormData(form));
          ok = !res?.error;
        } catch {
          ok = false;
        }
        if (!ok) {
          // Anything but a clean success — validation, CSRF, offline — hands off
          // to the native POST so the submission ALWAYS goes through (the server
          // re-render surfaces the error). Belt-and-suspenders over the no-reload UX.
          form.submit();
          return;
        }
        form.dataset.loading = '';
        document.querySelector('[data-agency-formwrap]')?.setAttribute('hidden', '');
        document.querySelector('[data-sticky-cta]')?.remove();
        const confirm = document.querySelector<HTMLElement>('[data-agency-confirm]');
        if (!confirm) return;
        confirm.removeAttribute('hidden');
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        confirm.scrollIntoView({ block: 'center', behavior: reduce ? 'auto' : 'smooth' });
        confirm.focus({ preventScroll: true });
      });
    }

    // Hide the sticky CTA once the form scrolls into view (slide down), bring it
    // back when you scroll away (slide up) — never two CTAs fighting on screen.
    function initStickyCta() {
      const cta = document.querySelector<HTMLElement>('[data-sticky-cta]');
      const join = document.getElementById('join');
      if (!cta || !join || cta.dataset.init) return;
      cta.dataset.init = '1';
      if (!('IntersectionObserver' in window)) return;
      const io = new IntersectionObserver((entries) => entries.forEach((e) => cta.classList.toggle('is-hidden', e.isIntersecting)), {
        rootMargin: '0px 0px -30% 0px',
      });
      io.observe(join);
    }

    function initAgencies() {
      initAgencyForm();
      initStickyCta();
    }
    initAgencies();
    document.addEventListener('astro:page-load', initAgencies);
  </script>
</Layout>

<style>
  /* The brand slab shear (DESIGN §1.1) on the two ink blocks. */
  .ink-slab {
    clip-path: polygon(0 6px, 100% 0, 100% calc(100% - 6px), 0 100%);
  }
  /* Fixed bar rides the home-indicator inset; bracket paddings are banned in
     class lists (tests/style.test.ts), so the safe-area math lives here. */
  .agencies-cta {
    padding-bottom: calc(0.75rem + env(safe-area-inset-bottom));
    transition: transform 0.3s ease;
  }
  /* Slides fully off the bottom edge when the real form is on screen. */
  .agencies-cta.is-hidden {
    transform: translateY(130%);
  }
  @media (prefers-reduced-motion: reduce) {
    .agencies-cta {
      transition: none;
    }
  }
</style>
