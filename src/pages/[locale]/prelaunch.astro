---
/**
 * The pre-launch landing — served at `/{locale}/` on the apex during the
 * campaign window (middleware rewrite via lib/prelaunch.ts; the full home
 * stays untouched for beta). One job: a professional pre-registers in under a
 * minute. Deliberately dark and cinematic (the brand's ink language), bare
 * chrome, zero islands. Dies at launch together with the corridor.
 */
import { actions } from 'astro:actions';
import Layout from '@/layouts/Layout.astro';
import * as m from '@/paraglide/messages';
import { sessionApi } from '@/app/api/session';
import { accountApi } from '@/app/api/account';
import { profilesApi } from '@/app/api/profiles';
import { agencyBySlug } from '@/app/api/orgs';
import { isLocale, localizePath, homeAlternates, homeUrl } from '@/lib/i18n';
import { articlesForLocale } from '@/lib/articles';
import { organizationJsonLd, websiteJsonLd } from '@/lib/seo';
import Button from '@/components/atoms/Button.astro';
import SafeImage from '@/components/atoms/SafeImage.astro';
import SlabField from '@/components/molecules/SlabField.astro';
import SupportChips from '@/components/molecules/SupportChips.astro';
import RecentSignups from '@/components/organisms/profile/RecentSignups.astro';
import ProfileSheet from '@/components/organisms/profile/ProfileSheet.astro';

const locale = Astro.params.locale;
if (!isLocale(locale)) return new Response(null, { status: 404 });

/* Proof of life for the landing: a live rail of "recent signups", drawn from
 * Schipol Escort's roster (the strongest photos). A tap opens the ProfileSheet
 * (X-Sheet fetch — the one profile path the pre-launch corridor lets through). */
const signupOrg = await agencyBySlug('schipol-escort');
const roster = signupOrg ? (await profilesApi.list({ orgId: signupOrg.id, limit: 60 })).items : [];
/* A random sample, not a newest-first feed — Fisher–Yates, then take 18. Frozen
 * per edge-cache fill (fine — the client ticker keeps reshuffling the order). */
for (let i = roster.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [roster[i], roster[j]] = [roster[j], roster[i]];
}
const signups = roster.slice(0, 18);

/* Below-the-fold editorial shelf: our own articles as real, indexable HTML +
 * internal links (SEO). The corridor lets /blog through; the reader renders BARE
 * (Astro.locals.prelaunch), so a tap opens a clean article with no way back into
 * the marketplace. ro/it fall back to en (same as the live blog). */
const articles = await articlesForLocale(locale);

const result = Astro.getActionResult(actions.prelaunch.join);
// Advertiser → her real (passwordless) draft profile in /account/setup, built now
// so it goes live at launch. The auth session cookie register() set rides this
// same redirect response (Astro applies the cookie jar to redirects too).
if (result?.data?.href) return Astro.redirect(result.data.href);
const done = !!result?.data?.ok; // client lead: show the "you're on the list" card

// A professional who already joined lands back here (the setup wordmark links to
// `/`, or she revisits) — greet her with her status, not the form again. Session
// read is memoized (Layout already called it); anon returns null and stays cached.
const session = await sessionApi.current(Astro);
const myProfile = session?.role === 'advertiser' ? await accountApi.myProfile(session) : null;
const joined = myProfile ? (myProfile.state === 'draft' ? 'building' : 'submitted') : null;

/* Canonical is the HOME URL — this template answers /{locale}/ on the apex;
 * the /prelaunch path itself is an internal address, never the public one. */
const alternates = homeAlternates(Astro.url.origin);
const jsonLd = [websiteJsonLd(Astro.url.origin, locale), organizationJsonLd(Astro.url.origin)];
---

<Layout
  title={m.prelaunch_meta_title()}
  description={m.prelaunch_meta_desc()}
  canonical={homeUrl(Astro.url.origin, locale)}
  {alternates}
  {jsonLd}
  bare
  preloadImage="/video/hero-poster.jpg"
>
  <script is:inline>
    // Build-in-public switch: `localStorage['safe-mode'] = 'true'` flips this
    // page to the anime skin (the existing `dev` safe-mode — SafeImage's
    // data-dev + the hero video hidden). This page is `bare`, so there's no
    // safe-mode toggle here; the flag IS the switch. Runs before Layout's
    // end-of-body swap script, so it just primes the cookie + dev unlock and the
    // shared machinery does the actual swap (images, video, tab chrome).
    (function () {
      try {
        var v = localStorage.getItem('safe-mode');
        if (v === 'true') {
          localStorage.setItem('dev', '1'); // unlock the anime state (operator-only)
          document.cookie = 'safe_mode=dev; path=/; max-age=31536000; samesite=lax';
          document.documentElement.classList.add('safe-on'); // blur pre-swap → no sharp flash
        } else if (v === 'false' && /safe_mode=dev/.test(document.cookie)) {
          document.cookie = 'safe_mode=off; path=/; max-age=31536000; samesite=lax';
        }
      } catch (e) {}
    })();
  </script>
  <div class="dark min-h-dvh bg-neutral-950 text-white">
    <div class="relative overflow-hidden lg:min-h-dvh">
      <!-- Cinematic media: right half on DESKTOP only. Mobile stays a clean,
           solid-dark canvas — no video, no busy backdrop behind the type. -->
      <div class="absolute inset-y-0 right-0 hidden w-1/2 lg:block" data-safe-video-wrap>
        <video
          class="hidden h-full w-full object-cover"
          data-safe-video
          muted
          loop
          playsinline
          preload="none"
          data-poster="/video/hero-poster.jpg"
        >
          <source src="/video/hero.webm" type="video/webm" />
          <source src="/video/hero.mp4" type="video/mp4" />
        </video>
        <SafeImage imageKey="hero-video" src="/video/hero-poster.jpg" alt="" class="h-full w-full" loading="eager" />
      </div>
      <div class="hero-panel absolute inset-y-0 left-0 hidden w-[58%] bg-neutral-950 lg:block" aria-hidden="true"></div>

      <div class="relative mx-auto max-w-7xl px-4 md:px-6">
        <div class="flex min-h-dvh flex-col py-6 lg:max-w-[46%] lg:justify-center">
          <img src="/img/logo-light.svg" alt={m.app_name()} width="1242" height="597" class="h-6 w-auto md:h-7" />

          {/* Live proof-of-life rail — top of the column on every viewport. */}
          {signups.length > 0 && <RecentSignups profiles={signups} class="mt-6" />}

          <div class="flex flex-1 flex-col justify-center py-10 lg:flex-none lg:py-12">
            <p class="eyebrow flex items-center gap-2 font-condensed text-lg font-bold uppercase tracking-wide">
              <span class="size-1.5 rounded-full bg-online" aria-hidden="true"></span>
              {m.prelaunch_eyebrow()}
            </p>
            <h1 class="display mt-3 text-3xl md:text-5xl">{m.prelaunch_title()}</h1>
            <p class="mt-4 max-w-md text-lg leading-relaxed text-white/75">{m.prelaunch_sub()}</p>

            <ul class="mt-8 max-w-md space-y-2.5">
              {
                [
                  [m.prelaunch_point_1_lead(), m.prelaunch_point_1_body()],
                  [m.prelaunch_point_2_lead(), m.prelaunch_point_2_body()],
                  [m.prelaunch_point_3_lead(), m.prelaunch_point_3_body()],
                ].map(([lead, body]) => (
                  <li class="text-sm leading-relaxed text-white/70">
                    <span class="font-condensed font-bold uppercase tracking-wide text-brand">{lead} </span>
                    {body}
                  </li>
                ))
              }
            </ul>

            <div id="join" class="mt-10 max-w-md scroll-mt-6">
              {
                joined === 'submitted' ? (
                  <>
                    <div class="ink-slab bg-white p-6 text-neutral-950">
                      <p class="display text-2xl">{m.prelaunch_joined_title()}</p>
                      <p class="mt-2 leading-relaxed text-neutral-700">{m.prelaunch_joined_body()}</p>
                    </div>
                    <SupportChips class="mt-6 text-white/70" />
                  </>
                ) : joined === 'building' ? (
                  <div class="ink-slab bg-white p-6 text-neutral-950">
                    <p class="display text-2xl">{m.prelaunch_building_title()}</p>
                    <p class="mt-2 leading-relaxed text-neutral-700">{m.prelaunch_building_body()}</p>
                    <Button as="a" href={localizePath('/account/setup/')} class="mt-4 block w-full">{m.prelaunch_building_cta()}</Button>
                  </div>
                ) : done ? (
                  <div class="ink-slab bg-white p-6 text-neutral-950">
                    <p class="display text-2xl">{m.prelaunch_done_title()}</p>
                    <p class="mt-2 leading-relaxed text-neutral-700">{m.prelaunch_done_body()}</p>
                  </div>
                ) : (
                  <>
                    <h2 class="display text-2xl">{m.prelaunch_form_title()}</h2>
                    <form
                      method="POST"
                      action={actions.prelaunch.join}
                      class="mt-4 space-y-4"
                      data-prelaunch-form
                      data-name-advertiser={m.prelaunch_form_name()}
                      data-name-client={m.prelaunch_name_client()}
                      data-contacts-hint={m.prelaunch_contacts_hint()}
                    >
                      {result?.error && <p class="text-sm font-medium text-destructive">{m.prelaunch_form_error()}</p>}

                      {/* Pick FIRST — two equal cards, no default (a deliberate
                          tap). Agencies get the richer /agencies/ flow, linked below. */}
                      <fieldset>
                        <legend class="text-sm font-medium">{m.prelaunch_kind_label()}</legend>
                        <div class="mt-2.5 grid grid-cols-2 gap-3">
                          {[
                            { value: 'advertiser', title: m.role_advertiser(), desc: m.role_advertiser_desc(), icon: '<path d="M4 8h3l2-2h6l2 2h3v11H4z"/><circle cx="12" cy="13" r="3.5"/>' },
                            { value: 'client', title: m.role_client(), desc: m.role_client_desc(), icon: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"/>' },
                          ].map((o) => (
                            <label class="group flex cursor-pointer flex-col items-center gap-2 border border-white/20 p-5 text-center transition-colors hover:border-white/50 has-[:checked]:border-white has-[:checked]:bg-white has-[:checked]:text-neutral-950">
                              <input type="radio" name="kind" value={o.value} required class="sr-only" />
                              <svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={o.icon} />
                              <span class="font-condensed text-base font-bold uppercase tracking-wide">{o.title}</span>
                              <span class="text-xs text-white/60 group-has-[:checked]:text-neutral-950/70">{o.desc}</span>
                            </label>
                          ))}
                        </div>
                      </fieldset>

                      <SlabField class="js-name-field" label={m.prelaunch_form_name()} name="name" required autocomplete="nickname" />
                      <SlabField label={m.prelaunch_form_email()} name="email" type="email" inputmode="email" required autocomplete="email" />

                      {/* Contacts — advertiser only (CSS-revealed below), at least one. */}
                      <div data-contacts class="space-y-4">
                        <SlabField label={m.prelaunch_contact_phone()} name="phone" type="tel" inputmode="tel" autocomplete="tel" />
                        <SlabField label={m.prelaunch_contact_whatsapp()} name="whatsapp" type="tel" inputmode="tel" />
                        <SlabField label={m.prelaunch_contact_telegram()} name="telegram" placeholder="@username" />
                        <p class="text-xs text-white/50">{m.prelaunch_contacts_hint()}</p>
                      </div>

                      <input type="hidden" name="locale" value={locale} />
                      <Button type="submit" class="block w-full">
                        {m.prelaunch_form_submit()}
                      </Button>
                      <p class="text-center text-sm">
                        <a
                          href={localizePath('/agencies/')}
                          class="text-white/55 underline underline-offset-4 transition-colors hover:text-white"
                        >
                          {m.prelaunch_agency_link()} →
                        </a>
                      </p>
                    </form>
                    <SupportChips class="mt-6 text-white/70" />
                  </>
                )
              }
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* Below the fold: our editorial shelf. Real indexable text + internal links
        (SEO) and the only reading path the corridor opens besides the form. */}
    {
      articles.length > 0 && (
        <section class="border-t border-white/10 px-4 py-16 md:px-6">
          <div class="mx-auto max-w-3xl">
            <h2 class="eyebrow font-condensed text-lg font-bold uppercase tracking-wide text-white/50">
              {m.section_articles()}
            </h2>
            <ul class="mt-6 divide-y divide-white/10">
              {articles.map((a) => (
                <li>
                  <a href={localizePath(`/blog/${a.data.slug}/`)} class="group block py-5">
                    <h3 class="font-condensed text-xl font-bold leading-snug transition-colors group-hover:text-brand">
                      {a.data.title}
                    </h3>
                    <p class="mt-1.5 text-sm leading-relaxed text-white/60">{a.data.excerpt}</p>
                  </a>
                </li>
              ))}
            </ul>

            {/* Homepage SEO copy — our brand voice, localized in all five
                languages (verified · discreet by design · the NL cities). Real
                indexable text closing the page. */}
            <div class="mt-14 max-w-2xl">
              <h2 class="font-condensed text-xl font-bold leading-snug text-white/70">
                {m.home_seo_title()}
              </h2>
              <p class="mt-3 text-sm leading-relaxed text-white/40">{m.home_seo_body()}</p>
            </div>
          </div>
        </section>
      )
    }
  </div>

  <script>
    // The name field means a different thing per join-type — swap its label so
    // "Working name" doesn't greet a browsing client. Also enforce the
    // advertiser "at least one contact" rule client-side (server is the real gate).
    function initKindLabel() {
      const form = document.querySelector<HTMLFormElement>('[data-prelaunch-form]');
      if (!form || form.dataset.kindInit) return;
      form.dataset.kindInit = '1';
      const label = form.querySelector<HTMLElement>('.js-name-field > span');
      const radios = form.querySelectorAll<HTMLInputElement>('input[name="kind"]');
      const contacts = ['phone', 'whatsapp', 'telegram'].map((n) => form.querySelector<HTMLInputElement>(`[name="${n}"]`));
      const checked = () => form.querySelector<HTMLInputElement>('input[name="kind"]:checked')?.value;
      const sync = () => {
        const kind = checked();
        if (label && kind) label.textContent = kind === 'client' ? form.dataset.nameClient! : form.dataset.nameAdvertiser!;
      };
      radios.forEach((r) => r.addEventListener('change', sync));
      contacts.forEach((c) => c?.addEventListener('input', () => contacts.forEach((x) => x?.setCustomValidity(''))));
      form.addEventListener('submit', (e) => {
        if (checked() !== 'advertiser' || contacts.some((c) => c?.value.trim())) return;
        e.preventDefault();
        contacts[0]?.setCustomValidity(form.dataset.contactsHint || '');
        contacts[0]?.reportValidity();
      });
      sync();
    }
    initKindLabel();
    document.addEventListener('astro:page-load', initKindLabel);
  </script>

  {/* A tapped signup card opens here (bottom sheet / desktop slide-over) instead
      of navigating — the corridor only lets the X-Sheet profile fetch through. */}
  {signups.length > 0 && <ProfileSheet />}
</Layout>

<style>
  /* The home hero's jagged ink seam — one brand, one cut. */
  .hero-panel {
    clip-path: polygon(0 0, 100% 0, 91% 32%, 97% 58%, 87% 100%, 0 100%);
  }
  .ink-slab {
    clip-path: polygon(0 6px, 100% 0, 100% calc(100% - 6px), 0 100%);
  }
  /* Contacts belong to the independent professional — revealed by the card
     choice, zero JS. Clients (just browsing) never see them. */
  [data-contacts] {
    display: none;
  }
  form:has(input[name='kind'][value='advertiser']:checked) [data-contacts] {
    display: block;
  }
</style>
