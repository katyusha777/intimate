---
/** Account settings — the "Account" tab. Appearance, language, pause, sign out. */
import * as m from '@/paraglide/messages';
import { accountApi } from '@/app/api/account';
import { messagingApi } from '@/app/api/messaging';
import { sessionApi } from '@/app/api/session';
import { isLocale, localizePath } from '@/lib/i18n';
import { CONVERSATION_MODES, LOCALES } from '@/lib/taxonomy';
import AccountShell from '@/components/organisms/dashboard/AccountShell.astro';
import SignInPrompt from '@/components/organisms/dashboard/SignInPrompt.astro';
import ThemeToggle from '@/components/molecules/ThemeToggle.astro';
import SafeModeToggle from '@/components/molecules/SafeModeToggle.astro';
import Select from '@/components/atoms/Select.astro';
import Modal from '@/components/molecules/Modal.astro';
import Layout from '@/layouts/Layout.astro';

const locale = Astro.params.locale;
if (!isLocale(locale)) return new Response(null, { status: 404 });

const session = await sessionApi.current(Astro);
const isAdvertiser = session?.role === 'advertiser';
const convo = session && isAdvertiser && session.profileId ? await messagingApi.settings(session.profileId) : null;
const profile = session && isAdvertiser ? await accountApi.myProfile(session) : null;
// The pause toggle only makes sense for a profile that's actually live or paused.
const canPause = profile?.state === 'live' || profile?.state === 'paused';
const isPaused = profile?.state === 'paused';
const isUnlisted = profile?.unlisted ?? false;
const blocked = session ? await messagingApi.listBlocked(session) : [];
const account = session ? await accountApi.get(session) : null;
const modeLabel = (mode: (typeof CONVERSATION_MODES)[number]) =>
  mode === 'off' ? m.msg_mode_off() : mode === 'everyone' ? m.msg_mode_everyone() : m.msg_mode_verified();
const LANGS: Record<(typeof LOCALES)[number], string> = {
  nl: 'Nederlands',
  en: 'English',
  de: 'Deutsch',
  ro: 'Română',
  it: 'Italiano',
  es: 'Español',
};
const heading = 'font-condensed text-sm font-bold uppercase tracking-wide text-muted-foreground';
---

<Layout noindex title={`${m.settings_title()} | Intimate`}>
  {!session && <SignInPrompt />}
  {
    session && (
      <AccountShell {session} title={m.settings_title()} path={localizePath('/account/settings/')} bannerState={profile?.state}>
        <div class="max-w-xl divide-y divide-border">
          <section class="flex items-center justify-between gap-4 py-5 first:pt-0">
            <h2 class={heading}>{m.settings_appearance()}</h2>
            <div class="flex items-center gap-4">
              <SafeModeToggle />
              <ThemeToggle />
            </div>
          </section>

          <section class="flex flex-wrap items-center justify-between gap-4 py-5">
            <h2 class={heading}>{m.settings_language()}</h2>
            <div class="flex gap-1.5">
              {LOCALES.map((l) => (
                <a
                  href={`/${l}/account/settings/`}
                  class:list={[
                    'border px-3 py-1.5 text-sm font-medium transition-colors',
                    l === locale
                      ? 'border-foreground bg-foreground text-background'
                      : 'border-foreground/20 hover:border-foreground/60',
                  ]}
                >
                  {LANGS[l]}
                </a>
              ))}
            </div>
          </section>

          {/* Account credentials (#6): change email (confirm link) + password. */}
          <section class="py-5" data-account-sec
            data-saved={m.settings_saved()} data-sent={m.settings_change_email_sent()}
            data-wrong={m.settings_pw_wrong()} data-err={m.auth_error()}>
            <h2 class={heading}>{m.settings_account()}</h2>
            {/* Read-only: which kind of account this is (client/advertiser/admin). */}
            <div class="mt-3 flex items-center justify-between text-sm">
              <span class="font-medium">{m.settings_account_type()}</span>
              <span class="text-muted-foreground">
                {session.role === 'advertiser' ? m.role_advertiser() : session.role === 'client' ? m.role_client() : 'Admin'}
              </span>
            </div>
            <div class="mt-4">
              <label class="text-sm font-medium" for="acct-email">{m.settings_change_email()}</label>
              <div class="mt-1.5 flex flex-wrap items-stretch gap-2">
                <span class="slab-field grow basis-56">
                  <span class="slab-field__face block">
                    <input id="acct-email" data-acct-email type="email" value={session.email} autocomplete="email"
                      class="w-full bg-transparent p-2.5 text-sm caret-brand outline-none" />
                  </span>
                </span>
                <button type="button" data-acct-email-btn class="cursor-pointer border border-foreground/20 px-3 text-sm font-medium transition-colors hover:border-foreground/60">
                  {m.settings_change_email_btn()}
                </button>
              </div>
              <p data-acct-email-msg class="mt-2 hidden text-sm font-medium text-online"></p>
            </div>
            <div class="mt-5">
              <p class="text-sm font-medium">{m.settings_change_password()}</p>
              <div class="mt-1.5 space-y-2">
                <span class="slab-field block"><span class="slab-field__face block">
                  <input data-acct-cur type="password" placeholder={m.settings_current_password()} autocomplete="current-password"
                    class="w-full bg-transparent p-2.5 text-sm caret-brand outline-none placeholder:text-muted-foreground" />
                </span></span>
                <span class="slab-field block"><span class="slab-field__face block">
                  <input data-acct-new type="password" placeholder={m.settings_new_password()} autocomplete="new-password"
                    class="w-full bg-transparent p-2.5 text-sm caret-brand outline-none placeholder:text-muted-foreground" />
                </span></span>
              </div>
              <button type="button" data-acct-pw-btn class="mt-2 cursor-pointer border border-foreground/20 px-3 py-2 text-sm font-medium transition-colors hover:border-foreground/60">
                {m.settings_change_password_btn()}
              </button>
              <p data-acct-pw-msg class="mt-2 hidden text-sm font-medium"></p>
            </div>
          </section>

          {convo && (
            <section class="py-5">
              <div class="flex flex-wrap items-center justify-between gap-4">
                <h2 class={heading}>{m.settings_messaging()}</h2>
                <Select name="convo-mode" data-convo-mode class="w-48">
                  {CONVERSATION_MODES.map((mode) => (
                    <option value={mode} selected={convo.mode === mode}>{modeLabel(mode)}</option>
                  ))}
                </Select>
              </div>
              <p class="mt-2 text-xs text-muted-foreground">{m.settings_messaging_note()}</p>

              {/* Screening question (UX-PLAN 4.3): asked as the last step of a
                  request; her answer rides in the request card. Empty = no screening. */}
              <div class="mt-4">
                <label class="text-sm font-medium" for="screening-q">{m.settings_screening()}</label>
                <span class="slab-field mt-1.5 block">
                  <span class="slab-field__face block">
                    <input
                      id="screening-q"
                      type="text"
                      data-screening-q
                      maxlength="140"
                      value={convo.screeningQuestion}
                      placeholder={m.settings_screening_ph()}
                      class="w-full bg-transparent p-2.5 text-sm caret-brand outline-none placeholder:text-muted-foreground"
                    />
                  </span>
                </span>
                <p class="mt-2 text-xs text-muted-foreground">{m.settings_screening_note()}</p>
              </div>
            </section>
          )}

          {/* Push notifications (both roles) — hidden until PushManager confirms
              support; all behavior lives in organisms/push/PushManager.astro. */}
          <section class="py-5" data-push-section hidden>
            <h2 class={heading}>{m.push_settings_title()}</h2>
            <div class="mt-4 space-y-4">
              <div class="flex items-center justify-between gap-4">
                <span class="flex flex-col">
                  <span class="text-sm font-medium">{m.push_master()}</span>
                  <span class="text-xs text-muted-foreground">{m.push_master_desc()}</span>
                </span>
                <label class="flex cursor-pointer items-center">
                  <input type="checkbox" data-push-master class="sr-only" />
                  <span class="switch-track" aria-hidden="true" />
                </label>
              </div>
              <p data-push-denied hidden class="text-sm font-medium text-brand">{m.push_denied()}</p>
              <p data-push-error hidden class="text-sm text-brand">
                {m.push_error()} <span data-push-error-detail class="font-mono text-xs"></span>
              </p>
              {isAdvertiser && (
                <div class="flex items-center justify-between gap-4">
                  <span class="flex flex-col">
                    <span class="text-sm font-medium">{m.push_cat_requests()}</span>
                    <span class="text-xs text-muted-foreground">{m.push_cat_requests_desc()}</span>
                  </span>
                  <label class="flex cursor-pointer items-center">
                    <input type="checkbox" data-push-pref="requests" checked class="sr-only" />
                    <span class="switch-track" aria-hidden="true" />
                  </label>
                </div>
              )}
              <div class="flex items-center justify-between gap-4">
                <span class="flex flex-col">
                  <span class="text-sm font-medium">{m.push_cat_messages()}</span>
                  <span class="text-xs text-muted-foreground">{m.push_cat_messages_desc()}</span>
                </span>
                <label class="flex cursor-pointer items-center">
                  <input type="checkbox" data-push-pref="messages" checked class="sr-only" />
                  <span class="switch-track" aria-hidden="true" />
                </label>
              </div>
            </div>
          </section>

          {session.role === 'advertiser' && (
            <section class="py-5">
              <div class="flex items-center justify-between gap-4">
                <h2 class={heading}>{m.settings_pause()}</h2>
                {canPause && (
                  <label class="flex cursor-pointer items-center">
                    <input type="checkbox" data-pause checked={isPaused} class="sr-only" />
                    <span class="switch-track" aria-hidden="true" />
                  </label>
                )}
              </div>
              <p class="mt-2 text-xs text-muted-foreground">{m.settings_pause_note()}</p>
              {canPause ? (
                <p
                  data-pause-status
                  data-live={m.settings_pause_live()}
                  data-paused={m.settings_pause_paused()}
                  class:list={['mt-2 text-sm font-medium', isPaused ? 'text-brand' : 'text-online']}
                >
                  {isPaused ? m.settings_pause_paused() : m.settings_pause_live()}
                </p>
              ) : (
                <p class="mt-2 text-sm text-muted-foreground">{m.settings_pause_locked()}</p>
              )}
            </section>
          )}

          {session.role === 'advertiser' && canPause && (
            <section class="py-5">
              <div class="flex items-center justify-between gap-4">
                <h2 class={heading}>{m.settings_unlisted()}</h2>
                <label class="flex cursor-pointer items-center">
                  <input type="checkbox" data-unlisted checked={isUnlisted} class="sr-only" />
                  <span class="switch-track" aria-hidden="true" />
                </label>
              </div>
              <p class="mt-2 text-xs text-muted-foreground">{m.settings_unlisted_note()}</p>
            </section>
          )}

          {/* GDPR self-service (items.md #6/#7) — both fulfilled by a human.
              Hidden for admin accounts: they manage GDPR through /admin, and the
              super admin must not self-request data/deletion (#3). */}
          {!session.adminRole && (
          <section class="py-5">
            <h2 class={heading}>{m.settings_privacy()}</h2>
            <div class="mt-3 space-y-3">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <p class="text-sm">{m.settings_data_request()}</p>
                {account?.dataRequestedAt ? (
                  <p class="text-sm font-medium text-online">{m.settings_gdpr_pending()}</p>
                ) : (
                  <button type="button" data-gdpr="data" class="cursor-pointer border border-foreground/20 px-3 py-1.5 text-sm font-medium transition-colors hover:border-foreground/60">
                    {m.settings_data_request_btn()}
                  </button>
                )}
              </div>
              <div class="flex flex-wrap items-center justify-between gap-3">
                <p class="text-sm">{m.settings_delete_request()}</p>
                {account?.deletionRequestedAt ? (
                  <p class="text-sm font-medium text-brand">{m.settings_gdpr_pending()}</p>
                ) : (
                  <button type="button" data-modal-open="confirm-delete" class="cursor-pointer border border-brand/40 px-3 py-1.5 text-sm font-medium text-brand transition-colors hover:border-brand">
                    {m.settings_delete_request_btn()}
                  </button>
                )}
              </div>
              <p class="text-xs text-muted-foreground">{m.settings_gdpr_note()}</p>
            </div>
          </section>
          )}

          {/* Site-styled confirm for account deletion — replaces the browser
              confirm() popup (#1). */}
          <Modal id="confirm-delete" class="max-w-sm">
            <div class="p-6">
              <h2 class="font-condensed text-xl font-bold">{m.settings_delete_title()}</h2>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{m.settings_delete_confirm()}</p>
              <div class="mt-5 flex justify-end gap-2.5">
                <button type="button" data-modal-close class="cursor-pointer border border-foreground/20 px-4 py-2 text-sm font-medium transition-colors hover:border-foreground/60">
                  {m.action_cancel()}
                </button>
                <button type="button" data-gdpr-confirm class="slab-cut cursor-pointer bg-brand px-4 py-2 text-sm font-bold uppercase tracking-wide text-white transition-colors hover:bg-brand/90">
                  {m.settings_delete_request_btn()}
                </button>
              </div>
            </div>
          </Modal>

          <section class="py-5">
            <h2 class={heading}>{m.settings_blocked()}</h2>
            {blocked.length === 0 ? (
              <p class="mt-2 text-sm text-muted-foreground">{m.settings_blocked_empty()}</p>
            ) : (
              <ul class="mt-3 divide-y divide-border">
                {blocked.map((t) => (
                  <li class="flex items-center justify-between gap-4 py-2.5">
                    <span class="truncate text-sm font-medium">
                      {isAdvertiser ? t.clientName : t.profileName}
                    </span>
                    <button
                      type="button"
                      data-unblock={t.id}
                      class="border border-foreground/20 px-3 py-1 text-sm font-medium transition-colors hover:border-foreground/60"
                    >
                      {m.msg_unblock()}
                    </button>
                  </li>
                ))}
              </ul>
            )}
          </section>
        </div>
      </AccountShell>
    )
  }
</Layout>

<script>
  import { actions } from 'astro:actions';
  function initMsgSettings() {
    const mode = document.querySelector('[data-convo-mode]') as HTMLSelectElement | null;
    if (mode && !mode.dataset.init) {
      mode.dataset.init = '1';
      mode.addEventListener('change', () =>
        actions.messaging.setMode({ mode: mode.value as 'off' | 'everyone' | 'verified_only' }),
      );
    }
    const screening = document.querySelector('[data-screening-q]') as HTMLInputElement | null;
    if (screening && !screening.dataset.init) {
      screening.dataset.init = '1';
      screening.addEventListener('blur', () =>
        actions.messaging.setScreeningQuestion({ question: screening.value }),
      );
    }
    document.querySelectorAll<HTMLElement>('[data-unblock]').forEach((btn) => {
      if (btn.dataset.init) return;
      btn.dataset.init = '1';
      btn.addEventListener('click', async () => {
        await actions.messaging.setBlocked({ threadId: btn.dataset.unblock!, blocked: false });
        btn.closest('li')?.remove();
      });
    });

    // GDPR requests (items.md #6/#7): flag → reload shows the pending state.
    // Data request is one tap; deletion is confirmed through the styled modal
    // (#1) whose confirm button carries data-gdpr-confirm.
    document.querySelectorAll<HTMLElement>('[data-gdpr]').forEach((btn) => {
      if (btn.dataset.init) return;
      btn.dataset.init = '1';
      btn.addEventListener('click', async () => {
        await actions.account.requestGdpr({ kind: btn.dataset.gdpr as 'deletion' | 'data' });
        location.reload();
      });
    });
    const confirmDelete = document.querySelector<HTMLElement>('[data-gdpr-confirm]');
    if (confirmDelete && !confirmDelete.dataset.init) {
      confirmDelete.dataset.init = '1';
      confirmDelete.addEventListener('click', async () => {
        await actions.account.requestGdpr({ kind: 'deletion' });
        location.reload();
      });
    }

    // Pause / resume the live profile, with immediate status feedback.
    const pause = document.querySelector('[data-pause]') as HTMLInputElement | null;
    const status = document.querySelector('[data-pause-status]') as HTMLElement | null;
    if (pause && !pause.dataset.init) {
      pause.dataset.init = '1';
      pause.addEventListener('change', async () => {
        const paused = pause.checked;
        pause.disabled = true;
        const { error } = await actions.account.setPaused({ paused });
        pause.disabled = false;
        if (error) {
          pause.checked = !paused; // revert on failure
          return;
        }
        if (status) {
          status.textContent = paused ? status.dataset.paused! : status.dataset.live!;
          status.classList.toggle('text-brand', paused);
          status.classList.toggle('text-online', !paused);
        }
      });
    }

    // Unlisted: out of listings/search, direct link keeps working.
    const unlisted = document.querySelector('[data-unlisted]') as HTMLInputElement | null;
    if (unlisted && !unlisted.dataset.init) {
      unlisted.dataset.init = '1';
      unlisted.addEventListener('change', async () => {
        const value = unlisted.checked;
        unlisted.disabled = true;
        const { error } = await actions.account.setUnlisted({ unlisted: value });
        unlisted.disabled = false;
        if (error) unlisted.checked = !value; // revert on failure
      });
    }
  }
  // Change email + password (#6).
  function initAccount() {
    const sec = document.querySelector<HTMLElement>('[data-account-sec]');
    if (!sec || sec.dataset.init) return;
    sec.dataset.init = '1';
    const d = sec.dataset;
    sec.querySelector<HTMLElement>('[data-acct-email-btn]')?.addEventListener('click', async () => {
      const email = sec.querySelector<HTMLInputElement>('[data-acct-email]')!.value.trim();
      const msg = sec.querySelector<HTMLElement>('[data-acct-email-msg]')!;
      const { error } = await actions.auth.changeEmail({ email });
      msg.textContent = error ? d.err! : d.sent!;
      msg.classList.remove('hidden', 'text-online', 'text-brand');
      msg.classList.add(error ? 'text-brand' : 'text-online');
    });
    sec.querySelector<HTMLElement>('[data-acct-pw-btn]')?.addEventListener('click', async () => {
      const currentPassword = sec.querySelector<HTMLInputElement>('[data-acct-cur]')!.value;
      const newPassword = sec.querySelector<HTMLInputElement>('[data-acct-new]')!.value;
      const msg = sec.querySelector<HTMLElement>('[data-acct-pw-msg]')!;
      const { error } = await actions.auth.changePassword({ currentPassword, newPassword });
      const text = !error ? d.saved! : error.message === 'settings_pw_wrong' ? d.wrong! : d.err!;
      msg.textContent = text;
      msg.classList.remove('hidden', 'text-online', 'text-brand');
      msg.classList.add(error ? 'text-brand' : 'text-online');
      if (!error) { sec.querySelectorAll<HTMLInputElement>('[data-acct-cur],[data-acct-new]').forEach((i) => (i.value = '')); }
    });
  }
  initAccount();
  document.addEventListener('astro:page-load', initAccount);

  initMsgSettings();
  document.addEventListener('astro:page-load', initMsgSettings);
</script>
