---
/** Account settings — the "Account" tab. Appearance, language, pause, sign out. */
import * as m from '@/paraglide/messages';
import { messagingApi } from '@/app/api/messaging';
import { sessionApi } from '@/app/api/session';
import { isLocale, localizePath } from '@/lib/i18n';
import { CONVERSATION_MODES, LOCALES } from '@/lib/taxonomy';
import AccountShell from '@/components/organisms/dashboard/AccountShell.astro';
import SignInPrompt from '@/components/organisms/dashboard/SignInPrompt.astro';
import ThemeToggle from '@/components/molecules/ThemeToggle.astro';
import SafeModeToggle from '@/components/molecules/SafeModeToggle.astro';
import Select from '@/components/atoms/Select.astro';
import Layout from '@/layouts/Layout.astro';

const locale = Astro.params.locale;
if (!isLocale(locale)) return new Response(null, { status: 404 });

const session = await sessionApi.fromCookies(Astro.cookies);
const isAdvertiser = session?.role === 'advertiser';
const convo = session && isAdvertiser && session.profileId ? await messagingApi.settings(session.profileId) : null;
const blocked = session ? await messagingApi.listBlocked(session) : [];
const modeLabel = (mode: (typeof CONVERSATION_MODES)[number]) =>
  mode === 'off' ? m.msg_mode_off() : mode === 'everyone' ? m.msg_mode_everyone() : m.msg_mode_verified();
const LANGS: Record<(typeof LOCALES)[number], string> = {
  nl: 'Nederlands',
  en: 'English',
  de: 'Deutsch',
};
const heading = 'font-condensed text-sm font-bold uppercase tracking-wide text-muted-foreground';
---

<Layout noindex title={`${m.settings_title()} | Intimate`}>
  {!session && <SignInPrompt />}
  {
    session && (
      <AccountShell {session} title={m.settings_title()} path={localizePath('/account/settings/')}>
        <div class="max-w-xl divide-y divide-border">
          <section class="flex items-center justify-between gap-4 py-5 first:pt-0">
            <h2 class={heading}>{m.settings_appearance()}</h2>
            <div class="flex items-center gap-4">
              <SafeModeToggle />
              <ThemeToggle />
            </div>
          </section>

          <section class="flex flex-wrap items-center justify-between gap-4 py-5">
            <h2 class={heading}>{m.settings_language()}</h2>
            <div class="flex gap-1.5">
              {LOCALES.map((l) => (
                <a
                  href={`/${l}/account/settings/`}
                  class:list={[
                    'rounded-md border px-3 py-1.5 text-sm font-medium transition-colors',
                    l === locale
                      ? 'border-foreground bg-foreground text-background'
                      : 'border-foreground/20 hover:border-foreground/60',
                  ]}
                >
                  {LANGS[l]}
                </a>
              ))}
            </div>
          </section>

          {convo && (
            <section class="py-5">
              <div class="flex flex-wrap items-center justify-between gap-4">
                <h2 class={heading}>{m.settings_messaging()}</h2>
                <Select name="convo-mode" data-convo-mode class="w-48">
                  {CONVERSATION_MODES.map((mode) => (
                    <option value={mode} selected={convo.mode === mode}>{modeLabel(mode)}</option>
                  ))}
                </Select>
              </div>
              <p class="mt-2 text-xs text-muted-foreground">{m.settings_messaging_note()}</p>

              {/* Screening question (UX-PLAN 4.3): asked as the last step of a
                  request; her answer rides in the request card. Empty = no screening. */}
              <div class="mt-4">
                <label class="text-sm font-medium" for="screening-q">{m.settings_screening()}</label>
                <span class="slab-field mt-1.5 block">
                  <span class="slab-field__face block">
                    <input
                      id="screening-q"
                      type="text"
                      data-screening-q
                      maxlength="140"
                      value={convo.screeningQuestion}
                      placeholder={m.settings_screening_ph()}
                      class="w-full bg-transparent p-2.5 text-sm caret-brand outline-none placeholder:text-muted-foreground"
                    />
                  </span>
                </span>
                <p class="mt-2 text-xs text-muted-foreground">{m.settings_screening_note()}</p>
              </div>
            </section>
          )}

          {session.role === 'advertiser' && (
            <section class="py-5">
              <div class="flex items-center justify-between gap-4">
                <h2 class={heading}>{m.settings_pause()}</h2>
                <label class="flex cursor-pointer items-center">
                  <input type="checkbox" class="sr-only" />
                  <span class="switch-track" aria-hidden="true" />
                </label>
              </div>
              <p class="mt-2 text-xs text-muted-foreground">{m.settings_pause_note()}</p>
            </section>
          )}

          <section class="py-5">
            <h2 class={heading}>{m.settings_blocked()}</h2>
            {blocked.length === 0 ? (
              <p class="mt-2 text-sm text-muted-foreground">{m.settings_blocked_empty()}</p>
            ) : (
              <ul class="mt-3 divide-y divide-border">
                {blocked.map((t) => (
                  <li class="flex items-center justify-between gap-4 py-2.5">
                    <span class="truncate text-sm font-medium">
                      {isAdvertiser ? t.clientName : t.profileName}
                    </span>
                    <button
                      type="button"
                      data-unblock={t.id}
                      class="rounded-md border border-foreground/20 px-3 py-1 text-sm font-medium transition-colors hover:border-foreground/60"
                    >
                      {m.msg_unblock()}
                    </button>
                  </li>
                ))}
              </ul>
            )}
          </section>
        </div>
      </AccountShell>
    )
  }
</Layout>

<script>
  import { actions } from 'astro:actions';
  function initMsgSettings() {
    const mode = document.querySelector('[data-convo-mode]') as HTMLSelectElement | null;
    if (mode && !mode.dataset.init) {
      mode.dataset.init = '1';
      mode.addEventListener('change', () =>
        actions.messaging.setMode({ mode: mode.value as 'off' | 'everyone' | 'verified_only' }),
      );
    }
    const screening = document.querySelector('[data-screening-q]') as HTMLInputElement | null;
    if (screening && !screening.dataset.init) {
      screening.dataset.init = '1';
      screening.addEventListener('blur', () =>
        actions.messaging.setScreeningQuestion({ question: screening.value }),
      );
    }
    document.querySelectorAll<HTMLElement>('[data-unblock]').forEach((btn) => {
      if (btn.dataset.init) return;
      btn.dataset.init = '1';
      btn.addEventListener('click', async () => {
        await actions.messaging.setBlocked({ threadId: btn.dataset.unblock!, blocked: false });
        btn.closest('li')?.remove();
      });
    });
  }
  initMsgSettings();
  document.addEventListener('astro:page-load', initMsgSettings);
</script>
