---
/**
 * The professional's guided setup flow (docs/ONBOARDING.md) — one job per screen,
 * reusing the editor sections (ProfileEditorForm variant props), MediaManager and
 * VerificationFlow. Progress + resume are DERIVED (lib/onboarding.ts) — no stored
 * step. Server-rendered per `?step`; the reused islands (photo upload, SMS/ID)
 * reload in place, which preserves ?step. Advertiser only.
 */
import * as m from '@/paraglide/messages';
import { accountApi } from '@/app/api/account';
import { sessionApi } from '@/app/api/session';
import { onboardingProgress } from '@/lib/onboarding';
import { isLocale, localizePath } from '@/lib/i18n';
import SetupShell from '@/components/organisms/onboarding/SetupShell.astro';
import ProfileEditorForm from '@/components/organisms/dashboard/ProfileEditorForm.astro';
import MediaManager from '@/components/organisms/dashboard/MediaManager.astro';
import VerificationFlow from '@/components/organisms/dashboard/VerificationFlow.astro';
import Button from '@/components/atoms/Button.astro';
import Layout from '@/layouts/Layout.astro';

const locale = Astro.params.locale;
if (!isLocale(locale)) return new Response(null, { status: 404 });

const session = await sessionApi.current(Astro);
// Solo professional only — clients/agencies never enter the flow.
if (!session) return Astro.redirect(localizePath('/account/'));
if (session.role !== 'advertiser') return Astro.redirect(localizePath('/account/'));

const account = await accountApi.get(session);
const profile = await accountApi.myProfile(session);
const progress = onboardingProgress(profile!, account);
const photos = progress.steps.find((s) => s.key === 'basics')?.done ? await accountApi.photos(session) : [];

// Flow order; NUMBERED drives the progress bar (welcome + done sit outside it).
// Photos-first (docs/ONBOARDING.md): identity → contact → photos → verify. The
// "reading" (rates/services/hours) is optional and edited from the dashboard.
const NUMBERED = ['basics', 'contact', 'photos', 'verify'] as const;
const ALL = ['welcome', ...NUMBERED, 'done'] as const;
type Step = (typeof ALL)[number];
const NEXT: Record<string, Step> = {
  welcome: 'basics', basics: 'contact', contact: 'photos', photos: 'verify',
};

// Where a returning visitor resumes: the first incomplete REQUIRED step. `id`
// lives on the 'verify' screen; once all required are done, land on 'verify'.
const resume = (): Step => {
  const fi = progress.firstIncomplete;
  if (fi === null || fi === 'id') return 'verify';
  return fi as Step;
};
const basicsDone = progress.steps.find((s) => s.key === 'basics')!.done;
let step = (Astro.url.searchParams.get('step') ?? '') as Step;
if (!ALL.includes(step)) step = progress.submitted ? 'done' : basicsDone ? resume() : 'welcome';
// Once submitted, the flow is over — only the 'done' celebration is reachable.
if (progress.submitted && step !== 'done') return Astro.redirect(localizePath('/account/'));

const idx = (NUMBERED as readonly string[]).indexOf(step) + 1; // 0 for welcome/done
const cont = 'w-full';
const title = 'display text-2xl md:text-3xl';
const why = 'mt-2 leading-relaxed text-muted-foreground';
---

<Layout noindex title={`${m.onb_title()} | Intimate`}>
  <SetupShell index={idx > 0 ? idx : undefined} total={NUMBERED.length}>
    {
      step === 'welcome' && (
        <div>
          <h1 class={title}>{m.onb_welcome_title()}</h1>
          <ol class="mt-6 space-y-4">
            <li class="flex items-start gap-3.5">
              <span aria-hidden="true" class="grid size-6 flex-none place-items-center bg-foreground text-2xs font-bold text-background">1</span>
              <span>
                {m.onb_welcome_p1()} — <em class="not-italic text-muted-foreground">{m.onb_welcome_p1_note()}</em>
              </span>
            </li>
            <li class="flex items-start gap-3.5">
              <span aria-hidden="true" class="grid size-6 flex-none place-items-center bg-foreground text-2xs font-bold text-background">2</span>
              <span>{m.onb_welcome_p2()}</span>
            </li>
            <li class="flex items-start gap-3.5">
              <span aria-hidden="true" class="grid size-6 flex-none place-items-center bg-foreground text-2xs font-bold text-background">3</span>
              <span>{m.onb_welcome_p3()}</span>
            </li>
          </ol>
          <p class="mt-6 text-sm text-muted-foreground">{m.onb_welcome_reassure()}</p>
          <Button as="a" href={`?step=basics`} size="lg" class={`${cont} mt-8`}>{m.onb_start()}</Button>
          <a href={`${localizePath('/account/')}?later=1`} class="mt-3 block text-center text-sm text-muted-foreground underline-offset-2 hover:underline">
            {m.onb_look_around()}
          </a>
        </div>
      )
    }

    {
      step === 'basics' && (
        <div>
          <h1 class={title}>{m.onb_step_basics()}</h1>
          <p class={why}>{m.onb_why_basics()}</p>
          <div class="mt-6"><ProfileEditorForm profile={profile!} only={['basics']} wizard /></div>
          <Button size="lg" class={`${cont} mt-8`} data-wizard-continue data-save data-next="contact">
            {m.onb_continue()}
          </Button>
          <p data-wizard-error class="mt-2 hidden text-sm font-medium text-brand"></p>
        </div>
      )
    }

    {
      step === 'contact' && (
        <div>
          <h1 class={title}>{m.onb_step_contact()}</h1>
          <p class={why}>{m.onb_why_contact()}</p>
          <div class="mt-6"><ProfileEditorForm profile={profile!} only={['contact']} wizard /></div>
          <Button size="lg" class={`${cont} mt-8`} data-wizard-continue data-save data-next="photos">
            {m.onb_continue()}
          </Button>
          <a href={`?step=photos`} class="mt-3 block text-center text-sm text-muted-foreground underline-offset-2 hover:underline">
            {m.onb_skip()}
          </a>
          <p data-wizard-error class="mt-2 hidden text-sm font-medium text-brand"></p>
        </div>
      )
    }

    {
      step === 'photos' && (
        <div>
          <h1 class={title}>{m.onb_step_photos()}</h1>
          <p class={why}>{m.onb_why_photos()}</p>
          <ul class="mt-3 space-y-1.5 text-sm text-muted-foreground">
            <li class="flex gap-2"><span aria-hidden="true">•</span>{m.onb_photo_rule1()}</li>
            <li class="flex gap-2"><span aria-hidden="true">•</span>{m.onb_photo_rule2()}</li>
          </ul>
          <div class="mt-6"><MediaManager {photos} /></div>
          {photos.length > 0 ? (
            <Button as="a" href={`?step=verify`} size="lg" class={`${cont} mt-8`}>{m.onb_continue_photos()}</Button>
          ) : (
            <Button size="lg" class={`${cont} mt-8`} disabled>{m.onb_continue_photos()}</Button>
          )}
        </div>
      )
    }

    {
      step === 'verify' && (
        <div>
          <h1 class={title}>{m.verify_title()}</h1>
          <p class={why}>{m.onb_why_verify()}</p>
          <div class="mt-6"><VerificationFlow {session} {account} wizardFinish={progress.firstIncomplete === 'id'} /></div>
          {progress.readyToSubmit && (
            <div class="mt-8 border-t border-border pt-6">
              <p class="mb-3 text-sm text-muted-foreground">{m.onb_verify_submit_hint()}</p>
              <Button size="lg" class={cont} data-wizard-submit>{m.onb_submit()}</Button>
              <p data-wizard-error class="mt-2 hidden text-sm font-medium text-brand"></p>
            </div>
          )}
        </div>
      )
    }

    {
      step === 'done' && (
        <div class="py-10 text-center">
          <span class="mx-auto grid size-16 place-items-center rounded-full bg-online/15 text-online">
            <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
          </span>
          <h1 class="display mt-5 text-2xl md:text-3xl">{m.onb_done_title()}</h1>
          <p class="mx-auto mt-2 max-w-sm leading-relaxed text-muted-foreground">{m.onb_done_note()}</p>
          <Button
            as="a"
            href={profile?.slug ? localizePath(`/profile/${profile.slug}/`) : localizePath('/account/')}
            size="lg"
            class={`${cont} mt-8`}
          >
            {m.onb_done_cta()}
          </Button>
        </div>
      )
    }
  </SetupShell>
</Layout>

<script>
  import { actions } from 'astro:actions';
  import { readProfilePatch } from '@/lib/editor-form';

  function initWizard() {
    // Save-and-advance: read the step's editor form → partial save → next step.
    document.querySelectorAll<HTMLElement>('[data-wizard-continue]').forEach((btn) => {
      if (btn.dataset.init) return;
      btn.dataset.init = '1';
      btn.addEventListener('click', async () => {
        if (btn.dataset.loading) return;
        const err = document.querySelector<HTMLElement>('[data-wizard-error]');
        const fail = (msg: string) => {
          if (err) { err.textContent = msg; err.classList.remove('hidden'); }
          delete btn.dataset.loading;
        };
        btn.dataset.loading = '1';
        err?.classList.add('hidden');
        try {
          if (btn.dataset.save !== undefined) {
            const form = document.querySelector<HTMLFormElement>('[data-profile-editor]');
            if (form) {
              const patch = readProfilePatch(form);
              // saveProfile accepts empty rates/services; enforce the step's
              // required minimum here so she can't skip past it into a dead-end.
              const req = btn.dataset.require;
              const list = (patch as Record<string, unknown[]>)[req ?? ''];
              if (req && (!Array.isArray(list) || list.length === 0)) return fail(btn.dataset.requireMsg || 'Please complete this step.');
              const { error } = await actions.account.saveProfile({ patch });
              if (error) throw error;
            }
          }
          location.href = `?step=${btn.dataset.next}`;
        } catch (e) {
          fail((e as { message?: string })?.message || 'Try again');
        }
      });
    });

    // The big moment: submit for review → the finish screen.
    const submit = document.querySelector<HTMLButtonElement>('[data-wizard-submit]');
    if (submit && !submit.dataset.init) {
      submit.dataset.init = '1';
      submit.addEventListener('click', async () => {
        if (submit.dataset.loading) return;
        submit.dataset.loading = '1';
        // If a phone code was typed (code sent) but not verified, verify it as
        // part of submitting — best-effort, phone is optional so it never blocks.
        const check = document.querySelector<HTMLElement>('[data-sms-check]');
        const smsCode = (document.querySelector<HTMLInputElement>('[data-sms-check] input[name="code"]')?.value ?? '').trim();
        if (check && !check.hidden && /^\d{6}$/.test(smsCode)) {
          try { await actions.account.checkSms({ code: smsCode }); } catch { /* optional */ }
        }
        const { error } = await actions.account.submitProfile({});
        if (error) {
          document.querySelector('[data-wizard-error]')?.classList.remove('hidden');
          delete submit.dataset.loading;
          return;
        }
        location.href = '?step=done';
      });
    }
  }
  initWizard();
  document.addEventListener('astro:page-load', initWizard);
</script>
