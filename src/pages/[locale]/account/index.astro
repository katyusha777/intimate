---
/** Account dashboard — role-aware. */
import * as m from '@/paraglide/messages';
import { accountApi } from '@/app/api/account';
import { messagingApi } from '@/app/api/messaging';
import { profileAge } from '@/app/models/profile';
import { sessionApi } from '@/app/api/session';
import { onboardingProgress } from '@/lib/onboarding';
import type { ProfileState } from '@/lib/taxonomy';
import { isLocale, localizePath } from '@/lib/i18n';
import AccountShell from '@/components/organisms/dashboard/AccountShell.astro';
import Icon from '@/components/atoms/Icon.astro';
import OnboardingChecklist from '@/components/organisms/dashboard/OnboardingChecklist.astro';
import SignInPrompt from '@/components/organisms/dashboard/SignInPrompt.astro';
import Layout from '@/layouts/Layout.astro';

const locale = Astro.params.locale;
if (!isLocale(locale)) return new Response(null, { status: 404 });

const session = await sessionApi.current(Astro);

// Claim a pending invite (from /c/<token>) now that she's signed in (#9): this
// is the landing after signup + email confirmation. claimInvite adds her to the
// advertiser's contacts and posts the "joined via your invite link" auto-chat;
// then we drop her straight into that thread.
if (session && session.role === 'client') {
  const inviteToken = Astro.cookies.get('invite_token')?.value;
  if (inviteToken) {
    Astro.cookies.delete('invite_token', { path: '/' });
    const claimed = await messagingApi.claimInvite(session, { token: inviteToken });
    if (claimed && claimed !== 'own') return Astro.redirect(`/${locale}/messages/${claimed.id}/`);
  }
}

const account = session ? await accountApi.get(session) : null;
const profile = session ? await accountApi.myProfile(session) : null;

// Advertiser + not-yet-submitted → the onboarding checklist IS the dashboard.
const progress =
  session?.role === 'advertiser' && profile && account ? onboardingProgress(profile, account) : null;
const onboarding = progress != null && !progress.submitted;

// First-run guidance: send an unfinished advertiser into the setup flow, unless
// she's explicitly tapped "later" (a session cookie remembers that choice).
const later = Astro.url.searchParams.get('later');
if (later) Astro.cookies.set('setup_later', '1', { path: '/', httpOnly: true, sameSite: 'lax' });
if (onboarding && !later && !Astro.cookies.get('setup_later')) {
  return Astro.redirect(localizePath('/account/setup/'));
}

const card = 'facts-card dark bg-neutral-950 p-6 text-white';
// Human words, never "pending_review" (ONBOARDING.md law 5).
const stateLabel = (s: ProfileState) =>
  s === 'live' ? m.state_live() : s === 'pending_review' ? m.state_pending() : s === 'paused' ? m.state_paused() : m.state_draft();
// Analytics (profile views/contacts) land with the events table — until then the
// dashboard shows only real state (no invented numbers). See docs/ANALYTICS.md.
---

<Layout noindex title={`${m.nav_account()} | Intimate`}>
  {!session && <SignInPrompt />}
  {
    session && account && (
      <AccountShell
        {session}
        title={m.nav_dashboard()}
        path={localizePath('/account/')}
        bannerState={session.role === 'advertiser' ? profile?.state : undefined}
      >
        {onboarding && progress ? (
          <div class="max-w-xl">
            <OnboardingChecklist {progress} />
          </div>
        ) : (
        <div class="grid items-start gap-5 md:grid-cols-2">
          {profile && session.role === 'advertiser' && (
            <div class={card}>
              <p class="eyebrow text-2xs text-white/50">{m.account_state()}</p>
              <p class="mt-2.5 flex items-center gap-3 font-condensed text-2xl font-bold">
                {profile.name}, {profileAge(profile.birthDate)}
                <span
                  class:list={[
                    'rounded inline-block border px-2.5 py-1 font-condensed text-xs font-bold uppercase tracking-wide',
                    profile.state === 'live' ? 'border-online/50 text-online' : 'border-white/30',
                  ]}
                >
                  {stateLabel(profile.state)}
                </span>
              </p>
              <p class="mt-1.5 text-sm text-white/60">
                €{profile.priceFrom} · {profile.services.length} {m.account_services_count()} ·{' '}
                {profile.photos.length} {m.photos_title().toLowerCase()}
              </p>
              <div class="mt-5 flex items-center justify-between gap-4 border-t border-white/10 pt-5">
                <label class="flex cursor-pointer select-none items-center gap-2.5 text-sm font-medium">
                  <input type="checkbox" checked={profile.online} class="sr-only" />
                  <span class="switch-track" aria-hidden="true" />
                  {m.online_toggle()}
                </label>
                <a
                  href={localizePath(`/profile/${profile.slug}/`)}
                  class="text-sm font-semibold underline-offset-4 hover:underline"
                >
                  {m.account_view_public()} →
                </a>
              </div>
            </div>
          )}

          {session.role === 'advertiser' && (
            <div class={card}>
              <p class="eyebrow text-2xs text-white/50">{m.account_verification()}</p>
              <div class="mt-4 space-y-2.5 text-sm">
                <p class="flex items-center justify-between gap-4 border-b border-white/10 pb-2.5">
                  <span class="text-white/70">{m.account_sms()}</span>
                  <span class:list={account.phoneVerifiedAt ? 'font-medium text-online' : 'text-white/50'}>
                    {account.phoneVerifiedAt ? m.verify_verified() : '—'}
                  </span>
                </p>
                <p class="flex items-center justify-between gap-4">
                  <span class="text-white/70">{m.account_id()}</span>
                  <span
                    class:list={
                      account.idVerification === 'approved'
                        ? 'font-medium text-online'
                        : account.idVerification === 'rejected'
                          ? 'font-medium text-brand'
                          : 'text-white/50'
                    }
                  >
                    {account.idVerification === 'approved'
                      ? m.verify_verified()
                      : account.idVerification === 'pending'
                        ? m.verify_pending()
                        : account.idVerification === 'rejected'
                          ? m.verify_rejected()
                          : '—'}
                  </span>
                </p>
                {account.idVerification === 'rejected' && account.verificationReason && (
                  <p class="mt-1 border-l-2 border-brand pl-2.5 text-xs leading-relaxed text-white/70">
                    {m.verify_reason_label()}: {account.verificationReason.replace(/_/g, ' ')}. {m.verify_reason_fix()}
                  </p>
                )}
              </div>
              <a
                href={localizePath('/account/verification/')}
                class="mt-5 inline-block text-sm font-semibold underline-offset-4 hover:underline"
              >
                {m.verify_title()} →
              </a>
            </div>
          )}

          {/* Advertiser-only profile lookup by username/name (feedback v7 —
              never shown to clients). GETs to the shared search listing. */}
          {session.role === 'advertiser' && (
            <div class={card}>
              <p class="eyebrow text-2xs text-white/50">{m.account_find_title()}</p>
              <form method="GET" action={localizePath('/search/')} class="mt-3 flex items-center gap-2">
                <input
                  type="search"
                  name="q"
                  placeholder={m.search_find_ph()}
                  class="min-w-0 flex-1 border border-white/20 bg-transparent px-3 py-2 text-sm text-white outline-none placeholder:text-white/40 focus:border-white/60"
                />
                <button type="submit" aria-label={m.search_open()} class="grid size-9 flex-none place-items-center bg-white text-neutral-950">
                  <Icon name="magnifying-glass" class="text-base" />
                </button>
              </form>
            </div>
          )}

          {session.role === 'client' && (
            <div class={card}>
              <p class="eyebrow text-2xs text-white/50">{m.nav_account()}</p>
              <div class="mt-3 space-y-2.5 text-sm">
                <p class="flex items-center justify-between gap-4 border-b border-white/10 pb-2.5">
                  <span class="text-white/70">{m.auth_email()}</span>
                  {session.email}
                </p>
                <p class="flex items-center justify-between gap-4">
                  <span class="text-white/70">{m.filter_gender()}</span>
                  {m.role_client()}
                </p>
              </div>
              <p class="mt-5 text-xs text-white/50">{m.account_demo_note()}</p>
            </div>
          )}
        </div>
        )}
      </AccountShell>
    )
  }
</Layout>

<style>
  .facts-card {
    clip-path: polygon(0 8px, 100% 0, 100% calc(100% - 5px), 0 100%);
  }
</style>
