---
/**
 * Pre-signup upload page (pre-launch corridor). A professional who just left her
 * contacts lands here to drop her photos + ID NOW, so she's ready to go live the
 * moment we launch — NO account, NO site chrome. Bare + dark (the landing's ink
 * language). Gated by the httponly `psl` cookie (her lead id); bytes live in R2
 * (lib/presignup-media), served back only through /api/prelaunch/media. Dies at
 * launch with the corridor.
 */
import Layout from '@/layouts/Layout.astro';
import * as m from '@/paraglide/messages';
import { isLocale, localizePath } from '@/lib/i18n';
import { listPresignupPhotos, hasPresignupId } from '@/lib/presignup-media';

const locale = Astro.params.locale;
if (!isLocale(locale)) return new Response(null, { status: 404 });

// The `psl` cookie IS the capability (her lead id). No cookie → she didn't come
// from the form; send her back to join rather than expose an empty uploader.
const leadId = Astro.cookies.get('psl')?.value;
if (!leadId) return Astro.redirect(localizePath('/'));

const photos = (await listPresignupPhotos(leadId)).map((key) => ({ key, name: key.split('/').pop()! }));
const idDone = await hasPresignupId(leadId);
---

<Layout title={m.presignup_meta_title()} description={m.presignup_meta_desc()} noindex bare>
  <div class="dark min-h-dvh bg-neutral-950 text-white">
    <div class="mx-auto max-w-xl px-4 py-8 md:py-12">
      <img src="/img/logo-light.svg" alt={m.app_name()} width="1242" height="597" class="h-6 w-auto md:h-7" />

      <div class="mt-8">
        <p class="eyebrow flex items-center gap-2 font-condensed text-lg font-bold uppercase tracking-wide text-online">
          <span class="size-1.5 rounded-full bg-online" aria-hidden="true"></span>
          {m.presignup_kicker()}
        </p>
        <h1 class="display mt-3 text-3xl md:text-4xl">{m.presignup_title()}</h1>
        <p class="mt-3 max-w-md leading-relaxed text-white/75">{m.presignup_sub()}</p>
      </div>

      {/* Photos — reused upload flow: canvas re-encode strips EXIF client-side,
          the action re-strips server-side, bytes land in R2 under her lead id. */}
      <section class="mt-10" data-presignup>
        <h2 class="font-condensed text-lg font-bold uppercase tracking-wide">{m.presignup_photos_title()}</h2>
        <p class="mt-1 text-sm text-white/60">{m.presignup_photos_hint()}</p>
        <div class="mt-4 grid grid-cols-3 gap-3">
          {
            photos.map((p, i) => (
              <div class="relative aspect-[3/4] overflow-hidden bg-neutral-900">
                <img src={`/api/prelaunch/media/${p.name}`} alt={`Photo ${i + 1}`} class="h-full w-full object-cover" loading="lazy" />
                <button
                  type="button"
                  data-remove
                  data-key={p.key}
                  aria-label="Remove"
                  class="absolute right-1.5 top-1.5 grid size-7 cursor-pointer place-items-center bg-neutral-950/85 text-white transition-transform active:scale-90"
                >
                  <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
                </button>
              </div>
            ))
          }
          <label
            class="flex aspect-[3/4] cursor-pointer flex-col items-center justify-center gap-2 border border-dashed border-white/25 text-white/60 transition-colors hover:border-white/60 hover:text-white has-[:disabled]:cursor-wait has-[:disabled]:opacity-70"
          >
            <input type="file" accept="image/*" multiple data-add class="sr-only" />
            <span data-idle class="flex flex-col items-center gap-2">
              <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
              <span class="text-xs font-medium">{m.presignup_add()}</span>
            </span>
            <span data-busy hidden class="text-white">
              <svg class="size-7 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.2-8.6" stroke-linecap="round" /></svg>
            </span>
          </label>
        </div>
      </section>

      {/* ID — into the private EU verification bucket, never served back here. */}
      <section class="mt-10" data-presignup-id>
        <h2 class="font-condensed text-lg font-bold uppercase tracking-wide">{m.presignup_id_title()}</h2>
        <p class="mt-1 text-sm text-white/60">{m.presignup_id_hint()}</p>
        <div class="mt-4">
          <p
            data-id-done
            class:list={['flex items-center gap-2 border border-online/40 bg-online/10 px-4 py-3 text-sm text-white', !idDone && 'hidden']}
          >
            <svg class="size-5 flex-none text-online" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
            {m.presignup_id_done()}
          </p>
          <label class:list={['block', idDone && 'hidden']} data-id-label>
            <input type="file" accept="image/*" data-id-input class="sr-only" />
            <span data-id-idle class="inline-flex cursor-pointer items-center gap-2 border border-white/25 px-4 py-3 text-sm font-medium transition-colors hover:border-white/60">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
              {m.presignup_id_add()}
            </span>
            <span data-id-busy hidden class="inline-flex items-center gap-2 px-4 py-3 text-sm text-white/70">{m.presignup_uploading()}</span>
          </label>
        </div>
      </section>

      <p class="mt-10 border-t border-white/10 pt-6 text-sm leading-relaxed text-white/60">{m.presignup_done_note()}</p>
    </div>
  </div>
</Layout>

<script>
  import { actions } from 'astro:actions';
  import { reencode } from '@/lib/reencode';

  function toggle(el: Element | null, hidden: boolean) {
    if (el) el.toggleAttribute('hidden', hidden);
  }

  function init() {
    // Photos
    const root = document.querySelector<HTMLElement>('[data-presignup]');
    if (root && !root.dataset.init) {
      root.dataset.init = '1';
      root.querySelectorAll<HTMLElement>('[data-remove]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          await actions.prelaunch.removePhoto({ key: btn.dataset.key! });
          location.reload();
        });
      });
      const input = root.querySelector<HTMLInputElement>('[data-add]');
      const idle = root.querySelector<HTMLElement>('[data-idle]');
      const busy = root.querySelector<HTMLElement>('[data-busy]');
      input?.addEventListener('change', async () => {
        const files = [...(input.files ?? [])];
        if (!files.length) return;
        input.disabled = true;
        toggle(idle, true);
        toggle(busy, false);
        let ok = 0;
        for (const file of files) {
          try {
            const dataUrl = await reencode(file); // downscale + JPEG re-encode (drops EXIF)
            const { error } = await actions.prelaunch.addPhoto({ dataUrl });
            if (!error) ok++;
          } catch {
            /* skip this file, keep the rest */
          }
        }
        if (ok > 0) {
          location.reload();
        } else {
          input.disabled = false;
          toggle(busy, true);
          toggle(idle, false);
        }
      });
    }
    // ID
    const idInput = document.querySelector<HTMLInputElement>('[data-id-input]');
    if (idInput && !idInput.dataset.init) {
      idInput.dataset.init = '1';
      const idle = document.querySelector<HTMLElement>('[data-id-idle]');
      const busy = document.querySelector<HTMLElement>('[data-id-busy]');
      idInput.addEventListener('change', async () => {
        const file = idInput.files?.[0];
        if (!file) return;
        idInput.disabled = true;
        toggle(idle, true);
        toggle(busy, false);
        try {
          const dataUrl = await reencode(file);
          const { error } = await actions.prelaunch.submitId({ dataUrl });
          if (!error) {
            location.reload();
            return;
          }
        } catch {
          /* fall through to re-enable */
        }
        idInput.disabled = false;
        toggle(busy, true);
        toggle(idle, false);
      });
    }
  }
  init();
  document.addEventListener('astro:page-load', init);
</script>
