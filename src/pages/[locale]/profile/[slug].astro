---
/**
 * Profile page (hard rule 8: full SEO treatment). Mobile-first: immersive
 * swipeable hero → facts slab → about → services → gallery. Desktop: sticky
 * facts column beside the content.
 */
import * as m from '@/paraglide/messages';
import { profilesApi } from '@/app/api/profiles';
import { messagingApi } from '@/app/api/messaging';
import { accountApi } from '@/app/api/account';
import { sessionApi } from '@/app/api/session';
import { availabilityState, localizedDescription, profileNameAge } from '@/app/models/profile';
import { agencyById } from '@/app/api/orgs';
import { isLocale, samePathAlternates } from '@/lib/i18n';
import { realImageFor } from '@/lib/safe-images';
import { breadcrumbJsonLd, cityName } from '@/lib/seo';
import ProfileDetail from '@/components/organisms/profile/ProfileDetail.astro';
import ProfileAdminBar from '@/components/organisms/profile/ProfileAdminBar.astro';
import Layout from '@/layouts/Layout.astro';

const { locale, slug } = Astro.params;
if (!isLocale(locale) || !slug) return new Response(null, { status: 404 });

// Public reads only ever surface a LIVE profile. But the OWNER previewing her
// own not-yet-live profile shouldn't hit a 404 — fetch it (all states) when the
// signed-in owner asks for her own slug. Authenticated → never edge-cached
// (middleware caches anonymous only), so a draft never leaks.
// Session and the profile row are independent — fetch concurrently (each is a
// separate DB/auth round trip; serializing them was pure added TTFB).
const [session, publicProfile] = await Promise.all([sessionApi.current(Astro), profilesApi.bySlug(slug)]);
const isAdmin = session?.role === 'admin';
let p = publicProfile;
let preview = false;
if (!p) {
  // Owner preview: compare her ACTUAL profile slug, not session.profileSlug —
  // the session is memoised ~60s, so right after she creates her profile that
  // field is still empty and would 404 her own fresh profile.
  if (session?.role === 'advertiser') {
    const own = await accountApi.myProfile(session);
    if (own && own.slug === slug) {
      p = own;
      preview = true;
    }
  }
  // listAll() covers EVERY lifecycle state (read-only). One fetch serves both
  // the admin god-view and the 404-vs-410 decision below.
  if (!p) {
    const dead = (await profilesApi.listAll()).find((x) => x.slug === slug) ?? null;
    // Admin god view: any lifecycle state renders (never edge-cached — authed).
    if (isAdmin && dead) {
      p = dead;
      preview = true;
    }
    // Hard rule 8 / SEO §1.6: a slug that EXISTS but is blocked/deleted is Gone
    // (410 + IndexNow removal ping), not a soft-404. A slug that never existed
    // stays 404.
    if (!p) {
      return new Response(null, {
        status: dead && (dead.state === 'blocked' || dead.state === 'deleted') ? 410 : 404,
      });
    }
  }
}
// The owner viewing her own profile shouldn't see a "Save" (favourite) control.
const isOwner = session?.profileSlug === slug;

// Everything below depends only on `p`, so fetch it in ONE parallel wave rather
// than four sequential edge→Frankfurt round-trips (the cold-load cost). The
// offline-fallback candidates (2.6) are only fetched when she's away.
const offline = availabilityState(p).kind !== 'online';
const [replySpeed, convo, candidates, agency] = await Promise.all([
  // Measured reply speed (3.2): null below the honest sample threshold → hidden.
  messagingApi.replySpeedFor(p.id),
  // Request sheet (UX-PLAN 4.x): her screening question rides in the request
  // when set. Public projection only — the mode never leaks (the sheet just
  // won't submit if her inbox is off, enforced in the action).
  messagingApi.settings(p.id),
  offline
    ? profilesApi.list({ city: p.city, onlineOnly: true, limit: 12 })
    : Promise.resolve({ items: [] as (typeof p)[] }),
  // Her agency (P3): branch phone + "ask for her" block on the deal card.
  // Suppressed in the pre-launch corridor — profiles opened from the waiting
  // page read as standalone (agency stays wired for the live site, not removed).
  p.orgId && !Astro.locals.prelaunch ? agencyById(p.orgId) : Promise.resolve(null),
]);

let similar: (typeof p)[] = [];
if (offline) {
  const services = new Set(p.services as readonly string[]);
  similar = candidates.items
    .filter((c) => c.id !== p.id && c.services.some((s) => services.has(s)))
    .slice(0, 3);
}
const screeningQuestion = convo.screeningQuestion || undefined;

const description = localizedDescription(p);
const city = cityName(p.city);
const title = `${profileNameAge(p)} — ${city} | Intimate`;
const metaDescription = `${description.slice(0, 140)}${description.length > 140 ? '…' : ''}`;
const canonical = new URL(`/${locale}/profile/${p.slug}/`, Astro.url.origin).href;

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Intimate', url: `${Astro.url.origin}/${locale}/` },
    { name: city, url: `${Astro.url.origin}/${locale}/${p.city}/` },
    { name: p.name, url: canonical },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    mainEntity: {
      '@type': 'Person',
      name: p.name,
      description: metaDescription,
      image: new URL(p.photos[0] ?? '', Astro.url.origin).href,
      address: { '@type': 'PostalAddress', addressLocality: city, addressCountry: 'NL' },
    },
  },
];
---

<Layout
  {title}
  description={metaDescription}
  {canonical}
  noindex={preview || p.unlisted}
  alternates={preview || p.unlisted ? undefined : samePathAlternates(Astro.url.origin, `/profile/${p.slug}/`)}
  {jsonLd}
  preloadImage={realImageFor(`${p.id}-0`, p.photos[0])}
  image={realImageFor(`${p.id}-0`, p.photos[0])}
>
  {isAdmin && <ProfileAdminBar profile={p} />}
  {
    preview && !isAdmin && (
      <div class="border-b border-brand/40 bg-brand/10 px-4 py-2.5 text-center text-sm font-medium text-foreground">
        {m.profile_preview_banner()}
      </div>
    )
  }
  <ProfileDetail profile={p} {agency} {similar} {replySpeed} {screeningQuestion} {isOwner} prelaunch={!!Astro.locals.prelaunch} loggedIn={!!session} />
</Layout>
