---
/**
 * Inbox (docs/MESSAGING.md §6). `?to={slug}` starts/opens a client's thread with
 * that professional and redirects in — the "Message" button on a profile is a
 * plain link, so it works logged-out (→ sign-in prompt) with zero JS.
 */
import * as m from '@/paraglide/messages';
import { messagingApi } from '@/app/api/messaging';
import { sessionApi } from '@/app/api/session';
import { isLocale, localizePath } from '@/lib/i18n';
import Inbox from '@/components/organisms/messaging/Inbox.astro';
import SignInPrompt from '@/components/organisms/dashboard/SignInPrompt.astro';
import Layout from '@/layouts/Layout.astro';

const locale = Astro.params.locale;
if (!isLocale(locale)) return new Response(null, { status: 404 });

const session = await sessionApi.current(Astro);

let unavailable = false;
if (session && !session.profileId) {
  const to = Astro.url.searchParams.get('to');
  if (to) {
    const thread = await messagingApi.startThread(session, { profileSlug: to });
    if (thread) return Astro.redirect(localizePath(`/messages/${thread.id}/`));
    unavailable = true; // her inbox is closed
  }
}

const viewer: 'professional' | 'client' = session?.profileId ? 'professional' : 'client';
// Demo seeding is DEV-only (it inserts fake client accounts + flips her
// conversation mode to 'everyone' — never against the real DB). See seedDemo.
if (import.meta.env.DEV && session?.profileId) await messagingApi.seedDemo(session);
const threads = session ? await messagingApi.listThreads(session) : [];
---

<Layout noindex title={`${m.msg_title()} | Intimate`}>
  {!session && <SignInPrompt />}
  {
    session && (
      <>
        {/* Mobile: the list IS the page. */}
        <div class="mx-auto max-w-2xl px-4 py-6 pb-24 md:hidden">
          <h1 class="display text-3xl">{m.msg_title()}</h1>
          {unavailable && (
            <p class="mt-3 border border-brand/40 bg-brand/5 px-3 py-2 text-sm">
              {m.msg_unavailable()}
            </p>
          )}
          <div class="mt-4">
            <Inbox {threads} {viewer} />
          </div>
        </div>
        {/* Desktop: mailbox frame — rail left, empty pane until a thread is picked
            (the thread page renders the same frame with the conversation right). */}
        <div class="mx-auto hidden max-w-6xl px-6 py-6 md:block">
          {unavailable && (
            <p class="mb-4 border border-brand/40 bg-brand/5 px-3 py-2 text-sm">
              {m.msg_unavailable()}
            </p>
          )}
          <div class="flex h-thread overflow-hidden border border-border">
            <aside class="flex w-80 flex-none flex-col border-r border-border">
              <p class="flex flex-none items-center border-b border-border px-4 py-3.5 font-condensed text-lg font-bold">
                {m.msg_title()}
              </p>
              <div class="min-h-0 flex-1 overflow-y-auto px-2 pb-4">
                <Inbox {threads} {viewer} />
              </div>
            </aside>
            <div class="grid min-w-0 flex-1 place-items-center">
              <div class="text-center">
                <svg class="mx-auto size-10 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/></svg>
                <p class="mt-4 text-sm text-muted-foreground">{m.msg_select_thread()}</p>
              </div>
            </div>
          </div>
        </div>
      </>
    )
  }
</Layout>
