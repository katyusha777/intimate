---
/**
 * Thread view (docs/MESSAGING.md §6) — immersive `bare` chat screen. Access is
 * participant-only: getThread returns null for anyone but the two parties.
 */
import { messagingApi } from '@/app/api/messaging';
import { sessionApi } from '@/app/api/session';
import { isLocale, localizePath } from '@/lib/i18n';
import Thread from '@/components/organisms/messaging/Thread.astro';
import Layout from '@/layouts/Layout.astro';

const { locale, thread: threadId } = Astro.params;
if (!isLocale(locale) || !threadId) return new Response(null, { status: 404 });

const session = await sessionApi.fromCookies(Astro.cookies);
if (!session) return Astro.redirect(localizePath('/account/'));

const thread = await messagingApi.getThread(session, threadId);
if (!thread) return new Response(null, { status: 404 });
await messagingApi.markRead(session, threadId);

const viewer: 'professional' | 'client' =
  session.profileId === thread.profileId ? 'professional' : 'client';
const paused =
  viewer === 'client' && (await messagingApi.settings(thread.profileId)).mode === 'off';
const other = viewer === 'professional' ? thread.clientName : thread.profileName;
---

<Layout bare noindex title={`${other} | Intimate`}>
  <Thread {thread} {viewer} {paused} />
</Layout>
