---
/**
 * Contacts — the professional's mini-CRM (docs/MESSAGING.md §6). Same threads
 * as the inbox, shown with her private note + photo-grant glyph; tap opens the
 * thread where the controls live. Clients don't have contacts → sent home.
 */
import * as m from '@/paraglide/messages';
import { messagingApi } from '@/app/api/messaging';
import { sessionApi } from '@/app/api/session';
import { isLocale, localizePath } from '@/lib/i18n';
import Inbox from '@/components/organisms/messaging/Inbox.astro';
import SignInPrompt from '@/components/organisms/dashboard/SignInPrompt.astro';
import Layout from '@/layouts/Layout.astro';

const locale = Astro.params.locale;
if (!isLocale(locale)) return new Response(null, { status: 404 });

const session = await sessionApi.fromCookies(Astro.cookies);
if (session && !session.profileId) return Astro.redirect(localizePath('/messages/'));

const threads = session ? await messagingApi.listThreads(session) : [];
---

<Layout noindex title={`${m.contacts_title()} | Intimate`}>
  {!session && <SignInPrompt />}
  {
    session && (
      <div class="mx-auto max-w-2xl px-4 py-6 pb-24 md:py-10 md:pb-10">
        <h1 class="display text-3xl md:text-4xl">{m.contacts_title()}</h1>
        <div class="mt-4">
          <Inbox {threads} viewer="professional" variant="contacts" />
        </div>
      </div>
    )
  }
</Layout>
