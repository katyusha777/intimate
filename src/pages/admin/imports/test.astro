---
/**
 * Import test tool (docs/ADMIN.md §3). Paste a source URL → the import runs
 * server-side and the result is shown three ways: (1) our REAL profile editor,
 * pre-filled and read-only, so you see exactly how each field maps into our UI;
 * (2) the mapped JSON; (3) the raw LLM output. Optionally apply onto a profile
 * by id (super-only, audit-logged). Same src/lib/import/ path the advertiser
 * flow uses — testing this tests the real thing.
 */
import { getAdmin } from '@/actions/admin/lib';
import { importFromUrl, knownSites } from '@/lib/import';
import { ProfileSchema, type Profile } from '@/app/models/profile';
import { CITIES } from '@/lib/taxonomy';
import AdminShell from '@/components/organisms/admin/AdminShell.astro';
import ProfileEditorForm from '@/components/organisms/dashboard/ProfileEditorForm.astro';

const session = await getAdmin(Astro);
const sites = knownSites().map((s) => s.label).join(', ');
const url = Astro.url.searchParams.get('url')?.trim() || '';

let outcome: Awaited<ReturnType<typeof importFromUrl>> | null = null;
let preview: Profile | null = null;
let error: string | null = null;
if (session && url) {
  try {
    outcome = await importFromUrl(url);
    // Build a throwaway Profile so the REAL editor renders populated. Identity
    // fields she owns (name/DOB) aren't imported, so we seed placeholders.
    preview = ProfileSchema.parse({
      id: '',
      slug: '',
      state: 'draft',
      name: 'Imported preview',
      birthDate: '1995-06-15',
      gender: outcome.fields.gender ?? 'female',
      city: outcome.fields.city ?? CITIES[0]!.slug,
      verified: false,
      online: false,
      featured: false,
      rates: [],
      services: [],
      meetingTypes: [],
      description: '',
      photos: [],
      createdAt: new Date().toISOString(),
      ...outcome.fields,
    });
  } catch (e) {
    error = (e as Error).message;
  }
}

const input = 'slab-cut w-full border border-foreground/20 bg-background px-3 py-2 text-sm outline-none focus:border-foreground';
const btn = 'slab-cut border border-foreground/20 px-4 py-2 text-sm font-semibold hover:border-foreground/60 disabled:opacity-50';
---

<AdminShell title="Import test" section="imports">
  {
    session && (
      <div class="max-w-5xl">
        <h1 class="display text-3xl">Import test</h1>
        <p class="mt-1 text-sm text-muted-foreground">Scrape + normalize a profile URL and inspect the mapping. Supported: {sites}.</p>

        {/* Preview = a plain GET so the import runs server-side and the real
            editor can render pre-filled below. */}
        <form method="get" class="mt-6 space-y-3">
          <input name="url" type="url" required value={url} placeholder="https://www.kinky.nl/advertenties/12345-…" class={input} />
          <div class="flex flex-wrap items-center gap-3">
            <button type="submit" class={btn}>Preview mapping</button>
            <span class="text-2xs text-muted-foreground">or apply onto a profile:</span>
            <input data-profile-id placeholder="profile UUID" class={`${input} max-w-xs`} />
            <button type="button" data-apply data-url={url} class={btn}>Apply (super)</button>
            <span data-status class="text-2xs text-muted-foreground" />
          </div>
        </form>

        {/* Preview is a GET reload (~1 min); this overlay makes the wait visible
            until the response replaces the page. */}
        <div data-import-overlay hidden class="fixed inset-0 z-50 grid place-items-center bg-background/85 backdrop-blur-sm">
          <div class="w-full max-w-sm px-8 text-center">
            <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
              <div data-import-bar class="h-full rounded-full bg-brand transition-[width] duration-500 ease-out" style="width:0%"></div>
            </div>
            <p data-import-msg class="mt-3 text-sm text-muted-foreground"></p>
          </div>
        </div>

        {error && <p class="mt-4 text-sm text-brand">Error: {error}</p>}

        {outcome && preview && (
          <div class="mt-8 space-y-8">
            <p class="text-2xs text-muted-foreground">
              {outcome.site.label} · ${outcome.cost.toFixed(4)}
              {outcome.warnings.length > 0 && ` · ${outcome.warnings.length} warning(s)`}
            </p>
            {outcome.warnings.length > 0 && (
              <div class="border-l-2 border-amber-500 pl-3 text-xs text-muted-foreground">
                {outcome.warnings.map((w) => (<div>• {w}</div>))}
              </div>
            )}

            <section>
              <h2 class="font-condensed text-sm font-bold uppercase tracking-wide">Our fields, populated (read-only preview)</h2>
              <p class="mt-1 text-2xs text-muted-foreground">This is the actual editor — name & date of birth are placeholders (she enters those herself).</p>
              {/* Disabled fieldset = native read-only: every field/chip/dropdown
                  shows its imported value, nothing can be edited or saved here. */}
              <fieldset disabled class="mt-3 border border-border p-4">
                <ProfileEditorForm profile={preview} />
              </fieldset>
            </section>

            <div class="grid gap-6 lg:grid-cols-2">
              <div>
                <h2 class="font-condensed text-sm font-bold uppercase tracking-wide">Mapped → our schema</h2>
                <pre class="mt-2 overflow-x-auto border border-border bg-muted p-3 text-xs">{JSON.stringify(outcome.fields, null, 2)}</pre>
              </div>
              <div>
                <h2 class="font-condensed text-sm font-bold uppercase tracking-wide">Raw LLM output</h2>
                <pre class="mt-2 overflow-x-auto border border-border bg-muted p-3 text-xs">{JSON.stringify(outcome.raw, null, 2)}</pre>
              </div>
            </div>
          </div>
        )}
      </div>
    )
  }
</AdminShell>

<script>
  import { actions } from 'astro:actions';
  import { startImportProgress } from '@/lib/import-progress';

  function init() {
    const form = document.querySelector<HTMLFormElement>('form[method="get"]');
    if (!form || form.dataset.init) return;
    form.dataset.init = '1';
    const overlay = document.querySelector<HTMLElement>('[data-import-overlay]')!;
    const bar = overlay.querySelector<HTMLElement>('[data-import-bar]')!;
    const msg = overlay.querySelector<HTMLElement>('[data-import-msg]')!;
    const showOverlay = () => {
      overlay.hidden = false;
      return startImportProgress(bar, msg);
    };

    // Preview = a real GET navigation; show the overlay and let it ride until the
    // response replaces the page (no done() needed).
    form.addEventListener('submit', () => {
      showOverlay();
    });

    const apply = document.querySelector<HTMLButtonElement>('[data-apply]');
    const pidEl = document.querySelector<HTMLInputElement>('[data-profile-id]')!;
    const urlEl = document.querySelector<HTMLInputElement>('input[name="url"]')!;
    const status = document.querySelector<HTMLElement>('[data-status]')!;
    apply?.addEventListener('click', async () => {
      const profileId = pidEl.value.trim();
      const url = urlEl.value.trim();
      if (!profileId || !url) { status.textContent = 'Need a URL and a profile UUID.'; return; }
      if (!confirm('Apply this import onto that profile? It overwrites the mapped fields.')) return;
      status.textContent = 'Importing + applying…';
      apply.disabled = true;
      const prog = showOverlay();
      const { data, error } = await actions.admin.importApply({ profileId, url });
      prog.done();
      overlay.hidden = true;
      apply.disabled = false;
      status.textContent = error ? `Error: ${error.message}` : 'Applied ✓';
    });
  }
  init();
  document.addEventListener('astro:page-load', init);
</script>
