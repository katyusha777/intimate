---
/**
 * Settings (docs/ADMIN.md §13, super-only): admin accounts + roles, feature
 * flags (PostHog in prod), taxonomy snapshot, retention/policy. Read surface in
 * the mock; mutations arrive with the real backend.
 */
import { getAdmin } from '@/actions/admin/lib';
import { accountApi } from '@/app/api/account';
import { ADMIN_ROLES, ALL_SERVICES, CITIES, GENDERS, REJECTION_REASONS, SERVICE_CATEGORIES } from '@/lib/taxonomy';
import AdminShell from '@/components/organisms/admin/AdminShell.astro';

const session = await getAdmin(Astro);
const isSuper = session?.adminRole === 'super';

// Real admin accounts from the DB (account_type = 'admin').
const admins = isSuper
  ? (await accountApi.all())
      .filter((a) => a.accountType === 'admin')
      .map((a) => ({ email: a.email, role: a.adminRole ?? '—' }))
      .sort((a, b) => a.email.localeCompare(b.email))
  : [];
const flags = [
  { key: 'messaging', label: 'Messaging', on: true },
  { key: 'ai_search', label: 'AI search', on: true },
  { key: 'calls', label: 'Video calls', on: false },
  { key: 'imports', label: 'Self-service imports', on: false },
];
const taxo = [
  ['Account roles', ADMIN_ROLES.length],
  ['Genders', GENDERS.length],
  ['Cities', CITIES.length],
  ['Service categories', SERVICE_CATEGORIES.length],
  ['Services', ALL_SERVICES.length],
  ['Rejection reasons', REJECTION_REASONS.length],
] as const;
---

<AdminShell title="Settings" section="settings">
  {
    session && !isSuper ? (
      <p class="text-sm text-muted-foreground">Settings are restricted to the <b>super</b> role.</p>
    ) : (
      session && (
        <div class="space-y-8">
          <h1 class="display text-3xl">Settings</h1>

          <section>
            <h2 class="font-condensed text-sm font-bold uppercase tracking-wide text-muted-foreground">Admin accounts</h2>
            <div class="mt-3 max-w-lg divide-y divide-border border border-border">
              {admins.map((a) => (
                <div class="flex items-center justify-between px-3 py-2.5 text-sm">
                  <span>{a.email}</span>
                  <span class="slab-cut border border-foreground/20 px-2 py-0.5 text-2xs font-bold uppercase tracking-wide">{a.role}</span>
                </div>
              ))}
            </div>
            <p class="mt-2 text-2xs text-muted-foreground">Live from Supabase Auth (promote via <code>scripts/make-admin.ts</code>). Invite/revoke UI + MFA enrolment + Cloudflare Access are the remaining hardening.</p>
          </section>

          <section>
            <h2 class="font-condensed text-sm font-bold uppercase tracking-wide text-muted-foreground">Feature flags</h2>
            <div class="mt-3 grid max-w-lg gap-2 sm:grid-cols-2">
              {flags.map((f) => (
                <div class="flex items-center justify-between border border-border px-3 py-2 text-sm">
                  {f.label}
                  <span class:list={['text-2xs font-bold uppercase', f.on ? 'text-online' : 'text-muted-foreground']}>{f.on ? 'On' : 'Off'}</span>
                </div>
              ))}
            </div>
            <p class="mt-2 text-2xs text-muted-foreground">Flags are managed in PostHog in production; shown read-only here.</p>
          </section>

          <section>
            <h2 class="font-condensed text-sm font-bold uppercase tracking-wide text-muted-foreground">Taxonomy snapshot</h2>
            <div class="mt-3 grid max-w-2xl grid-cols-2 gap-px border border-border bg-border sm:grid-cols-3">
              {taxo.map(([k, v]) => (
                <div class="bg-card px-3 py-2.5">
                  <p class="text-2xs uppercase tracking-wide text-muted-foreground">{k}</p>
                  <p class="mt-0.5 font-condensed text-xl font-bold">{v}</p>
                </div>
              ))}
            </div>
            <p class="mt-2 text-2xs text-muted-foreground">Taxonomy = law: edited in <code>src/lib/taxonomy.ts</code> + translations + migration, never here.</p>
          </section>

          <section>
            <h2 class="font-condensed text-sm font-bold uppercase tracking-wide text-muted-foreground">Edge cache</h2>
            <p class="mt-2 max-w-2xl text-sm text-muted-foreground">
              Profile pages are cached at the edge (24h, busted on edit). <b>Purge</b> drops every cached
              page; <b>Warm</b> re-fetches all live profiles so none load cold. A scheduled cron warms
              automatically — these are for testing.
            </p>
            <div class="mt-3 flex flex-wrap items-center gap-3">
              <button
                type="button"
                data-cache-purge
                class="slab-cut cursor-pointer border border-foreground/20 bg-card px-4 py-2 text-sm font-semibold transition-colors hover:bg-foreground hover:text-background disabled:opacity-50"
              >
                Purge all cache
              </button>
              <button
                type="button"
                data-cache-warm
                class="slab-cut cursor-pointer border border-foreground/20 bg-card px-4 py-2 text-sm font-semibold transition-colors hover:bg-foreground hover:text-background disabled:opacity-50"
              >
                Warm now
              </button>
              <span data-cache-status class="text-sm text-muted-foreground" aria-live="polite"></span>
            </div>
          </section>

          <section>
            <h2 class="font-condensed text-sm font-bold uppercase tracking-wide text-muted-foreground">Retention & policy</h2>
            <ul class="mt-3 max-w-2xl space-y-1.5 text-sm text-muted-foreground">
              <li>· Verification docs: private R2, presigned ≤5min, purged on the retention schedule (never public, never in the product).</li>
              <li>· Messages + chat media: auto-deleted after 90 days.</li>
              <li>· Audit log: long retention — our defensibility (documented GDPR exception, legitimate interest).</li>
              <li>· Age: 18 absolute DB floor; <b>21</b> policy minimum to advertise (NL) — enforced at the profiles CHECK + Zod.</li>
            </ul>
          </section>
        </div>
      )
    )
  }
</AdminShell>

<script>
  import { actions } from 'astro:actions';

  const status = document.querySelector<HTMLElement>('[data-cache-status]');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-cache-purge], [data-cache-warm]');
  const setBusy = (busy: boolean) => buttons.forEach((b) => (b.disabled = busy));

  document.querySelector('[data-cache-purge]')?.addEventListener('click', async () => {
    setBusy(true);
    if (status) status.textContent = 'Purging…';
    const { error } = await actions.admin.cachePurge({});
    if (status) status.textContent = error ? `Failed: ${error.message}` : 'Cache purged.';
    setBusy(false);
  });

  document.querySelector('[data-cache-warm]')?.addEventListener('click', async () => {
    setBusy(true);
    if (status) status.textContent = 'Warming…';
    const { data, error } = await actions.admin.cacheWarmUrls({});
    if (error) {
      if (status) status.textContent = `Failed: ${error.message}`;
      setBusy(false);
      return;
    }
    // The browser (external to the worker) fetches each URL → worker renders →
    // KV store. Small pool so we don't open 90 sockets at once.
    const urls = data.urls;
    let done = 0;
    let idx = 0;
    const tick = () => {
      if (status) status.textContent = `Warming ${done}/${urls.length}…`;
    };
    const run = async () => {
      while (idx < urls.length) {
        const url = urls[idx++];
        try {
          await fetch(url, { headers: { 'X-Warm': '1' } });
        } catch {
          /* keep going */
        }
        done++;
        tick();
      }
    };
    await Promise.all(Array.from({ length: Math.min(8, urls.length) }, run));
    if (status) status.textContent = `Warmed ${done}/${urls.length} pages.`;
    setBusy(false);
  });
</script>
