---
/**
 * Settings (docs/ADMIN.md §13, super-only): admin accounts + roles (live from
 * the DB), feature flags (managed in PostHog, read-only here), taxonomy
 * snapshot, cache controls, retention/policy.
 */
import { env } from 'cloudflare:workers';
import { getAdmin } from '@/actions/admin/lib';
import { ADMIN_EVENTS, NOTIFY_PREFS_KEY, mergeNotifyPrefs } from '@/lib/pushover';
import type { CacheKv } from '@/lib/page-cache';
import { accountApi } from '@/app/api/account';
import { ADMIN_ROLES, ALL_SERVICES, CITIES, GENDERS, REJECTION_REASONS, SERVICE_CATEGORIES } from '@/lib/taxonomy';
import AdminShell from '@/components/organisms/admin/AdminShell.astro';
import MfaCard from '@/components/organisms/admin/MfaCard.astro';
import * as m from '@/paraglide/messages';

const session = await getAdmin(Astro);
const isSuper = session?.adminRole === 'super';

// Real admin accounts from the DB (account_type = 'admin').
const admins = isSuper
  ? (await accountApi.all())
      .filter((a) => a.accountType === 'admin')
      .map((a) => ({ id: a.id, email: a.email, role: a.adminRole ?? '—', pushoverKey: a.pushoverKey ?? '' }))
      .sort((a, b) => a.email.localeCompare(b.email))
  : [];
// Pushover event toggles (KV; all-on defaults). English: internal surface.
const notifyKv = (env as unknown as Record<string, unknown>).SESSION as CacheKv | undefined;
const notifyPrefs = mergeNotifyPrefs(notifyKv ? await notifyKv.get(NOTIFY_PREFS_KEY) : null);
const flags = [
  { key: 'messaging', label: m.adm_nav_messaging(), on: true },
  { key: 'ai_search', label: m.wand_title(), on: true },
  { key: 'calls', label: m.adm_settings_flag_calls(), on: false },
  { key: 'imports', label: m.adm_settings_flag_imports(), on: false },
];
const taxo = [
  [m.adm_settings_tx_roles(), ADMIN_ROLES.length],
  [m.adm_settings_tx_genders(), GENDERS.length],
  [m.adm_settings_tx_cities(), CITIES.length],
  [m.adm_settings_tx_service_categories(), SERVICE_CATEGORIES.length],
  [m.filter_services(), ALL_SERVICES.length],
  [m.adm_settings_tx_rejection_reasons(), REJECTION_REASONS.length],
] as const;
---

<AdminShell title={m.settings_title()} section="settings">
  {
    session && (
      <div class="space-y-8">
        <h1 class="display text-3xl">{m.settings_title()}</h1>

        {/* 2FA is per-admin — shown to EVERY admin (not just super) so the whole
            team can enroll before ADMIN_REQUIRE_AAL2 is turned on. */}
        <MfaCard />

        {!isSuper && (
          <p class="text-sm text-muted-foreground" set:html={m.adm_settings_super_only()} />
        )}

        {isSuper && (
          <Fragment>
          <section>
            <h2 class="font-condensed text-sm font-bold uppercase tracking-wide text-muted-foreground">{m.adm_settings_admins()}</h2>
            <div class="mt-3 max-w-lg divide-y divide-border border border-border">
              {admins.map((a) => (
                <div class="px-3 py-2.5 text-sm">
                  <div class="flex items-center justify-between">
                    <span>{a.email}</span>
                    <span class="slab-cut border border-foreground/20 px-2 py-0.5 text-2xs font-bold uppercase tracking-wide">{a.role}</span>
                  </div>
                  {/* Pushover user key — admin-event notifications (English on
                      purpose: internal surface). Empty + save clears it. */}
                  <div class="mt-2 flex items-center gap-2">
                    <input
                      data-pushover-key={a.id}
                      value={a.pushoverKey}
                      placeholder="Pushover user key"
                      autocomplete="off"
                      spellcheck="false"
                      class="w-full border border-border bg-transparent px-2 py-1 font-mono text-xs caret-brand outline-none placeholder:text-muted-foreground focus:border-foreground/50"
                    />
                    <button
                      type="button"
                      data-pushover-save={a.id}
                      class="cursor-pointer border border-foreground/20 px-2.5 py-1 text-2xs font-bold uppercase tracking-wide transition-colors hover:border-foreground/60"
                    >
                      Save
                    </button>
                  </div>
                </div>
              ))}
            </div>
            <p class="mt-2 text-2xs text-muted-foreground" set:html={m.adm_settings_admins_note()} />
            <p class="mt-1 text-2xs text-muted-foreground">
              Pushover: admins with a user key get pinged on the events below.
            </p>
          </section>

          <section>
            <h2 class="font-condensed text-sm font-bold uppercase tracking-wide text-muted-foreground">Admin notifications</h2>
            <div class="mt-3 max-w-lg divide-y divide-border border border-border">
              {ADMIN_EVENTS.map((ev) => (
                <label class="flex cursor-pointer items-center justify-between px-3 py-2.5 text-sm">
                  <span>{ev.label}</span>
                  <input type="checkbox" data-notify-pref={ev.key} checked={notifyPrefs[ev.key]} class="size-4 accent-brand" />
                </label>
              ))}
            </div>
            <p class="mt-2 text-2xs text-muted-foreground" data-notify-status>Changes save immediately.</p>
          </section>

          <section>
            <h2 class="font-condensed text-sm font-bold uppercase tracking-wide text-muted-foreground">{m.adm_settings_flags()}</h2>
            <div class="mt-3 grid max-w-lg gap-2 sm:grid-cols-2">
              {flags.map((f) => (
                <div class="flex items-center justify-between border border-border px-3 py-2 text-sm">
                  {f.label}
                  <span class:list={['text-2xs font-bold uppercase', f.on ? 'text-online' : 'text-muted-foreground']}>{f.on ? m.adm_on() : m.adm_off()}</span>
                </div>
              ))}
            </div>
            <p class="mt-2 text-2xs text-muted-foreground">{m.adm_settings_flags_note()}</p>
          </section>

          <section>
            <h2 class="font-condensed text-sm font-bold uppercase tracking-wide text-muted-foreground">{m.adm_settings_taxonomy()}</h2>
            <div class="mt-3 grid max-w-2xl grid-cols-2 gap-px border border-border bg-border sm:grid-cols-3">
              {taxo.map(([k, v]) => (
                <div class="bg-card px-3 py-2.5">
                  <p class="text-2xs uppercase tracking-wide text-muted-foreground">{k}</p>
                  <p class="mt-0.5 font-condensed text-xl font-bold">{v}</p>
                </div>
              ))}
            </div>
            <p class="mt-2 text-2xs text-muted-foreground" set:html={m.adm_settings_taxonomy_note()} />
          </section>

          <section>
            <h2 class="font-condensed text-sm font-bold uppercase tracking-wide text-muted-foreground">{m.adm_settings_cache()}</h2>
            <p class="mt-2 max-w-2xl text-sm text-muted-foreground" set:html={m.adm_settings_cache_note()} />
            <div class="mt-3 flex flex-wrap items-center gap-3">
              <button
                type="button"
                data-cache-purge
                class="slab-cut cursor-pointer border border-foreground/20 bg-card px-4 py-2 text-sm font-semibold transition-colors hover:bg-foreground hover:text-background disabled:opacity-50"
              >
                {m.adm_settings_cache_purge()}
              </button>
              <button
                type="button"
                data-cache-warm
                class="slab-cut cursor-pointer border border-foreground/20 bg-card px-4 py-2 text-sm font-semibold transition-colors hover:bg-foreground hover:text-background disabled:opacity-50"
              >
                {m.adm_settings_cache_warm()}
              </button>
              <span data-cache-status class="text-sm text-muted-foreground" aria-live="polite"></span>
            </div>
          </section>

          <section>
            <h2 class="font-condensed text-sm font-bold uppercase tracking-wide text-muted-foreground">{m.adm_settings_retention()}</h2>
            <ul class="mt-3 max-w-2xl space-y-1.5 text-sm text-muted-foreground">
              <li>· {m.adm_settings_ret_docs()}</li>
              <li>· {m.adm_settings_ret_messages()}</li>
              <li>· {m.adm_settings_ret_audit()}</li>
              <li>· <Fragment set:html={m.adm_settings_ret_age()} /></li>
            </ul>
          </section>
          </Fragment>
        )}
      </div>
    )
  }
</AdminShell>

<script>
  import { actions } from 'astro:actions';
  import * as m from '@/paraglide/messages';

  const status = document.querySelector<HTMLElement>('[data-cache-status]');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-cache-purge], [data-cache-warm]');
  const setBusy = (busy: boolean) => buttons.forEach((b) => (b.disabled = busy));

  document.querySelector('[data-cache-purge]')?.addEventListener('click', async () => {
    setBusy(true);
    if (status) status.textContent = m.adm_cache_purging();
    const { error } = await actions.admin.cachePurge({});
    if (status) status.textContent = error ? m.adm_cache_failed({ message: error.message }) : m.adm_cache_purged();
    setBusy(false);
  });

  document.querySelector('[data-cache-warm]')?.addEventListener('click', async () => {
    setBusy(true);
    if (status) status.textContent = m.adm_cache_warming_start();
    const { data, error } = await actions.admin.cacheWarmUrls({});
    if (error) {
      if (status) status.textContent = m.adm_cache_failed({ message: error.message });
      setBusy(false);
      return;
    }
    // The browser (external to the worker) fetches each URL → worker renders →
    // KV store. Small pool so we don't open 90 sockets at once.
    const urls = data.urls;
    let done = 0;
    let idx = 0;
    const tick = () => {
      if (status) status.textContent = m.adm_cache_warming({ done, total: urls.length });
    };
    const run = async () => {
      while (idx < urls.length) {
        const url = urls[idx++];
        try {
          await fetch(url, { headers: { 'X-Warm': '1' } });
        } catch {
          /* keep going */
        }
        done++;
        tick();
      }
    };
    await Promise.all(Array.from({ length: Math.min(8, urls.length) }, run));
    if (status) status.textContent = m.adm_cache_warmed({ done, total: urls.length });
    setBusy(false);
  });

  // Pushover keys — save per admin row.
  document.querySelectorAll<HTMLButtonElement>('[data-pushover-save]').forEach((btn) => {
    if (btn.dataset.init) return;
    btn.dataset.init = '1';
    btn.addEventListener('click', async () => {
      const id = btn.dataset.pushoverSave!;
      const input = document.querySelector<HTMLInputElement>(`[data-pushover-key="${id}"]`);
      if (!input) return;
      btn.disabled = true;
      const prev = btn.textContent;
      const { error } = await actions.admin.setPushoverKey({ accountId: id, key: input.value });
      btn.disabled = false;
      btn.textContent = error ? 'Error' : 'Saved';
      if (error) console.error(error.message);
      setTimeout(() => (btn.textContent = prev), 1500);
    });
  });

  // Admin notification toggles — auto-save the whole set on every flip (the
  // old explicit Save button silently lost changes when it wasn't pressed).
  const notifyBoxes = document.querySelectorAll<HTMLInputElement>('[data-notify-pref]');
  notifyBoxes.forEach((box) =>
    box.addEventListener('change', async () => {
      const prefs: Record<string, boolean> = {};
      notifyBoxes.forEach((b) => (prefs[b.dataset.notifyPref!] = b.checked));
      const { error } = await actions.admin.setNotifyPrefs({ prefs });
      const s = document.querySelector<HTMLElement>('[data-notify-status]');
      if (s) s.textContent = error ? `Save failed: ${error.message}` : 'Saved.';
      if (error) box.checked = !box.checked; // roll the optimistic flip back
    }),
  );
</script>
