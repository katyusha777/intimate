---
/**
 * Reports queue (docs/ADMIN.md §7). Escalations (underage/coercion) pinned top;
 * then oldest. Report-scoped context by default (§9). Resolve with the action
 * taken, or dismiss with a reason — the reporter is notified it was reviewed.
 */
import { getAdmin } from '@/actions/admin/lib';
import { reportsQueue } from '@/actions/admin/queues';
import { REPORT_RESOLUTIONS } from '@/lib/taxonomy';
import AdminShell from '@/components/organisms/admin/AdminShell.astro';
import QueueList from '@/components/organisms/admin/QueueList.astro';
import * as m from '@/paraglide/messages';

const session = await getAdmin(Astro);
const items = session ? await reportsQueue() : [];
const selId = Astro.url.searchParams.get('item');
const selected = items.find((r) => r.id === selId) ?? null;

function ago(iso: string): string {
  const mins = Math.max(0, Math.round((Date.now() - new Date(iso).getTime()) / 60000));
  return mins < 60 ? `${mins}m` : mins < 2880 ? `${Math.round(mins / 60)}h` : `${Math.round(mins / 1440)}d`;
}
const humanize = (s: string) => s.replace(/_/g, ' ').replace(/^./, (c) => c.toUpperCase());

const rows = items.map((r) => ({
  href: `/admin/reports?item=${r.id}`,
  title: `${humanize(r.reason)}${r.escalated ? ` · ${m.adm_reports_escalation_tag()}` : ''}`,
  subtitle: `${r.targetKind}: ${r.targetLabel || r.targetId}`,
  age: ago(r.createdAt),
  claimedBy: r.claim?.by ?? null,
  escalated: r.escalated,
  active: r.id === selId,
}));
---

<AdminShell title={m.adm_nav_reports()} section="reports">
  {
    session && (
      <div>
        <h1 class="display text-3xl">{m.adm_nav_reports()}</h1>
        <p class="mt-1 text-sm text-muted-foreground">{m.adm_reports_meta({ count: items.length })}</p>

        <div class="mt-6 grid gap-6 lg:grid-cols-[22rem_1fr]">
          <QueueList rows={rows} empty={m.adm_reports_empty()} />

          {!selected ? (
            <div class="grid place-items-center border border-dashed border-border py-24 text-sm text-muted-foreground">
              {m.adm_reports_select()}
            </div>
          ) : (
            <div data-report data-id={selected.id} class="min-w-0 space-y-5">
              {selected.escalated && (
                <div class="bg-brand px-3 py-2 text-sm font-semibold text-white">{m.adm_reports_escalation_banner()}</div>
              )}
              <dl class="divide-y divide-border border border-border text-sm">
                <div class="flex justify-between gap-4 px-3 py-2"><dt class="text-muted-foreground">{m.verify_reason_label()}</dt><dd class="font-medium">{humanize(selected.reason)}</dd></div>
                <div class="flex justify-between gap-4 px-3 py-2"><dt class="text-muted-foreground">{m.adm_reports_target()}</dt><dd class="font-medium">{selected.targetKind}: {selected.targetLabel || selected.targetId}</dd></div>
                <div class="flex justify-between gap-4 px-3 py-2"><dt class="text-muted-foreground">{m.adm_reports_reporter()}</dt><dd class="font-medium">{selected.reporterEmail.split('@')[0]}</dd></div>
                <div class="flex justify-between gap-4 px-3 py-2"><dt class="text-muted-foreground">{m.adm_reports_filed()}</dt><dd class="font-medium">{m.adm_ago({ age: ago(selected.createdAt) })}</dd></div>
              </dl>
              {selected.note && <p class="border border-border bg-muted/40 px-3 py-2 text-sm">“{selected.note}”</p>}
              {selected.profileSlug && (
                <a href={`/en/profile/${selected.profileSlug}/`} target="_blank" class="inline-block text-sm font-medium underline underline-offset-4">{m.adm_reports_open_profile()} ↗</a>
              )}

              <div class="flex flex-wrap items-end gap-3 border-t border-border pt-5">
                <label class="text-sm">
                  <span class="mb-1 block text-xs font-medium text-muted-foreground">{m.adm_reports_action_taken()}</span>
                  <select data-resolution class="slab-cut border border-foreground/20 bg-background px-3 py-2 text-sm">
                    <option value="">{m.adm_select()}</option>
                    {REPORT_RESOLUTIONS.map((r) => <option value={r}>{humanize(r)}</option>)}
                  </select>
                </label>
                <button type="button" data-resolve class="slab-cut bg-foreground px-4 py-2 text-sm font-semibold text-background">{m.adm_reports_resolve()}</button>
                <button type="button" data-dismiss class="slab-cut border border-foreground/20 px-4 py-2 text-sm font-medium">{m.adm_reports_dismiss()}</button>
              </div>
            </div>
          )}
        </div>
      </div>
    )
  }
</AdminShell>

<script>
  import { actions } from 'astro:actions';
  import * as m from '@/paraglide/messages';
  function initReport() {
    const panel = document.querySelector<HTMLElement>('[data-report]');
    if (!panel || panel.dataset.init) return;
    panel.dataset.init = '1';
    const id = panel.dataset.id!;
    actions.admin.claim({ itemKey: `report:${id}` });
    const resolution = panel.querySelector('[data-resolution]') as unknown as HTMLSelectElement;
    // Optimistic close (see verification page — SSR lists lag writes).
    const flash = (msg: string, ok = true) => {
      const p = document.createElement('p');
      p.className = ok ? 'text-sm font-medium text-online' : 'text-sm font-medium text-brand';
      p.textContent = msg;
      return p;
    };
    const done = (msg: string) => {
      document.querySelector(`a[href="/admin/reports?item=${id}"]`)?.closest('li')?.remove();
      panel.replaceChildren(flash(msg));
      history.replaceState({}, '', '/admin/reports');
    };
    const fail = (message: string) => panel.prepend(flash(m.adm_action_failed({ message }), false));
    panel.querySelector('[data-resolve]')!.addEventListener('click', async () => {
      if (!resolution.value) { resolution.focus(); return; }
      const { error } = await actions.admin.reportDecision({ id, decision: 'resolve', resolution: resolution.value as any });
      error ? fail(error.message) : done(m.adm_done_resolved());
    });
    panel.querySelector('[data-dismiss]')!.addEventListener('click', async () => {
      const { error } = await actions.admin.reportDecision({ id, decision: 'dismiss' });
      error ? fail(error.message) : done(m.adm_done_dismissed());
    });
  }
  initReport();
  document.addEventListener('astro:page-load', initReport);
</script>
