---
/**
 * Profiles directory — the "girls" god-view (docs/ADMIN.md §8). Filterable
 * table of every profile with state, verification, completeness % and quality
 * flags; a detail drawer with all media (blurred + reveal), full facts, reports
 * against, and lifecycle actions (approve/pause/block/unblock/delete + reason).
 */
import { getAdmin, listAudit } from '@/actions/admin/lib';
import { listProfilesAdmin, profileByIdAdmin } from '@/actions/admin/entities';
import { reportsApi } from '@/app/api/reports';
import { listAgencies } from '@/app/api/orgs';
import { localizedDescription } from '@/app/models/profile';
import { CITIES, GENDERS, PROFILE_STATES, REJECTION_REASONS } from '@/lib/taxonomy';
import { cityName } from '@/lib/seo';
import { signVdocUrl } from '@/lib/vdoc-sign';
import { verificationCode } from '@/lib/verification-code';
import AdminShell from '@/components/organisms/admin/AdminShell.astro';
import DocViewer from '@/components/organisms/admin/DocViewer.astro';
import NewProfileForm from '@/components/organisms/admin/NewProfileForm.astro';
import Lightbox from '@/components/molecules/Lightbox.astro';
import SideDrawer from '@/components/molecules/SideDrawer.astro';
import * as m from '@/paraglide/messages';

const session = await getAdmin(Astro);
const sp = Astro.url.searchParams;
const f = {
  q: sp.get('q') ?? '',
  state: sp.get('state') ?? '',
  city: sp.get('city') ?? '',
  gender: sp.get('gender') ?? '',
  onlineOnly: sp.has('online'),
  verifiedOnly: sp.has('verified'),
};
const rows = session ? await listProfilesAdmin(f) : [];
// orgId → agency, so each row/detail can name (and link to) its agency.
const agencyById = new Map((session ? await listAgencies(true) : []).map((a) => [a.id, a]));
const id = sp.get('id');
const detail = session && id ? await profileByIdAdmin(id) : null;
const reportsAgainst = detail
  ? (await reportsApi.list()).filter((r) => r.profileSlug === detail.profile.slug)
  : [];
// Per-profile audit history (state changes etc.) — the "everything" trail.
const history = detail
  ? (await listAudit()).filter((e) => e.entityType === 'profile' && e.entityId === detail.admin.id).slice(0, 8)
  : [];
// Signed doc URLs for the ID panel — viewing an approved account's docs is the
// legitimate re-check path; each reveal is tap-gated by DocViewer and audited
// at the serve route. The (id) => wrapper matters: bare .map(signVdocUrl)
// passes the array index as nowMs → URLs signed for 1970 → always "forbidden".
const docSrcs = detail?.vdocs.length ? await Promise.all(detail.vdocs.map((d) => signVdocUrl(d.id))) : [];
// Kind captions + the code she was told to write (deterministic from email —
// lib/verification-code): the reviewer compares the code photo against this.
const docKindLabels: Record<string, string> = { id_front: 'ID', id_selfie: 'Selfie with ID', code_selfie: 'Selfie with code' };
const docLabels = detail?.vdocs.map((d) => docKindLabels[d.kind] ?? d.kind) ?? [];
const expectedCode = detail?.account?.email ? verificationCode(detail.account.email) : null;
const humanizeH = (s: string) => s.replace(/_/g, ' ').replace(/^./, (c) => c.toUpperCase());

const vClass = (s: string) =>
  ({ approved: 'text-online', pending: 'text-amber-500', rejected: 'text-brand' })[s] ?? 'text-muted-foreground';
const stateClass = (s: string) =>
  ({ live: 'text-online', pending_review: 'text-amber-500', paused: 'text-muted-foreground', blocked: 'text-brand', deleted: 'text-muted-foreground', draft: 'text-muted-foreground' })[s] ??
  'text-muted-foreground';
const genderLabel = (g: string) => ({ female: 'F', male: 'M', trans_woman: 'TW', trans_man: 'TM' })[g] ?? g;
const fmtDate = (iso: string) => new Date(iso).toLocaleDateString('nl-NL', { day: '2-digit', month: 'short', year: '2-digit' });
const ago = (iso: string) => {
  const days = Math.floor((Date.now() - new Date(iso).getTime()) / 86_400_000);
  if (days <= 0) return 'today';
  if (days === 1) return '1d ago';
  if (days < 30) return `${days}d ago`;
  if (days < 365) return `${Math.floor(days / 30)}mo ago`;
  return `${Math.floor(days / 365)}y ago`;
};
---

<AdminShell title={m.adm_nav_profiles()} section="profiles" wide>
  {
    session && (
      <div>
        <div class="flex items-end justify-between gap-4">
          <div>
            <h1 class="display text-3xl">{m.adm_nav_profiles()}</h1>
            <p class="mt-1 text-sm text-muted-foreground">{m.adm_profiles_meta({ count: rows.length })}</p>
          </div>
        </div>

        {/* Create a standalone profile (same module as the org roster, §8). */}
        {session.adminRole === 'super' && <div class="mt-4"><NewProfileForm /></div>}

        {/* Filter bar */}
        <form method="get" class="mt-4 flex flex-wrap items-center gap-2 text-sm">
          <input name="q" value={f.q} placeholder={m.adm_profiles_search_ph()} class="slab-cut border border-foreground/20 bg-background px-3 py-1.5 outline-none focus:border-foreground" />
          <select name="state" class="slab-cut border border-foreground/20 bg-background px-2 py-1.5">
            <option value="">{m.adm_filter_all_states()}</option>
            {PROFILE_STATES.map((s) => <option value={s} selected={f.state === s}>{s}</option>)}
          </select>
          <select name="city" class="slab-cut border border-foreground/20 bg-background px-2 py-1.5">
            <option value="">{m.adm_filter_all_cities()}</option>
            {CITIES.map((c) => <option value={c.slug} selected={f.city === c.slug}>{c.name}</option>)}
          </select>
          <select name="gender" class="slab-cut border border-foreground/20 bg-background px-2 py-1.5">
            <option value="">{m.adm_filter_all_genders()}</option>
            {GENDERS.map((g) => <option value={g} selected={f.gender === g}>{g}</option>)}
          </select>
          <label class="flex items-center gap-1.5"><input type="checkbox" name="online" checked={f.onlineOnly} class="cbx-box" /> {m.adm_filter_online()}</label>
          <label class="flex items-center gap-1.5"><input type="checkbox" name="verified" checked={f.verifiedOnly} class="cbx-box" /> {m.verified()}</label>
          <button type="submit" class="slab-cut border border-foreground/20 px-3 py-1.5 font-medium">{m.adm_filter()}</button>
          <a href="/admin/profiles" class="px-2 py-1.5 text-muted-foreground hover:text-foreground">{m.filter_reset()}</a>
        </form>

        {/* Table — full width; the detail is now a modal overlay (opens on ?id=). */}
        <div class="mt-5 overflow-x-auto border border-border">
            <table class="w-full min-w-[860px] text-left text-sm">
              <thead class="border-b border-border bg-muted text-2xs uppercase tracking-wide text-muted-foreground">
                <tr>
                  <th class="px-3 py-2 font-semibold">{m.adm_th_profile()}</th>
                  <th class="px-3 py-2 font-semibold">{m.filter_city()}</th>
                  <th class="px-3 py-2 font-semibold">Agency</th>
                  <th class="px-3 py-2 font-semibold">{m.adm_th_state()}</th>
                  <th class="px-3 py-2 font-semibold">Created</th>
                  <th class="px-3 py-2 font-semibold">{m.request_card_price()}</th>
                  <th class="px-3 py-2 font-semibold">{m.adm_th_complete()}</th>
                  <th class="px-3 py-2 font-semibold">{m.adm_th_flags()}</th>
                  <th class="px-3 py-2 font-semibold"></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                {rows.map((r) => (
                  <tr data-href={`/admin/profiles?id=${r.id}`} class:list={['cursor-pointer transition-colors hover:bg-muted', r.id === id && 'bg-muted']}>
                    <td class="px-3 py-2">
                      <a href={`/admin/profiles?id=${r.id}`} class="flex items-center gap-2.5">
                        {r.photos[0] ? (
                          <img src={r.photos[0]} alt={r.name} loading="lazy" class="size-9 flex-none rounded-full object-cover" />
                        ) : (
                          <span class="grid size-9 flex-none place-items-center rounded-full bg-muted font-condensed text-sm font-bold">{r.name.charAt(0)}</span>
                        )}
                        <span class="min-w-0">
                          <span class="flex items-center gap-1.5 font-medium">
                            {r.name}, {r.age}
                            {r.verified && <svg class="size-3 flex-none text-online" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9 12l2 2 4-4 1.5 1.5L11 17l-3.5-3.5z"/><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"/></svg>}
                            {r.online && <span class="size-1.5 rounded-full bg-online" title={m.online_now()} />}
                          </span>
                          <span class="block text-2xs text-muted-foreground">{genderLabel(r.gender)} · {r.servicesCount} {m.account_services_count()} · {r.photos.length}📷</span>
                        </span>
                      </a>
                    </td>
                    <td class="px-3 py-2 text-muted-foreground">{cityName(r.city)}</td>
                    <td class="px-3 py-2 text-2xs">
                      {r.orgId && agencyById.has(r.orgId) ? (
                        <a href={`/admin/organizations?id=${r.orgId}`} class="text-foreground underline underline-offset-2 hover:text-brand">{agencyById.get(r.orgId)!.name}</a>
                      ) : (
                        <span class="text-muted-foreground">—</span>
                      )}
                    </td>
                    <td class="px-3 py-2">
                      <span data-state-cell class:list={['font-medium', stateClass(r.state)]}>{r.state}</span>
                      {/* How long it's been in this state (DB trigger stamp). */}
                      {r.stateChangedAt && <span class="block text-2xs text-muted-foreground">{ago(r.stateChangedAt)}</span>}
                    </td>
                    <td class="whitespace-nowrap px-3 py-2 text-2xs text-muted-foreground">
                      {fmtDate(r.createdAt)} <span class="opacity-70">· {ago(r.createdAt)}</span>
                    </td>
                    <td class="px-3 py-2 tabular-nums">€{r.priceFrom}</td>
                    <td class="px-3 py-2">
                      <span class="flex items-center gap-1.5">
                        <span class="relative h-1.5 w-12 overflow-hidden rounded-full bg-muted"><span class:list={['absolute inset-y-0 left-0', r.completeness >= 75 ? 'bg-online' : r.completeness >= 50 ? 'bg-amber-500' : 'bg-brand']} style={`width:${r.completeness}%`} /></span>
                        <span class="tabular-nums text-2xs text-muted-foreground">{r.completeness}%</span>
                      </span>
                    </td>
                    <td class="px-3 py-2 text-2xs text-brand">{r.flags.join(', ')}</td>
                    <td class="px-3 py-2 text-right">
                      {/* One-tap lifecycle without the drawer: live ⇄ paused. */}
                      {(r.state === 'live' || r.state === 'paused') && (
                        <button
                          type="button"
                          data-row-state={r.id}
                          data-next={r.state === 'live' ? 'pause' : 'resume'}
                          class="slab-cut cursor-pointer border border-foreground/20 px-2.5 py-1 text-2xs font-bold uppercase transition-colors hover:border-foreground"
                        >
                          {r.state === 'live' ? m.adm_pause() : m.adm_resume()}
                        </button>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
        </div>

        {/* Detail drawer — SSR-rendered from ?id=, slides in from the right so
            the table runs full-width. Closing navigates back to the clean list. */}
        <SideDrawer id="profile-detail" label={m.adm_nav_profiles()} class="max-w-md">
          {detail && (
            <aside data-profile-detail data-id={detail.admin.id} class="space-y-4 p-5">
              <div class="flex items-center gap-3 pr-12">
                {detail.profile.photos[0] ? (
                  <img src={detail.profile.photos[0]} alt={detail.admin.name} class="size-12 flex-none rounded-full object-cover" />
                ) : (
                  <span class="grid size-12 flex-none place-items-center rounded-full bg-muted font-condensed text-lg font-bold">{detail.admin.name.charAt(0)}</span>
                )}
                <div class="min-w-0">
                  <p class="font-condensed text-xl font-bold">{detail.admin.name}, {detail.admin.age}</p>
                  <p data-pstate class:list={['text-xs font-medium', stateClass(detail.admin.state)]}>
                    {detail.admin.state}{detail.admin.stateReason ? ` · ${detail.admin.stateReason}` : ''}
                    {detail.admin.stateChangedAt && <span class="font-normal text-muted-foreground"> · {ago(detail.admin.stateChangedAt)}</span>}
                  </p>
                </div>
              </div>

              {/* Media strip — admin always sees the real images (never blurred);
                  click opens the shared Lightbox. */}
              <div class="flex flex-wrap gap-2" data-lightbox-group>
                <div class="contents" data-lightbox-photos>
                  {detail.profile.photos.slice(0, 8).map((url, i) => (
                    <button type="button" data-lightbox data-lightbox-index={i} class="block size-16 cursor-pointer overflow-hidden border border-border">
                      <img src={url} alt={`photo ${i + 1}`} loading="lazy" class="size-full object-cover" />
                    </button>
                  ))}
                </div>
              </div>

              <dl class="grid grid-cols-2 gap-px overflow-hidden border border-border bg-border text-xs">
                {[
                  [m.filter_city(), cityName(detail.profile.city)],
                  ['Agency', detail.admin.orgId && agencyById.has(detail.admin.orgId)
                    ? <a href={`/admin/organizations?id=${detail.admin.orgId}`} class="underline underline-offset-2 hover:text-brand">{agencyById.get(detail.admin.orgId)!.name}</a>
                    : '—'],
                  [m.filter_gender(), detail.profile.gender],
                  [m.request_card_price(), `€${detail.profile.priceFrom}`],
                  [m.filter_services(), String(detail.profile.services.length)],
                  [m.nav_photos(), String(detail.profile.photos.length)],
                  [m.adm_field_completeness(), `${detail.admin.completeness}%`],
                  [m.verified(), detail.profile.verified ? m.adm_yes() : m.adm_no()],
                  [m.adm_nav_reports(), String(reportsAgainst.length)],
                ].map(([k, v]) => (
                  <div class="bg-card px-2.5 py-1.5"><dt class="text-2xs uppercase tracking-wide text-muted-foreground">{k}</dt><dd class="font-medium">{v}</dd></div>
                ))}
              </dl>

              <p class="line-clamp-3 text-xs text-muted-foreground">{localizedDescription(detail.profile, 'en')}</p>

              <div class="flex flex-wrap items-center gap-3">
                <a href={`/admin/profiles/edit?id=${detail.admin.id}`} class="slab-cut bg-foreground px-3 py-1.5 text-xs font-bold uppercase text-background">Edit profile</a>
                <a href={`/en/profile/${detail.profile.slug}/`} target="_blank" class="text-xs font-medium underline underline-offset-4">{m.adm_profiles_public_page()} ↗</a>
              </div>

              {detail.profile.importedFromUrl && (
                <p class="break-all text-2xs text-muted-foreground">
                  Imported from <a href={detail.profile.importedFromUrl} target="_blank" class="underline underline-offset-2">{detail.profile.importedFromUrl}</a>
                </p>
              )}

              {/* Account — the owning account's identity, so support isn't blind. */}
              {detail.account && (
                <div class="border-t border-border pt-3">
                  <p class="text-2xs font-semibold uppercase tracking-wide text-muted-foreground">Account</p>
                  <dl class="mt-1.5 grid grid-cols-2 gap-px overflow-hidden border border-border bg-border text-xs">
                    <div class="bg-card px-2.5 py-1.5">
                      <dt class="text-2xs uppercase tracking-wide text-muted-foreground">Email</dt>
                      <dd class="font-medium">
                        {detail.account.email ? (
                          <button type="button" data-copy={detail.account.email} class="cursor-pointer break-all text-left font-medium underline underline-offset-2 hover:text-brand">{detail.account.email}</button>
                        ) : ('—')}
                      </dd>
                    </div>
                    <div class="bg-card px-2.5 py-1.5">
                      <dt class="text-2xs uppercase tracking-wide text-muted-foreground">Phone</dt>
                      <dd class="font-medium">
                        {detail.account.phone ? (
                          <button type="button" data-copy={detail.account.phone} class="cursor-pointer break-all text-left font-medium underline underline-offset-2 hover:text-brand">{detail.account.phone}</button>
                        ) : ('—')}{' '}
                        {detail.account.phoneVerified ? <span class="text-online">✓ verified</span> : <span class="text-muted-foreground">unverified</span>}
                      </dd>
                    </div>
                    <div class="bg-card px-2.5 py-1.5"><dt class="text-2xs uppercase tracking-wide text-muted-foreground">Type</dt><dd class="font-medium">{humanizeH(detail.account.accountType)}</dd></div>
                    <div class="bg-card px-2.5 py-1.5"><dt class="text-2xs uppercase tracking-wide text-muted-foreground">Created</dt><dd class="font-medium">{fmtDate(detail.account.createdAt)} <span class="text-muted-foreground">· {ago(detail.account.createdAt)}</span></dd></div>
                    {[
                      ['WhatsApp', detail.profile.whatsapp],
                      ['Telegram', detail.profile.telegram],
                      ['Instagram', detail.profile.instagram],
                      ['Profile phone', detail.profile.phone && detail.profile.phone !== detail.account.phone ? detail.profile.phone : undefined],
                    ].map(([k, v]) => v && (
                      <div class="bg-card px-2.5 py-1.5"><dt class="text-2xs uppercase tracking-wide text-muted-foreground">{k}</dt><dd class="font-medium"><button type="button" data-copy={v} class="cursor-pointer break-all text-left font-medium underline underline-offset-2 hover:text-brand">{v}</button></dd></div>
                    ))}
                  </dl>
                  {detail.account.email && (
                    <a href={`/admin/users?email=${encodeURIComponent(detail.account.email)}`} class="mt-2 inline-block text-xs font-medium underline underline-offset-4">Open in Users</a>
                  )}
                  {detail.siblings.length > 0 && (
                    <div class="mt-3">
                      <p class="text-2xs font-semibold uppercase tracking-wide text-muted-foreground">Other profiles on this account ({detail.siblings.length})</p>
                      <ul class="mt-1.5 space-y-1">
                        {detail.siblings.slice(0, 8).map((s) => (
                          <li class="flex items-center justify-between gap-2 text-xs">
                            <a href={`/admin/profiles?id=${s.id}`} class="underline underline-offset-2 hover:text-brand">{s.name}</a>
                            <span class:list={['text-2xs', stateClass(s.state)]}>{s.state}</span>
                          </li>
                        ))}
                        {detail.siblings.length > 8 && <li class="text-2xs text-muted-foreground">+{detail.siblings.length - 8} more</li>}
                      </ul>
                    </div>
                  )}
                </div>
              )}

              {/* ID verification — authoritative account state + the audited doc
                  viewer (every reveal logged at the vdoc serve route). Reject only
                  renders while pending and rejects the WHOLE submission (ID →
                  rejected, pending_review profile → draft, pending photos →
                  rejected — all state-guarded); approve = the drawer's Approve,
                  which chains approveWholeSubmission. */}
              {detail.account && (
                <div class="border-t border-border pt-3">
                  <p class="text-2xs font-semibold uppercase tracking-wide text-muted-foreground">ID verification</p>
                  <p class="mt-1.5 text-xs">
                    <span data-vstate class:list={['font-medium', vClass(detail.account.idVerification)]}>{detail.account.idVerification}</span>
                    {detail.account.verificationSubmittedAt && (
                      <span class="text-muted-foreground"> · submitted {fmtDate(detail.account.verificationSubmittedAt)} ({ago(detail.account.verificationSubmittedAt)})</span>
                    )}
                    {detail.account.verificationReason && <span class="text-brand"> · {humanizeH(detail.account.verificationReason)}</span>}
                  </p>
                  {expectedCode && docSrcs.length > 0 && (
                    <p class="mt-1.5 text-xs text-muted-foreground">
                      Expected code: <span class="slab-cut bg-foreground px-1.5 py-0.5 font-condensed font-bold tracking-widest text-background">{expectedCode}</span>
                    </p>
                  )}
                  <div class="mt-2">
                    <DocViewer srcs={docSrcs} labels={docLabels} admin={session.email} />
                  </div>
                  {detail.account.idVerification === 'pending' && (
                    <div data-vreject-row class="mt-2 flex flex-wrap items-center gap-1.5">
                      <select data-vreason class="slab-cut border border-foreground/20 bg-background px-2.5 py-1.5 text-xs outline-none focus:border-foreground">
                        <option value="" disabled selected>Reject reason…</option>
                        {REJECTION_REASONS.map((r) => <option value={r}>{humanizeH(r)}</option>)}
                      </select>
                      <button type="button" data-vreject data-drafts={detail.admin.state === 'pending_review' ? '1' : undefined} class="slab-cut border border-brand px-2.5 py-1 text-2xs font-bold uppercase text-brand">Reject submission</button>
                    </div>
                  )}
                </div>
              )}

              {/* IDs — copyable identifiers for support lookups. */}
              <div class="border-t border-border pt-3">
                <p class="text-2xs font-semibold uppercase tracking-wide text-muted-foreground">IDs</p>
                <dl class="mt-1.5 divide-y divide-border border border-border text-xs">
                  {[
                    ['Profile ID', detail.admin.id],
                    ['Slug', detail.profile.slug],
                    ['Account ID', detail.account?.id],
                  ].map(([k, v]) => (
                    <div class="flex justify-between gap-4 px-2.5 py-1.5">
                      <dt class="text-muted-foreground">{k}</dt>
                      <dd>{v ? <button type="button" data-copy={v} class="cursor-pointer break-all text-right font-mono text-2xs hover:text-brand">{v}</button> : '—'}</dd>
                    </div>
                  ))}
                </dl>
              </div>

              {reportsAgainst.length > 0 && (
                <div class="border-t border-border pt-3">
                  <p class="text-2xs font-semibold uppercase tracking-wide text-brand">{m.adm_profiles_reports_against({ count: reportsAgainst.length })}</p>
                  <ul class="mt-1.5 space-y-1">
                    {reportsAgainst.slice(0, 5).map((r) => (
                      <li class="flex items-center justify-between gap-2 text-xs">
                        <span>{humanizeH(r.reason)}{r.escalated && ' ⚠'}</span>
                        <span class="text-2xs text-muted-foreground">{r.state}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {history.length > 0 && (
                <div class="border-t border-border pt-3">
                  <p class="text-2xs font-semibold uppercase tracking-wide text-muted-foreground">{m.adm_profiles_history()}</p>
                  <ul class="mt-1.5 space-y-1">
                    {history.map((e) => (
                      <li class="flex items-center justify-between gap-2 text-xs text-muted-foreground">
                        <span>{humanizeH(e.action)}{e.reason ? ` · ${humanizeH(e.reason)}` : ''}</span>
                        <span class="text-2xs">{e.adminEmail.split('@')[0]}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {/* Visibility — the same "unlisted" switch the owner has in her
                  own settings: out of search/listings, direct link still works. */}
              <div class="flex items-center justify-between gap-3 border-t border-border pt-3">
                <div class="min-w-0">
                  <p class="text-2xs font-semibold uppercase tracking-wide text-muted-foreground">{m.settings_unlisted()}</p>
                  <p class="mt-0.5 text-2xs text-muted-foreground">{m.settings_unlisted_note()}</p>
                </div>
                <label class="flex cursor-pointer items-center">
                  <input type="checkbox" data-unlisted checked={detail.admin.unlisted} class="sr-only" />
                  <span class="switch-track" aria-hidden="true" />
                </label>
              </div>

              {/* Lifecycle actions */}
              <div class="space-y-2 border-t border-border pt-3">
                <input data-reason placeholder={m.adm_profiles_reason_ph()} class="w-full slab-cut border border-foreground/20 bg-background px-2.5 py-1.5 text-xs outline-none focus:border-foreground" />
                <div class="flex flex-wrap gap-1.5">
                  <button type="button" data-act="approve" class="slab-cut bg-online px-2.5 py-1 text-2xs font-bold uppercase text-white">{m.adm_approve()}</button>
                  {detail.admin.state === 'paused' ? (
                    <button type="button" data-act="resume" class="slab-cut border border-foreground/20 px-2.5 py-1 text-2xs font-bold uppercase">{m.adm_resume()}</button>
                  ) : (
                    <button type="button" data-act="pause" class="slab-cut border border-foreground/20 px-2.5 py-1 text-2xs font-bold uppercase">{m.adm_pause()}</button>
                  )}
                  {detail.admin.state === 'blocked' ? (
                    <button type="button" data-act="unblock" class="slab-cut border border-foreground/20 px-2.5 py-1 text-2xs font-bold uppercase">{m.msg_unblock()}</button>
                  ) : (
                    <button type="button" data-act="block" class="slab-cut border border-brand px-2.5 py-1 text-2xs font-bold uppercase text-brand">{m.msg_block()}</button>
                  )}
                  <button type="button" data-act="delete" class="slab-cut border border-brand px-2.5 py-1 text-2xs font-bold uppercase text-brand">{m.adm_delete()}</button>
                </div>
              </div>
            </aside>
          )}
        </SideDrawer>
      </div>
    )
  }
</AdminShell>

<Lightbox />

<script>
  import { actions } from 'astro:actions';
  import * as m from '@/paraglide/messages';
  import type { RejectionReason } from '@/lib/taxonomy';
  function initProfiles() {
    // Whole row opens the detail drawer (the name cell stays a real link).
    document.querySelectorAll<HTMLTableRowElement>('tr[data-href]').forEach((row) => {
      if (row.dataset.init) return;
      row.dataset.init = '1';
      row.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a, button')) return;
        location.href = row.dataset.href!;
      });
    });

    // Row-level pause ⇄ resume — optimistic flip in place (SSR reads lag
    // writes behind the Hyperdrive cache, so never reload after a write).
    document.querySelectorAll<HTMLButtonElement>('[data-row-state]').forEach((b) => {
      if (b.dataset.init) return;
      b.dataset.init = '1';
      b.addEventListener('click', async () => {
        const action = b.dataset.next as 'pause' | 'resume';
        b.disabled = true;
        const { error } = await actions.admin.profileState({ id: b.dataset.rowState!, action });
        b.disabled = false;
        if (error) { b.textContent = m.adm_action_failed({ message: error.message }); return; }
        const next = action === 'pause' ? 'paused' : 'live';
        const cell = b.closest('tr')?.querySelector<HTMLElement>('[data-state-cell]');
        if (cell) {
          cell.textContent = next;
          cell.classList.toggle('text-online', next === 'live');
          cell.classList.toggle('text-muted-foreground', next === 'paused');
          cell.nextElementSibling?.remove(); // the "Xd ago" line is now stale
        }
        b.dataset.next = action === 'pause' ? 'resume' : 'pause';
        b.textContent = action === 'pause' ? m.adm_resume() : m.adm_pause();
      });
    });

    const d = document.querySelector<HTMLElement>('[data-profile-detail]');
    if (!d || d.dataset.init) return;
    d.dataset.init = '1';
    const id = d.dataset.id!;

    // The detail is SSR'd from ?id= — slide the right-edge drawer open, and
    // closing (✕ / backdrop / Esc) returns to the list, filters intact, no ?id.
    const dlg = document.getElementById('profile-detail') as (HTMLDialogElement & { openSheet?(): void; closeSheet?(): void }) | null;
    if (dlg) {
      // rAF so SideDrawer's own init (which attaches openSheet) has run first.
      requestAnimationFrame(() => dlg.openSheet?.());
      dlg.querySelector('[data-sheet-close]')?.addEventListener('click', () => dlg.closeSheet?.());
      dlg.addEventListener('sheet:closed', () => {
        const back = new URL(location.href);
        back.searchParams.delete('id');
        location.href = back.pathname + back.search;
      });
    }

    // Unlisted toggle — same visibility switch the owner has (settings.astro).
    const unlisted = d.querySelector<HTMLInputElement>('[data-unlisted]');
    unlisted?.addEventListener('change', async () => {
      const value = unlisted.checked;
      unlisted.disabled = true;
      const { error } = await actions.admin.profileUnlisted({ id, unlisted: value });
      unlisted.disabled = false;
      if (error) unlisted.checked = !value; // revert on failure
    });

    d.querySelectorAll<HTMLElement>('[data-reveal]').forEach((b) => b.addEventListener('click', () => b.classList.toggle('shown')));
    const reason = d.querySelector('[data-reason]') as unknown as HTMLInputElement;
    d.querySelectorAll<HTMLButtonElement>('[data-act]').forEach((b) =>
      b.addEventListener('click', async () => {
        const action = b.dataset.act as 'approve' | 'pause' | 'resume' | 'block' | 'unblock' | 'delete';
        if ((action === 'block' || action === 'delete') && !reason.value) { reason.focus(); return; }
        b.disabled = true;
        const { error } = await actions.admin.profileState({ id, action, reason: reason.value || undefined });
        b.disabled = false;
        // Optimistic (SSR lists lag writes) — flash the outcome in place.
        const p = document.createElement('p');
        p.className = error ? 'text-xs font-medium text-brand' : 'text-xs font-medium text-online';
        p.textContent = error ? m.adm_action_failed({ message: error.message }) : m.adm_done_saved();
        b.closest('div')!.after(p);
        setTimeout(() => p.remove(), 4000);
      }),
    );

    // Click-to-copy for account facts + IDs (mirrors tools/index.astro).
    d.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
      b.addEventListener('click', async () => {
        const orig = b.textContent;
        try {
          await navigator.clipboard.writeText(b.dataset.copy!);
          b.textContent = 'Copied ✓';
        } catch {
          b.textContent = 'Copy failed';
        }
        setTimeout(() => (b.textContent = orig), 1500);
      }),
    );

    // Reject the pending ID with a reason (approvalDecision — same action as the
    // approvals queue). Optimistic: flip the state line in place, never reload
    // (Hyperdrive reads lag writes).
    const vreject = d.querySelector<HTMLButtonElement>('[data-vreject]');
    vreject?.addEventListener('click', async () => {
      const sel = d.querySelector('[data-vreason]') as unknown as HTMLInputElement;
      if (!sel.value) { sel.focus(); return; }
      vreject.disabled = true;
      const { error } = await actions.admin.approvalDecision({
        key: 'profile:' + id,
        decision: 'reject',
        reason: sel.value as RejectionReason,
      });
      vreject.disabled = false;
      const row = d.querySelector<HTMLElement>('[data-vreject-row]')!;
      const drafts = !!vreject.dataset.drafts; // profile was pending_review → now draft
      const p = document.createElement('p');
      p.className = error ? 'text-xs font-medium text-brand' : 'text-xs font-medium text-online';
      p.textContent = error
        ? m.adm_action_failed({ message: error.message })
        : drafts ? 'Submission rejected — profile back to draft, pending photos rejected' : 'Submission rejected — ID rejected, pending photos rejected';
      row.after(p);
      setTimeout(() => p.remove(), 8000);
      if (!error) {
        const st = d.querySelector<HTMLElement>('[data-vstate]');
        if (st) {
          st.textContent = 'rejected';
          st.classList.remove('text-amber-500');
          st.classList.add('text-brand');
        }
        if (drafts) {
          const ps = d.querySelector<HTMLElement>('[data-pstate]');
          if (ps) {
            ps.textContent = 'draft';
            ps.classList.remove('text-amber-500');
            ps.classList.add('text-muted-foreground');
          }
        }
        row.remove();
      }
    });
  }
  initProfiles();
  document.addEventListener('astro:page-load', initProfiles);
</script>
