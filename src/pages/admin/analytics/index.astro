---
/**
 * Ops analytics (docs/ADMIN.md §12). First-party numbers: verification funnel,
 * report mix, completeness distribution, category supply, admin throughput.
 * PostHog (product analytics) is deep-linked, not rebuilt here.
 */
import { getAdmin } from '@/actions/admin/lib';
import { analytics } from '@/actions/admin/analytics';
import AdminShell from '@/components/organisms/admin/AdminShell.astro';
import * as m from '@/paraglide/messages';

const session = await getAdmin(Astro);
const a = session ? await analytics() : null;
const humanize = (s: string) => s.replace(/_/g, ' ').replace(/^./, (c) => c.toUpperCase());

/** rows: {label, count}[]; renders proportional bars. */
function Bars(rows: { label: string; count: number }[], color = 'bg-foreground') {
  const max = Math.max(1, ...rows.map((r) => r.count));
  return { rows, max, color };
}
const sections = a
  ? [
      { title: m.adm_analytics_funnel(), data: Bars([
        { label: m.adm_unverified(), count: a.verification.unverified },
        { label: m.adm_pending(), count: a.verification.pending },
        { label: m.adm_approved(), count: a.verification.approved },
        { label: m.verify_rejected(), count: a.verification.rejected },
      ]) },
      { title: m.adm_nav_reports(), data: Bars([
        { label: m.adm_open_state(), count: a.reports.open },
        { label: m.adm_resolved(), count: a.reports.resolved },
        { label: m.adm_dismissed(), count: a.reports.dismissed },
        { label: m.adm_escalations(), count: a.reports.escalations },
      ]) },
      { title: m.adm_analytics_report_reasons(), data: Bars(a.reportReasons.map((r) => ({ label: humanize(r.reason), count: r.count }))) },
      { title: m.adm_field_completeness(), data: Bars(a.completenessBuckets) },
      { title: m.adm_analytics_supply_category(), data: Bars(a.byServiceCategory.map((c) => ({ label: humanize(c.category), count: c.count }))) },
      { title: m.adm_analytics_throughput(), data: Bars(a.adminThroughput.map((t) => ({ label: t.admin, count: t.actions }))) },
    ]
  : [];
---

<AdminShell title={m.adm_nav_analytics()} section="analytics">
  {
    a && (
      <div>
        <h1 class="display text-3xl">{m.adm_nav_analytics()}</h1>
        <p class="mt-1 text-sm text-muted-foreground">
          {m.adm_analytics_meta({ profiles: a.totals.profiles, accounts: a.totals.accounts, entries: a.totals.auditEntries })}
        </p>

        <div class="mt-6 grid gap-6 md:grid-cols-2">
          {sections.map((s) => (
            <section class="border border-border p-4">
              <h2 class="font-condensed text-sm font-bold uppercase tracking-wide text-muted-foreground">{s.title}</h2>
              <div class="mt-3 space-y-1.5">
                {s.data.rows.length === 0 ? (
                  <p class="text-xs text-muted-foreground">{m.adm_no_data()}</p>
                ) : (
                  s.data.rows.map((r) => (
                    <div class="flex items-center gap-2 text-sm">
                      <span class="w-28 flex-none truncate text-muted-foreground">{r.label}</span>
                      <span class="relative h-3 flex-1 overflow-hidden bg-muted">
                        <span class="absolute inset-y-0 left-0 bg-foreground" style={`width:${(r.count / s.data.max) * 100}%`} />
                      </span>
                      <span class="w-8 flex-none text-right tabular-nums text-muted-foreground">{r.count}</span>
                    </div>
                  ))
                )}
              </div>
            </section>
          ))}
        </div>

        <p class="mt-6 text-2xs text-muted-foreground">
          {m.adm_analytics_note()}
        </p>
      </div>
    )
  }
</AdminShell>
