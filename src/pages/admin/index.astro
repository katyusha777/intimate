---
/**
 * Admin Overview — the live cockpit (docs/ADMIN.md §4). Queue depths + oldest
 * age (SLA at a glance), today's counters, supply-by-city. Realtime layering
 * (Supabase) comes with the backend; SSR paint is the base.
 */
import { getAdmin } from '@/actions/admin/lib';
import { overview } from '@/actions/admin/queues';
import AdminShell from '@/components/organisms/admin/AdminShell.astro';

const session = await getAdmin({ cookies: Astro.cookies });
const ov = session ? await overview() : null;

/** Duration since an ISO time — tz-independent, safe server-side. */
function ago(iso: string | null): string {
  if (!iso) return '—';
  const mins = Math.max(0, Math.round((Date.now() - new Date(iso).getTime()) / 60000));
  if (mins < 60) return `${mins}m`;
  const hrs = Math.round(mins / 60);
  return hrs < 48 ? `${hrs}h` : `${Math.round(hrs / 24)}d`;
}
const SLA_H = 24;
function breach(iso: string | null): boolean {
  return iso ? Date.now() - new Date(iso).getTime() > SLA_H * 3600_000 : false;
}

const queues = ov
  ? [
      { key: 'verification', label: 'Verification', href: '/admin/verification', depth: ov.queues.verification, oldest: ov.oldest.verification },
      { key: 'moderation', label: 'Moderation', href: '/admin/moderation', depth: ov.queues.moderation, oldest: ov.oldest.moderation },
      { key: 'reports', label: 'Reports', href: '/admin/reports', depth: ov.queues.reports, oldest: ov.oldest.reports },
    ]
  : [];
const counters = ov
  ? [
      { label: 'Accounts', value: ov.today.registrations },
      { label: 'Awaiting review', value: ov.today.submitted },
      { label: 'Live profiles', value: ov.today.published },
      { label: 'Online now', value: ov.onlineNow },
    ]
  : [];
---

<AdminShell title="Overview" section="overview">
  {
    ov && (
      <>
        <h1 class="display text-3xl">Overview</h1>
        <p class="mt-1 text-sm text-muted-foreground">Live ops. SLA target: verification &lt; {SLA_H}h.</p>

        <section class="mt-6 grid gap-3 sm:grid-cols-3">
          {queues.map((q) => (
            <a href={q.href} class="slab-cut border border-border bg-card p-4 transition-colors hover:border-foreground/40">
              <p class="eyebrow text-2xs text-muted-foreground">{q.label}</p>
              <p class="mt-2 font-condensed text-4xl font-bold leading-none">{q.depth}</p>
              <p class:list={['mt-2 text-xs', breach(q.oldest) ? 'font-semibold text-brand' : 'text-muted-foreground']}>
                oldest {ago(q.oldest)}{breach(q.oldest) ? ' · SLA breached' : ''}
              </p>
            </a>
          ))}
        </section>

        <section class="mt-4 grid gap-3 sm:grid-cols-4">
          {counters.map((c) => (
            <div class="border border-border p-4">
              <p class="eyebrow text-2xs text-muted-foreground">{c.label}</p>
              <p class="mt-2 font-condensed text-3xl font-bold leading-none">{c.value}</p>
            </div>
          ))}
        </section>

        <section class="mt-8">
          <h2 class="font-condensed text-sm font-bold uppercase tracking-wide text-muted-foreground">Supply by city</h2>
          <div class="mt-3 max-w-2xl space-y-2">
            {ov.supply.map((s) => (
              <div class="flex items-center gap-3 text-sm">
                <span class="w-28 flex-none truncate">{s.city}</span>
                <span class="relative h-4 flex-1 overflow-hidden bg-muted">
                  <span class="absolute inset-y-0 left-0 bg-foreground" style={`width:${Math.min(100, (s.live / s.target) * 100)}%`} />
                </span>
                <span class="w-14 flex-none text-right tabular-nums text-muted-foreground">{s.live}/{s.target}</span>
              </div>
            ))}
          </div>
        </section>
      </>
    )
  }
</AdminShell>
