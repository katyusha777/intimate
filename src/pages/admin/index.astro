---
/**
 * Admin Overview — the live cockpit (docs/ADMIN.md §4). Queue depths + oldest
 * age (SLA at a glance), today's counters, supply-by-city. Realtime layering
 * (Supabase) comes with the backend; SSR paint is the base.
 */
import { env } from 'cloudflare:workers';
import { getAdmin, listAudit } from '@/actions/admin/lib';
import { overview } from '@/actions/admin/queues';
import { commandStats, listProfilesAdmin } from '@/actions/admin/entities';
import AdminShell from '@/components/organisms/admin/AdminShell.astro';
import AdminLogin from '@/components/organisms/admin/AdminLogin.astro';
import * as m from '@/paraglide/messages';

const session = await getAdmin(Astro);
// No admin session → sign in right here (not via the app). `?signedin` means
// they authenticated but the account isn't an admin.
const signedIn = Astro.url.searchParams.has('signedin');
// When aal2 is enforced, an admin with no factor must enroll at sign-in (else
// the gate locks them out with no way to reach the settings enroll card).
const requireMfa = (env as unknown as Record<string, string | undefined>).ADMIN_REQUIRE_AAL2 === 'true';
const ov = session ? await overview() : null;
const stats = session ? await commandStats() : null;
const activity = session ? (await listAudit()).slice(0, 12) : [];
// Blocked profiles surfaced on the cockpit (feedback v10 #3) — check + unblock
// without hunting through the profiles table's state filter.
const blocked = session ? await listProfilesAdmin({ state: 'blocked' }) : [];
const humanizeA = (s: string) => s.replace(/_/g, ' ').replace(/^./, (c) => c.toUpperCase());
const agoShort = (iso: string) => {
  const m = Math.max(0, Math.round((Date.now() - new Date(iso).getTime()) / 60000));
  return m < 60 ? `${m}m` : m < 1440 ? `${Math.round(m / 60)}h` : `${Math.round(m / 1440)}d`;
};
const stateColor = (s: string) =>
  ({ live: 'bg-online', pending_review: 'bg-amber-500', paused: 'bg-muted-foreground', blocked: 'bg-brand', deleted: 'bg-muted-foreground', draft: 'bg-muted-foreground' })[s] ?? 'bg-foreground';

/** Duration since an ISO time — tz-independent, safe server-side. */
function ago(iso: string | null): string {
  if (!iso) return '—';
  const mins = Math.max(0, Math.round((Date.now() - new Date(iso).getTime()) / 60000));
  if (mins < 60) return `${mins}m`;
  const hrs = Math.round(mins / 60);
  return hrs < 48 ? `${hrs}h` : `${Math.round(hrs / 24)}d`;
}
const SLA_H = 24;
function breach(iso: string | null): boolean {
  return iso ? Date.now() - new Date(iso).getTime() > SLA_H * 3600_000 : false;
}

const queues = ov
  ? [
      { key: 'approvals', label: m.adm_nav_approvals(), href: '/admin/approvals', depth: ov.queues.approvals, oldest: ov.oldest.approvals },
      { key: 'reports', label: m.adm_nav_reports(), href: '/admin/reports', depth: ov.queues.reports, oldest: ov.oldest.reports },
    ]
  : [];
const counters = ov
  ? [
      { label: m.adm_counter_accounts(), value: ov.today.registrations },
      { label: m.adm_counter_awaiting_review(), value: ov.today.submitted },
      { label: m.adm_counter_live_profiles(), value: ov.today.published },
      { label: m.online_now(), value: ov.onlineNow },
    ]
  : [];
---

{!session && <AdminLogin notAdmin={signedIn} requireMfa={requireMfa} />}
{session && (
<AdminShell title={m.adm_nav_overview()} section="overview">
  {
    ov && (
      <>
        <h1 class="display text-3xl">{m.adm_nav_overview()}</h1>
        <p class="mt-1 text-sm text-muted-foreground">{m.adm_overview_sla({ hours: SLA_H })}</p>

        <section class="mt-6 grid gap-3 sm:grid-cols-2">
          {queues.map((q) => (
            <a href={q.href} class="slab-cut border border-border bg-card p-4 transition-colors hover:border-foreground/40">
              <p class="eyebrow text-2xs text-muted-foreground">{q.label}</p>
              <p class="mt-2 font-condensed text-4xl font-bold leading-none">{q.depth}</p>
              <p class:list={['mt-2 text-xs', breach(q.oldest) ? 'font-semibold text-brand' : 'text-muted-foreground']}>
                {m.adm_overview_oldest({ age: ago(q.oldest) })}{breach(q.oldest) ? ` · ${m.adm_sla_breached()}` : ''}
              </p>
            </a>
          ))}
        </section>

        <section class="mt-4 grid gap-3 sm:grid-cols-4">
          {counters.map((c) => (
            <div class="border border-border p-4">
              <p class="eyebrow text-2xs text-muted-foreground">{c.label}</p>
              <p class="mt-2 font-condensed text-3xl font-bold leading-none">{c.value}</p>
            </div>
          ))}
        </section>

        {stats && (
          <section class="mt-8">
            <h2 class="font-condensed text-sm font-bold uppercase tracking-wide text-muted-foreground">{m.adm_overview_platform()}</h2>
            <div class="mt-3 grid gap-3 sm:grid-cols-3 lg:grid-cols-6">
              {[
                { label: m.adm_nav_profiles(), value: stats.advertisers },
                { label: m.adm_nav_clients(), value: stats.clients },
                { label: m.verified(), value: `${stats.verifiedPct}%` },
                { label: m.online_now(), value: stats.onlineNow },
                { label: m.adm_stat_avg_complete(), value: `${stats.avgCompleteness}%` },
                { label: m.nav_photos(), value: stats.totalPhotos },
              ].map((s) => (
                <div class="border border-border p-3">
                  <p class="eyebrow text-2xs text-muted-foreground">{s.label}</p>
                  <p class="mt-1.5 font-condensed text-2xl font-bold leading-none">{s.value}</p>
                </div>
              ))}
            </div>

            <div class="mt-4 grid gap-6 sm:grid-cols-2">
              <div>
                <p class="text-2xs uppercase tracking-wide text-muted-foreground">{m.adm_overview_by_state()}</p>
                <div class="mt-2 space-y-1.5">
                  {stats.profilesByState.map((s) => (
                    <div class="flex items-center gap-2 text-sm">
                      <span class="w-24 flex-none text-muted-foreground">{s.state}</span>
                      <span class="relative h-3 flex-1 overflow-hidden bg-muted"><span class:list={['absolute inset-y-0 left-0', stateColor(s.state)]} style={`width:${Math.min(100, (s.count / stats.advertisers) * 100)}%`} /></span>
                      <span class="w-6 flex-none text-right tabular-nums text-muted-foreground">{s.count}</span>
                    </div>
                  ))}
                </div>
              </div>
              <div>
                <p class="text-2xs uppercase tracking-wide text-muted-foreground">{m.adm_overview_by_gender()}</p>
                <div class="mt-2 space-y-1.5">
                  {stats.byGender.map((s) => (
                    <div class="flex items-center gap-2 text-sm">
                      <span class="w-24 flex-none text-muted-foreground">{s.gender}</span>
                      <span class="relative h-3 flex-1 overflow-hidden bg-muted"><span class="absolute inset-y-0 left-0 bg-foreground" style={`width:${Math.min(100, (s.count / stats.advertisers) * 100)}%`} /></span>
                      <span class="w-6 flex-none text-right tabular-nums text-muted-foreground">{s.count}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </section>
        )}

        <section class="mt-8">
          <h2 class="font-condensed text-sm font-bold uppercase tracking-wide text-muted-foreground">{m.adm_overview_supply()}</h2>
          <div class="mt-3 max-w-2xl space-y-2">
            {ov.supply.map((s) => (
              <div class="flex items-center gap-3 text-sm">
                <span class="w-28 flex-none truncate">{s.city}</span>
                <span class="relative h-4 flex-1 overflow-hidden bg-muted">
                  <span class="absolute inset-y-0 left-0 bg-foreground" style={`width:${Math.min(100, (s.live / s.target) * 100)}%`} />
                </span>
                <span class="w-14 flex-none text-right tabular-nums text-muted-foreground">{s.live}/{s.target}</span>
              </div>
            ))}
          </div>
        </section>

        {blocked.length > 0 && (
          <section class="mt-8">
            <div class="flex items-center justify-between">
              <h2 class="font-condensed text-sm font-bold uppercase tracking-wide text-brand">{m.adm_blocked_title()} ({blocked.length})</h2>
              <a href="/admin/profiles?state=blocked" class="text-2xs font-medium text-muted-foreground hover:text-foreground">{m.adm_nav_profiles()} →</a>
            </div>
            <ul class="mt-3 max-w-2xl divide-y divide-border border border-border">
              {blocked.map((p) => (
                <li class="flex items-center gap-3 px-3 py-2 text-sm">
                  <a href={`/admin/profiles?id=${p.id}`} class="min-w-0 flex-1 truncate font-medium underline-offset-4 hover:underline">{p.name}</a>
                  <span class="flex-none text-2xs text-muted-foreground">
                    {p.stateReason && `${p.stateReason} · `}{p.stateChangedAt && agoShort(p.stateChangedAt)}
                  </span>
                  <button type="button" data-unblock={p.id} class="slab-cut flex-none cursor-pointer border border-foreground/20 px-2.5 py-1 text-2xs font-bold uppercase transition-colors hover:border-foreground/60">{m.msg_unblock()}</button>
                </li>
              ))}
            </ul>
          </section>
        )}

        <section class="mt-8">
          <div class="flex items-center justify-between">
            <h2 class="font-condensed text-sm font-bold uppercase tracking-wide text-muted-foreground">{m.adm_overview_activity()}</h2>
            <a href="/admin/audit" class="text-2xs font-medium text-muted-foreground hover:text-foreground">{m.adm_nav_audit()} →</a>
          </div>
          {activity.length === 0 ? (
            <p class="mt-3 text-sm text-muted-foreground">{m.adm_overview_no_activity()}</p>
          ) : (
            <ul class="mt-3 max-w-2xl divide-y divide-border border border-border">
              {activity.map((e) => (
                <li class="flex items-center gap-3 px-3 py-2 text-sm">
                  <span class="w-8 flex-none tabular-nums text-2xs text-muted-foreground">{agoShort(e.at)}</span>
                  <span class="min-w-0 flex-1 truncate">
                    <span class="font-medium">{e.adminEmail.split('@')[0]}</span>
                    <span class="text-muted-foreground"> · {humanizeA(e.action)}</span>
                    <span class="text-muted-foreground"> · {e.entityType}:{e.entityId.split('@')[0]}</span>
                  </span>
                  {e.reason && <span class="flex-none text-2xs text-muted-foreground">{humanizeA(e.reason)}</span>}
                </li>
              ))}
            </ul>
          )}
        </section>
      </>
    )
  }
</AdminShell>
)}

<script>
  import { actions } from 'astro:actions';

  // Unblock from the cockpit — optimistic row removal (Hyperdrive reads lag
  // writes, so never reload after a write; the section drops when emptied).
  function initUnblock() {
    document.querySelectorAll<HTMLButtonElement>('[data-unblock]').forEach((btn) => {
      if (btn.dataset.init) return;
      btn.dataset.init = '1';
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        const { error } = await actions.admin.profileState({ id: btn.dataset.unblock!, action: 'unblock' });
        if (error) {
          btn.disabled = false;
          alert(`Unblock failed: ${error.message}`);
          return;
        }
        const section = btn.closest('section');
        btn.closest('li')?.remove();
        if (!section?.querySelector('[data-unblock]')) section?.remove();
      });
    });
  }
  initUnblock();
  document.addEventListener('astro:page-load', initUnblock);
</script>
