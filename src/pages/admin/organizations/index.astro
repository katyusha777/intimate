---
/**
 * Organizations / partner agencies (docs/ADMIN.md §8): CRUD + logo + roster +
 * the auto-crawl panel (test discovery → test one URL → crawl now → job queue).
 * Master-detail via ?id=. Agencies have no login; profiles are created for them
 * by the crawl pipeline (src/lib/crawl.ts) into the moderation queue.
 */
import { getAdmin } from '@/actions/admin/lib';
import { listOrgs, orgById } from '@/actions/admin/orgs';
import { cityName } from '@/lib/seo';
import { CITIES } from '@/lib/taxonomy';
import AdminShell from '@/components/organisms/admin/AdminShell.astro';
import NewProfileForm from '@/components/organisms/admin/NewProfileForm.astro';
import * as m from '@/paraglide/messages';

const session = await getAdmin(Astro);
const orgs = session ? await listOrgs() : [];
const id = Astro.url.searchParams.get('id');
const detail = session && id ? await orgById(id) : null;
const stateClass = (s: string) =>
  ({ live: 'text-online', pending_review: 'text-amber-500', paused: 'text-muted-foreground', blocked: 'text-brand', confirmed: 'text-online', failed: 'text-brand', queued: 'text-amber-500' })[s] ?? 'text-muted-foreground';

const input = 'slab-cut w-full border border-foreground/20 bg-background px-3 py-2 text-sm outline-none focus:border-foreground';
const btn = 'slab-cut border border-foreground/20 px-4 py-2 text-sm font-semibold hover:border-foreground/60 disabled:opacity-50';
const label = 'block text-2xs uppercase tracking-wide text-muted-foreground';
---

<AdminShell title={m.adm_orgs_title()} section="organizations">
  {
    session && (
      <div>
        <h1 class="display text-3xl">{m.adm_orgs_title()}</h1>
        <p class="mt-1 text-sm text-muted-foreground">{m.adm_orgs_meta({ count: orgs.length })}</p>

        <details class="mt-4 max-w-xl border border-border">
          <summary class="cursor-pointer px-3 py-2 text-sm font-semibold">+ New agency</summary>
          <form data-org-create class="space-y-3 border-t border-border p-3">
            <div class="grid gap-3 sm:grid-cols-2">
              <div><span class={label}>Name *</span><input name="name" required minlength="2" class={input} /></div>
              <div>
                <span class={label}>City *</span>
                <select name="city" class={input}>{CITIES.map((c) => <option value={c.slug}>{c.name}</option>)}</select>
              </div>
              <div><span class={label}>Website</span><input name="siteUrl" type="url" placeholder="https://…" class={input} /></div>
              <div><span class={label}>Crawl URL (roster page)</span><input name="crawlListUrl" type="url" placeholder="https://…/dames" class={input} /></div>
              <div><span class={label}>Contact email</span><input name="contactEmail" type="email" class={input} /></div>
              <div><span class={label}>Contact phone</span><input name="contactPhone" class={input} /></div>
              <div><span class={label}>KvK</span><input name="kvk" class={input} /></div>
            </div>
            <button type="submit" class={btn}>Create agency</button>
            <span data-create-status class="text-2xs text-muted-foreground" />
          </form>
        </details>

        <div class="mt-6 grid gap-6 lg:grid-cols-[22rem_1fr]">
          <ul class="divide-y divide-border border border-border">
            {orgs.map((o) => (
              <li>
                <a href={`/admin/organizations?id=${o.id}`} class:list={['flex items-center justify-between gap-3 px-3 py-2.5 text-sm transition-colors hover:bg-muted', o.id === id && 'bg-muted']}>
                  <span class="min-w-0">
                    <span class="flex items-center gap-1.5 font-medium">
                      {o.name}
                      {o.verified && <svg class="size-3 flex-none text-online" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"/><path d="M9 12l2 2 4-4"/></svg>}
                      {o.crawlEnabled && <span class="text-2xs text-muted-foreground" title="auto-crawl on">⟳</span>}
                    </span>
                    <span class="block text-2xs text-muted-foreground">{cityName(o.city)} · {m.adm_orgs_members_count({ count: o.memberCount })}</span>
                  </span>
                  <span class="flex-none text-2xs text-muted-foreground">{m.adm_orgs_live_count({ count: o.liveCount })}</span>
                </a>
              </li>
            ))}
          </ul>

          {!detail ? (
            <div class="grid place-items-center border border-dashed border-border py-24 text-sm text-muted-foreground">{m.adm_orgs_select()}</div>
          ) : (
            <div class="min-w-0 space-y-6">
              <div class="flex items-start justify-between gap-4">
                <div class="flex items-center gap-3">
                  {detail.logoKey && <img src={`/media/${detail.logoKey}?v=thumb`} alt="" width="48" height="48" class="size-12 border border-border object-cover" />}
                  <div>
                    <p class="font-condensed text-xl font-bold">{detail.name}</p>
                    <p class="text-sm text-muted-foreground">
                      {detail.kvk ? `KvK ${detail.kvk} · ` : ''}{cityName(detail.city)} ·{' '}
                      <span class:list={detail.verified ? 'text-online' : 'text-brand'}>{detail.verified ? m.verified() : m.adm_unverified()}</span>
                      {' · '}
                      <a href={`/nl/agencies/${detail.slug}/`} target="_blank" class="underline underline-offset-2">/agencies/{detail.slug}</a>
                    </p>
                  </div>
                </div>
                <label class={`${btn} cursor-pointer`}>
                  Logo…
                  <input data-logo data-org={detail.id} type="file" accept="image/*" class="hidden" />
                </label>
              </div>

              <dl class="grid max-w-md grid-cols-3 gap-px overflow-hidden border border-border bg-border text-xs">
                {[[m.adm_orgs_members(), String(detail.members.length)], [m.state_live(), String(detail.liveCount)], [m.adm_stat_avg_complete(), `${detail.avgCompleteness}%`]].map(([k, v]) => (
                  <div class="bg-card px-2.5 py-1.5"><dt class="text-2xs uppercase tracking-wide text-muted-foreground">{k}</dt><dd class="font-medium">{v}</dd></div>
                ))}
              </dl>

              {/* Tabbed detail: roster (the girls) · crawler · agency details.
                  Panels are all SSR'd; the tab bar just show/hides them (§8). */}
              <div role="tablist" aria-label="Agency sections" class="flex gap-1 border-b border-border">
                {[['roster', m.adm_orgs_roster()], ['crawler', 'Crawler'], ['details', 'Details']].map(([key, tabLabel], i) => (
                  <button
                    type="button"
                    role="tab"
                    data-tab-btn={key}
                    aria-selected={i === 0 ? 'true' : 'false'}
                    class="-mb-px border-b-2 border-transparent px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground aria-selected:border-foreground aria-selected:text-foreground"
                  >
                    {tabLabel}
                  </button>
                ))}
              </div>

              {/* Roster — the profiles this agency holds + add/assign. */}
              <div role="tabpanel" data-tab-panel="roster" class="max-w-2xl space-y-4">
                <div>
                  <div class="divide-y divide-border border border-border">
                    {detail.members.map((mmb) => (
                      <div class="flex items-center justify-between gap-3 px-3 py-2 text-sm">
                        <a href={`/admin/profiles?id=${mmb.id}`} class="flex min-w-0 items-center gap-1.5 font-medium hover:underline">
                          {mmb.name}
                          {mmb.verified && <span class="text-online">✓</span>}
                        </a>
                        <span class="flex flex-none items-center gap-3 text-2xs">
                          <span class="text-muted-foreground">{cityName(mmb.city)}</span>
                          <span class="tabular-nums text-muted-foreground">{mmb.completeness}%</span>
                          <span class:list={['font-medium', stateClass(mmb.state)]}>{mmb.state}</span>
                          <button type="button" data-unassign data-profile={mmb.id} class="text-muted-foreground underline underline-offset-2 hover:text-brand">unassign</button>
                        </span>
                      </div>
                    ))}
                    {detail.members.length === 0 && <p class="px-3 py-2 text-sm text-muted-foreground">No profiles yet — create one below, run a crawl, or assign an existing profile.</p>}
                  </div>
                </div>

                {session.adminRole === 'super' && <NewProfileForm orgId={detail.id} defaultCity={detail.city} />}

                <div class="flex flex-wrap items-center gap-3">
                  <input data-assign-id placeholder="assign existing profile UUID" class={`${input} max-w-xs`} />
                  <button type="button" data-assign data-org={detail.id} class={btn}>Assign profile</button>
                  <span data-assign-status class="text-2xs text-muted-foreground" />
                </div>
              </div>

              {/* Crawler — discovery, test import, crawl-now + the job log. */}
              <div role="tabpanel" data-tab-panel="crawler" hidden class="max-w-2xl space-y-6">
                <div class="space-y-3 border border-border p-3">
                  {detail.lastCrawledAt && (
                    <p class="text-2xs text-muted-foreground">Last crawl {detail.lastCrawledAt.slice(0, 16).replace('T', ' ')} — {detail.lastCrawlNote ?? ''}</p>
                  )}
                  <p class="text-2xs text-muted-foreground">Set the crawl URL + auto-crawl in the <b>Details</b> tab, then discover/import here.</p>
                  <div class="flex flex-wrap items-center gap-3">
                    <button type="button" data-discover data-org={detail.id} class={btn}>Test discovery</button>
                    <button type="button" data-crawl data-org={detail.id} class={btn}>Crawl now</button>
                    <span data-crawl-status class="text-2xs text-muted-foreground" />
                  </div>
                  <div data-discover-out class="hidden space-y-1 text-xs" />
                  <div class="flex flex-wrap items-center gap-3">
                    <input data-test-url type="url" placeholder="test one profile URL…" class={`${input} max-w-md`} />
                    <button type="button" data-test-import class={btn}>Test import</button>
                    <button type="button" data-import-create data-org={detail.id} class={btn}>Import &amp; create profile</button>
                    <span data-test-status class="text-2xs text-muted-foreground" />
                  </div>
                  <div data-test-photos class="hidden flex-wrap gap-2" />
                  <pre data-test-out class="hidden max-h-96 overflow-auto border border-border bg-muted p-3 text-xs" />
                </div>

                {detail.jobs.length > 0 && (
                  <div>
                    <p class="text-2xs uppercase tracking-wide text-muted-foreground">Import jobs</p>
                    <div class="mt-2 divide-y divide-border border border-border text-xs">
                      {detail.jobs.map((j) => (
                        <div class="flex items-center justify-between gap-3 px-3 py-1.5">
                          <span class="min-w-0 truncate">
                            <span class="font-medium">{j.profileName ?? new URL(j.sourceUrl).pathname}</span>
                            {j.error && <span class="text-brand"> — {j.error}</span>}
                          </span>
                          <span class="flex flex-none items-center gap-3">
                            <span class="text-muted-foreground">{j.createdAt.slice(5, 16).replace('T', ' ')}</span>
                            <span class:list={['font-medium', stateClass(j.state)]}>{j.state}</span>
                          </span>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>

              {/* Details — the agency record itself. */}
              <div role="tabpanel" data-tab-panel="details" hidden>
                <form data-org-edit data-org={detail.id} class="max-w-2xl space-y-3 border border-border p-3">
                  <p class="text-2xs uppercase tracking-wide text-muted-foreground">Agency details</p>
                  <div class="grid gap-3 sm:grid-cols-2">
                    <div><span class={label}>Name</span><input name="name" value={detail.name} class={input} /></div>
                    <div>
                      <span class={label}>City</span>
                      <select name="city" class={input}>{CITIES.map((c) => <option value={c.slug} selected={c.slug === detail.city}>{c.name}</option>)}</select>
                    </div>
                    <div><span class={label}>Website</span><input name="siteUrl" type="url" value={detail.siteUrl ?? ''} class={input} /></div>
                    <div><span class={label}>KvK</span><input name="kvk" value={detail.kvk ?? ''} class={input} /></div>
                    <div><span class={label}>Contact email</span><input name="contactEmail" type="email" value={detail.contactEmail ?? ''} class={input} /></div>
                    <div><span class={label}>Contact phone</span><input name="contactPhone" value={detail.contactPhone ?? ''} class={input} /></div>
                  </div>
                  <div><span class={label}>Description (shown on the public page)</span><textarea name="description" rows="3" class={input}>{detail.description}</textarea></div>
                  <div class="flex flex-wrap items-center gap-4 text-sm">
                    <label class="flex items-center gap-2"><input type="checkbox" name="verified" checked={detail.verified} /> Verified</label>
                    <label class="flex items-center gap-2"><input type="checkbox" name="crawlEnabled" checked={detail.crawlEnabled} /> Auto-crawl daily</label>
                  </div>
                  <div><span class={label}>Crawl URL (roster/homepage)</span><input name="crawlListUrl" type="url" value={detail.crawlListUrl ?? ''} class={input} /></div>
                  <div class="flex items-center gap-3">
                    <button type="submit" class={btn}>Save</button>
                    <span data-edit-status class="text-2xs text-muted-foreground" />
                  </div>
                </form>
              </div>
            </div>
          )}
        </div>
      </div>
    )
  }
</AdminShell>

<script>
  import { actions } from 'astro:actions';
  import { reencode } from '@/lib/reencode';

  function val(form: HTMLFormElement, name: string): string {
    return (form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement)?.value.trim() ?? '';
  }
  function checked(form: HTMLFormElement, name: string): boolean {
    return (form.elements.namedItem(name) as HTMLInputElement)?.checked ?? false;
  }

  function init() {
    const root = document.querySelector<HTMLElement>('[data-org-create]')?.closest('body') ?? document.body;
    if ((root as HTMLElement).dataset.orgsInit) return;
    (root as HTMLElement).dataset.orgsInit = '1';

    // Detail tabs (roster / crawler / details) — panels are SSR'd, just toggle.
    const tabBtns = document.querySelectorAll<HTMLButtonElement>('[data-tab-btn]');
    tabBtns.forEach((tb) =>
      tb.addEventListener('click', () => {
        const key = tb.dataset.tabBtn;
        tabBtns.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tabBtn === key)));
        document.querySelectorAll<HTMLElement>('[data-tab-panel]').forEach((p) => {
          p.hidden = p.dataset.tabPanel !== key;
        });
      }),
    );

    // Create
    document.querySelector<HTMLFormElement>('[data-org-create]')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.currentTarget as HTMLFormElement;
      const status = document.querySelector<HTMLElement>('[data-create-status]')!;
      status.textContent = 'Creating…';
      const { data, error } = await actions.admin.orgCreate({
        name: val(form, 'name'),
        city: val(form, 'city') as never,
        siteUrl: val(form, 'siteUrl') || undefined,
        crawlListUrl: val(form, 'crawlListUrl') || undefined,
        contactEmail: val(form, 'contactEmail') || undefined,
        contactPhone: val(form, 'contactPhone') || undefined,
        kvk: val(form, 'kvk') || undefined,
      });
      if (error) status.textContent = `Error: ${error.message}`;
      else location.href = `/admin/organizations?id=${data.id}`;
    });

    // Edit
    document.querySelector<HTMLFormElement>('[data-org-edit]')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.currentTarget as HTMLFormElement;
      const status = document.querySelector<HTMLElement>('[data-edit-status]')!;
      status.textContent = 'Saving…';
      const { error } = await actions.admin.orgUpdate({
        id: form.dataset.org!,
        name: val(form, 'name'),
        city: val(form, 'city') as never,
        siteUrl: val(form, 'siteUrl'),
        kvk: val(form, 'kvk'),
        contactEmail: val(form, 'contactEmail'),
        contactPhone: val(form, 'contactPhone'),
        description: val(form, 'description'),
        verified: checked(form, 'verified'),
        crawlEnabled: checked(form, 'crawlEnabled'),
        crawlListUrl: val(form, 'crawlListUrl'),
      });
      status.textContent = error ? `Error: ${error.message}` : 'Saved ✓';
    });

    // Logo upload (canvas re-encode strips EXIF client-side, hard rule 2)
    document.querySelector<HTMLInputElement>('[data-logo]')?.addEventListener('change', async (e) => {
      const el = e.currentTarget as HTMLInputElement;
      const file = el.files?.[0];
      if (!file) return;
      const dataUrl = await reencode(file, 512, 0.85);
      const { error } = await actions.admin.orgSetLogo({ id: el.dataset.org!, dataUrl });
      if (error) alert(`Logo error: ${error.message}`);
      else location.reload();
    });

    // Test discovery
    document.querySelector<HTMLButtonElement>('[data-discover]')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const form = document.querySelector<HTMLFormElement>('[data-org-edit]')!;
      const url = val(form, 'crawlListUrl');
      const status = document.querySelector<HTMLElement>('[data-crawl-status]')!;
      const out = document.querySelector<HTMLElement>('[data-discover-out]')!;
      if (!url) { status.textContent = 'Set a crawl URL first (and Save).'; return; }
      btn.disabled = true;
      status.textContent = 'Discovering… (~30s)';
      const { data, error } = await actions.admin.orgDiscoverPreview({ url });
      btn.disabled = false;
      if (error) { status.textContent = `Error: ${error.message}`; return; }
      status.textContent = `${data.urls.length} profile URL(s) across ${data.pages} page(s) · $${data.cost.toFixed(4)}`;
      out.classList.remove('hidden');
      out.innerHTML = data.urls.map((u: string) => `<div class="truncate"><button type="button" data-pick-url="${u}" class="underline underline-offset-2">test</button> ${u}</div>`).join('');
      out.querySelectorAll<HTMLButtonElement>('[data-pick-url]').forEach((b) =>
        b.addEventListener('click', () => {
          document.querySelector<HTMLInputElement>('[data-test-url]')!.value = b.dataset.pickUrl!;
          document.querySelector<HTMLButtonElement>('[data-test-import]')!.click();
        }),
      );
    });

    // Test one profile URL — dry run, shows the photos it WOULD import.
    document.querySelector<HTMLButtonElement>('[data-test-import]')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const url = document.querySelector<HTMLInputElement>('[data-test-url]')!.value.trim();
      const out = document.querySelector<HTMLPreElement>('[data-test-out]')!;
      const photos = document.querySelector<HTMLElement>('[data-test-photos]')!;
      if (!url) return;
      btn.disabled = true;
      photos.classList.add('hidden');
      out.classList.remove('hidden');
      out.textContent = 'Scraping + extracting… (~1 min)';
      const { data, error } = await actions.admin.orgImportPreview({ url });
      btn.disabled = false;
      if (error) { out.textContent = `Error: ${error.message}`; return; }
      if (data.photoUrls.length) {
        photos.classList.remove('hidden');
        photos.classList.add('flex');
        // Via /admin/imgproxy — agency sites send CORP: same-origin, so
        // hotlinking is browser-blocked; the proxy fetches server-side.
        photos.innerHTML = data.photoUrls
          .map((u: string) => `<img src="/admin/imgproxy?u=${encodeURIComponent(u)}" loading="lazy" class="h-28 w-auto border border-border object-cover" />`)
          .join('');
      }
      out.textContent = JSON.stringify(
        { name: data.name, age: data.age, photoUrls: data.photoUrls, warnings: data.warnings, fields: data.fields, cost: data.cost, raw: data.raw },
        null,
        2,
      );
    });

    // Import & create — the REAL pipeline for one URL; lands in moderation.
    document.querySelector<HTMLButtonElement>('[data-import-create]')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const url = document.querySelector<HTMLInputElement>('[data-test-url]')!.value.trim();
      const status = document.querySelector<HTMLElement>('[data-test-status]')!;
      if (!url) { status.textContent = 'Enter a profile URL first.'; return; }
      if (!confirm('Import this URL and create/update the profile (photos included)?')) return;
      btn.disabled = true;
      status.textContent = 'Importing… (~1 min)';
      const { data, error } = await actions.admin.orgImportCreate({ id: btn.dataset.org!, url });
      btn.disabled = false;
      if (error) { status.textContent = `Error: ${error.message}`; return; }
      // textContent + a DOM-built anchor — `name` is LLM-extracted from a
      // scraped page and MUST stay data, never markup (hard rule 7).
      status.textContent = `${data.created ? 'Created' : 'Updated'} ${data.name ?? 'profile'} · ${data.photosStored}/${data.photosAttempted} photo(s) → `;
      const link = document.createElement('a');
      link.className = 'underline underline-offset-2';
      link.href = `/admin/profiles?id=${encodeURIComponent(data.profileId)}`;
      link.textContent = 'open profile';
      status.append(link);
    });

    // Crawl now → drain THIS org's queue with visible, honest progress: an
    // error or a stall keeps its message on screen (no reload over it); only a
    // fully drained queue announces success.
    document.querySelector<HTMLButtonElement>('[data-crawl]')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const orgId = btn.dataset.org!;
      const status = document.querySelector<HTMLElement>('[data-crawl-status]')!;
      if (!confirm('Discover the roster and import every profile? New profiles land in the moderation queue.')) return;
      btn.disabled = true;
      status.textContent = 'Discovering…';
      const { data, error } = await actions.admin.orgCrawl({ id: orgId });
      if (error) { status.textContent = `Error: ${error.message}`; btn.disabled = false; return; }
      let remaining = data.queuedNew + data.queuedUpdates;
      status.textContent = `Discovered ${data.discovered} — importing ${remaining}…`;
      let done = 0;
      let failed = 0;
      while (remaining > 0) {
        const r = await actions.admin.orgProcessJobs({ orgId });
        if (r.error) { status.textContent = `Error: ${r.error.message} — ${remaining} job(s) still queued (the cron keeps draining them)`; btn.disabled = false; return; }
        done += r.data.processed + r.data.failed;
        failed += r.data.failed;
        remaining = r.data.remaining;
        status.textContent = `Importing… ${done} done${failed ? ` (${failed} failed)` : ''}, ${remaining} left`;
        if (r.data.processed + r.data.failed === 0 && remaining > 0) {
          // Claim races resolve themselves (the engine retries the next row);
          // reaching here means the queue genuinely isn't moving from this tab.
          status.textContent = `Stopped with ${remaining} queued — the 5-min cron continues in the background; refresh to see progress.`;
          btn.disabled = false;
          return;
        }
      }
      status.textContent = failed ? `Crawl finished — ${done - failed} imported, ${failed} failed (see the job list)` : 'Crawl complete ✓';
      setTimeout(() => location.reload(), failed ? 2500 : 800);
    });

    // Roster assign/unassign
    document.querySelectorAll<HTMLButtonElement>('[data-unassign]').forEach((b) =>
      b.addEventListener('click', async () => {
        if (!confirm('Remove this profile from the agency?')) return;
        const { error } = await actions.admin.orgAssignProfile({ profileId: b.dataset.profile!, orgId: null });
        if (error) alert(error.message);
        else location.reload();
      }),
    );
    document.querySelector<HTMLButtonElement>('[data-assign]')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const idEl = document.querySelector<HTMLInputElement>('[data-assign-id]')!;
      const status = document.querySelector<HTMLElement>('[data-assign-status]')!;
      const profileId = idEl.value.trim();
      if (!profileId) return;
      const { error } = await actions.admin.orgAssignProfile({ profileId, orgId: btn.dataset.org! });
      if (error) status.textContent = `Error: ${error.message}`;
      else location.reload();
    });
  }
  init();
  document.addEventListener('astro:page-load', init);
</script>
