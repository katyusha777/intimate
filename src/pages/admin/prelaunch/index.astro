---
/**
 * Pre-signups (docs/ADMIN.md) — every pre-launch inbound in one list: the
 * landing leads (`prelaunch_leads`) AND the /agencies consent signups (`orgs`
 * with a consent stamp). The closer sees who registered, how to reach them, and
 * can fix a typo or delete a junk/test row (super-only, audit-logged actions).
 * English-only (temporary, internal, retires at launch — like Danger zone).
 */
import { getAdmin } from '@/actions/admin/lib';
import { listPrelaunchLeads } from '@/app/api/prelaunch';
import { listAgencyConsents } from '@/app/api/orgs';
import AdminShell from '@/components/organisms/admin/AdminShell.astro';

const session = await getAdmin(Astro);

// One chronological list of every pre-launch inbound: landing leads AND the
// /agencies consent-form signups (they also live under Agencies, but the closer
// wants them here too). Agency rows carry their site; leads carry WA/TG.
type Row = {
  id: string;
  source: 'lead' | 'agency';
  name: string;
  kind: string | null;
  email: string | null;
  phone: string | null;
  whatsapp: string | null;
  telegram: string | null;
  siteUrl: string | null;
  locale: string | null;
  at: string;
};
const [leads, agencies] = session ? await Promise.all([listPrelaunchLeads(), listAgencyConsents()]) : [[], []];
const rows: Row[] = [
  ...leads.map((l): Row => ({
    id: l.id, source: 'lead', name: l.name, kind: l.kind, email: l.email, phone: l.phone, whatsapp: l.whatsapp, telegram: l.telegram,
    siteUrl: null, locale: l.locale, at: new Date(l.createdAt).toISOString(),
  })),
  ...agencies.map((a): Row => ({
    id: a.id, source: 'agency', name: a.name, kind: 'agency', email: a.email, phone: a.phone, whatsapp: null, telegram: null,
    siteUrl: a.siteUrl, locale: a.locale, at: a.consentAt,
  })),
].sort((x, y) => (x.at < y.at ? 1 : -1));

const fmt = new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short' });
const waLink = (n: string) => `https://wa.me/${n.replace(/[^\d]/g, '')}`;
const tgLink = (n: string) => `https://t.me/${n.replace(/^@/, '')}`;
---

<AdminShell title="Pre-signups" section="prelaunch" wide>
  {
    session && (
      <div>
        <h1 class="display text-3xl">Pre-signups</h1>
        <p class="mt-1 text-sm text-muted-foreground">{rows.length} pre-launch {rows.length === 1 ? 'signup' : 'signups'} · landing leads + agency consents · newest first</p>

        <div class="mt-5 overflow-x-auto border border-border">
          <table class="w-full min-w-[720px] text-left text-sm">
            <thead class="border-b border-border bg-muted text-2xs uppercase tracking-wide text-muted-foreground">
              <tr>
                <th class="px-3 py-2 font-semibold">Name</th>
                <th class="px-3 py-2 font-semibold">Type</th>
                <th class="px-3 py-2 font-semibold">Email</th>
                <th class="px-3 py-2 font-semibold">Contacts</th>
                <th class="px-3 py-2 font-semibold">Locale</th>
                <th class="px-3 py-2 font-semibold">Registered</th>
                <th class="px-3 py-2 font-semibold text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              {rows.length === 0 ? (
                <tr><td colspan="7" class="px-3 py-10 text-center text-muted-foreground">No pre-signups yet.</td></tr>
              ) : (
                rows.map((l) => (
                  <tr class="align-top transition-colors hover:bg-muted">
                    <td class="px-3 py-2 font-medium">{l.name}</td>
                    <td class="px-3 py-2">
                      {l.kind ? (
                        <span class="inline-block border border-border px-1.5 py-0.5 text-2xs uppercase tracking-wide text-muted-foreground">{l.kind}</span>
                      ) : (
                        <span class="text-muted-foreground">—</span>
                      )}
                    </td>
                    <td class="px-3 py-2">
                      {l.email ? (
                        <a href={`mailto:${l.email}`} class="text-brand hover:underline">{l.email}</a>
                      ) : (
                        <span class="text-muted-foreground">—</span>
                      )}
                    </td>
                    <td class="px-3 py-2 text-xs">
                      {l.phone || l.whatsapp || l.telegram || l.siteUrl ? (
                        <div class="space-y-0.5">
                          {l.siteUrl && <div><a href={l.siteUrl} target="_blank" rel="noopener" class="text-brand hover:underline">{l.siteUrl.replace(/^https?:\/\//, '')}</a></div>}
                          {l.phone && <div><a href={`tel:${l.phone}`} class="hover:underline">{l.phone}</a></div>}
                          {l.whatsapp && <div>WA <a href={waLink(l.whatsapp)} target="_blank" rel="noopener" class="text-brand hover:underline">{l.whatsapp}</a></div>}
                          {l.telegram && <div>TG <a href={tgLink(l.telegram)} target="_blank" rel="noopener" class="text-brand hover:underline">{l.telegram}</a></div>}
                        </div>
                      ) : (
                        <span class="text-muted-foreground">—</span>
                      )}
                    </td>
                    <td class="px-3 py-2 uppercase text-muted-foreground">{l.locale}</td>
                    <td class="px-3 py-2 whitespace-nowrap text-xs text-muted-foreground">{fmt.format(new Date(l.at))}</td>
                    <td class="px-3 py-2 whitespace-nowrap text-right text-xs">
                      <button
                        type="button"
                        data-ps-edit
                        data-id={l.id}
                        data-source={l.source}
                        data-name={l.name}
                        data-email={l.email ?? ''}
                        data-phone={l.phone ?? ''}
                        data-site={l.siteUrl ?? ''}
                        class="font-medium text-muted-foreground hover:text-foreground hover:underline"
                      >
                        Edit
                      </button>
                      <button
                        type="button"
                        data-ps-del
                        data-id={l.id}
                        data-source={l.source}
                        data-name={l.name}
                        class="ml-3 font-medium text-destructive hover:underline"
                      >
                        Delete
                      </button>
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>

        <dialog data-ps-dialog class="w-full max-w-md border border-border bg-card p-6 text-card-foreground backdrop:bg-black/60">
          <h2 class="display text-xl">Edit signup</h2>
          <form data-ps-form class="mt-4 space-y-3">
            <input type="hidden" name="id" />
            <input type="hidden" name="source" />
            <label class="block space-y-1">
              <span class="text-xs font-medium text-muted-foreground">Name</span>
              <input name="name" required class="w-full border border-border bg-background px-3 py-2 text-sm outline-none focus:border-brand" />
            </label>
            <label class="block space-y-1">
              <span class="text-xs font-medium text-muted-foreground">Email</span>
              <input name="email" type="email" class="w-full border border-border bg-background px-3 py-2 text-sm outline-none focus:border-brand" />
            </label>
            <label class="block space-y-1">
              <span class="text-xs font-medium text-muted-foreground">Phone</span>
              <input name="phone" class="w-full border border-border bg-background px-3 py-2 text-sm outline-none focus:border-brand" />
            </label>
            <label data-ps-site-field class="block space-y-1" hidden>
              <span class="text-xs font-medium text-muted-foreground">Website</span>
              <input name="siteUrl" class="w-full border border-border bg-background px-3 py-2 text-sm outline-none focus:border-brand" />
            </label>
            <p data-ps-err class="hidden text-sm font-medium text-destructive"></p>
            <div class="flex justify-end gap-2 pt-2">
              <button type="button" data-ps-cancel class="border border-border px-4 py-2 text-sm font-medium hover:bg-muted">Cancel</button>
              <button type="submit" class="border border-foreground bg-foreground px-4 py-2 text-sm font-medium text-background">Save</button>
            </div>
          </form>
        </dialog>
      </div>
    )
  }
</AdminShell>

<script>
  import { actions } from 'astro:actions';

  // Pre-signups edit/delete. Reload after a change — a raw admin list, no need
  // for in-place DOM surgery. Server actions are super-gated + audit-logged.
  function initPresignupCrud() {
    const dialog = document.querySelector<HTMLDialogElement>('[data-ps-dialog]');
    const form = document.querySelector<HTMLFormElement>('[data-ps-form]');
    if (!dialog || !form || dialog.dataset.init) return;
    dialog.dataset.init = '1';
    const err = dialog.querySelector<HTMLElement>('[data-ps-err]');
    const field = (n: string) => form.querySelector<HTMLInputElement>(`[name="${n}"]`)!;

    document.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      const del = target.closest<HTMLButtonElement>('[data-ps-del]');
      if (del) {
        if (!confirm(`Delete "${del.dataset.name}"? This can't be undone.`)) return;
        del.disabled = true;
        const { error } = await actions.admin.presignupDelete({ source: del.dataset.source as 'lead' | 'agency', id: del.dataset.id! });
        if (error) {
          alert('Delete failed: ' + error.message);
          del.disabled = false;
          return;
        }
        location.reload();
        return;
      }
      const edit = target.closest<HTMLElement>('[data-ps-edit]');
      if (edit) {
        field('id').value = edit.dataset.id!;
        field('source').value = edit.dataset.source!;
        field('name').value = edit.dataset.name || '';
        field('email').value = edit.dataset.email || '';
        field('phone').value = edit.dataset.phone || '';
        const isAgency = edit.dataset.source === 'agency';
        dialog.querySelector<HTMLElement>('[data-ps-site-field]')!.hidden = !isAgency;
        field('siteUrl').value = edit.dataset.site || '';
        err?.classList.add('hidden');
        dialog.showModal();
        return;
      }
      if (target.closest('[data-ps-cancel]')) dialog.close();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err?.classList.add('hidden');
      const source = field('source').value as 'lead' | 'agency';
      const { error } = await actions.admin.presignupUpdate({
        source,
        id: field('id').value,
        name: field('name').value.trim(),
        email: field('email').value.trim(),
        phone: field('phone').value.trim(),
        siteUrl: source === 'agency' ? field('siteUrl').value.trim() : undefined,
      });
      if (error) {
        if (err) {
          err.textContent = 'Save failed: ' + error.message;
          err.classList.remove('hidden');
        }
        return;
      }
      dialog.close();
      location.reload();
    });
  }
  initPresignupCrud();
  document.addEventListener('astro:page-load', initPresignupCrud);
</script>
