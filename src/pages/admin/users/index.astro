---
/**
 * Users lookup + relations panel (docs/ADMIN.md §8). Search by email; detail
 * resolves the tangle in one view: account → profile, verification, reports
 * made/received, favorites. Status actions (warn/suspend/block) ride on
 * platform messaging (§10) — next pass; this is the read surface.
 */
import { getAdmin, isOwner } from '@/actions/admin/lib';
import { accountApi } from '@/app/api/account';
import { reportsApi } from '@/app/api/reports';
import { profilesApi } from '@/app/api/profiles';

import AdminShell from '@/components/organisms/admin/AdminShell.astro';
import * as m from '@/paraglide/messages';

const session = await getAdmin(Astro);
const owner = isOwner(session);
const q = (Astro.url.searchParams.get('q') ?? '').toLowerCase().trim();
const email = Astro.url.searchParams.get('email');

const [accounts, reports, { items: profiles }] = session
  ? await Promise.all([accountApi.all(), reportsApi.list(), profilesApi.list({ limit: 60 })])
  : [[], [], { items: [] }];

const filtered = q ? accounts.filter((a) => a.email.includes(q)) : accounts;
const selected = email ? (accounts.find((a) => a.email === email) ?? null) : null;
/** Pending GDPR requests (items.md #6/#7) — surfaced before everything else. */
const gdpr = accounts.filter((a) => a.deletionRequestedAt || a.dataRequestedAt);

const localPart = (e: string) => (e.split('@')[0] ?? '').replace(/[^a-z0-9]/g, '');
const profileFor = (e: string) => profiles.find((p) => p.slug.startsWith(localPart(e)));
const selProfile = selected ? profileFor(selected.email) : null;
const madeBy = selected ? reports.filter((r) => r.reporterEmail === selected.email).length : 0;
const againstProfile = selProfile ? reports.filter((r) => r.profileSlug === selProfile.slug).length : 0;
const humanize = (s: string) => s.replace(/_/g, ' ').replace(/^./, (c) => c.toUpperCase());
// Account type (advertiser / client / admin) — the thing you most need to know
// at a glance when viewing a user; admins also carry a sub-role.
const accountType = selected
  ? selected.accountType === 'admin' && selected.adminRole
    ? `${humanize(selected.accountType)} · ${humanize(selected.adminRole)}`
    : humanize(selected.accountType)
  : '—';
const typeChip =
  selected?.accountType === 'admin'
    ? 'border-brand text-brand'
    : selected?.accountType === 'advertiser'
      ? 'border-foreground text-foreground'
      : 'border-border text-muted-foreground';
---

<AdminShell title={m.adm_users_title()} section="users">
  {
    session && (
      <div>
        <h1 class="display text-3xl">{m.adm_users_title()}</h1>

        {gdpr.length > 0 && (
          <section class="mt-4 border border-brand/40 bg-brand/5 p-4">
            <h2 class="font-condensed text-sm font-bold uppercase tracking-wide text-brand">
              {m.adm_gdpr_title()} ({gdpr.length})
            </h2>
            <ul class="mt-2 divide-y divide-border">
              {gdpr.map((a) => (
                <li class="flex flex-wrap items-center justify-between gap-3 py-2.5">
                  <span class="min-w-0">
                    <span class="block truncate text-sm font-medium">{a.email}</span>
                    <span class="block text-2xs text-muted-foreground">
                      {a.deletionRequestedAt && `${m.adm_gdpr_deletion()} · ${new Date(a.deletionRequestedAt).toLocaleDateString('nl-NL')}`}
                      {a.deletionRequestedAt && a.dataRequestedAt && ' · '}
                      {a.dataRequestedAt && `${m.adm_gdpr_data()} · ${new Date(a.dataRequestedAt).toLocaleDateString('nl-NL')}`}
                    </span>
                  </span>
                  <span class="flex flex-none gap-2">
                    {/* Export stays available for any listed account (data OR
                        deletion request) until the account is deleted (#2) —
                        re-downloadable, e.g. to grab data before a deletion. */}
                    {(a.dataRequestedAt || a.deletionRequestedAt) && (
                      <button type="button" data-gdpr-export={a.id} data-email={a.email} class="cursor-pointer border border-foreground/20 px-3 py-1.5 text-sm font-medium transition-colors hover:border-foreground/60">
                        {m.adm_gdpr_export_btn()}
                      </button>
                    )}
                    {a.deletionRequestedAt && (
                      <button type="button" data-gdpr-delete={a.id} data-confirm={m.adm_gdpr_delete_confirm()} class="cursor-pointer border border-brand/40 px-3 py-1.5 text-sm font-medium text-brand transition-colors hover:border-brand">
                        {m.adm_gdpr_delete_btn()}
                      </button>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <form method="get" class="mt-3 flex max-w-md gap-2">
          <input
            type="search"
            name="q"
            value={q}
            placeholder={m.adm_users_search_ph()}
            class="slab-cut w-full border border-foreground/20 bg-background px-3 py-2 text-sm outline-none focus:border-foreground"
          />
          <button type="submit" class="slab-cut border border-foreground/20 px-3 py-2 text-sm font-medium">{m.nav_search()}</button>
        </form>

        <div class="mt-6 grid gap-6 lg:grid-cols-[22rem_1fr]">
          <ul class="divide-y divide-border border border-border">
            {filtered.length === 0 ? (
              <li class="px-3 py-10 text-center text-sm text-muted-foreground">{m.adm_users_empty()}</li>
            ) : (
              filtered.slice(0, 40).map((a) => (
                <li>
                  <a
                    href={`/admin/users?email=${encodeURIComponent(a.email)}${q ? `&q=${q}` : ''}`}
                    class:list={['flex items-center justify-between gap-3 px-3 py-2.5 text-sm transition-colors hover:bg-muted', a.email === email && 'bg-muted']}
                  >
                    <span class="min-w-0 truncate">{a.email}</span>
                    <span class:list={['flex-none text-2xs', a.idVerification === 'approved' ? 'text-online' : 'text-muted-foreground']}>{a.idVerification}</span>
                  </a>
                </li>
              ))
            )}
          </ul>

          {!selected ? (
            <div class="grid place-items-center border border-dashed border-border py-24 text-sm text-muted-foreground">{m.adm_users_select()}</div>
          ) : (
            <div class="min-w-0 space-y-5">
              <div class="flex flex-wrap items-center gap-3">
                <span class="grid size-10 flex-none place-items-center rounded-full bg-foreground font-condensed text-base font-bold text-background">{selected.email.charAt(0).toUpperCase()}</span>
                <div class="min-w-0">
                  <p data-user-email class="break-all font-condensed text-xl font-bold">{selected.email}</p>
                  <span class:list={['mt-1 inline-block slab-cut border px-2 py-0.5 text-2xs font-bold uppercase tracking-wide', typeChip]}>{accountType}</span>
                </div>
              </div>

              <dl class="grid gap-px overflow-hidden border border-border bg-border sm:grid-cols-2">
                {[
                  [m.settings_account_type(), accountType],
                  [m.adm_users_linked_profile(), selProfile ? selProfile.name : '—'],
                  [m.adm_users_profile_state(), selProfile?.state ?? '—'],
                  [m.adm_users_id_verification(), humanize(selected.idVerification)],
                  [m.account_sms(), selected.phoneVerifiedAt ? m.verified() : '—'],
                  [m.nav_favorites(), String(selected.favorites.length)],
                  [m.adm_clients_reports_made(), String(madeBy)],
                  [m.adm_users_reports_against(), String(againstProfile)],
                  [m.adm_reject_reason(), selected.verificationReason ? humanize(selected.verificationReason) : '—'],
                ].map(([k, v]) => (
                  <div class="bg-card px-3 py-2.5">
                    <dt class="text-2xs uppercase tracking-wide text-muted-foreground">{k}</dt>
                    <dd class="mt-0.5 text-sm font-medium">{v}</dd>
                  </div>
                ))}
              </dl>

              {selProfile && (
                <a href={`/en/profile/${selProfile.slug}/`} target="_blank" class="inline-block text-sm font-medium underline underline-offset-4">{m.adm_users_open_profile()} ↗</a>
              )}

              {/* Fix a mis-registered account (client ↔ advertiser). Never shown
                  for admins — this tool can't grant or remove admin. */}
              {selected.accountType !== 'admin' && (
                <div class="border-t border-border pt-4">
                  <p class="text-2xs uppercase tracking-wide text-muted-foreground">{m.settings_account_type()}</p>
                  <div class="mt-2 flex items-center gap-3">
                    <button
                      type="button"
                      data-set-type={selected.id}
                      data-to={selected.accountType === 'client' ? 'advertiser' : 'client'}
                      class="slab-cut cursor-pointer border border-foreground/20 px-3 py-1.5 text-sm font-medium transition-colors hover:border-foreground/60"
                    >
                      {selected.accountType === 'client' ? 'Switch to advertiser' : 'Switch to client'}
                    </button>
                    <span data-set-type-done class="hidden text-2xs text-online">Changed ✓ (reload to confirm)</span>
                  </div>
                </div>
              )}

              {/* Owner-only: change the login email (setAccountEmail — auth user
                  + accounts row together, auto-confirmed, audit-logged). */}
              {owner && (
                <div class="border-t border-border pt-4">
                  <p class="text-2xs uppercase tracking-wide text-muted-foreground">Email (owner)</p>
                  <div class="mt-2 flex flex-wrap items-center gap-2">
                    <input
                      type="email"
                      data-email-input={selected.id}
                      value={selected.email}
                      class="slab-cut w-72 max-w-full border border-foreground/20 bg-background px-3 py-1.5 text-sm outline-none focus:border-foreground"
                    />
                    <button type="button" data-email-save class="slab-cut cursor-pointer border border-foreground/20 px-3 py-1.5 text-sm font-medium transition-colors hover:border-foreground/60">Save</button>
                    <span data-email-msg class="text-2xs" />
                  </div>
                  <p class="mt-1 text-2xs text-muted-foreground">Changes the login immediately (auto-confirmed, no mail sent). She signs in with the new address from now on.</p>
                </div>
              )}

              <p class="text-2xs text-muted-foreground">{m.adm_status_actions_note()}</p>
            </div>
          )}
        </div>
      </div>
    )
  }
</AdminShell>

<script>
  import { actions } from 'astro:actions';

  // GDPR fulfilment buttons (items.md #6/#7).
  // Server clears the flag, but the banner reads through Hyperdrive's query
  // cache — a reload can still show the stale row for the cache window. So drop
  // the button optimistically: remove its row once no pending action remains
  // (an account that asked for BOTH data + deletion keeps the other button).
  function settleGdpr(btn: HTMLElement) {
    btn.remove();
    const li = btn.closest('li');
    if (li && !li.querySelector('[data-gdpr-export],[data-gdpr-delete]')) li.remove();
    const section = document.querySelector('section:has([data-gdpr-export],[data-gdpr-delete])');
    if (!document.querySelector('[data-gdpr-export],[data-gdpr-delete]')) section?.remove();
  }
  function initGdpr() {
    document.querySelectorAll<HTMLElement>('[data-gdpr-export]').forEach((btn) => {
      if (btn.dataset.init) return;
      btn.dataset.init = '1';
      btn.addEventListener('click', async () => {
        const { data } = await actions.admin.gdprExport({ accountId: btn.dataset.gdprExport! });
        if (!data) return;
        // One JSON file, named for the account — the admin mails it by hand.
        const blob = new Blob([JSON.stringify(data.data, null, 2)], { type: 'application/json' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = `intimate-data-${(btn.dataset.email || 'account').replace(/[^a-z0-9.@-]/gi, '_')}.json`;
        a.click();
        URL.revokeObjectURL(a.href);
        // Keep the button (re-downloadable until the account is deleted, #2).
      });
    });
    document.querySelectorAll<HTMLElement>('[data-gdpr-delete]').forEach((btn) => {
      if (btn.dataset.init) return;
      btn.dataset.init = '1';
      btn.addEventListener('click', async () => {
        if (!confirm(btn.dataset.confirm || 'Approve deletion?')) return;
        const accountId = btn.dataset.gdprDelete!;
        const { data, error } = await actions.admin.gdprApproveDeletion({ accountId });
        if (error) {
          alert(`Deletion failed: ${error.message}`);
          return;
        }
        if (data) settleGdpr(btn);
        // Scrub + soft-delete succeeded but the auth user survived (no
        // service-role key) — the login and auth email still exist. Ops
        // warning, deliberately not localized.
        if (data && !data.authDeleted)
          alert(
            `Data scrubbed and profile soft-deleted, but the Supabase auth user was NOT removed (service-role key not configured). Delete auth user ${accountId} in the Supabase dashboard, then configure the secret.`,
          );
      });
    });
  }
  initGdpr();
  document.addEventListener('astro:page-load', initGdpr);

  // Account-type correction (client ↔ advertiser). The post-write read lags
  // Hyperdrive's cache, so confirm optimistically in place rather than reload.
  function initSetType() {
    document.querySelectorAll<HTMLButtonElement>('[data-set-type]').forEach((btn) => {
      if (btn.dataset.init) return;
      btn.dataset.init = '1';
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        const { data, error } = await actions.admin.setAccountType({
          accountId: btn.dataset.setType!,
          type: btn.dataset.to as 'client' | 'advertiser',
        });
        if (error || !data) {
          btn.disabled = false;
          return;
        }
        document.querySelector('[data-set-type-done]')?.classList.remove('hidden');
        btn.remove();
      });
    });
  }
  initSetType();
  document.addEventListener('astro:page-load', initSetType);

  // Owner-only login-email change. Optimistic in place (Hyperdrive reads lag
  // writes — a reload would also lose the selection, keyed by the OLD ?email=).
  function initSetEmail() {
    const btn = document.querySelector<HTMLButtonElement>('[data-email-save]');
    if (!btn || btn.dataset.init) return;
    btn.dataset.init = '1';
    const input = document.querySelector<HTMLInputElement>('[data-email-input]')!;
    const msg = document.querySelector<HTMLElement>('[data-email-msg]')!;
    btn.addEventListener('click', async () => {
      const email = input.value.trim();
      if (!email || !input.checkValidity()) { input.focus(); return; }
      btn.disabled = true;
      const { error } = await actions.admin.setAccountEmail({ accountId: input.dataset.emailInput!, email });
      btn.disabled = false;
      msg.textContent = error ? `Failed: ${error.message}` : 'Changed ✓';
      msg.className = error ? 'text-2xs text-brand' : 'text-2xs text-online';
      if (!error) {
        const header = document.querySelector<HTMLElement>('[data-user-email]');
        if (header) header.textContent = email;
      }
    });
  }
  initSetEmail();
  document.addEventListener('astro:page-load', initSetEmail);
</script>
