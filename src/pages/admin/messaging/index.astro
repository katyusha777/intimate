---
/**
 * Messaging oversight (docs/ADMIN.md §9). Metadata for every thread is
 * unrestricted; CONTENT is governed: opening a full thread requires the `super`
 * role + a stated reason, renders read-only, and writes `thread_viewed_by_admin`
 * to the audit log. Report-scoped access for moderators is the productionized
 * path (noted). No editing/deleting of user content here.
 */
import { getAdmin, record } from '@/actions/admin/lib';
import { messagingApi } from '@/app/api/messaging';
import AdminShell from '@/components/organisms/admin/AdminShell.astro';
import * as m from '@/paraglide/messages';

const session = await getAdmin(Astro);
const metas = session ? await messagingApi.adminListThreads() : [];

const threadId = Astro.url.searchParams.get('thread');
const reason = Astro.url.searchParams.get('reason') ?? '';
const REASONS = ['report_investigation', 'legal_request', 'safety_escalation'];
const canContent = session?.adminRole === 'super';

// Governed content read: only super + valid reason, and it is audit-logged.
let thread = null;
if (session && threadId && reason && REASONS.includes(reason) && canContent) {
  thread = await messagingApi.adminGetThread(threadId);
  if (thread) {
    await record(session, { action: 'thread_viewed_by_admin', entityType: 'thread', entityId: threadId, reason });
  }
}
const humanize = (s: string) => s.replace(/_/g, ' ').replace(/^./, (c) => c.toUpperCase());
const time = (iso: string) => iso.replace('T', ' ').slice(5, 16);
---

<AdminShell title={m.adm_nav_messaging()} section="messaging">
  {
    session && (
      <div>
        <h1 class="display text-3xl">{m.adm_nav_messaging()}</h1>
        <p class="mt-1 text-sm text-muted-foreground">{m.adm_msg_meta({ count: metas.length })}</p>

        <div class="mt-6 grid gap-6 lg:grid-cols-[1fr_24rem]">
          <div class="overflow-x-auto border border-border">
            <table class="w-full min-w-[640px] text-left text-sm">
              <thead class="border-b border-border bg-muted text-2xs uppercase tracking-wide text-muted-foreground">
                <tr>
                  <th class="px-3 py-2 font-semibold">{m.adm_th_professional()}</th>
                  <th class="px-3 py-2 font-semibold">{m.role_client()}</th>
                  <th class="px-3 py-2 font-semibold">{m.adm_th_msgs()}</th>
                  <th class="px-3 py-2 font-semibold">{m.adm_th_last()}</th>
                  <th class="px-3 py-2 font-semibold" />
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                {metas.length === 0 ? (
                  <tr><td colspan="5" class="px-3 py-10 text-center text-muted-foreground">{m.adm_msg_empty()}</td></tr>
                ) : (
                  // `t`, not `m` — a map param named `m` shadows the Paraglide
                  // messages import and turns m.adm_*() into a runtime 500.
                  metas.map((t) => (
                    <tr data-href={`/admin/messaging?thread=${t.id}`} class:list={['cursor-pointer transition-colors hover:bg-muted', t.id === threadId && 'bg-muted']}>
                      <td class="px-3 py-2 font-medium">{t.profileName}</td>
                      <td class="px-3 py-2 text-muted-foreground">{t.clientName}</td>
                      <td class="px-3 py-2 tabular-nums">{t.messageCount}{t.hasMedia && ' 📷'}</td>
                      <td class="px-3 py-2 text-2xs text-muted-foreground">{time(t.lastMessageAt)}</td>
                      <td class="px-3 py-2 text-right">
                        {canContent ? (
                          <details class="inline-block text-left">
                            <summary class="cursor-pointer text-2xs font-medium text-brand">{m.adm_msg_open()} ▾</summary>
                            <div class="absolute z-10 mt-1 border border-border bg-background p-1 shadow-soft-lg">
                              {REASONS.map((r) => (
                                <a href={`/admin/messaging?thread=${t.id}&reason=${r}`} class="block whitespace-nowrap px-2 py-1 text-2xs hover:bg-muted">{humanize(r)}</a>
                              ))}
                            </div>
                          </details>
                        ) : (
                          <span class="text-2xs text-muted-foreground">{m.adm_msg_metadata_only()}</span>
                        )}
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>

          {threadId && (
            <aside class="space-y-3 border border-border p-4">
              {!canContent ? (
                <p class="text-sm text-muted-foreground" set:html={m.adm_msg_super_required()} />
              ) : !thread ? (
                <div class="space-y-2">
                  <p class="text-sm text-muted-foreground">{m.adm_msg_pick_reason()}</p>
                  {REASONS.map((r) => (
                    <a href={`/admin/messaging?thread=${threadId}&reason=${r}`} class="slab-cut block border border-foreground/20 px-3 py-2 text-sm font-medium transition-colors hover:bg-muted">
                      {humanize(r)}
                    </a>
                  ))}
                </div>
              ) : (
                <>
                  <div class="border-b border-border pb-2">
                    <p class="font-condensed text-lg font-bold">{thread.profileName} · {thread.clientName}</p>
                    <p class="text-2xs text-brand">{m.adm_msg_readonly({ reason: humanize(reason) })}</p>
                  </div>
                  <div class="max-h-[70vh] space-y-2 overflow-y-auto">
                    {thread.messages.map((msg) =>
                      msg.kind === 'system' ? (
                        <p class="text-center text-2xs text-muted-foreground">{m.adm_msg_system()}</p>
                      ) : (
                        <div class:list={['flex', msg.sender === 'professional' ? 'justify-start' : 'justify-end']}>
                          <div class:list={['max-w-[80%] rounded-lg px-2.5 py-1.5 text-xs', msg.sender === 'professional' ? 'bg-muted' : 'bg-foreground text-background']}>
                            {msg.kind === 'photo' ? <span class="italic opacity-70">{m.adm_msg_photo()}</span> : msg.body}
                          </div>
                        </div>
                      ),
                    )}
                  </div>
                </>
              )}
            </aside>
          )}
        </div>
      </div>
    )
  }
</AdminShell>

<script>
  // Whole thread row opens the governed reason picker (the Open ▾ dropdown stays).
  function initThreadRows() {
    document.querySelectorAll<HTMLTableRowElement>('tr[data-href]').forEach((row) => {
      if (row.dataset.init) return;
      row.dataset.init = '1';
      row.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a, button, details')) return;
        location.href = row.dataset.href!;
      });
    });
  }
  initThreadRows();
  document.addEventListener('astro:page-load', initThreadRows);
</script>
