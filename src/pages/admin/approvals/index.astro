---
/**
 * Profile approval queue (docs/ADMIN.md §5) — the crown jewel, and the ONE
 * place a submission is approved. Merges what were two queues (verification +
 * moderation): a pending item shows the ID document, the profile summary, and
 * the pending photos side by side, plus a link to the full public profile.
 * One decision approves/rejects the whole submission (ID + profile + photos).
 * Oldest-first list → claim → review → approve / reject-with-reason / escalate.
 * Keyboard a/r/e.
 */
import { getAdmin, verificationDocIdsFor } from '@/actions/admin/lib';
import { signVdocUrl } from '@/lib/vdoc-sign';
import { approvalQueue } from '@/actions/admin/queues';
import { profileAge } from '@/app/models/profile';
import { REJECTION_REASONS } from '@/lib/taxonomy';
import { cityName } from '@/lib/seo';
import AdminShell from '@/components/organisms/admin/AdminShell.astro';
import QueueList from '@/components/organisms/admin/QueueList.astro';
import DocViewer from '@/components/organisms/admin/DocViewer.astro';
import SafeImage from '@/components/atoms/SafeImage.astro';
import * as m from '@/paraglide/messages';

const session = await getAdmin(Astro);
const items = session ? await approvalQueue() : [];
const selKey = Astro.url.searchParams.get('item');
const selected = items.find((i) => i.key === selKey) ?? null;

// Short-TTL signed URLs for the submitted docs — only when there's a pending ID
// to review (each reveal is audited at the serve route, hard rule 3). The
// (id) => wrapper matters: bare .map(signVdocUrl) passes the array index as its
// nowMs param → URLs signed for 1970 → always "forbidden".
const docSrcs =
  selected?.idPending && selected.email
    ? await Promise.all((await verificationDocIdsFor(selected.email)).map((id) => signVdocUrl(id)))
    : [];

function ago(iso: string): string {
  const mins = Math.max(0, Math.round((Date.now() - new Date(iso).getTime()) / 60000));
  return mins < 60 ? `${mins}m` : mins < 2880 ? `${Math.round(mins / 60)}h` : `${Math.round(mins / 1440)}d`;
}
const humanize = (s: string) => s.replace(/_/g, ' ').replace(/^./, (c) => c.toUpperCase());

// Subtitle / chip = what's pending, at a glance.
const kindOf = (i: (typeof items)[number]) => {
  const parts: string[] = [];
  if (i.idPending) parts.push('ID');
  if (i.profilePending) parts.push(m.adm_mod_kind_new_profile());
  else if (i.media.length) parts.push(m.adm_mod_kind_media());
  return parts.join(' · ') || m.adm_mod_kind_media();
};

const rows = items.map((i) => ({
  href: `/admin/approvals?item=${encodeURIComponent(i.key)}`,
  title: i.profileName,
  subtitle: kindOf(i),
  age: i.submittedAt ? ago(i.submittedAt) : '—',
  claimedBy: i.claim?.by ?? null,
  active: i.key === selKey,
}));
---

<AdminShell title={m.adm_nav_approvals()} section="approvals">
  {
    session && (
      <div>
        <h1 class="display text-3xl">{m.adm_nav_approvals()}</h1>
        <p class="mt-1 text-sm text-muted-foreground">{m.adm_approval_meta({ count: items.length })}</p>

        <div class="mt-6 grid gap-6 lg:grid-cols-[20rem_1fr]">
          <QueueList rows={rows} empty={m.adm_approval_empty()} />

          {!selected ? (
            <div class="grid place-items-center border border-dashed border-border py-24 text-sm text-muted-foreground">
              {m.adm_select_item()}
            </div>
          ) : (
            <div data-review data-key={selected.key} data-email={selected.email ?? ''} class="min-w-0 space-y-5">
              <div class="flex flex-wrap items-center gap-3">
                <span class="slab-cut border border-foreground/20 px-2 py-0.5 text-2xs font-bold uppercase tracking-wide">{kindOf(selected)}</span>
                {selected.profileSlug && (
                  <a href={`/en/profile/${selected.profileSlug}/`} target="_blank" class="slab-cut border border-foreground/20 px-3 py-1.5 text-sm font-medium hover:bg-muted">
                    {m.adm_view_profile()} ↗
                  </a>
                )}
              </div>

              <div class="grid gap-5 md:grid-cols-2">
                {selected.idPending && (
                  <div>
                    <h2 class="font-condensed text-sm font-bold uppercase tracking-wide text-muted-foreground">{m.adm_verification_doc_title()}</h2>
                    <div class="mt-2">
                      <DocViewer srcs={docSrcs} admin={session.email} />
                    </div>
                    <p class="mt-2 text-2xs text-muted-foreground">{m.adm_verification_doc_note()}</p>
                  </div>
                )}

                <div>
                  <h2 class="font-condensed text-sm font-bold uppercase tracking-wide text-muted-foreground">{m.adm_verification_claim_title()}</h2>
                  <dl class="mt-2 divide-y divide-border border border-border text-sm">
                    <div class="flex justify-between gap-4 px-3 py-2"><dt class="text-muted-foreground">{m.contacts_name()}</dt><dd class="font-medium">{selected.profileName}</dd></div>
                    <div class="flex justify-between gap-4 px-3 py-2"><dt class="text-muted-foreground">{m.adm_field_birth_date()}</dt><dd class="font-medium">{selected.birthDate ?? '—'}{selected.birthDate ? ` (${profileAge(selected.birthDate)})` : ''}</dd></div>
                    <div class="flex justify-between gap-4 px-3 py-2"><dt class="text-muted-foreground">{m.filter_city()}</dt><dd class="font-medium">{selected.city ? cityName(selected.city) : '—'}</dd></div>
                    <div class="flex justify-between gap-4 px-3 py-2">
                      <dt class="text-muted-foreground">{m.account_sms()}</dt>
                      <dd class:list={['font-medium', selected.phoneVerified ? 'text-online' : 'text-brand']}>
                        {selected.phoneVerified ? m.verified() : m.adm_not_verified()}
                      </dd>
                    </div>
                    <div class="flex justify-between gap-4 px-3 py-2"><dt class="text-muted-foreground">{m.adm_field_submitted()}</dt><dd class="font-medium">{selected.submittedAt ? m.adm_ago({ age: ago(selected.submittedAt) }) : '—'}</dd></div>
                  </dl>
                  {selected.idPending && !selected.phoneVerified && (
                    <p class="mt-2 border-l-2 border-brand pl-2 text-xs text-muted-foreground">{m.adm_verification_sms_gate()}</p>
                  )}
                  {selected.claim && (
                    <p class="mt-2 text-xs text-muted-foreground">{m.adm_claimed_by({ name: selected.claim.by.split('@')[0] })}</p>
                  )}
                </div>
              </div>

              {selected.media.length > 0 && (
                <div>
                  <h2 class="font-condensed text-sm font-bold uppercase tracking-wide text-muted-foreground">{m.adm_mod_media_title()}</h2>
                  <div class="mt-2 flex flex-wrap gap-3">
                    {selected.media.map((mm) => (
                      <button type="button" data-reveal class="group relative block size-28 overflow-hidden border border-border">
                        <SafeImage imageKey={mm.imageKey} alt="media" class="size-full blur-lg transition group-[.shown]:blur-0" />
                        <span class:list={['absolute left-1 top-1 rounded px-1 text-2xs font-bold text-white', mm.nsfwScore > 0.6 ? 'bg-brand' : 'bg-black/60']}>{Math.round(mm.nsfwScore * 100)}%</span>
                        <span class="absolute inset-x-0 bottom-0 bg-black/60 py-0.5 text-center text-2xs text-white group-[.shown]:hidden">{m.adm_mod_tap_reveal()}</span>
                      </button>
                    ))}
                  </div>
                </div>
              )}

              {/* Decision bar — one approve/reject for the whole submission */}
              <div class="flex flex-wrap items-end gap-3 border-t border-border pt-5">
                <button type="button" data-approve class="slab-cut bg-online px-4 py-2 text-sm font-semibold text-white">{m.adm_approve()}</button>
                <label class="text-sm">
                  <span class="mb-1 block text-xs font-medium text-muted-foreground">{m.adm_reject_reason()}</span>
                  <select data-reason class="slab-cut border border-foreground/20 bg-background px-3 py-2 text-sm">
                    <option value="">{m.adm_select_reason()}</option>
                    {REJECTION_REASONS.map((r) => <option value={r}>{humanize(r)}</option>)}
                  </select>
                </label>
                <button type="button" data-reject class="slab-cut border border-brand px-4 py-2 text-sm font-semibold text-brand">{m.adm_reject()}</button>
                {selected.email && (
                  <button type="button" data-escalate class="ml-auto text-sm font-medium text-muted-foreground hover:text-foreground">{m.adm_escalate()}</button>
                )}
              </div>
            </div>
          )}
        </div>
      </div>
    )
  }
</AdminShell>

<script>
  import { actions } from 'astro:actions';
  import * as m from '@/paraglide/messages';
  function initReview() {
    const panel = document.querySelector<HTMLElement>('[data-review]');
    if (!panel || panel.dataset.init) return;
    panel.dataset.init = '1';
    const key = panel.dataset.key!;
    const email = panel.dataset.email || '';

    // Claim on open (broadcast "reviewing", §5).
    actions.admin.claim({ itemKey: `approve:${key}` });

    // Per-item blur reveal (§2 — no page-wide toggle).
    panel.querySelectorAll<HTMLElement>('[data-reveal]').forEach((b) =>
      b.addEventListener('click', () => b.classList.toggle('shown')),
    );

    const reason = panel.querySelector('[data-reason]') as unknown as HTMLSelectElement;
    // Optimistic close: drop the row + panel in place instead of re-rendering
    // the SSR list (DB reads can lag writes behind the Hyperdrive query cache).
    const flash = (msg: string, ok = true) => {
      const p = document.createElement('p');
      p.className = ok ? 'text-sm font-medium text-online' : 'text-sm font-medium text-brand';
      p.textContent = msg;
      return p;
    };
    const done = (msg: string) => {
      document.querySelector(`a[href="/admin/approvals?item=${encodeURIComponent(key)}"]`)?.closest('li')?.remove();
      panel.replaceChildren(flash(msg));
      history.replaceState({}, '', '/admin/approvals');
    };
    const fail = (message: string) => panel.prepend(flash(m.adm_action_failed({ message }), false));
    const approve = async () => {
      const { error } = await actions.admin.approvalDecision({ key, decision: 'approve' });
      error ? fail(error.message) : done(m.adm_done_approved());
    };
    const reject = async () => {
      if (!reason.value) { reason.focus(); return; }
      const { error } = await actions.admin.approvalDecision({ key, decision: 'reject', reason: reason.value as any });
      error ? fail(error.message) : done(m.adm_done_rejected());
    };
    const escalate = async () => {
      if (!email) return;
      const { error } = await actions.admin.escalate({ entityType: 'account', entityId: email });
      error ? fail(error.message) : panel.prepend(flash(m.adm_done_escalated()));
    };
    panel.querySelector('[data-approve]')!.addEventListener('click', approve);
    panel.querySelector('[data-reject]')!.addEventListener('click', reject);
    panel.querySelector('[data-escalate]')?.addEventListener('click', escalate);

    document.addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement)?.tagName === 'SELECT' || (e.target as HTMLElement)?.tagName === 'INPUT') return;
      if (e.key === 'a') approve();
      else if (e.key === 'r') reject();
      else if (e.key === 'e') escalate();
    });
  }
  initReview();
  document.addEventListener('astro:page-load', initReview);
</script>
