---
import Layout from '@/layouts/Layout.astro';
import * as m from '@/paraglide/messages';
import ProfileCard from '@/components/ProfileCard.astro';
import ProfileImage from '@/components/ProfileImage.astro';
import SearchControl from '@/components/SearchControl.astro';
import { Button } from '@/components/ui/button';
import { ARTICLES, FEATURED, PROFILES } from '@/lib/fixtures';
import { CITIES } from '@/lib/taxonomy';

const cities = CITIES.slice(0, 8);
const onlineCount = PROFILES.filter((p) => p.online).length;
const rail = [...FEATURED, ...PROFILES.filter((p) => !p.featured)].slice(0, 8);
const heroAvatars = [PROFILES[2]!, PROFILES[3]!, PROFILES[6]!];
const featuredArticle = ARTICLES.find((a) => a.featured)!;
const moreArticles = ARTICLES.filter((a) => !a.featured);
---

<Layout>
  <div class="mx-auto max-w-7xl px-4 md:px-6">
    <!-- Hero: clean black card (registration for advertisers + clients) -->
    <section
      class="relative mt-4 overflow-hidden rounded-3xl bg-neutral-950 text-white ring-1 ring-white/10 md:mt-6"
    >
      <!-- Promo video fills the right half, fading into the black (intimate.nl style).
           Safe-mode gated: safe image by default, video only when safe mode is off. -->
      <div class="absolute inset-y-0 right-0 hidden w-[52%] lg:block" data-safe-video-wrap>
        <video
          class="hidden h-full w-full object-cover"
          data-safe-video
          muted
          loop
          playsinline
          autoplay
          preload="metadata"
          poster="/video/hero-poster.jpg"
        >
          <source src="/video/hero.webm" type="video/webm" />
          <source src="/video/hero.mp4" type="video/mp4" />
        </video>
        <ProfileImage imageKey="hero-video" alt="" class="h-full w-full" loading="eager" />
        <div
          class="absolute inset-0 bg-gradient-to-r from-neutral-950 via-neutral-950/35 to-transparent"
          aria-hidden="true"
        >
        </div>
      </div>

      <div class="relative p-7 md:p-12">
        <div class="lg:max-w-[52%]">
          <h1 class="text-4xl font-bold tracking-tight md:text-6xl">
            Find
            <span class="mx-1 inline-flex align-middle -space-x-3">
              {
                heroAvatars.map((a) => (
                  <ProfileImage
                    imageKey={a.id}
                    src={a.photos[0]}
                    alt={a.name}
                    class="size-10 rounded-full ring-3 ring-neutral-950 md:size-14"
                    loading="eager"
                  />
                ))
              }
            </span>
            your intimate connection<span class="text-primary">.</span>
          </h1>
          <p class="mt-5 max-w-md leading-relaxed text-white/70">
            Verified profiles, discreet and safe — for advertisers and visitors.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <Button as="a" href="/account/" size="lg">Start advertising</Button>
            <Button
              as="a"
              href="/account/"
              size="lg"
              class="border-0 bg-white text-neutral-900 hover:bg-white/90"
            >
              Create free account
            </Button>
          </div>
          <p class="mt-8 flex items-center gap-2 text-xs font-medium uppercase tracking-[0.14em] text-white/60">
            <span class="size-1.5 rounded-full bg-online"></span>
            {onlineCount} {m.online_now().toLowerCase()} · 100% verified
          </p>
        </div>
      </div>
    </section>

    <!-- Search (mobile) + city chips -->
    <section class="space-y-4 pt-6 md:pt-10">
      <SearchControl class="md:hidden" />
      <div class="flex gap-2 overflow-x-auto pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {
          cities.map((c, i) => (
            <a
              href={`/${c.slug}/`}
              class:list={[
                'flex-none rounded-full border px-4 py-2 text-sm font-medium transition-colors',
                i === 0
                  ? 'border-transparent bg-foreground text-background'
                  : 'bg-card text-muted-foreground hover:text-foreground',
              ]}
            >
              {c.name}
            </a>
          ))
        }
      </div>
    </section>

    <!-- Featured: slideshow of cards -->
    <section class="py-10 md:py-14">
      <h2 class="display mb-5 text-2xl">{m.section_featured()}</h2>
      <!-- bleeds to the viewport edge so cards and their shadows never get cut -->
      <div
        class="-mx-4 -mb-6 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-10 pt-1 [scrollbar-width:none] scroll-pl-4 md:-mx-6 md:px-6 md:scroll-pl-6 [&::-webkit-scrollbar]:hidden"
      >
        {
          rail.map((p) => (
            <div class="w-52 flex-none snap-start sm:w-60">
              <ProfileCard profile={p} />
            </div>
          ))
        }
      </div>
    </section>

    <!-- Grid -->
    <section class="pb-10 md:pb-14">
      <h2 class="display mb-5 text-2xl">New & online</h2>
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        {PROFILES.map((p, i) => <ProfileCard profile={p} loading={i < 4 ? 'eager' : 'lazy'} />)}
      </div>
    </section>

    <!-- Articles -->
    <section class="pb-12 md:pb-16">
      <div class="mb-5 flex items-end justify-between gap-4">
        <div class="flex items-baseline gap-3">
          <h2 class="display text-2xl">{m.section_articles()}</h2>
          <p class="hidden text-sm text-muted-foreground sm:block">{m.articles_by()}</p>
        </div>
        <a
          href="/blog/"
          class="text-xs font-semibold uppercase tracking-[0.12em] text-foreground hover:text-primary"
        >
          {m.to_blog()} →
        </a>
      </div>

      <div class="grid gap-4 lg:grid-cols-[1.4fr_1fr]">
        <a
          href={`/blog/${featuredArticle.slug}/`}
          class="group relative block overflow-hidden rounded-2xl shadow-soft transition-shadow hover:shadow-soft-lg dark:ring-1 dark:ring-border"
        >
          <ProfileImage
            imageKey={featuredArticle.id}
            alt={featuredArticle.title}
            class="aspect-[16/10] h-full w-full transition-transform duration-300 group-hover:scale-[1.02] lg:aspect-auto lg:absolute lg:inset-0"
          />
          <span class="glass-media absolute left-4 top-4 rounded-full border px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.12em]">
            {m.section_featured()}
          </span>
          <div class="glass-media bottom-4 left-4 right-4 rounded-xl border p-5 lg:absolute">
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-primary-foreground/90">
              {featuredArticle.minutes} {m.min_read()}
            </p>
            <h3 class="mt-1.5 text-xl font-semibold leading-snug">{featuredArticle.title}</h3>
            <p class="mt-1.5 line-clamp-2 text-sm text-white/80">{featuredArticle.excerpt}</p>
            <p class="mt-3 text-xs font-semibold uppercase tracking-[0.12em]">
              {m.read_article()} →
            </p>
          </div>
          <!-- reserve height on lg since the image is absolutely positioned -->
          <span class="hidden lg:block lg:min-h-[24rem]" aria-hidden="true"></span>
        </a>

        <div class="grid gap-4">
          {
            moreArticles.map((a) => (
              <a
                href={`/blog/${a.slug}/`}
                class="group flex items-center gap-4 rounded-2xl bg-card p-3 shadow-soft transition-shadow hover:shadow-soft-lg dark:ring-1 dark:ring-border"
              >
                <ProfileImage
                  imageKey={a.id}
                  alt={a.title}
                  class="aspect-[4/3] w-28 flex-none rounded-xl"
                />
                <div class="min-w-0">
                  <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-primary">
                    {a.minutes} {m.min_read()}
                  </p>
                  <h3 class="mt-1 line-clamp-2 font-semibold leading-snug group-hover:text-primary">
                    {a.title}
                  </h3>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Bottom hero: advertisers CTA banner -->
    <section class="pb-12 md:pb-16">
      <div class="grid overflow-hidden rounded-3xl shadow-soft dark:ring-1 dark:ring-border lg:grid-cols-[1fr_1.15fr]">
        <div class="relative aspect-[16/10] lg:aspect-auto lg:min-h-[22rem]">
          <ProfileImage
            imageKey="bottom-hero"
            src="/video/hero-poster.jpg"
            alt=""
            class="h-full w-full lg:absolute lg:inset-0"
          />
          <span class="glass-media absolute left-4 top-4 rounded-full border px-3.5 py-1.5 text-[11px] font-semibold uppercase tracking-[0.12em]">
            Free in early access
          </span>
        </div>
        <div
          class="flex flex-col justify-center bg-gradient-to-br from-(--accent-gradient-from) to-(--accent-gradient-to) p-8 text-white md:p-12"
        >
          <p class="flex items-center gap-3 text-xs font-medium uppercase tracking-[0.18em] text-white/70">
            <span class="h-px w-6 bg-white/50" aria-hidden="true"></span>
            For advertisers
          </p>
          <h2 class="display mt-4 text-3xl md:text-5xl [&::after]:text-white">
            Place your ad
          </h2>
          <p class="mt-4 max-w-md leading-relaxed text-white/85">
            And get found easily by the right people — verified, discreet and visible
            in your region.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <Button as="a" href="/account/" size="lg" class="border-0 bg-white text-neutral-900 hover:bg-white/90">
              Place ad
            </Button>
            <Button
              as="a"
              href="/blog/starten-als-escort-in-nederland/"
              size="lg"
              class="border border-white/30 bg-white/10 text-white hover:bg-white/20"
            >
              More info →
            </Button>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
