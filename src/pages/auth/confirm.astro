---
/**
 * Email-confirmation landing (SUPABASE.md §2.2). Handles BOTH auth-link shapes:
 *  · `?token_hash=…&type=…`  — the custom template (verifyOtp)
 *  · `?code=…`               — the DEFAULT Supabase template's PKCE redirect
 *    (the mail hits supabase.co/auth/v1/verify, which then redirects HERE with a
 *    `code`; without exchanging it the recovery link "does nothing"). #3/#4.
 * Locale-less by design (middleware BYPASS) — the redirect negotiates the locale.
 *
 * To also make the LINK read intimate.nl (not supabase.co), set the Supabase
 * dashboard email templates (Auth → Templates) to:
 *   Confirm signup:  {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=email
 *   Reset password:  {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=recovery&next=/auth/reset
 * and Site URL = https://intimate.nl. Until then the code-exchange path below
 * makes the default template work (just with a supabase.co-shaped link).
 */
import type { EmailOtpType } from '@supabase/supabase-js';
import { supabaseServer } from '@/lib/supabase';
import { negotiateLocale } from '@/lib/i18n';

const code = Astro.url.searchParams.get('code');
const tokenHash = Astro.url.searchParams.get('token_hash');
const type = Astro.url.searchParams.get('type') as EmailOtpType | null;
const nextParam = Astro.url.searchParams.get('next');
// Only same-site absolute paths — never an open redirect.
const next = nextParam && /^\/(?!\/)/.test(nextParam) ? nextParam : '/account/';
const locale = negotiateLocale(Astro.request.headers.get('accept-language'));

const supabase = supabaseServer(Astro);
if (code) {
  const { error } = await supabase.auth.exchangeCodeForSession(code);
  if (!error) return Astro.redirect(`/${locale}${next}`, 302);
} else if (tokenHash && type) {
  const { error } = await supabase.auth.verifyOtp({ token_hash: tokenHash, type });
  if (!error) return Astro.redirect(`/${locale}${next}`, 302);
}
return Astro.redirect(`/${locale}/`, 302);
---
