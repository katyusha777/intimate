---
import { ClientRouter } from 'astro:transitions';
import * as m from '@/paraglide/messages';
import { getLocale } from '@/paraglide/runtime';
import type { Locale } from '@/lib/taxonomy';
import { accountApi } from '@/app/api/account';
import { messagingApi } from '@/app/api/messaging';
import { sessionApi } from '@/app/api/session';
import Header from '@/components/organisms/layout/Header.astro';
import Footer from '@/components/organisms/layout/Footer.astro';
import BottomTabBar from '@/components/organisms/layout/BottomTabBar.astro';
import AuthModal from '@/components/organisms/auth/AuthModal.astro';
import PageSheet from '@/components/molecules/PageSheet.astro';
import ProfileSheet from '@/components/organisms/profile/ProfileSheet.astro';
import Lightbox from '@/components/molecules/Lightbox.astro';
import FavoritesController from '@/components/molecules/FavoritesController.astro';
import CallDock from '@/components/organisms/call/CallDock.astro';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow/700.css';
import '@fontsource/barlow/600-italic.css';
import '@fontsource/barlow-condensed/500.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Clean indexable URL for filtered listings (SEO: variants canonicalize here). */
  canonical?: string;
  /** Absolute URL per locale → full reciprocal hreflang set + x-default (en). */
  alternates?: Record<Locale, string>;
  /** JSON-LD objects to embed (SEO.md §4). */
  jsonLd?: unknown[];
  /** Utility pages (account, favorites): keep out of the index. */
  noindex?: boolean;
  /** Immersive full-screen page (chat thread): drop header/footer/dock chrome. */
  bare?: boolean;
  /** LCP image URL (realImageFor) — preloaded because the preload scanner
   *  can't see SafeImage's data-real; without it the hero/first-card photo is
   *  only discovered when the safe-mode swap script runs at end of body. */
  preloadImage?: string;
}

const { title = m.app_name(), description, canonical, alternates, jsonLd = [], noindex, bare, preloadImage } = Astro.props;
const locale = getLocale();

/* Session-aware chrome: layouts may read the seam (docs/API.md). */
const session = await sessionApi.current(Astro);
const idVerified =
  session?.role === 'advertiser'
    ? (await accountApi.get(session)).idVerification === 'approved'
    : true;
// Dock unread badge. ponytail: reads all thread docs per page (mock); the
// Supabase backend replaces this with a realtime per-account count subscription.
const unread =
  session && !bare
    ? (await messagingApi.listThreads(session)).reduce((n, t) => n + t.unread, 0)
    : 0;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <title>{title}</title>
    <!-- Real title kept out of <title> so the safe-mode script can restore it
         after neutralizing the tab, and stays fresh across view transitions. -->
    <meta name="x-real-title" content={title} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {
      alternates &&
        Object.entries(alternates).map(([l, href]) => (
          <link rel="alternate" hreflang={l} href={href} />
        ))
    }
    {alternates && <link rel="alternate" hreflang="x-default" href={alternates.en} />}
    {jsonLd.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
    <link rel="manifest" href="/manifest.webmanifest" />
    <!-- Font Awesome 8 Pro (kit: thin + brands), self-hosted from public/fa/.
         Loaded ASYNC (print→all swap): 41KB of icon CSS was the biggest
         render-blocker (~1.3s on slow 4G) and icons aren't first-paint
         critical. Fonts still download lazily, only when a glyph renders. -->
    <link rel="stylesheet" href="/fa/css/all.min.css" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="/fa/css/all.min.css" /></noscript>
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <link rel="icon" data-real-icon href="/icons/icon.svg" type="image/svg+xml" />
    <!-- Dark is the site default (theme rides localStorage, not the device). -->
    <meta name="theme-color" content="#171717" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Intimate" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon-180.png" />
    <ClientRouter />
    <!-- Privacy-friendly analytics by Plausible (cookieless — the "anonymous
         analytics" consent tier, no banner gate needed; tracks ClientRouter
         navigations via its built-in pushState hook) -->
    <script is:inline async src="https://plausible.io/js/pa-dVJlubTNYbSGy8qFF_GT-.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
    <script is:inline>
      // No-flash theme (items.md #4): first visit follows the DEVICE
      // (prefers-color-scheme); an explicit pick on the toggle persists and
      // wins from then on. On view transitions the class is stamped on the
      // INCOMING document BEFORE the swap (after-swap re-adding it straddled a
      // style recalc, so the theme switch thumb visibly slid per navigation).
      (function () {
        const dark = () => {
          const t = localStorage.theme;
          if (t === 'light' || t === 'dark') return t === 'dark';
          return matchMedia('(prefers-color-scheme: dark)').matches;
        };
        document.documentElement.classList.toggle('dark', dark());
        document.addEventListener('astro:before-swap', (e) => {
          e.newDocument.documentElement.classList.toggle('dark', dark());
        });
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-background font-sans text-foreground antialiased">
    <!-- 18+ gate (items.md #8): SSR'd on every page (edge-cached HTML can't
         vary on the cookie), hidden pre-paint by the inline script right below
         when already accepted. Content stays in the DOM — crawlers see it. -->
    <div
      data-age-gate
      class="fixed inset-0 z-[90] flex items-center justify-center bg-background/60 p-5 backdrop-blur-2xl"
      role="alertdialog"
      aria-label={m.age_gate_title()}
    >
      <div class="w-full max-w-sm border border-foreground/20 bg-background p-6 text-center shadow-soft-lg">
        <p class="display text-4xl">18<span class="text-brand">+</span></p>
        <h2 class="mt-3 font-condensed text-xl font-bold">{m.age_gate_title()}</h2>
        <p class="mt-2 text-sm text-muted-foreground">{m.age_gate_body()}</p>
        <div class="mt-5 flex flex-col gap-2.5">
          <button
            type="button"
            data-age-enter
            class="slab-cut cursor-pointer bg-foreground px-4 py-3 text-sm font-bold uppercase tracking-wide text-background transition-colors hover:bg-brand hover:text-white"
          >
            {m.age_gate_enter()}
          </button>
          <a
            href="https://www.google.com"
            class="py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
          >
            {m.age_gate_leave()}
          </a>
        </div>
      </div>
    </div>
    <script is:inline data-astro-rerun>
      // Runs during parse, directly after the gate element — no flash for
      // returning visitors; the accept writes a 1-year cookie. data-astro-rerun:
      // must re-run after every view-transition swap (fresh gate element).
      (function () {
        var gate = document.querySelector('[data-age-gate]');
        if (!gate) return;
        if (/(?:^|;\s*)age_ok=1/.test(document.cookie)) {
          gate.remove();
          return;
        }
        document.documentElement.style.overflow = 'hidden';
        gate.querySelector('[data-age-enter]').addEventListener('click', function () {
          document.cookie = 'age_ok=1; path=/; max-age=31536000; samesite=lax';
          document.documentElement.style.overflow = '';
          gate.remove();
        });
      })();
    </script>
    <!-- .page-zoom = the iOS push-back target when a sheet opens; fixed
         chrome (dock, dialogs) lives outside it. -->
    <div class="page-zoom">
      {!bare && <Header {session} {unread} />}

      <main>
        <slot />
      </main>

      {!bare && <Footer />}
    </div>
    {!bare && <BottomTabBar {session} {idVerified} {unread} />}
    <AuthModal />
    <PageSheet />
    <ProfileSheet />
    <Lightbox />
    <FavoritesController />
    {/* Signed-in only: live badges + the incoming-call ring + call screen.
        Mounted globally so a ring reaches the client on ANY page; anonymous
        pages never ship its script (zero-JS budget untouched). */}
    {session && <CallDock {session} />}

    <script is:inline data-neutral-title={m.safe_neutral_title()}>
      // Safe mode (DESIGN.md §6, Phase 5): THREE-valued.
      //   off     — real photos (THE DEFAULT — discretion is opt-in)
      //   neutral — muted abstract placeholders
      //   dev     — anime placeholders (the operator's build-in-public skin)
      // Server HTML ships the neutral placeholder (no-JS stays discreet); the
      // script swaps in photos unless a cookie says otherwise.
      (function () {
        const script = document.currentScript;
        const NEUTRAL_TITLE = (script && script.dataset.neutralTitle) || 'Search';
        const NEUTRAL_FAVICON =
          "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512'%3E%3Crect width='512' height='512' rx='96' fill='%23888'/%3E%3C/svg%3E";
        // Real title lives in a meta tag Astro re-renders per page, so it stays
        // fresh across view transitions even after we neutralize document.title.
        const realTitle = (root) => {
          root = root || document;
          const m = root.querySelector("meta[name='x-real-title']");
          return (m && m.getAttribute('content')) || root.title;
        };
        const STATES = ['off', 'neutral', 'dev'];

        const state = () => {
          const m = document.cookie.match(/safe_mode=(\w+)/);
          const v = m && m[1];
          if (v === 'off' || v === 'neutral' || v === 'dev') return v;
          if (v === 'on') return 'neutral'; // legacy cookie
          return 'off'; // photos by default — safe mode is a choice, not a wall
        };
        const setState = (s) => {
          document.cookie = 'safe_mode=' + s + '; path=/; max-age=31536000; samesite=lax';
        };

        // `root` lets astro:before-swap run this against the INCOMING document
        // — images get their real src BEFORE first paint, so navigation never
        // flashes the neutral placeholder (the "images flicker" bug).
        const apply = (root) => {
          root = root || document;
          const s = state();
          const off = s === 'off';
          const pick = s === 'dev' ? 'dev' : 'safe'; // safe = neutral data-attr
          root.querySelectorAll('img[data-safe]').forEach((el) => {
            const want = off
              ? el.dataset.real || el.dataset.safe
              : el.dataset[pick] || el.dataset.safe;
            if (el.getAttribute('src') !== want) el.setAttribute('src', want);
            // Which set is showing — dark mode dims the placeholder sets
            // (items.md #9: they glared against the dark canvas).
            el.dataset.showing = off ? 'real' : pick;
          });
          root.querySelectorAll('[data-safe-video-wrap]').forEach((wrap) => {
            const video = wrap.querySelector('video');
            const fallback = wrap.querySelector('img');
            if (!video) return;
            video.classList.toggle('hidden', !off);
            if (fallback) fallback.classList.toggle('hidden', off);
            // Only play (and thus download — preload="none") when actually
            // rendered: the section is display:none on mobile, and 2.5 MB of
            // invisible hero video was starving the LCP image on slow 4G. The
            // poster rides data-poster for the same reason (57 KB, poster
            // fetches eagerly even on display:none videos).
            if (off && video.checkVisibility?.() !== false) {
              if (!video.poster && video.dataset.poster) video.poster = video.dataset.poster;
              video.play().catch(() => {});
            } else video.pause();
          });
          // Toggle UI: aria-checked = "is safe mode active at all", data-safe-state
          // carries the exact value so the label/icon can reflect all three.
          root.querySelectorAll('[data-safe-toggle]').forEach((b) => {
            b.setAttribute('aria-checked', String(!off));
            b.setAttribute('data-safe-state', s);
          });
          // Neutral tab chrome (5.3): generic title + monochrome favicon while
          // safe mode is on (neutral OR dev); restore the real ones when off.
          const icon = root.querySelector('link[data-real-icon]');
          if (off) {
            root.title = realTitle(root);
            if (icon) icon.setAttribute('href', '/icons/icon.svg');
          } else {
            root.title = NEUTRAL_TITLE;
            if (icon) icon.setAttribute('href', NEUTRAL_FAVICON);
          }
        };

        // Toggle cycles off → neutral → dev → off (5.2). Boss key flips on/off.
        const cycle = () => {
          setState(STATES[(STATES.indexOf(state()) + 1) % STATES.length]);
          apply();
        };
        const flip = () => {
          setState(state() === 'off' ? 'neutral' : 'off');
          apply();
        };

        document.addEventListener('click', (e) => {
          if (!e.target.closest) return;
          if (e.target.closest('[data-scroll-top]')) {
            window.scrollTo({ top: 0, behavior: 'smooth' });
            return;
          }
          if (e.target.closest('[data-safe-toggle]')) cycle();
        });

        // Boss key (5.4): double-Esc within 500ms flips safe mode, both ways.
        let lastEsc = 0;
        document.addEventListener('keydown', (e) => {
          if (e.key !== 'Escape') return;
          const now = Date.now();
          if (now - lastEsc < 500) {
            flip();
            lastEsc = 0;
          } else {
            lastEsc = now;
          }
        });

        // BEFORE-swap: the incoming document gets its real image srcs (and tab
        // chrome) pre-paint — no placeholder flash on navigation. page-load
        // stays as the fallback for injected content (profile sheet etc.).
        document.addEventListener('astro:before-swap', (e) => apply(e.newDocument));
        document.addEventListener('astro:page-load', () => apply());
        apply();
      })();

      // Live availability badge (page-cache.ts): the profile page HTML is edge
      // -cached 24h, so its "online" dot is a snapshot. On any profile view
      // (full page or lifted into the sheet) re-fetch the fresh state once and
      // patch the [data-avail] badges — the cached shell is never stale-online.
      (function () {
        // Mirrors AvailabilityLine.astro's dot/glyph markup — keep the two in
        // sync if that component's mark styling changes.
        const markMarkup = (online, glyph, muted) =>
          online
            ? '<span class="size-1.5 flex-none rounded-full bg-online" aria-hidden="true"></span>'
            : '<span class="flex-none leading-none ' + muted + '" aria-hidden="true">' + glyph + '</span>';
        async function refreshAvail() {
          if (!document.querySelector('[data-avail-refresh]')) return;
          try {
            const base = location.pathname.replace(/\/+$/, '');
            const res = await fetch(base + '/avail.json', { headers: { 'X-Sheet': '1' } });
            if (!res.ok) return;
            const a = await res.json(); // { online, glyph, label, sub }
            document.querySelectorAll('[data-avail]').forEach((el) => {
              const muted = el.getAttribute('data-avail-variant') === 'card' ? 'text-white/50' : 'text-muted-foreground';
              const mark = el.querySelector('[data-avail-mark]');
              if (mark) mark.innerHTML = markMarkup(a.online, a.glyph, muted);
              const label = el.querySelector('[data-avail-label]');
              if (label) label.textContent = a.label;
              const sub = el.querySelector('[data-avail-sub]');
              if (sub) {
                const t = a.sub ? '· ' + a.sub : '';
                sub.textContent = t;
                sub.classList.toggle('hidden', !t);
              }
            });
          } catch (_) {
            /* cached snapshot stands */
          }
        }
        document.addEventListener('astro:page-load', refreshAvail);
      })();

      if ('serviceWorker' in navigator) {
        addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
      }
    </script>
  </body>
</html>
