---
import { ClientRouter } from 'astro:transitions';
import * as m from '@/paraglide/messages';
import ThemeToggle from '@/components/ThemeToggle.astro';
import SafeModeToggle from '@/components/SafeModeToggle.astro';
import { CITIES } from '@/lib/taxonomy';
import '@fontsource-variable/inter';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = m.app_name(), description } = Astro.props;
const path = Astro.url.pathname;

const tabs = [
  {
    href: '/',
    label: m.nav_search(),
    active: path === '/',
    icon: '<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>',
  },
  {
    href: '/favorites/',
    label: m.nav_favorites(),
    active: path.startsWith('/favorites'),
    icon: '<path d="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7Z"/>',
  },
  {
    href: '/account/',
    label: m.nav_account(),
    active: path.startsWith('/account'),
    icon: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"/>',
  },
];
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="manifest" href="/manifest.webmanifest" />
    <!-- Font Awesome 8 Pro (kit: thin + brands), self-hosted from public/fa/.
         Fonts download lazily, only when a fa-* glyph is actually rendered. -->
    <link rel="stylesheet" href="/fa/css/all.min.css" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <ClientRouter />
    <script is:inline>
      // No-flash theme: runs before first paint, and again after each view transition swap.
      (function () {
        const apply = () => {
          const t = localStorage.theme;
          document.documentElement.classList.toggle(
            'dark',
            t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches),
          );
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-background font-sans text-foreground antialiased">
    <header
      class="glass sticky top-0 z-40 border-b"
      style="padding-top: env(safe-area-inset-top)"
    >
      <!-- Row 1: logo · locale · search · nav · theme/favorites · login -->
      <div class="mx-auto flex h-14 max-w-7xl items-center gap-3 px-4 md:h-[4.5rem] md:gap-5 md:px-6">
        <a href="/" aria-label={m.app_name()} class="flex flex-none items-center">
          <!-- naming follows the source files: LIGHT = light (white) lettering, DARK = dark lettering -->
          <img src="/img/logo-dark.svg" alt={m.app_name()} class="h-9 w-auto dark:hidden" />
          <img src="/img/logo-light.svg" alt={m.app_name()} class="hidden h-9 w-auto dark:block" />
        </a>

        <button
          type="button"
          class="hidden flex-none items-center gap-1 rounded-md px-2 py-1.5 text-sm font-medium text-muted-foreground hover:text-foreground md:flex"
        >
          NL
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
        </button>

        <label
          class="hidden h-11 max-w-xl flex-1 cursor-text items-center gap-3 rounded-full bg-muted/70 px-5 ring-1 ring-transparent transition-shadow focus-within:ring-ring md:flex"
        >
          <svg class="size-4.5 flex-none text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
          <input
            type="search"
            placeholder={m.search_placeholder()}
            class="w-full bg-transparent text-sm outline-none placeholder:text-muted-foreground [&::-webkit-search-cancel-button]:hidden"
          />
        </label>

        <nav class="ml-auto hidden flex-none items-center gap-5 text-sm font-medium lg:flex">
          <a href="/account/" class="rounded-sm bg-primary/15 px-2 py-1">{m.cta_advertise()}</a>
          <a href="/blog/" class="text-muted-foreground transition-colors hover:text-foreground">{m.section_articles()}</a>
          <a href="/contact/" class="text-muted-foreground transition-colors hover:text-foreground">{m.nav_contact()}</a>
        </nav>

        <span class="hidden h-6 w-px flex-none bg-border lg:block" aria-hidden="true"></span>

        <div class="ml-auto flex flex-none items-center gap-0.5 lg:ml-0">
          <ThemeToggle />
          <a
            href="/favorites/"
            aria-label={m.nav_favorites()}
            class="hidden rounded-md p-2 text-muted-foreground hover:text-foreground md:block"
          >
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7Z" /></svg>
          </a>
          <a
            href="/"
            aria-label={m.nav_search()}
            class="rounded-md p-2 text-muted-foreground hover:text-foreground md:hidden"
          >
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
          </a>
        </div>

        <a
          href="/account/"
          class="flex h-9 flex-none items-center rounded-full bg-foreground px-5 text-sm font-semibold text-background transition-opacity hover:opacity-85 md:h-11 md:px-7"
        >
          {m.nav_login()}
        </a>
      </div>

      <!-- Row 2: category bar -->
      <div class="border-t border-border/60">
        <div class="mx-auto flex h-12 max-w-7xl items-stretch px-4 md:h-14 md:px-6">
          <button
            type="button"
            class="my-2 mr-4 hidden flex-none items-center gap-3 rounded-xl bg-gradient-to-r from-(--accent-gradient-from) to-(--accent-gradient-to) px-5 text-sm font-semibold uppercase tracking-wide text-white transition-opacity hover:opacity-90 md:flex"
          >
            <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg>
            {m.all_categories()}
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </button>

          <nav
            class="flex flex-1 items-stretch overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
            aria-label={m.all_categories()}
          >
            {
              [
                {
                  label: m.cat_women(),
                  href: '/vrouwen/',
                  active: true,
                  icon: '<circle cx="12" cy="8" r="5"/><path d="M12 13v8M9 18h6"/>',
                },
                {
                  label: m.cat_men(),
                  href: '/mannen/',
                  icon: '<circle cx="10" cy="14" r="5"/><path d="m19 5-5.4 5.4M14 5h5v5"/>',
                },
                {
                  label: m.cat_lgbt(),
                  href: '/lgbt/',
                  icon: '<path d="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7Z"/>',
                },
                {
                  label: m.cat_business(),
                  href: '/bedrijven/',
                  icon: '<rect x="4" y="2" width="16" height="20" rx="2"/><path d="M9 22v-4h6v4M8 7h.01M16 7h.01M12 7h.01M8 12h.01M12 12h.01M16 12h.01"/>',
                },
                {
                  label: m.cat_events(),
                  href: '/evenementen/',
                  icon: '<rect x="3" y="4" width="18" height="17" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
                },
              ].map((c) => (
                <a
                  href={c.href}
                  aria-current={c.active ? 'page' : undefined}
                  class:list={[
                    'relative flex flex-none items-center gap-2.5 px-4 text-sm font-medium transition-colors md:px-6',
                    c.active
                      ? 'bg-primary/5 text-primary after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:bg-primary'
                      : 'text-muted-foreground hover:text-foreground',
                  ]}
                >
                  <svg
                    class="size-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={c.icon}
                  />
                  {c.label}
                </a>
              ))
            }
          </nav>

          <button
            type="button"
            class="my-2 ml-4 hidden flex-none items-center gap-3 rounded-xl px-2 text-left transition-colors hover:bg-muted/60 lg:flex"
          >
            <span class="grid size-10 flex-none place-items-center rounded-full bg-primary/10 text-primary">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="3" /></svg>
            </span>
            <span>
              <span class="block text-sm font-semibold leading-tight">Amsterdam</span>
              <span class="block text-xs leading-tight text-muted-foreground">Noord-Holland</span>
            </span>
            <svg class="size-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </button>
        </div>
      </div>
    </header>

    <main class="pb-24 md:pb-0">
      <slot />
    </main>

    <!-- Footer — always dark (intimate.nl style); `dark` class scopes tokens so
         children (safe-mode toggle, text colors) render on dark correctly. -->
    <footer class="dark mt-16 overflow-hidden bg-neutral-950 text-foreground">
      <!-- City ticker -->
      <div class="border-b border-white/10 py-3">
        <div class="animate-ticker flex w-max">
          {
            [0, 1].map(() => (
              <div class="flex items-center" aria-hidden="true">
                {CITIES.slice(0, 12).map((c) => (
                  <span class="flex items-center gap-10 pr-10 text-[11px] font-medium uppercase tracking-[0.2em] text-white/40">
                    {c.name}
                    <span class="size-1 rounded-full bg-primary/80" />
                  </span>
                ))}
              </div>
            ))
          }
        </div>
      </div>

      <div class="mx-auto max-w-7xl px-4 md:px-6">
        <!-- Top: claim + logo -->
        <div class="grid gap-10 border-b border-white/10 py-12 lg:grid-cols-2 lg:items-center">
          <div>
            <span class="inline-flex items-center gap-2 rounded-full border border-primary/40 px-3.5 py-1.5 text-[11px] font-semibold uppercase tracking-[0.16em] text-white/80">
              <span class="size-1.5 rounded-full bg-primary"></span>
              Early access
            </span>
            <p class="display mt-5 text-3xl md:text-5xl">Waar connecties beginnen</p>
          </div>
          <div class="space-y-3 lg:text-right">
            <img src="/img/logo-light.svg" alt={m.app_name()} class="h-14 w-auto lg:ml-auto" />
            <p class="max-w-xs text-sm text-white/50 lg:ml-auto">
              Nieuw platform, volop in ontwikkeling. We bouwen Intimate samen met jou.
            </p>
          </div>
        </div>

        <!-- Link columns + contact card -->
        <div class="grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
          {
            [
              {
                title: 'Informatie',
                links: [
                  ['Over Intimate', '/over/'],
                  ['Artikelen', '/blog/'],
                  ['Forum', '/forum/'],
                  ['Documentatie', '/docs/'],
                ],
              },
              {
                title: 'Help',
                links: [
                  ['Profielregels', '/profielregels/'],
                  ['Veiligheid & Bewustwording', '/veiligheid/'],
                  ['Helpdesk', '/helpdesk/'],
                  ['Contact', '/contact/'],
                ],
              },
              {
                title: 'Regelgeving',
                links: [
                  ['Algemene Voorwaarden', '/voorwaarden/'],
                  ['Privacy & Cookies', '/privacy/'],
                ],
              },
            ].map((col) => (
              <div>
                <p class="flex items-center gap-3 text-xs font-medium uppercase tracking-[0.18em] text-white/50">
                  <span class="h-px w-5 bg-white/30" aria-hidden="true" />
                  {col.title}
                </p>
                <ul class="mt-4 space-y-2.5">
                  {col.links.map(([label, href]) => (
                    <li>
                      <a href={href} class="text-sm text-white/75 transition-colors hover:text-white">
                        {label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }

          <div class="rounded-2xl bg-white/5 p-5 ring-1 ring-white/10">
            <p class="flex items-center gap-3 text-xs font-medium uppercase tracking-[0.18em] text-white/50">
              <span class="h-px w-5 bg-white/30" aria-hidden="true"></span>
              Vragen?
            </p>
            <p class="mt-3 flex items-center gap-2.5">
              <span class="grid size-8 place-items-center rounded-full bg-online/90 text-neutral-950">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /></svg>
              </span>
              <span class="font-semibold">085 333 2377</span>
            </p>
            <p class="mt-2 text-xs text-white/50">WhatsApp, ma–vr 9:00–17:00</p>
            <div class="mt-4 rounded-lg bg-amber-400/10 p-3 ring-1 ring-amber-400/25">
              <p class="text-[11px] font-bold uppercase tracking-[0.08em] text-amber-200">
                ⚠ Géén escortbureau
              </p>
              <p class="mt-1 text-xs leading-relaxed text-amber-100/70">
                Wij zijn een advertentieplatform — afspraken maak je rechtstreeks met adverteerders.
                We bemiddelen niet en plannen geen boekingen.
              </p>
            </div>
          </div>
        </div>

        <!-- Bottom bar -->
        <div class="flex flex-wrap items-center justify-between gap-4 border-t border-white/10 py-6 pb-24 md:pb-6">
          <p class="flex items-center gap-3">
            <span class="rounded-full px-2.5 py-1 text-xs font-bold ring-1 ring-white/25">18+</span>
            <span class="text-sm text-white/50">© 2026 Intimate.nl. Alle rechten voorbehouden.</span>
          </p>
          <div class="flex items-center gap-6">
            <SafeModeToggle />
            <button
              type="button"
              data-scroll-top
              class="flex items-center gap-2 rounded-full px-4 py-2 text-xs font-semibold uppercase tracking-[0.12em] ring-1 ring-white/20 transition-colors hover:bg-white/10"
            >
              Terug naar boven
              <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6" /></svg>
            </button>
          </div>
        </div>
      </div>
    </footer>

    <nav
      class="glass-thin fixed inset-x-0 bottom-0 z-40 border-t pb-[env(safe-area-inset-bottom)] md:hidden"
      aria-label={m.nav_search()}
    >
      <div class="grid grid-cols-3">
        {
          tabs.map((t) => (
            <a
              href={t.href}
              class:list={[
                'flex min-h-14 flex-col items-center justify-center gap-0.5 text-[11px] font-medium transition-colors',
                t.active ? 'text-primary' : 'text-muted-foreground',
              ]}
              aria-current={t.active ? 'page' : undefined}
            >
              <svg
                class="size-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={t.icon}
              />
              {t.label}
            </a>
          ))
        }
      </div>
    </nav>

    <script is:inline>
      // Safe mode (DESIGN.md §6): fail-closed. Server HTML always ships safe
      // placeholders; real photos swap in only when cookie safe_mode=off.
      (function () {
        const isSafe = () => !document.cookie.includes('safe_mode=off');
        const apply = () => {
          const on = isSafe();
          document.querySelectorAll('img[data-safe]').forEach((el) => {
            const want = on ? el.dataset.safe : el.dataset.real || el.dataset.safe;
            if (el.getAttribute('src') !== want) el.setAttribute('src', want);
          });
          document.querySelectorAll('[data-safe-video-wrap]').forEach((wrap) => {
            const video = wrap.querySelector('video');
            const fallback = wrap.querySelector('img');
            if (!video) return;
            video.classList.toggle('hidden', on);
            if (fallback) fallback.classList.toggle('hidden', !on);
            if (on) video.pause();
            else video.play().catch(() => {});
          });
          document
            .querySelectorAll('[data-safe-toggle]')
            .forEach((b) => b.setAttribute('aria-checked', String(on)));
        };
        document.addEventListener('click', (e) => {
          if (!e.target.closest) return;
          if (e.target.closest('[data-scroll-top]')) {
            window.scrollTo({ top: 0, behavior: 'smooth' });
            return;
          }
          const btn = e.target.closest('[data-safe-toggle]');
          if (!btn) return;
          document.cookie =
            'safe_mode=' + (isSafe() ? 'off' : 'on') + '; path=/; max-age=31536000; samesite=lax';
          apply();
        });
        document.addEventListener('astro:page-load', apply);
        apply();
      })();

      if ('serviceWorker' in navigator) {
        addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
      }
    </script>
  </body>
</html>
