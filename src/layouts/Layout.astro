---
import { ClientRouter } from 'astro:transitions';
import * as m from '@/paraglide/messages';
import ThemeToggle from '@/components/ThemeToggle.astro';
import SafeModeToggle from '@/components/SafeModeToggle.astro';
import AuthModal from '@/components/AuthModal.astro';
import { CITIES } from '@/lib/taxonomy';
import '@fontsource-variable/inter';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = m.app_name(), description } = Astro.props;
const path = Astro.url.pathname;

const tabs = [
  {
    href: '/',
    label: m.nav_search(),
    active: path === '/',
    icon: '<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>',
  },
  {
    href: '/favorites/',
    label: m.nav_favorites(),
    active: path.startsWith('/favorites'),
    icon: '<path d="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7Z"/>',
  },
  {
    href: '/account/',
    label: m.nav_account(),
    active: path.startsWith('/account'),
    icon: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"/>',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="manifest" href="/manifest.webmanifest" />
    <!-- Font Awesome 8 Pro (kit: thin + brands), self-hosted from public/fa/.
         Fonts download lazily, only when a fa-* glyph is actually rendered. -->
    <link rel="stylesheet" href="/fa/css/all.min.css" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <ClientRouter />
    <script is:inline>
      // No-flash theme: runs before first paint, and again after each view transition swap.
      (function () {
        const apply = () => {
          const t = localStorage.theme;
          document.documentElement.classList.toggle(
            'dark',
            t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches),
          );
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-background font-sans text-foreground antialiased">
    <header
      class="glass sticky top-0 z-40 border-b"
      style="padding-top: env(safe-area-inset-top)"
    >
      <!-- Row 1: logo · nav (active underline) · location · circle buttons · account -->
      <div class="mx-auto flex h-14 max-w-7xl items-center gap-3 px-4 md:h-[4.25rem] md:gap-4 md:px-6">
        <a href="/" aria-label={m.app_name()} class="flex flex-none items-center">
          <!-- naming follows the source files: LIGHT = light (white) lettering, DARK = dark lettering -->
          <img src="/img/logo-dark.svg" alt={m.app_name()} class="h-9 w-auto dark:hidden" />
          <img src="/img/logo-light.svg" alt={m.app_name()} class="hidden h-9 w-auto dark:block" />
        </a>

        <!-- Main categories -->
        <nav class="ml-2 hidden items-stretch self-stretch lg:flex">
          {
            [
              { label: m.cat_private(), href: '/private-visit/', icon: 'fa-house', active: path.startsWith('/private-visit') },
              { label: m.cat_escort(), href: '/escort/', icon: 'fa-car-side', active: path.startsWith('/escort') },
              { label: m.cat_massage(), href: '/massage/', icon: 'fa-spa', active: path.startsWith('/massage') },
              { label: m.cat_virtual(), href: '/virtual/', icon: 'fa-camera-web', active: path.startsWith('/virtual') },
              { label: m.cat_bdsm(), href: '/bdsm/', icon: 'fa-handcuffs', active: path.startsWith('/bdsm') },
            ].map((l) => (
              <a
                href={l.href}
                aria-current={l.active ? 'page' : undefined}
                class:list={[
                  'relative flex items-center gap-2 px-3.5 text-sm font-medium transition-colors',
                  l.active
                    ? 'text-primary after:absolute after:inset-x-3.5 after:bottom-0 after:h-0.5 after:bg-primary'
                    : 'text-muted-foreground hover:text-foreground',
                ]}
              >
                <i class:list={['fa-thin', l.icon]} aria-hidden="true" />
                {l.label}
              </a>
            ))
          }
        </nav>

        <nav class="ml-auto hidden flex-none items-center gap-5 text-sm font-medium md:flex">
          <a href="/blog/" class="text-muted-foreground transition-colors hover:text-foreground">
            {m.section_articles()}
          </a>
          <a href="/contact/" class="text-muted-foreground transition-colors hover:text-foreground">
            {m.nav_contact()}
          </a>
        </nav>

        <div class="ml-auto flex flex-none items-center gap-4 md:ml-5">
          <button
            type="button"
            data-modal-open="auth"
            data-auth-tab="login"
            class="text-sm font-semibold transition-colors hover:text-primary"
          >
            {m.nav_login()}
          </button>
          <button
            type="button"
            data-modal-open="auth"
            data-auth-tab="register"
            class="h-9 rounded-full bg-primary px-5 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90 md:h-10 md:px-6"
          >
            {m.nav_register()}
          </button>
        </div>
      </div>

      <!-- Row 2: search bar · filter segments · save search -->
      <div class="border-t border-border/60 bg-muted/30">
        <div class="mx-auto flex h-14 max-w-7xl items-center px-4 md:h-16 md:px-6">
          <label
            class="flex h-10 w-full max-w-sm cursor-text items-center gap-3 rounded-xl bg-muted px-4 ring-1 ring-transparent transition-shadow focus-within:ring-ring md:h-11"
          >
            <i class="fa-thin fa-wand-magic-sparkles text-primary" aria-hidden="true"></i>
            <input
              type="search"
              placeholder={m.search_ai_placeholder()}
              class="w-full bg-transparent text-sm outline-none placeholder:text-muted-foreground [&::-webkit-search-cancel-button]:hidden"
            />
          </label>
          <button
            type="button"
            class="ml-3 flex h-10 flex-none items-center gap-2 rounded-xl bg-primary px-5 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90 md:h-11 md:px-6"
          >
            <i class="fa-thin fa-sparkles" aria-hidden="true"></i>
            {m.nav_search()}
          </button>

          <div class="mx-2 hidden flex-1 items-stretch self-stretch lg:flex">
            {
              [
                { label: 'Amsterdam', icon: 'fa-location-dot' },
                { label: m.cat_women(), icon: 'fa-venus' },
                { label: m.search_availability(), icon: 'fa-bolt' },
              ].map((f) => (
                <button
                  type="button"
                  class="flex flex-1 items-center justify-center gap-3 border-l border-border text-sm font-medium text-foreground transition-colors last:border-r hover:bg-muted/50"
                >
                  <i class:list={['fa-thin', f.icon, 'text-muted-foreground']} aria-hidden="true" />
                  {f.label}
                  <i class="fa-thin fa-chevron-down text-xs text-muted-foreground" aria-hidden="true" />
                </button>
              ))
            }
          </div>

        </div>
      </div>
    </header>

    <main class="pb-24 md:pb-0">
      <slot />
    </main>

    <!-- Footer — always dark (intimate.nl style); `dark` class scopes tokens so
         children (safe-mode toggle, text colors) render on dark correctly. -->
    <footer class="dark mt-16 overflow-hidden bg-neutral-950 text-foreground">
      <!-- City ticker -->
      <div class="border-b border-white/10 py-3">
        <div class="animate-ticker flex w-max">
          {
            [0, 1].map(() => (
              <div class="flex items-center" aria-hidden="true">
                {CITIES.slice(0, 12).map((c) => (
                  <span class="flex items-center gap-10 pr-10 text-[11px] font-medium uppercase tracking-[0.2em] text-white/40">
                    {c.name}
                    <span class="size-1 rounded-full bg-primary/80" />
                  </span>
                ))}
              </div>
            ))
          }
        </div>
      </div>

      <div class="mx-auto max-w-7xl px-4 md:px-6">
        <!-- Top: claim + logo -->
        <div class="grid gap-10 border-b border-white/10 py-12 lg:grid-cols-2 lg:items-center">
          <div>
            <span class="inline-flex items-center gap-2 rounded-full border border-primary/40 px-3.5 py-1.5 text-[11px] font-semibold uppercase tracking-[0.16em] text-white/80">
              <span class="size-1.5 rounded-full bg-primary"></span>
              Early access
            </span>
            <p class="display mt-5 text-3xl md:text-5xl">Where connections begin</p>
          </div>
          <div class="space-y-3 lg:text-right">
            <img src="/img/logo-light.svg" alt={m.app_name()} class="h-14 w-auto lg:ml-auto" />
            <p class="max-w-xs text-sm text-white/50 lg:ml-auto">
              A new platform, in active development. We're building Intimate together with you.
            </p>
          </div>
        </div>

        <!-- Link columns + contact card -->
        <div class="grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
          {
            [
              {
                title: 'Information',
                links: [
                  ['About Intimate', '/about/'],
                  ['Articles', '/blog/'],
                  ['Forum', '/forum/'],
                  ['Documentation', '/docs/'],
                ],
              },
              {
                title: 'Help',
                links: [
                  ['Profile rules', '/profile-rules/'],
                  ['Safety & awareness', '/safety/'],
                  ['Helpdesk', '/helpdesk/'],
                  ['Contact', '/contact/'],
                ],
              },
              {
                title: 'Legal',
                links: [
                  ['Terms & conditions', '/terms/'],
                  ['Privacy & Cookies', '/privacy/'],
                ],
              },
            ].map((col) => (
              <div>
                <p class="flex items-center gap-3 text-xs font-medium uppercase tracking-[0.18em] text-white/50">
                  <span class="h-px w-5 bg-white/30" aria-hidden="true" />
                  {col.title}
                </p>
                <ul class="mt-4 space-y-2.5">
                  {col.links.map(([label, href]) => (
                    <li>
                      <a href={href} class="text-sm text-white/75 transition-colors hover:text-white">
                        {label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }

          <div class="rounded-2xl bg-white/5 p-5 ring-1 ring-white/10">
            <p class="flex items-center gap-3 text-xs font-medium uppercase tracking-[0.18em] text-white/50">
              <span class="h-px w-5 bg-white/30" aria-hidden="true"></span>
              Questions?
            </p>
            <p class="mt-3 flex items-center gap-2.5">
              <span class="grid size-8 place-items-center rounded-full bg-online/90 text-neutral-950">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /></svg>
              </span>
              <span class="font-semibold">085 333 2377</span>
            </p>
            <p class="mt-2 text-xs text-white/50">WhatsApp, Mon–Fri 9:00–17:00</p>
            <div class="mt-4 rounded-lg bg-amber-400/10 p-3 ring-1 ring-amber-400/25">
              <p class="text-[11px] font-bold uppercase tracking-[0.08em] text-amber-200">
                ⚠ Not an escort agency
              </p>
              <p class="mt-1 text-xs leading-relaxed text-amber-100/70">
                We are an advertising platform — appointments are made directly with advertisers.
                We do not mediate or schedule bookings.
              </p>
            </div>
          </div>
        </div>

        <!-- Bottom bar -->
        <div class="flex flex-wrap items-center justify-between gap-4 border-t border-white/10 py-6 pb-24 md:pb-6">
          <p class="flex items-center gap-3">
            <span class="rounded-full px-2.5 py-1 text-xs font-bold ring-1 ring-white/25">18+</span>
            <span class="text-sm text-white/50">© 2026 Intimate.nl. All rights reserved.</span>
          </p>
          <div class="flex items-center gap-6">
            <SafeModeToggle />
            <ThemeToggle />
            <button
              type="button"
              data-scroll-top
              class="flex items-center gap-2 rounded-full px-4 py-2 text-xs font-semibold uppercase tracking-[0.12em] ring-1 ring-white/20 transition-colors hover:bg-white/10"
            >
              Back to top
              <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6" /></svg>
            </button>
          </div>
        </div>
      </div>
    </footer>

    <nav
      class="glass-thin fixed inset-x-0 bottom-0 z-40 border-t pb-[env(safe-area-inset-bottom)] md:hidden"
      aria-label={m.nav_search()}
    >
      <div class="grid grid-cols-3">
        {
          tabs.map((t) => (
            <a
              href={t.href}
              class:list={[
                'flex min-h-14 flex-col items-center justify-center gap-0.5 text-[11px] font-medium transition-colors',
                t.active ? 'text-primary' : 'text-muted-foreground',
              ]}
              aria-current={t.active ? 'page' : undefined}
            >
              <svg
                class="size-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={t.icon}
              />
              {t.label}
            </a>
          ))
        }
      </div>
    </nav>

    <AuthModal />

    <script is:inline>
      // Safe mode (DESIGN.md §6): fail-closed. Server HTML always ships safe
      // placeholders; real photos swap in only when cookie safe_mode=off.
      (function () {
        const isSafe = () => !document.cookie.includes('safe_mode=off');
        const apply = () => {
          const on = isSafe();
          document.querySelectorAll('img[data-safe]').forEach((el) => {
            const want = on ? el.dataset.safe : el.dataset.real || el.dataset.safe;
            if (el.getAttribute('src') !== want) el.setAttribute('src', want);
          });
          document.querySelectorAll('[data-safe-video-wrap]').forEach((wrap) => {
            const video = wrap.querySelector('video');
            const fallback = wrap.querySelector('img');
            if (!video) return;
            video.classList.toggle('hidden', on);
            if (fallback) fallback.classList.toggle('hidden', !on);
            if (on) video.pause();
            else video.play().catch(() => {});
          });
          document
            .querySelectorAll('[data-safe-toggle]')
            .forEach((b) => b.setAttribute('aria-checked', String(on)));
        };
        document.addEventListener('click', (e) => {
          if (!e.target.closest) return;
          if (e.target.closest('[data-scroll-top]')) {
            window.scrollTo({ top: 0, behavior: 'smooth' });
            return;
          }
          const btn = e.target.closest('[data-safe-toggle]');
          if (!btn) return;
          document.cookie =
            'safe_mode=' + (isSafe() ? 'off' : 'on') + '; path=/; max-age=31536000; samesite=lax';
          apply();
        });
        document.addEventListener('astro:page-load', apply);
        apply();
      })();

      if ('serviceWorker' in navigator) {
        addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
      }
    </script>
  </body>
</html>
