---
import { ClientRouter } from 'astro:transitions';
import * as m from '@/paraglide/messages';
import { getLocale } from '@/paraglide/runtime';
import type { Locale } from '@/lib/taxonomy';
import { accountApi } from '@/app/api/account';
import { sessionApi } from '@/app/api/session';
import Header from '@/components/organisms/layout/Header.astro';
import Footer from '@/components/organisms/layout/Footer.astro';
import BottomTabBar from '@/components/organisms/layout/BottomTabBar.astro';
import AuthModal from '@/components/organisms/auth/AuthModal.astro';
import ProfileSheet from '@/components/organisms/profile/ProfileSheet.astro';
import Lightbox from '@/components/molecules/Lightbox.astro';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow/700.css';
import '@fontsource/barlow/600-italic.css';
import '@fontsource/barlow-condensed/500.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Clean indexable URL for filtered listings (SEO: variants canonicalize here). */
  canonical?: string;
  /** Absolute URL per locale → full reciprocal hreflang set + x-default (en). */
  alternates?: Record<Locale, string>;
  /** JSON-LD objects to embed (SEO.md §4). */
  jsonLd?: unknown[];
  /** Utility pages (account, favorites): keep out of the index. */
  noindex?: boolean;
}

const { title = m.app_name(), description, canonical, alternates, jsonLd = [], noindex } = Astro.props;
const locale = getLocale();

/* Session-aware chrome: layouts may read the seam (docs/API.md). */
const session = await sessionApi.fromCookies(Astro.cookies);
const idVerified =
  session?.role === 'advertiser'
    ? (await accountApi.get(session)).idVerification === 'approved'
    : true;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex, follow" />}
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {
      alternates &&
        Object.entries(alternates).map(([l, href]) => (
          <link rel="alternate" hreflang={l} href={href} />
        ))
    }
    {alternates && <link rel="alternate" hreflang="x-default" href={alternates.en} />}
    {jsonLd.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
    <link rel="manifest" href="/manifest.webmanifest" />
    <!-- Font Awesome 8 Pro (kit: thin + brands), self-hosted from public/fa/.
         Fonts download lazily, only when a fa-* glyph is actually rendered. -->
    <link rel="stylesheet" href="/fa/css/all.min.css" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f7f7f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171717" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Intimate" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon-180.png" />
    <ClientRouter />
    <script is:inline>
      // No-flash theme: runs before first paint, and again after each view transition swap.
      (function () {
        const apply = () => {
          const t = localStorage.theme;
          document.documentElement.classList.toggle(
            'dark',
            t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches),
          );
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-background font-sans text-foreground antialiased">
    <!-- .page-zoom = the iOS push-back target when a sheet opens; fixed
         chrome (dock, dialogs) lives outside it. -->
    <div class="page-zoom">
      <Header {session} />

      <main>
        <slot />
      </main>

      <Footer />
    </div>
    <BottomTabBar {session} {idVerified} />
    <AuthModal />
    <ProfileSheet />
    <Lightbox />

    <script is:inline>
      // Safe mode (DESIGN.md §6): fail-closed. Server HTML always ships safe
      // placeholders; real photos swap in when safe mode is off. An explicit
      // cookie wins; otherwise: local dev defaults SAFE, deployed defaults NSFW
      // (it is an adult site — safe mode is the owner's build-in-public tool).
      (function () {
        const isSafe = () => {
          const c = document.cookie;
          if (c.includes('safe_mode=off')) return false;
          if (c.includes('safe_mode=on')) return true;
          return /^(localhost|127\.|192\.168\.|10\.)/.test(location.hostname);
        };
        const apply = () => {
          const on = isSafe();
          document.querySelectorAll('img[data-safe]').forEach((el) => {
            const want = on ? el.dataset.safe : el.dataset.real || el.dataset.safe;
            if (el.getAttribute('src') !== want) el.setAttribute('src', want);
          });
          document.querySelectorAll('[data-safe-video-wrap]').forEach((wrap) => {
            const video = wrap.querySelector('video');
            const fallback = wrap.querySelector('img');
            if (!video) return;
            video.classList.toggle('hidden', on);
            if (fallback) fallback.classList.toggle('hidden', !on);
            if (on) video.pause();
            else video.play().catch(() => {});
          });
          document
            .querySelectorAll('[data-safe-toggle]')
            .forEach((b) => b.setAttribute('aria-checked', String(on)));
        };
        document.addEventListener('click', (e) => {
          if (!e.target.closest) return;
          if (e.target.closest('[data-scroll-top]')) {
            window.scrollTo({ top: 0, behavior: 'smooth' });
            return;
          }
          const btn = e.target.closest('[data-safe-toggle]');
          if (!btn) return;
          document.cookie =
            'safe_mode=' + (isSafe() ? 'off' : 'on') + '; path=/; max-age=31536000; samesite=lax';
          apply();
        });
        document.addEventListener('astro:page-load', apply);
        apply();
      })();

      if ('serviceWorker' in navigator) {
        addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
      }
    </script>
  </body>
</html>
