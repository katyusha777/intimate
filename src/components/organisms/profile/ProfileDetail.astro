---
/**
 * The full profile content (hero → facts → about → services → gallery) —
 * shared by the profile page and the mobile ActionSheet, which fetches the
 * page and lifts out [data-profile-root]. The `sheet` flag adapts chrome that
 * differs between a full page and a sheet (e.g. the back control).
 */
import * as m from '@/paraglide/messages';
import type { Profile } from '@/app/models/profile';
import type { PublicAgency } from '@/app/models/org';
import { localizedDescription, profileNameAge, upcomingAvailability } from '@/app/models/profile';
import { dayLabel, serviceCategoryLabel, serviceLabel } from '@/lib/labels';
import { cityName } from '@/lib/seo';
import { DAYS, SERVICES, SERVICE_CATEGORIES } from '@/lib/taxonomy';
import VerifiedBadge from '@/components/atoms/VerifiedBadge.astro';
import AvailabilityLine from '@/components/molecules/AvailabilityLine.astro';
import DateStrip from '@/components/molecules/DateStrip.astro';
import EssentialsTags from '@/components/molecules/EssentialsTags.astro';
import GoodToKnow from '@/components/organisms/profile/GoodToKnow.astro';
import ProfileFacts from '@/components/organisms/profile/ProfileFacts.astro';
import ProfileGallery from '@/components/organisms/profile/ProfileGallery.astro';
import ProfileHero from '@/components/organisms/profile/ProfileHero.astro';
import ProfilePhotoMosaic from '@/components/organisms/profile/ProfilePhotoMosaic.astro';
import ReceiptSheet from '@/components/organisms/profile/ReceiptSheet.astro';
import ReportControl from '@/components/organisms/profile/ReportControl.astro';
import SimilarProfiles from '@/components/organisms/profile/SimilarProfiles.astro';
import type { ReplySpeed } from '@/app/models/messaging';

interface Props {
  profile: Profile;
  /** Her agency (when orgId is set), fetched at the page (app/api seam). */
  agency?: PublicAgency | null;
  /** Offline-fallback candidates (2.6), computed at the page (app/api seam). */
  similar?: Profile[];
  /** Measured reply speed (3.2), computed at the page; null → hidden. */
  replySpeed?: ReplySpeed | null;
  /** Her screening question (UX-PLAN 4.x), asked as the last step of a request. */
  screeningQuestion?: string;
  /** The signed-in owner viewing her own profile — hides the Save/favourite. */
  isOwner?: boolean;
}
const { profile: p, agency = null, similar = [], replySpeed, screeningQuestion, isOwner = false } = Astro.props;

const description = localizedDescription(p);
const serviceGroups = SERVICE_CATEGORIES.map((cat) => ({
  cat,
  items: SERVICES[cat].filter((s) => (p.services as readonly string[]).includes(s)),
})).filter((g) => g.items.length > 0);

const hours = p.openingHours ?? {};
const hasHours = DAYS.some((d) => hours[d]);
const hasDates = upcomingAvailability(p).length > 0;
// Amsterdam weekday, not the server's UTC one (they differ 00:00–02:00 CEST).
const todayKey = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Amsterdam', weekday: 'short' })
  .format(new Date())
  .toLowerCase()
  .slice(0, 3);
function hoursLabel(h: (typeof hours)[keyof typeof hours]): string {
  if (!h || h.closed) return m.hours_closed();
  if (h.allDay) return m.hours_allday();
  return h.from && h.to ? `${h.from} – ${h.to}` : m.hours_closed();
}
---

<div data-profile-root data-lightbox-group data-profile-slug={p.slug}>
  <!-- Marks a profile view (full page or lifted into the sheet) so Layout's
       post-paint refresh knows to re-fetch the live availability badge — the
       one bit the 24h page cache leaves out. -->
  <span data-avail-refresh hidden></span>
  <!-- Mobile: immersive full-viewport hero (tap → lightbox), the photo grid
       directly beneath it — gallery first, facts after. (The grid is ALSO the
       canonical lightbox photo source, hidden-but-present on desktop.) -->
  <div class="md:hidden">
    <ProfileHero profile={p} {replySpeed} {isOwner} />
  </div>
  <section class="mt-0.5 md:hidden">
    <ProfileGallery photos={p.photos} keyBase={p.id} alt={p.name} />
  </section>

  <!-- One shared trust receipt for this profile (3.1): opened by delegation
       from every verified mark (hero, desktop h1, deal-card link). Lives inside
       [data-profile-root] so the mobile ProfileSheet lifts it with the page. -->
  <ReceiptSheet profile={p} {replySpeed} />

  <!-- Desktop: title + horizontal photo strip (uncropped 3:4 cells). -->
  <div class="mx-auto hidden max-w-7xl px-6 pt-8 md:block">
    <div class="mb-4 flex items-end justify-between gap-4">
      <div>
        <h1 class="flex items-center gap-2.5 font-condensed text-3xl font-bold tracking-tight lg:text-4xl">
          {profileNameAge(p)}
          <VerifiedBadge receiptFor={p.id} class="size-6" />
        </h1>
        <p class="mt-1.5 flex items-center gap-2 text-sm text-muted-foreground">
          <!-- One availability truth line (2.3), shared component. -->
          <AvailabilityLine profile={p} variant="line" class="font-medium text-foreground" />
          <span aria-hidden="true">·</span>
          {cityName(p.city)}
          <span aria-hidden="true">·</span>
          {p.photos.length} {m.photos_title().toLowerCase()}
          {
            replySpeed && (
              <>
                <span aria-hidden="true">·</span>
                <span class="font-medium text-foreground">{m.receipt_reply_speed({ min: replySpeed.medianMinutes })}</span>
              </>
            )
          }
        </p>
      </div>
      {
        !isOwner && (
          <button
            type="button"
            data-fav-toggle
            data-fav-slug={p.slug}
            aria-label={m.nav_favorites()}
            class="flex flex-none cursor-pointer items-center gap-2 text-sm font-semibold underline-offset-4 transition-colors hover:text-brand hover:underline"
          >
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7Z" /></svg>
            {m.profile_save()}
          </button>
        )
      }
    </div>
    <ProfilePhotoMosaic photos={p.photos} keyBase={p.id} alt={p.name} />
  </div>

  <div class="mx-auto max-w-7xl px-4 py-8 md:px-6 md:py-12" id="profile-details">
    <div class="grid items-start gap-8 lg:grid-cols-[1fr_22rem] lg:gap-12">
      <ProfileFacts profile={p} {agency} {replySpeed} {screeningQuestion} class="order-first w-full lg:order-last" />

      <div class="min-w-0 space-y-10">
        <!-- Essentials chips (kinky-style): key specifics scannable up top. -->
        <EssentialsTags profile={p} />

        <section>
          <h2 class="display text-2xl md:text-3xl">{m.profile_about()}</h2>
          <p class="mt-4 max-w-2xl leading-relaxed">{description}</p>
        </section>

        <section>
          <h2 class="display text-2xl md:text-3xl">{m.filter_services()}</h2>
          <!-- Quiet rows, exactly like GOOD TO KNOW below — the white chips
               read as buttons and shouted over the page. -->
          <dl class="mt-4 max-w-2xl">
            {
              serviceGroups.map((g) => (
                <div class="flex items-baseline justify-between gap-4 border-b border-border py-2.5 text-sm">
                  <dt class="eyebrow flex-none text-2xs text-muted-foreground">
                    {serviceCategoryLabel(g.cat)}
                  </dt>
                  <dd class="min-w-0 break-words text-right font-medium">
                    {g.items.map(serviceLabel).join(', ')}
                  </dd>
                </div>
              ))
            }
          </dl>
        </section>

        <!-- Good-to-know rows (2.5): structured facts after SERVICES. -->
        <section>
          <h2 class="display text-2xl md:text-3xl">{m.gtk_title()}</h2>
          <GoodToKnow profile={p} class="mt-4 max-w-2xl" />
        </section>

        {
          (hasHours || hasDates) && (
            <section>
              <div class="flex items-baseline justify-between gap-4">
                <h2 class="display text-2xl md:text-3xl">{m.hours_title()}</h2>
                {/* "Today until 23:00" lives with the hours — contextual, not next to price. */}
                <AvailabilityLine profile={p} variant="line" class="text-sm font-medium text-foreground" />
              </div>
              {/* Agency-style date calendar first — dates override weekdays. */}
              {hasDates && <DateStrip profile={p} class="mt-4 max-w-md" />}
              {/* Always the full week — today highlighted (feedback v7 #4: the
                  "show all days" toggle read as a label, not a button). */}
              {hasHours && (
              <div class="mt-4 max-w-md divide-y divide-border">
                {DAYS.map((day) => (
                  <div
                    class:list={[
                      'flex items-center justify-between py-2.5 text-sm',
                      day === todayKey && 'font-semibold',
                    ]}
                  >
                    <span class:list={[day === todayKey ? 'text-foreground' : 'text-muted-foreground']}>
                      {dayLabel(day)}
                    </span>
                    <span class:list={[day === todayKey ? 'text-foreground' : 'text-muted-foreground']}>
                      {hoursLabel(hours[day])}
                    </span>
                  </div>
                ))}
              </div>
              )}
            </section>
          )
        }

        <div class="border-t border-border pt-5">
          <ReportControl profileId={p.id} profileSlug={p.slug} profileName={p.name} />
        </div>
      </div>
    </div>

    <!-- Offline fallback (2.6): keeps the loop alive ONLY when she's away. -->
    <div class="mt-10">
      <SimilarProfiles profile={p} {similar} />
    </div>
  </div>
</div>
