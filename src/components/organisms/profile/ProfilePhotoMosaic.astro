---
/**
 * Desktop photo strip: her photos are PORTRAITS, so a mosaic of wide crops
 * fought every image. Instead: a horizontal snap strip of uncropped 3:4
 * cells — works for any photo count, in the slide-over and full-width alike.
 * Each cell opens the shared lightbox at its index; SHOW ALL floats bottom-
 * right. Desktop only — mobile keeps the immersive hero + square grid.
 */
import * as m from '@/paraglide/messages';
import Button from '@/components/atoms/Button.astro';
import SafeImage from '@/components/atoms/SafeImage.astro';

interface Props {
  photos: string[];
  keyBase: string;
  alt: string;
  class?: string;
}
const { photos, keyBase, alt, class: className } = Astro.props;
const n = photos.length;
/* 1–3 photos: a fixed 3-column grid — a lone portrait stretched full-width read
   awful, so empty slots become skeleton-toned filler cells (never a wide crop).
   4+: the 3:4 snap strip, side-scrollable. */
const fills = n <= 3;
const placeholders = fills ? 3 - n : 0;
---

<div class:list={['relative', className]}>
  <div
    class:list={[
      'h-[26rem] gap-2 rounded-xl lg:h-[30rem]',
      fills
        ? 'grid grid-cols-3'
        : 'flex snap-x snap-mandatory overflow-x-auto overscroll-x-contain [scrollbar-width:none] [&::-webkit-scrollbar]:hidden',
    ]}
  >
    {
      photos.map((photo, i) => (
        <button
          type="button"
          data-lightbox
          data-lightbox-index={i}
          aria-label={`${alt} — ${i + 1}`}
          class:list={[
            'group relative cursor-pointer overflow-hidden rounded-xl bg-neutral-950',
            fills ? 'h-full w-full' : 'aspect-[3/4] h-full flex-none snap-start',
          ]}
        >
          <SafeImage
            imageKey={`${keyBase}-${i}`}
            src={photo}
            alt={`${alt} — ${i + 1}`}
            class="h-full w-full transition duration-200 group-hover:brightness-90"
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        </button>
      ))
    }
    {
      Array.from({ length: placeholders }).map(() => (
        <div class="h-full w-full rounded-xl bg-foreground/10" aria-hidden="true" />
      ))
    }
  </div>

  <!-- The SECONDARY button (plain anaglyph slab, no pink/cyan). -->
  {
    n > 1 && (
      <Button
        variant="secondary"
        size="sm"
        data-lightbox
        data-lightbox-index="0"
        class="absolute bottom-4 right-4"
      >
        {m.profile_show_all()}
      </Button>
    )
  }
</div>
