---
/**
 * Airbnb-style photo mosaic for the desktop profile header. Count-aware:
 * 1 → single · 2 → split · 3 → big-left + 2 · 4 → 2×2 · 5+ → big-left + 2×2
 * with a "Show all photos" button. Each cell (and the button) opens the shared
 * lightbox at its index. Desktop only — mobile keeps the immersive hero.
 */
import * as m from '@/paraglide/messages';
import SafeImage from '@/components/atoms/SafeImage.astro';

interface Props {
  photos: string[];
  keyBase: string;
  alt: string;
  class?: string;
}
const { photos, keyBase, alt, class: className } = Astro.props;

const n = photos.length;
const bucket = Math.min(n, 5); // how many cells the mosaic shows
const shown = photos.slice(0, bucket);

const gridClass =
  bucket === 1
    ? 'grid-cols-1 grid-rows-1'
    : bucket === 2
      ? 'grid-cols-2 grid-rows-1'
      : bucket === 5
        ? 'grid-cols-4 grid-rows-2'
        : 'grid-cols-2 grid-rows-2'; // 3 and 4

const cellSpan = (i: number) =>
  i === 0 && bucket === 3
    ? 'row-span-2'
    : i === 0 && bucket === 5
      ? 'col-span-2 row-span-2'
      : '';
---

<div class:list={['relative', className]}>
  <div class:list={['grid h-[20rem] gap-2 overflow-hidden rounded-xl lg:h-[28rem]', gridClass]}>
    {
      shown.map((photo, i) => (
        <button
          type="button"
          data-lightbox
          data-lightbox-index={i}
          aria-label={`${alt} — ${i + 1}`}
          class:list={['group relative cursor-pointer overflow-hidden bg-neutral-950', cellSpan(i)]}
        >
          <SafeImage
            imageKey={`${keyBase}-${i}`}
            src={photo}
            alt={`${alt} — ${i + 1}`}
            class="h-full w-full transition duration-200 group-hover:brightness-90"
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        </button>
      ))
    }
  </div>

  {
    n > 1 && (
      <button
        type="button"
        data-lightbox
        data-lightbox-index="0"
        class="rounded-md absolute bottom-4 right-4 flex cursor-pointer items-center gap-2 border border-foreground bg-background px-4 py-2 text-sm font-semibold shadow-soft transition-transform active:scale-95"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
        {m.profile_show_all()}
      </button>
    )
  }
</div>
