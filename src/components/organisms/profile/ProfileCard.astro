---
/**
 * THE profile card — one component, three variants (CLAUDE.md / DESIGN.md §3.2).
 * grid: uniform portrait card for listings · featured: carousel + info side-by-side
 * compact: horizontal row for favorites/suggestions/similar.
 */
import * as m from '@/paraglide/messages';
import { localizedDescription, type Profile } from '@/app/models/profile';
import { localizePath } from '@/lib/i18n';
import { genderLabel, serviceLabel } from '@/lib/labels';
import { CITIES } from '@/lib/taxonomy';
import SafeImage from '@/components/atoms/SafeImage.astro';
import PhotoCarousel from '@/components/molecules/PhotoCarousel.astro';
import VerifiedBadge from '@/components/atoms/VerifiedBadge.astro';
import Badge from '@/components/atoms/Badge.astro';

interface Props {
  profile: Profile;
  variant?: 'grid' | 'featured' | 'compact';
  loading?: 'lazy' | 'eager';
}

const { profile: p, variant = 'grid', loading = 'lazy' } = Astro.props;
const cityName = CITIES.find((c) => c.slug === p.city)?.name ?? p.city;
const href = localizePath(`/profile/${p.slug}/`);

/* Misprint "randomness": each card's ink slab gets its own position, tilt and
 * cut — deterministic from the profile id, so it's stable across renders. */
const SLABS = [
  { pos: 'left-1 right-2 bottom-1', rot: -1.1, clip: 'polygon(0 10px, 100% 0, 100% calc(100% - 6px), 0 100%)' },
  { pos: 'left-2 right-1 bottom-2', rot: 0.9, clip: 'polygon(0 0, 100% 8px, 100% 100%, 0 calc(100% - 8px))' },
  { pos: 'left-1 right-1 bottom-1.5', rot: -0.5, clip: 'polygon(0 6px, 100% 0, 100% calc(100% - 10px), 0 100%)' },
  { pos: 'left-2.5 right-1 bottom-1', rot: 1.2, clip: 'polygon(0 0, 100% 10px, 100% calc(100% - 4px), 0 100%)' },
  { pos: 'left-1 right-2.5 bottom-2.5', rot: -0.8, clip: 'polygon(0 8px, 100% 0, 100% 100%, 0 calc(100% - 10px))' },
];
const slab = SLABS[[...p.id].reduce((s, c) => s + c.charCodeAt(0), 0) % SLABS.length]!;
---

{
  variant === 'grid' && (
    <a
      href={href}
      class="group relative block aspect-[3/4] transition-transform duration-200 active:scale-[0.98]"
    >
      <div class="absolute inset-0 overflow-hidden rounded-lg bg-neutral-950 shadow-soft transition-shadow duration-200 group-hover:shadow-soft-lg">
        <PhotoCarousel photos={p.photos} keyBase={p.id} alt={p.name} class="h-full" {loading} />
      </div>
      <button
        type="button"
        aria-label={m.nav_favorites()}
        class="card-heart absolute right-2 top-2 grid size-9 cursor-pointer place-items-center bg-neutral-950 text-white transition-transform active:scale-90"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7Z" /></svg>
      </button>
      {p.online && (
        <span class="card-heart absolute left-2 top-2 flex items-center gap-1.5 bg-neutral-950 px-2.5 py-1.5 text-xs font-medium text-white">
          <span class="size-1.5 rounded-full bg-online" />
          {m.online_now()}
        </span>
      )}
      <!-- Ink slab floating WITHIN the photo (Misprint) — solid black,
           per-card position/tilt/cut so the grid feels hand-placed. -->
      <div
        class:list={['absolute bg-neutral-950 p-4 text-white', slab.pos]}
        style={`clip-path: ${slab.clip}; transform: rotate(${slab.rot}deg)`}
      >
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="flex items-center gap-1 font-condensed text-lg font-semibold leading-snug">
              <span class="truncate">{p.name}, {p.age}</span>
              {p.verified && <VerifiedBadge />}
            </p>
            <p class="truncate text-sm text-white/60">{cityName}</p>
          </div>
          <p class="flex-none pt-0.5 text-base font-semibold">€{p.priceFrom}</p>
        </div>
        <p class="mt-2 truncate text-xs text-white/50">
          {genderLabel(p.gender)}
          {p.services[0] && ` · ${serviceLabel(p.services[0])}`}
          {p.services.length > 1 && ` · +${p.services.length - 1}`}
        </p>
      </div>
    </a>
  )
}

{
  variant === 'featured' && (
    <article class="group relative overflow-hidden rounded-2xl bg-card shadow-soft transition-shadow hover:shadow-soft-lg dark:ring-1 dark:ring-border sm:grid sm:grid-cols-[2fr_3fr]">
      <div class="relative aspect-[3/4] sm:aspect-auto sm:h-full sm:min-h-72">
        <PhotoCarousel photos={p.photos} keyBase={p.id} alt={p.name} class="h-full" />
        <Badge class="glass-media absolute left-3 top-3 border">{m.section_featured()}</Badge>
      </div>
      <div class="flex flex-col justify-between gap-3 p-5">
        <div class="space-y-1.5">
          <h3 class="flex items-center gap-1.5 font-condensed text-xl font-semibold tracking-tight">
            <a href={href} class="after:absolute after:inset-0">{p.name}, {p.age}</a>
            {p.verified && <VerifiedBadge class="size-4.5" />}
            {p.online && (
              <span class="ml-auto flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
                <span class="size-1.5 rounded-full bg-online" />
                {m.online_now()}
              </span>
            )}
          </h3>
          <p class="text-sm text-muted-foreground">{cityName}</p>
          <p class="text-sm leading-relaxed">{localizedDescription(p)}</p>
        </div>
        <p class="text-sm">
          <span class="text-muted-foreground">{m.price_from()}</span>
          <span class="text-base font-semibold"> €{p.priceFrom}</span>
        </p>
      </div>
    </article>
  )
}

{
  variant === 'compact' && (
    <a
      href={href}
      class="group flex items-center gap-3 rounded-lg p-2 transition-colors hover:bg-muted"
    >
      <SafeImage imageKey={p.id} src={p.photos[0]} alt={p.name} class="size-14 flex-none rounded-lg" {loading} />
      <div class="min-w-0 flex-1">
        <p class="flex items-center gap-1 truncate font-condensed text-base font-semibold">
          {p.name}, {p.age}
          {p.verified && <VerifiedBadge class="size-3.5" />}
        </p>
        <p class="truncate text-xs text-muted-foreground">{cityName}</p>
      </div>
      <p class="flex-none text-sm font-semibold">€{p.priceFrom}</p>
    </a>
  )
}


<style>
  /* Heart + online flag are mini ink slabs like the arrows. */
  .card-heart {
    clip-path: polygon(0 3px, 100% 0, 100% calc(100% - 3px), 0 100%);
  }
</style>
