---
/**
 * Immersive profile hero (mobile-first, DESIGN §1.1): full-viewport swipeable
 * slideshow with story bars, back/heart chrome, and the identity block on a
 * bottom scrim. The chevron leads to the details below the fold.
 */
import * as m from '@/paraglide/messages';
import type { Profile } from '@/app/models/profile';
import { serviceLabel } from '@/lib/labels';
import { cityName } from '@/lib/seo';
import PhotoCarousel from '@/components/molecules/PhotoCarousel.astro';
import VerifiedBadge from '@/components/atoms/VerifiedBadge.astro';

interface Props {
  profile: Profile;
}
const { profile: p } = Astro.props;
---

<section class="relative h-[72dvh] min-h-[26rem] overflow-hidden bg-neutral-950 md:h-[75vh]" data-profile-hero>
  <PhotoCarousel photos={p.photos} keyBase={p.id} alt={p.name} class="h-full" loading="eager" swipe bars />

  <!-- top chrome (below the story bars) -->
  <button
    type="button"
    data-hero-back
    aria-label="Back"
    class="card-heart absolute left-3 top-7 grid size-10 cursor-pointer place-items-center bg-neutral-950/90 text-white transition-transform active:scale-90"
  >
    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
  </button>
  <button
    type="button"
    aria-label={m.nav_favorites()}
    class="card-heart absolute right-3 top-7 grid size-10 cursor-pointer place-items-center bg-neutral-950/90 text-white transition-transform active:scale-90"
  >
    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7Z" /></svg>
  </button>

  <!-- identity block on a fixed dark scrim (overlay on photo → theme-independent) -->
  <div class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/85 via-black/40 to-transparent pt-28">
    <div class="mx-auto max-w-7xl px-4 pb-10 text-white md:px-6">
      <h1 class="flex items-center gap-2.5 font-condensed text-4xl font-bold tracking-tight md:text-5xl">
        {p.name}, {p.age}
        <VerifiedBadge class="size-6" />
      </h1>
      <p class="mt-1.5 flex items-center gap-2 text-sm text-white/80">
        {p.online && (
          <span class="flex items-center gap-1.5">
            <span class="size-1.5 rounded-full bg-online"></span>
            {m.online_now()}
          </span>
        )}
        {p.online && <span aria-hidden="true">·</span>}
        {cityName(p.city)}
        <span aria-hidden="true">·</span>
        {m.price_from()} <span class="font-semibold text-white">€{p.priceFrom}</span>
      </p>
      <div class="mt-3.5 flex flex-wrap gap-1.5">
        {
          p.services.slice(0, 3).map((s) => (
            <span class="slab-cut border border-white/30 px-2.5 py-1 text-xs font-medium text-white/90">
              {serviceLabel(s)}
            </span>
          ))
        }
        {p.services.length > 3 && (
          <span class="slab-cut border border-white/30 px-2.5 py-1 text-xs font-medium text-white/90">
            +{p.services.length - 3}
          </span>
        )}
      </div>
    </div>
  </div>

  <a
    href="#profile-details"
    aria-label={m.profile_about()}
    class="absolute bottom-2.5 left-1/2 -translate-x-1/2 animate-bounce p-2 text-white/80 transition-colors hover:text-white"
  >
    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
  </a>
</section>

<script>
  function initHeroBack() {
    document.querySelectorAll<HTMLElement>('[data-hero-back]').forEach((btn) => {
      if (btn.dataset.init) return;
      btn.dataset.init = '1';
      btn.addEventListener('click', () => history.back());
    });
  }
  initHeroBack();
  document.addEventListener('astro:page-load', initHeroBack);
</script>
