---
/**
 * Immersive profile hero (mobile-first, DESIGN §1.1): one full-viewport photo
 * with back/heart chrome and the identity block on a bottom scrim. Tapping the
 * photo opens the fullscreen lightbox (the whole slideshow lives there now —
 * fewer competing elements up top). The chevron leads to the details.
 */
import * as m from '@/paraglide/messages';
import { profileNameAge, type Profile } from '@/app/models/profile';
import type { ReplySpeed } from '@/app/models/messaging';
import { cityName } from '@/lib/seo';
import SafeImage from '@/components/atoms/SafeImage.astro';
import VerifiedBadge from '@/components/atoms/VerifiedBadge.astro';
import AvailabilityLine from '@/components/molecules/AvailabilityLine.astro';

interface Props {
  profile: Profile;
  /** Measured reply speed (3.2); null → hidden. */
  replySpeed?: ReplySpeed | null;
  /** Owner viewing her own profile → no Save/favourite heart. */
  isOwner?: boolean;
}
const { profile: p, replySpeed, isOwner = false } = Astro.props;
---

<section class="relative h-[72dvh] min-h-[26rem] overflow-hidden bg-neutral-950 md:h-[75vh]" data-profile-hero>
  <!-- Tap the photo → lightbox (opens the gallery at the first image). -->
  <button
    type="button"
    data-lightbox
    data-lightbox-index="0"
    aria-label={m.profile_gallery()}
    class="absolute inset-0 h-full w-full cursor-pointer"
  >
    <SafeImage imageKey={`${p.id}-0`} src={p.photos[0]} alt={p.name} class="h-full w-full" loading="eager" fetchpriority="high" />
  </button>

  <!-- top chrome -->
  <button
    type="button"
    data-hero-back
    aria-label="Back"
    class="card-heart absolute left-3 top-7 z-10 grid size-10 cursor-pointer place-items-center bg-neutral-950/90 text-white transition-transform active:scale-90"
  >
    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
  </button>
  {
    !isOwner && (
      <button
        type="button"
        data-fav-toggle
        data-fav-slug={p.slug}
        aria-label={m.nav_favorites()}
        class="card-heart absolute right-3 top-7 z-10 grid size-10 cursor-pointer place-items-center bg-neutral-950/90 text-white transition-transform active:scale-90"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7Z" /></svg>
      </button>
    )
  }

  <!-- photo-count pill: hints the tap-for-gallery affordance -->
  {
    p.photos.length > 1 && (
      <span class="card-heart pointer-events-none absolute right-3 top-20 z-10 flex items-center gap-1.5 bg-neutral-950/90 px-2.5 py-1.5 text-xs font-medium text-white">
        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="14" height="14" rx="1" /><path d="M21 7v13a1 1 0 0 1-1 1H7" /></svg>
        {p.photos.length}
      </span>
    )
  }

  <!-- identity block on a fixed dark scrim (overlay on photo → theme-independent) -->
  <div class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/85 via-black/40 to-transparent pt-28">
    <div class="mx-auto max-w-7xl px-4 pb-10 text-white md:px-6">
      <h1 class="flex items-center gap-2.5 font-condensed text-4xl font-bold tracking-tight md:text-5xl">
        {profileNameAge(p)}
        <VerifiedBadge receiptFor={p.id} class="size-6" />
      </h1>
      <p class="mt-1.5 flex items-center gap-2 text-sm text-white/80">
        <!-- One availability truth line (2.3), shared component (card variant
             reads white-on-ink, matching the scrim). -->
        <AvailabilityLine profile={p} variant="card" class="text-sm text-white/90" />
        <span aria-hidden="true">·</span>
        {cityName(p.city)}
        {p.priceFrom > 0 && (
          <Fragment>
            <span aria-hidden="true">·</span>
            {m.price_from()} <span class="font-semibold text-white">€{p.priceFrom}</span>
          </Fragment>
        )}
      </p>
      {
        replySpeed && (
          <p class="mt-1 flex items-center gap-1.5 text-sm text-white/80">
            <VerifiedBadge class="size-3.5 text-white" />
            {m.receipt_reply_speed({ min: replySpeed.medianMinutes })}
          </p>
        )
      }
      <!-- No service tags on the hero — SERVICES below already says it;
           the photo stays clean. -->
    </div>
  </div>

  <a
    href="#profile-details"
    aria-label={m.profile_about()}
    class="absolute bottom-0.5 left-1/2 z-10 -translate-x-1/2 animate-bounce p-2 text-white/80 transition-colors hover:text-white"
  >
    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
  </a>
</section>

<!-- Back button is delegated globally in ProfileSheet.astro; the lightbox
     trigger is handled by molecules/Lightbox.astro. -->
