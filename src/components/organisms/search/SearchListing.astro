---
/**
 * Listing page body. Architecture (docs/API.md): tabs are presets over ONE
 * profile pool, never partitions; tab + city live in the URL PATH (indexable),
 * everything else is querystring; gender/city/online-now are persistent quick
 * chips; the rest lives in the filter panel (sidebar on lg, behind a Filters
 * button on mobile). One GET <form> + SSR = zero client state.
 */
import * as m from '@/paraglide/messages';
import { genderLabel, sortLabel } from '@/lib/labels';
import { CITIES, GENDERS, SORT_OPTIONS } from '@/lib/taxonomy';
import { LISTING_CATEGORIES, type Locale } from '@/lib/taxonomy';
import { getLocale } from '@/paraglide/runtime';
import { PAGE_SIZE, type ProfileList, type ProfileListParams } from '@/app/models/profile';
import Icon from '@/components/atoms/Icon.astro';
import FilterSidebar from '@/components/organisms/search/FilterSidebar.astro';
import ProfileCard from '@/components/organisms/profile/ProfileCard.astro';

interface Props {
  title: string;
  /** Answer-first stat sentence (SEO.md §3). */
  intro?: string;
  /** Visible freshness stamp. */
  updated?: string;
  params: ProfileListParams;
  result: ProfileList;
  /** Path for this tab WITHOUT the city segment, e.g. `/search/` or `/service/escort/`. */
  tabPath: string;
  currentUrl: URL;
  /** 'navigate' on meeting-type tabs — visit radios switch tabs (see FilterSidebar). */
  visitMode?: 'query' | 'navigate';
  openCategory?: string;
}

const { title, intro, updated, params, result, tabPath, currentUrl, visitMode = 'query', openCategory } =
  Astro.props;

const locale = getLocale() as Locale;

// Tab paths for visit-type navigation, derived from taxonomy (never hardcoded).
const incallSlug = LISTING_CATEGORIES.find(
  (c) => 'meetingType' in c.filter && c.filter.meetingType === 'incall',
)!.slugs[locale];
const outcallSlug = LISTING_CATEGORIES.find(
  (c) => 'meetingType' in c.filter && c.filter.meetingType === 'outcall',
)!.slugs[locale];

/** City lives in the path: `${tabPath}${city}/`. */
const basePath = params.city ? `${tabPath}${params.city}/` : tabPath;

const selectedGenders = new Set(params.genders ?? []);
const page = Math.floor((params.offset ?? 0) / PAGE_SIZE) + 1;
const pageCount = Math.max(1, Math.ceil(result.total / PAGE_SIZE));

function pageHref(p: number): string {
  const sp = new URLSearchParams(currentUrl.searchParams);
  if (p <= 1) sp.delete('page');
  else sp.set('page', String(p));
  const qs = sp.toString();
  return qs ? `${basePath}?${qs}` : basePath;
}

/* Misprint chip: cut keyline slab on bare canvas; checked = ink flip. */
const chip =
  'slab-cut flex h-9 cursor-pointer select-none items-center gap-2 border border-foreground/20 px-3 text-sm font-medium transition-colors hover:border-foreground/60 active:scale-[0.96]';
---

<form
  method="get"
  action={basePath}
  data-listing-form
  data-tab-path={tabPath}
  data-city={params.city ?? ''}
  data-visit-any-path={`/${locale}/search/`}
  data-visit-incall-path={`/${locale}/${incallSlug}/`}
  data-visit-outcall-path={`/${locale}/${outcallSlug}/`}
>
  {params.q && <input type="hidden" name="q" value={params.q} />}

  <div class="mb-6">
    <h1 class="display text-3xl md:text-4xl">{title}</h1>
    <p class="mt-1.5 max-w-2xl text-sm text-muted-foreground">
      {intro ?? m.results_count({ count: result.total })}
    </p>
    {updated && <p class="eyebrow mt-1.5">{updated}</p>}
  </div>

  <div class="grid items-start gap-x-6 gap-y-4 lg:grid-cols-[17rem_1fr]">
    <!-- Control rail: single scrollable line on mobile (app-style), wraps on lg.
         The combobox in the header drives the hidden data-city-nav select
         (path navigation); it is the MAIN location state. -->
    <div
      class="-mx-4 flex items-center gap-2 overflow-x-auto px-4 [scrollbar-width:none] lg:col-start-2 lg:mx-0 lg:flex-wrap lg:overflow-visible lg:px-0 [&::-webkit-scrollbar]:hidden"
    >
      <select data-city-nav aria-hidden="true" tabindex="-1" class="sr-only">
        <option value="" selected={!params.city} />
        {CITIES.map((c) => <option value={c.slug} selected={params.city === c.slug} />)}
      </select>

      <button type="button" data-toggle-filters class:list={[chip, 'flex-none lg:hidden']}>
        <Icon name="sliders" class="text-muted-foreground" />
        {m.filter_title()}
      </button>

      <!-- Gender chips: mobile only — on lg the sidebar group owns gender
           (the script disables whichever set is hidden, so values never double). -->
      <div class="flex flex-none items-center gap-2 lg:hidden" data-gender-mobile>
        {
          GENDERS.map((g) => (
            <label class="flex-none">
              <input
                type="checkbox"
                name="genders"
                value={g}
                checked={selectedGenders.has(g)}
                class="peer sr-only"
              />
              <span class:list={[chip, 'peer-checked:border-foreground peer-checked:bg-foreground peer-checked:text-background']}>
                <span class="chip-box" aria-hidden="true" />
                {genderLabel(g)}
              </span>
            </label>
          ))
        }
        {
          selectedGenders.size > 0 && (
            <button
              type="button"
              data-clear-genders
              class="flex-none cursor-pointer px-1 text-xs text-muted-foreground underline-offset-2 transition-colors hover:text-foreground hover:underline"
            >
              {m.filter_clear()}
            </button>
          )
        }
      </div>

      <label class="flex h-9 flex-none cursor-pointer select-none items-center gap-2.5 whitespace-nowrap px-2 text-sm font-medium">
        <input type="checkbox" name="online" checked={params.onlineOnly} class="sr-only" />
        <span class="switch-track" aria-hidden="true"></span>
        {m.filter_online()}
      </label>

      <label class="flex flex-none items-center text-sm lg:ml-auto">
        <span class="slab-cut relative inline-flex h-9 items-center border border-foreground/20 transition-colors hover:border-foreground/60">
          <select
            name="sort"
            aria-label={m.sort_by()}
            class="h-full cursor-pointer appearance-none bg-transparent pl-3.5 pr-8 text-base font-medium outline-none md:text-sm"
          >
            {
              SORT_OPTIONS.map((s) => (
                <option value={s} selected={(params.sort ?? 'newest') === s}>
                  {sortLabel(s)}
                </option>
              ))
            }
          </select>
          <Icon name="chevron-down" class="pointer-events-none absolute right-3 text-xs text-muted-foreground" />
        </span>
      </label>
    </div>

    <!-- Filter panel: opens under the rail on mobile; the always-open sidebar
         column on lg (placed into column 1 across both rows). -->
    <details
      data-filter-panel
      class="min-w-0 lg:col-start-1 lg:row-span-2 lg:row-start-1"
    >
      <summary class="hidden"></summary>
      <FilterSidebar params={params} resetHref={basePath} {visitMode} {openCategory} />
    </details>

    <div class="lg:col-start-2">
      {
        result.items.length > 0 ? (
          <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 xl:grid-cols-4">
            {result.items.map((p, i) => (
              <ProfileCard profile={p} loading={i < 6 ? 'eager' : 'lazy'} />
            ))}
          </div>
        ) : (
          <div class="grid place-items-center rounded-2xl bg-card py-24 text-center shadow-soft dark:ring-1 dark:ring-border">
            <div class="space-y-2">
              <Icon name="face-monocle" class="text-3xl text-muted-foreground" />
              <p class="font-semibold">{m.results_count({ count: 0 })}</p>
              <a href={basePath} class="text-sm text-brand underline-offset-2 hover:underline">
                {m.filter_reset()}
              </a>
            </div>
          </div>
        )
      }

      {
        pageCount > 1 && (
          <nav class="mt-8 flex items-center justify-center gap-2" aria-label="Pagination">
            {page > 1 && (
              <a href={pageHref(page - 1)} class="flex h-10 items-center gap-2 border border-foreground/20 px-4 text-sm font-medium transition-colors hover:border-foreground/60">
                <Icon name="chevron-left" class="text-xs" />
                {m.pagination_prev()}
              </a>
            )}
            <span class="px-3 text-sm text-muted-foreground">
              {page} / {pageCount}
            </span>
            {page < pageCount && (
              <a href={pageHref(page + 1)} class="flex h-10 items-center gap-2 border border-foreground/20 px-4 text-sm font-medium transition-colors hover:border-foreground/60">
                {m.pagination_next()}
                <Icon name="chevron-right" class="text-xs" />
              </a>
            )}
          </nav>
        )
      }
    </div>
  </div>
</form>

<script>
  // Auto-submit on change (SSR filters, zero client state). City navigates the
  // PATH (`${tabPath}${city}/`) keeping the remaining querystring. The filter
  // panel is a <details> that stays forced-open on desktop.
  // Filter submits are full SSR navigations — restore the scroll position so
  // clicking a filter never jumps the page. Re-asserted after paint because
  // the browser applies its own to-top scroll around load time.
  function restoreScroll() {
    const saved = sessionStorage.getItem('listing-scroll');
    if (saved === null) return;
    sessionStorage.removeItem('listing-scroll');
    const y = Number(saved);
    const assert = () => window.scrollTo({ top: y, behavior: 'instant' });
    assert();
    requestAnimationFrame(assert);
    setTimeout(assert, 60);
  }

  function initListingForm() {
    restoreScroll();

    // Gender lives twice (mobile chips / desktop sidebar) — only the visible
    // set may submit, so the hidden one is disabled.
    const mqLg = matchMedia('(min-width: 64rem)');
    const syncGender = () => {
      document
        .querySelectorAll<HTMLInputElement>('[data-gender-mobile] input')
        .forEach((i) => (i.disabled = mqLg.matches));
      document
        .querySelectorAll<HTMLInputElement>('[data-gender-desktop] input')
        .forEach((i) => (i.disabled = !mqLg.matches));
    };
    if (!(window as any).__genderMq) {
      (window as any).__genderMq = true;
      mqLg.addEventListener('change', syncGender);
    }
    syncGender();

    document.querySelectorAll<HTMLFormElement>('form[data-listing-form]').forEach((form) => {
      if (form.dataset.init) return;
      form.dataset.init = '1';

      form.querySelector('[data-toggle-filters]')?.addEventListener('click', () => {
        const panel = form.querySelector<HTMLDetailsElement>('[data-filter-panel]');
        if (panel) panel.open = !panel.open;
      });

      form.querySelector('[data-clear-genders]')?.addEventListener('click', () => {
        form
          .querySelectorAll<HTMLInputElement>('input[name="genders"]')
          .forEach((i) => (i.checked = false));
        sessionStorage.setItem('listing-scroll', String(window.scrollY));
        form.requestSubmit();
      });

      form.addEventListener('change', (e) => {
        sessionStorage.setItem('listing-scroll', String(window.scrollY));
        const t = e.target as HTMLElement;
        const citySeg = () => (form.dataset.city ? `${form.dataset.city}/` : '');

        const cityNav = t.closest('[data-city-nav]') as HTMLSelectElement | null;
        if (cityNav) {
          form.dataset.city = cityNav.value;
          form.action = form.dataset.tabPath! + citySeg();
        }

        const visitNav = t.closest('[data-visit-nav]') as HTMLInputElement | null;
        if (visitNav) {
          const tab =
            visitNav.value === 'incall'
              ? form.dataset.visitIncallPath!
              : visitNav.value === 'outcall'
                ? form.dataset.visitOutcallPath!
                : form.dataset.visitAnyPath!;
          form.action = tab + citySeg();
        }

        form.requestSubmit();
      });
    });

    const mq = matchMedia('(min-width: 64rem)');
    const sync = () =>
      document.querySelectorAll<HTMLDetailsElement>('[data-filter-panel]').forEach((d) => {
        if (mq.matches) d.open = true;
      });
    if (!(window as any).__filterPanelMq) {
      (window as any).__filterPanelMq = true;
      mq.addEventListener('change', sync);
    }
    sync();
  }
  initListingForm();
  document.addEventListener('astro:page-load', initListingForm);
</script>
