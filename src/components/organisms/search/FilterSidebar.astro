---
/**
 * Listing filters — flat print column: condensed group headings separated by
 * hairlines, options as stacked rows with print checkboxes/radios (whole label
 * clickable) — no gray cards, no native widgets (Misprint §1.1). Pure GET form
 * controls; the wrapping
 * <form> lives in SearchListing. THE SIDEBAR NEVER CHANGES SHAPE: every page
 * shows the same groups, and route presets show up as selected state (on
 * /service/escort/ the visit-type radio arrives checked). On meeting-type
 * tabs the visit radios NAVIGATE to the sibling tab (visitMode="navigate"),
 * keeping tab and filter as one dimension.
 */
import * as m from '@/paraglide/messages';
import { serviceCategoryLabel, serviceLabel, sortLabel } from '@/lib/labels';
import { CITIES, SERVICES, SERVICE_CATEGORIES, SORT_OPTIONS } from '@/lib/taxonomy';
import type { ProfileListParams } from '@/app/models/profile';
import Icon from '@/components/atoms/Icon.astro';
import Input from '@/components/atoms/Input.astro';

interface Props {
  params: ProfileListParams;
  /** Base path for Reset (route keeps its own category). */
  resetHref: string;
  /** 'navigate' on meeting-type tabs: visit radios switch tabs instead of adding a query param. */
  visitMode?: 'query' | 'navigate';
  /** Service category preset by the route → its group starts open. */
  openCategory?: string;
  /** Inside the mobile ActionSheet: the sheet footer owns Reset — hide the inline one. */
  sheet?: boolean;
}

const { params, resetHref, visitMode = 'query', openCategory, sheet } = Astro.props;
const visitNav = visitMode === 'navigate';
const selectedServices = new Set(params.services ?? []);
/* Resolved gender pick (radio, default women) — mirrors the header tabs. */
const genderPick = params.genders?.includes('male')
  ? 'men'
  : params.genders?.includes('trans_woman')
    ? 'trans'
    : 'women';
const genderOptions = [
  { value: 'women', label: m.gender_tab_women() },
  { value: 'men', label: m.gender_tab_men() },
  { value: 'trans', label: m.gender_tab_trans() },
];
/* Effective location set: main city (path, set top-right) + extra sidebar cities. */
const selectedCities = new Set([params.city, ...(params.cities ?? [])].filter(Boolean));

const group = 'space-y-3 border-b border-border py-5 first:pt-0';
const heading = 'font-condensed text-sm font-bold uppercase tracking-wide';
/* One option row: clean print checkbox/radio, whole label clickable. */
const row = 'flex cursor-pointer select-none items-center gap-2.5 text-sm hover:text-foreground/70';
---

<aside>
  <!-- h-9 matches the quick-control row so the first group top-aligns with the cards grid -->
  <div class="flex h-9 items-center justify-between px-1">
    <h2 class="font-condensed text-xl font-semibold tracking-tight">{m.filter_title()}</h2>
    {
      !sheet && (
        <a
          href={resetHref}
          data-filter-reset
          class="border border-foreground/20 px-3 py-1.5 text-xs font-medium text-muted-foreground transition-colors hover:border-foreground/60 hover:text-foreground"
        >
          {m.filter_reset()}
        </a>
      )
    }
  </div>

  <div class="mt-4 px-1">
    <!-- Find someone specific: name or phone number, rides the existing `q`
         param (digits ≥6 → phone lookup in the API). -->
    <div class={group}>
      <h3 class={heading}>{m.filter_find_someone()}</h3>
      <Input
        type="search"
        name="q"
        value={params.q ?? ''}
        placeholder={m.filter_find_someone_ph()}
        aria-label={m.filter_find_someone()}
      />
    </div>

    <!-- Sort — lives with the filters so the list column stays clean. -->
    <div class={group}>
      <h3 class={heading}>{m.sort_by()}</h3>
      <span class="relative flex h-10 items-center border border-foreground/20 transition-colors hover:border-foreground/60">
        <select
          name="sort"
          aria-label={m.sort_by()}
          class="h-full w-full cursor-pointer appearance-none bg-transparent pl-3 pr-8 text-base font-medium outline-none md:text-sm"
        >
          {
            SORT_OPTIONS.map((s) => (
              <option value={s} selected={(params.sort ?? 'recently_online') === s}>
                {sortLabel(s)}
              </option>
            ))
          }
        </select>
        <Icon name="chevron-down" class="pointer-events-none absolute right-3 text-xs text-muted-foreground" />
      </span>
    </div>

    <!-- Gender: on desktop the header tabs own it; the mobile filter sheet
         carries the same radio here (the header hides gender on mobile). -->
    {
      sheet && (
        <div class={group}>
          <h3 class={heading}>{m.filter_gender()}</h3>
          <div class="space-y-2">
            {genderOptions.map((g) => (
              <label class={row}>
                <input
                  type="radio"
                  name="gender"
                  value={g.value}
                  checked={g.value === genderPick}
                  class="radio-dot"
                />
                {g.label}
              </label>
            ))}
          </div>
        </div>
      )
    }

    <!-- Availability: the two live-now switches (moved out of the control
         rail — quick filters live with the other filters). -->
    <div class={group}>
      <h3 class={heading}>{m.filter_availability()}</h3>
      <div class="space-y-2.5">
        <label class="flex cursor-pointer select-none items-center gap-2.5 text-sm font-medium">
          <input type="checkbox" name="available" checked={params.availableNow} class="sr-only" />
          <span class="switch-track" aria-hidden="true"></span>
          <span class="flex items-center gap-1.5">
            <span class="size-1.5 flex-none rounded-full bg-online" aria-hidden="true"></span>
            {m.filter_available()}
          </span>
        </label>
        <label class="flex cursor-pointer select-none items-center gap-2.5 text-sm font-medium">
          <input type="checkbox" name="online" checked={params.onlineOnly} class="sr-only" />
          <span class="switch-track" aria-hidden="true"></span>
          {m.filter_online()}
        </label>
      </div>
    </div>

    <!-- Location: extra cities on top of the main one (header combobox).
         Checking cities here never changes the main path state. Top 6 visible
         (3 rows × 2 cols); the rest behind a native Show-more details, forced
         open when one of the hidden cities is already checked. -->
    <div class={group}>
      <h3 class={heading}>{m.filter_city()}</h3>
      <div class="grid grid-cols-2 gap-x-4 gap-y-2.5">
        {
          CITIES.slice(0, 6).map((c) => (
            <label class={row}>
              <input
                type="checkbox"
                name="cities"
                value={c.slug}
                checked={selectedCities.has(c.slug)}
                class="cbx-box"
              />
              {c.name}
            </label>
          ))
        }
      </div>
      <details
        class="group/cities"
        open={CITIES.slice(6).some((c) => selectedCities.has(c.slug)) || undefined}
      >
        <summary class="flex cursor-pointer list-none items-center gap-1.5 py-1 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground [&::-webkit-details-marker]:hidden">
          <span class="group-open/cities:hidden">{m.filter_show_more()}</span>
          <span class="hidden group-open/cities:inline">{m.filter_show_less()}</span>
          <Icon
            name="chevron-down"
            class="text-xs transition-transform group-open/cities:rotate-180"
          />
        </summary>
        <div class="grid grid-cols-2 gap-x-4 gap-y-2.5 pt-1.5">
          {
            CITIES.slice(6).map((c) => (
              <label class={row}>
                <input
                  type="checkbox"
                  name="cities"
                  value={c.slug}
                  checked={selectedCities.has(c.slug)}
                  class="cbx-box"
                />
                {c.name}
              </label>
            ))
          }
        </div>
      </details>
    </div>

    <!-- Services (grouped, collapsible, multi-select chips) -->
    <div class={group}>
      <h3 class={heading}>{m.filter_services()}</h3>
      <div>
        {
          SERVICE_CATEGORIES.map((cat) => {
            const services = SERVICES[cat];
            const checkedCount = services.filter((s) => selectedServices.has(s)).length;
            return (
              <details
                class="group/cat"
                open={cat === openCategory || checkedCount > 0 || undefined}
              >
                <summary class="flex cursor-pointer list-none items-center justify-between gap-2 py-2 text-sm font-medium transition-colors hover:text-foreground/70 [&::-webkit-details-marker]:hidden">
                  <span class="flex items-center gap-2">
                    {serviceCategoryLabel(cat)}
                    {checkedCount > 0 && (
                      <span class="grid size-5 place-items-center bg-foreground text-2xs font-semibold text-background">
                        {checkedCount}
                      </span>
                    )}
                  </span>
                  <Icon
                    name="chevron-down"
                    class="text-xs text-muted-foreground transition-transform group-open/cat:rotate-180"
                  />
                </summary>
                <div class="space-y-2 pb-3 pt-1">
                  {services.map((s) => (
                    <label class={row}>
                      <input
                        type="checkbox"
                        name="services"
                        value={s}
                        checked={selectedServices.has(s)}
                        class="cbx-box"
                      />
                      {serviceLabel(s)}
                    </label>
                  ))}
                </div>
              </details>
            );
          })
        }
      </div>
    </div>

    <!-- Visit type (always present; preset pages arrive with their radio checked) -->
    <div class={group}>
      <h3 class={heading}>{m.filter_visit()}</h3>
      <div class="space-y-2">
        <label class={row}>
          <input type="radio" name={visitNav ? undefined : 'visit'} data-visit-nav={visitNav || undefined} value="" checked={!params.meetingType} class="radio-dot" />
          {m.filter_any()}
        </label>
        <label class={row}>
          <input type="radio" name={visitNav ? undefined : 'visit'} data-visit-nav={visitNav || undefined} value="incall" checked={params.meetingType === 'incall'} class="radio-dot" />
          {m.cat_private()}
        </label>
        <label class={row}>
          <input type="radio" name={visitNav ? undefined : 'visit'} data-visit-nav={visitNav || undefined} value="outcall" checked={params.meetingType === 'outcall'} class="radio-dot" />
          {m.cat_escort()}
        </label>
      </div>
    </div>

    <!-- Price -->
    <div class:list={[group, 'border-b-0']}>
      <h3 class={heading}>{m.filter_price()}</h3>
      <div class="flex items-center gap-3">
        <Input
          type="number"
          inputmode="numeric"
          name="priceMin"
          min="0"
          step="10"
          placeholder={m.filter_min()}
          value={params.priceMin ?? ''}
          aria-label={m.filter_min()}
        />
        <span class="text-muted-foreground" aria-hidden="true">–</span>
        <Input
          type="number"
          inputmode="numeric"
          name="priceMax"
          min="0"
          step="10"
          placeholder={m.filter_max()}
          value={params.priceMax ?? ''}
          aria-label={m.filter_max()}
        />
      </div>
    </div>

  </div>
</aside>
