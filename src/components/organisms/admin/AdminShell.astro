---
/**
 * Admin shell (docs/ADMIN.md §1–3). The fenced frame for every /admin page:
 * guards the admin session + role, renders the sidebar IA, the un-dismissable
 * escalation banner, and the sign-out. Locale-less, noindex, English-only,
 * desktop-first but phone-usable. Not the public Layout — no header/footer/dock.
 *
 * ponytail: admin strings are hardcoded English (internal tool, English-only by
 * design, ADMIN.md §2) — no m.* / no nl-de tripling. Extract to Paraglide only
 * if admin ever needs translation.
 */
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow/700.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@/styles/global.css';
import type { AdminRole } from '@/lib/taxonomy';
import { getAdmin } from '@/actions/admin/lib';
import { adminBadges } from '@/actions/admin/queues';

interface Props {
  title: string;
  /** Current section key for nav highlight. */
  section?: string;
}
const { title, section = '' } = Astro.props;

const session = await getAdmin({ cookies: Astro.cookies });
const badges = session ? await adminBadges() : { escalations: 0, reportsOpen: 0 };

/** Nav items with the role capability that may see them (super sees all). */
const NAV: { key: string; label: string; href: string; roles: AdminRole[]; icon: string; badge?: number }[] = [
  { key: 'overview', label: 'Overview', href: '/admin', roles: ['moderator', 'support', 'super'], icon: '<rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/>' },
  { key: 'verification', label: 'Verification', href: '/admin/verification', roles: ['moderator', 'super'], icon: '<path d="M12 3l7 4v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V7z"/><path d="m9 12 2 2 4-4"/>' },
  { key: 'moderation', label: 'Moderation', href: '/admin/moderation', roles: ['moderator', 'super'], icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>' },
  { key: 'reports', label: 'Reports', href: '/admin/reports', roles: ['moderator', 'super'], icon: '<path d="M4 15V4a1 1 0 0 1 1-1h14l-3 5 3 5H5a1 1 0 0 0-1 1z"/><path d="M4 22v-7"/>', badge: badges.reportsOpen },
  { key: 'profiles', label: 'Profiles', href: '/admin/profiles', roles: ['moderator', 'support', 'super'], icon: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"/>' },
  { key: 'clients', label: 'Clients', href: '/admin/clients', roles: ['support', 'super'], icon: '<circle cx="9" cy="8" r="3.5"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M17 5a3.5 3.5 0 0 1 0 7"/>' },
  { key: 'audit', label: 'Audit log', href: '/admin/audit', roles: ['moderator', 'support', 'super'], icon: '<path d="M4 4h16v16H4z"/><path d="M8 8h8M8 12h8M8 16h5"/>' },
];
const canSee = (roles: AdminRole[]) => session && (session.adminRole === 'super' || roles.includes(session.adminRole!));
const nav = NAV.filter((n) => canSee(n.roles));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · Intimate Admin</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <script is:inline>
      (function () {
        const t = localStorage.theme;
        document.documentElement.classList.toggle(
          'dark',
          t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches),
        );
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-background font-sans text-foreground antialiased">
    {
      !session ? (
        <div class="grid min-h-dvh place-items-center px-4">
          <div class="max-w-sm space-y-3 text-center">
            <h1 class="display text-3xl">Admin</h1>
            <p class="text-sm text-muted-foreground">
              Sign in with an admin account. Real access is gated by Cloudflare Access + MFA;
              this mock accepts <code class="text-foreground">admin@intimate.nl</code>.
            </p>
            <a href="/en/account/" class="slab-cut inline-flex items-center bg-foreground px-4 py-2 text-sm font-semibold text-background">Go to sign in</a>
          </div>
        </div>
      ) : (
        <div class="flex min-h-dvh flex-col md:flex-row">
          {/* Sidebar (desktop) / top tabs (mobile) */}
          <aside class="flex-none border-b border-border bg-card md:w-56 md:border-b-0 md:border-r">
            <div class="flex items-center justify-between px-4 py-3 md:block md:py-4">
              <a href="/admin" class="flex items-center gap-2">
                <span class="grid size-7 place-items-center bg-foreground font-condensed text-sm font-bold text-background">A</span>
                <span class="font-condensed text-lg font-bold tracking-tight">Admin</span>
              </a>
              <p class="hidden text-2xs text-muted-foreground md:mt-1 md:block">{session.email} · {session.adminRole}</p>
            </div>
            <nav class="flex gap-1 overflow-x-auto px-2 pb-2 md:flex-col md:px-2 md:pb-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" aria-label="Admin">
              {nav.map((n) => (
                <a
                  href={n.href}
                  aria-current={section === n.key ? 'page' : undefined}
                  class:list={[
                    'flex flex-none items-center gap-2.5 rounded-md px-3 py-2 text-sm font-medium transition-colors',
                    section === n.key ? 'bg-foreground text-background' : 'text-muted-foreground hover:bg-muted hover:text-foreground',
                  ]}
                >
                  <svg class="size-4 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={n.icon} />
                  <span>{n.label}</span>
                  {n.badge ? <span class="ml-auto rounded-full bg-brand px-1.5 text-2xs font-bold text-white">{n.badge}</span> : null}
                </a>
              ))}
            </nav>
            <div class="hidden border-t border-border px-4 py-3 md:block">
              <button type="button" data-admin-signout class="text-sm font-medium text-brand hover:underline">Sign out</button>
            </div>
          </aside>

          {/* Main */}
          <div class="min-w-0 flex-1">
            {badges.escalations > 0 && (
              <div class="flex items-center gap-2 bg-brand px-4 py-2.5 text-sm font-semibold text-white">
                <svg class="size-4 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg>
                {badges.escalations} priority report{badges.escalations > 1 ? 's' : ''} awaiting review.
                <a href="/admin/reports" class="ml-auto underline underline-offset-2">Open reports →</a>
              </div>
            )}
            <main class="mx-auto max-w-6xl px-4 py-6 md:px-8 md:py-8">
              <slot />
            </main>
          </div>
        </div>
      )
    }

    <script>
      import { actions } from 'astro:actions';
      document.querySelector('[data-admin-signout]')?.addEventListener('click', async () => {
        await actions.auth.logout({ locale: 'en' });
        location.href = '/en/';
      });
    </script>
  </body>
</html>
