---
/**
 * Admin sign-in — shown by /admin when there's no admin session, so an admin
 * logs in on the admin page itself (no detour through the app's account flow).
 * On success it reloads /admin; getAdmin then admits admins and shows the
 * cockpit, or this form returns with "not an admin".
 */
import SlabField from '@/components/molecules/SlabField.astro';
import Button from '@/components/atoms/Button.astro';
import * as m from '@/paraglide/messages';
import { getLocale } from '@/paraglide/runtime';
// Own document skeleton (mirrors AdminShell's): this component IS the page
// when signed out — without an <html>/<head> no stylesheet ships, so the
// login rendered unstyled with the error line visible (`hidden` needs CSS).
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow/700.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@/styles/global.css';

interface Props {
  /** Signed in successfully, but the account isn't an admin. */
  notAdmin?: boolean;
  /** ADMIN_REQUIRE_AAL2 is on → an admin with no factor must enroll at sign-in
   *  (else the aal2 gate would lock them out with no way to reach settings). */
  requireMfa?: boolean;
}
const { notAdmin = false, requireMfa = false } = Astro.props;
---

<html lang={getLocale()}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{m.adm_title()} · Intimate Admin</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <script is:inline>
      (function () {
        const t = localStorage.theme;
        document.documentElement.classList.toggle(
          'dark',
          t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches),
        );
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-background font-sans text-foreground antialiased">
<main class="grid min-h-dvh place-items-center bg-background px-4">
  <div class="w-full max-w-sm">
    <div class="slab-cut border border-border bg-card p-6 sm:p-8">
      <img src="/icons/icon.svg" alt="" width="44" height="44" />
      <p class="eyebrow mt-4 text-2xs text-muted-foreground">Intimate</p>
      <h1 class="display mt-1 text-2xl">{m.adm_title()}</h1>
      {
        notAdmin && (
          <p class="mt-3 text-sm font-medium text-brand">{m.adm_login_not_admin()}</p>
        )
      }
      <form data-admin-login class="mt-6 space-y-3">
        <SlabField label={m.adm_login_email()} name="email" type="email" required autocomplete="username" />
        <SlabField label={m.auth_password()} name="password" type="password" required autocomplete="current-password" />
        <Button type="submit" class="w-full">{m.adm_login_submit()}</Button>
        <p data-admin-login-error class="hidden text-sm font-medium text-brand">{m.adm_login_error()}</p>
      </form>

      {/* Second step: TOTP challenge (has a factor) or forced enrollment (none +
          MFA required). Shown after a correct password; English (internal §2). */}
      <form data-mfa-form hidden class="mt-6 space-y-3" data-require-mfa={requireMfa ? '1' : ''}>
        <p data-mfa-heading class="text-sm text-muted-foreground">Enter the 6-digit code from your authenticator app.</p>
        <img data-mfa-qr alt="TOTP QR code" width="176" height="176" hidden class="mx-auto bg-white p-2" />
        <p data-mfa-secret-wrap hidden class="text-2xs text-muted-foreground">
          Manual key: <code data-mfa-secret class="select-all break-all font-mono text-foreground"></code>
        </p>
        <input
          data-mfa-code
          inputmode="numeric"
          autocomplete="one-time-code"
          maxlength="6"
          placeholder="123456"
          class="w-full border border-border bg-transparent px-3 py-2.5 text-center font-mono text-lg tracking-widest caret-brand outline-none focus:border-foreground/50"
        />
        <Button type="submit" class="w-full">Verify</Button>
        <p data-mfa-error class="hidden text-sm font-medium text-brand"></p>
      </form>
    </div>
    <p class="mt-4 text-center text-2xs text-muted-foreground">{m.adm_signin_prompt()}</p>
  </div>
</main>

<script>
  import { actions } from 'astro:actions';
  import { mfaStatus, startEnroll, verifyCode, verifiedTotpFactorId } from '@/app/mfa';

  const DONE = '/admin?signedin=1'; // reload → getAdmin decides

  function initAdminLogin() {
    const form = document.querySelector<HTMLFormElement>('[data-admin-login]');
    if (!form || form.dataset.init) return;
    form.dataset.init = '1';
    const err = form.querySelector<HTMLElement>('[data-admin-login-error]');

    const mfaForm = document.querySelector<HTMLFormElement>('[data-mfa-form]');
    const requireMfa = mfaForm?.dataset.requireMfa === '1';
    const heading = mfaForm?.querySelector<HTMLElement>('[data-mfa-heading]');
    const qr = mfaForm?.querySelector<HTMLImageElement>('[data-mfa-qr]');
    const secretWrap = mfaForm?.querySelector<HTMLElement>('[data-mfa-secret-wrap]');
    const secret = mfaForm?.querySelector<HTMLElement>('[data-mfa-secret]');
    const codeInput = mfaForm?.querySelector<HTMLInputElement>('[data-mfa-code]');
    const mfaErr = mfaForm?.querySelector<HTMLElement>('[data-mfa-error]');
    let factorId: string | null = null;

    const mfaFail = (msg: string) => { if (mfaErr) { mfaErr.textContent = msg; mfaErr.classList.remove('hidden'); } };

    // Reveal the second step; `enroll` shows the QR (no factor yet), otherwise a
    // plain code challenge.
    const showStep = (enroll: { qrCode: string; secret: string } | null) => {
      form.classList.add('hidden');
      mfaForm?.removeAttribute('hidden');
      if (enroll && qr && secret) {
        heading!.textContent = 'Set up two-factor auth: scan this, then enter the 6-digit code.';
        qr.src = enroll.qrCode;
        qr.removeAttribute('hidden');
        secret.textContent = enroll.secret;
        secretWrap?.removeAttribute('hidden');
      }
      codeInput?.focus();
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err?.classList.add('hidden');
      const fd = new FormData(form);
      const { error } = await actions.auth.login({
        email: String(fd.get('email') ?? ''),
        password: String(fd.get('password') ?? ''),
        locale: 'en',
      });
      if (error) { err?.classList.remove('hidden'); return; }

      // Password OK (session now aal1). Decide the second factor step.
      try {
        const s = await mfaStatus();
        if (s.currentLevel === 'aal2') { location.href = DONE; return; } // already stepped up
        if (s.nextLevel === 'aal2') { // has a verified factor → challenge
          factorId = await verifiedTotpFactorId();
          showStep(null);
          return;
        }
        if (requireMfa) { // no factor + MFA enforced → enroll on the spot
          const e2 = await startEnroll();
          factorId = e2.factorId;
          showStep(e2);
          return;
        }
      } catch { /* MFA unavailable → fall through and let getAdmin decide */ }
      location.href = DONE; // no factor + not enforced → in at aal1
    });

    mfaForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      mfaErr?.classList.add('hidden');
      const code = (codeInput?.value ?? '').trim();
      if (!/^\d{6}$/.test(code)) { mfaFail('Enter the 6-digit code.'); return; }
      if (!factorId) { mfaFail('Please sign in again.'); return; }
      try {
        await verifyCode(factorId, code);
        location.href = DONE; // session is now aal2
      } catch (err2) {
        mfaFail((err2 as Error).message);
      }
    });
  }
  initAdminLogin();
  document.addEventListener('astro:page-load', initAdminLogin);
</script>
  </body>
</html>
