---
/**
 * Two-factor authentication card (docs/ADMIN.md §1, §13). Every admin manages
 * their OWN TOTP factor here — rendered for any admin, not just super, so the
 * whole team can enroll before `ADMIN_REQUIRE_AAL2` is turned on. English on
 * purpose (internal surface, §2). Island drives supabase-js auth.mfa (src/app/mfa.ts).
 */
---

<section data-mfa>
  <h2 class="font-condensed text-sm font-bold uppercase tracking-wide text-muted-foreground">Two-factor authentication</h2>
  <p class="mt-2 max-w-2xl text-sm text-muted-foreground">
    Protect the admin area with an authenticator app (TOTP). Once every admin has enrolled, the
    <code class="text-2xs">ADMIN_REQUIRE_AAL2</code> flag makes a code mandatory at sign-in.
  </p>

  <div class="mt-3 max-w-lg border border-border p-4">
    <p data-mfa-loading class="text-sm text-muted-foreground">Loading…</p>

    <!-- Enrolled -->
    <div data-mfa-enabled hidden>
      <div class="flex items-center justify-between">
        <span class="text-sm font-medium text-online">● Enabled</span>
        <button
          type="button"
          data-mfa-disable
          class="cursor-pointer border border-foreground/20 px-2.5 py-1 text-2xs font-bold uppercase tracking-wide transition-colors hover:border-brand hover:text-brand"
        >
          Disable
        </button>
      </div>
      <p class="mt-2 text-2xs text-muted-foreground">
        A code from your authenticator app is required to reach the admin area (once enforced).
      </p>
    </div>

    <!-- Not enrolled -->
    <div data-mfa-setup hidden>
      <button
        type="button"
        data-mfa-start
        class="slab-cut cursor-pointer border border-foreground/20 bg-card px-4 py-2 text-sm font-semibold transition-colors hover:bg-foreground hover:text-background disabled:opacity-50"
      >
        Set up two-factor auth
      </button>

      <div data-mfa-enroll hidden class="mt-4">
        <p class="text-sm text-muted-foreground">Scan this with your authenticator app, then enter the 6-digit code.</p>
        <img data-mfa-qr alt="TOTP QR code" width="176" height="176" class="mt-3 bg-white p-2" />
        <p class="mt-2 text-2xs text-muted-foreground">
          Can’t scan? Enter this key manually:
          <code data-mfa-secret class="select-all break-all font-mono text-foreground"></code>
        </p>
        <div class="mt-3 flex items-center gap-2">
          <input
            data-mfa-code
            inputmode="numeric"
            autocomplete="one-time-code"
            maxlength="6"
            placeholder="123456"
            class="w-32 border border-border bg-transparent px-2 py-1.5 text-center font-mono tracking-widest caret-brand outline-none focus:border-foreground/50"
          />
          <button
            type="button"
            data-mfa-verify
            class="slab-cut cursor-pointer border border-foreground/20 bg-card px-3 py-1.5 text-sm font-semibold transition-colors hover:bg-foreground hover:text-background disabled:opacity-50"
          >
            Verify &amp; enable
          </button>
        </div>
      </div>
    </div>

    <p data-mfa-error hidden class="mt-3 text-sm font-medium text-brand"></p>
  </div>
</section>

<script>
  import { mfaStatus, startEnroll, verifyCode, disableMfa } from '@/app/mfa';

  function initMfaCard() {
    const root = document.querySelector<HTMLElement>('[data-mfa]');
    if (!root || root.dataset.init) return;
    root.dataset.init = '1';

    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel);
    const loading = $('[data-mfa-loading]');
    const enabled = $('[data-mfa-enabled]');
    const setup = $('[data-mfa-setup]');
    const enroll = $('[data-mfa-enroll]');
    const qr = $<HTMLImageElement>('[data-mfa-qr]');
    const secret = $('[data-mfa-secret]');
    const codeInput = $<HTMLInputElement>('[data-mfa-code]');
    const errBox = $('[data-mfa-error]');

    const show = (el: Element | null, on: boolean) => el?.toggleAttribute('hidden', !on);
    const fail = (msg: string) => {
      if (errBox) { errBox.textContent = msg; errBox.toggleAttribute('hidden', false); }
    };
    const clearErr = () => errBox?.toggleAttribute('hidden', true);

    let factorId: string | null = null;

    (async () => {
      try {
        const s = await mfaStatus();
        show(loading, false);
        show(enabled, s.hasFactor);
        show(setup, !s.hasFactor);
      } catch (e) {
        show(loading, false);
        show(setup, true);
        fail((e as Error).message);
      }
    })();

    $('[data-mfa-start]')?.addEventListener('click', async (ev) => {
      const btn = ev.currentTarget as HTMLButtonElement;
      btn.disabled = true;
      clearErr();
      try {
        const e = await startEnroll();
        factorId = e.factorId;
        if (qr) qr.src = e.qrCode;
        if (secret) secret.textContent = e.secret;
        show(enroll, true);
        btn.disabled = true;
        codeInput?.focus();
      } catch (err) {
        btn.disabled = false;
        fail((err as Error).message);
      }
    });

    $('[data-mfa-verify]')?.addEventListener('click', async (ev) => {
      const btn = ev.currentTarget as HTMLButtonElement;
      const code = (codeInput?.value ?? '').trim();
      if (!/^\d{6}$/.test(code)) { fail('Enter the 6-digit code.'); return; }
      if (!factorId) { fail('Start enrollment again.'); return; }
      btn.disabled = true;
      clearErr();
      try {
        await verifyCode(factorId, code);
        location.reload(); // refresh status; session is now aal2
      } catch (err) {
        btn.disabled = false;
        fail((err as Error).message);
      }
    });

    $('[data-mfa-disable]')?.addEventListener('click', async (ev) => {
      const btn = ev.currentTarget as HTMLButtonElement;
      btn.disabled = true;
      clearErr();
      try {
        await disableMfa();
        location.reload();
      } catch (err) {
        btn.disabled = false;
        // Disabling a verified factor needs an aal2 session — Supabase says so.
        fail((err as Error).message + ' (sign in with a code first, then disable).');
      }
    });
  }

  initMfaCard();
  document.addEventListener('astro:page-load', initMfaCard);
</script>
