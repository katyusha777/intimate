---
/**
 * The call dock (docs/VIDEO-CALLING.md §6) — mounted ONCE in Layout for every
 * signed-in user. Owns the three global call surfaces:
 *
 *  · account:{id} subscription → live unread dots (tabbar + header) and, for
 *    clients, the incoming-call ring (a DB-trigger broadcast — survives page
 *    navigation because the dock persists on every page).
 *  · IncomingCall overlay (client): full-screen accept/decline, 30s, vibrate.
 *  · CallScreen (both parties): full-bleed remote, PiP self-view, controls.
 *
 * WebRTC is pure P2P (ARCHITECTURE §10): negotiation belongs to trystero core
 * (offer/answer, glare, trickle ICE, restarts) signaling over the private
 * `call:{id}:rtc` channel (src/app/callroom.ts — RLS-authorized); server truth
 * (accept/decline/sweep) rides `call:{id}` via openChannel; media never
 * touches a server. The professional's peer connection is relay-only when
 * TURN is live (her IP never reaches a client — VIDEO-CALLING.md §1.1);
 * reason it stays vanilla script, not an island: state is one module-scoped
 * call object, same discipline as Thread.astro.
 *
 * Gesture discipline (the first-call killer): getUserMedia STARTS and remote
 * playback is PRIMED synchronously inside the tap handler, before any network
 * await — WebKit auto-denies an unprivileged gUM after a past denial, and
 * Brave's autoplay-block clears activation, so anything audible must anchor
 * to a live gesture. Remote AUDIO gets its own <audio> element (iOS won't
 * reliably play audio through a hidden <video>); remote VIDEO stays muted
 * forever (muted playback is never policy-blocked) — sound only ever flows
 * through the audio element.
 *
 * Signaling payloads are DATA, never instructions (hard rule 7): SDP/candidate
 * strings go only into RTCPeerConnection APIs, never into the DOM.
 */
import * as m from '@/paraglide/messages';
import Modal from '@/components/molecules/Modal.astro';
import type { Session } from '@/app/models/session';

interface Props {
  session: Session;
}
const { session } = Astro.props;
---

<div
  data-call-dock
  transition:persist="calldock"
  data-account-id={session.accountId}
  data-role={session.role}
  data-i18n-ringing={m.call_ringing()}
  data-i18n-connecting={m.call_connecting()}
  data-i18n-poor={m.call_poor()}
  data-i18n-reconnecting={m.call_reconnecting()}
  data-i18n-busy={m.call_busy()}
  data-i18n-call-failed={m.call_failed_toast()}
  data-i18n-media-blocked={m.call_media_blocked()}
  data-i18n-declined={m.call_declined_toast()}
  data-i18n-incoming-video={m.call_incoming_video()}
  data-i18n-incoming-voice={m.call_incoming_voice()}
>
  <!-- ── Incoming ring (client) ─────────────────────────────────────────── -->
  <div
    data-incoming
    hidden
    class="dark fixed inset-0 z-[70] flex flex-col items-center justify-between bg-neutral-950/95 text-white backdrop-blur-xl"
    style="padding-top: calc(env(safe-area-inset-top) + 3rem); padding-bottom: calc(env(safe-area-inset-bottom) + 3rem)"
    role="alertdialog"
    aria-label={m.call_incoming()}
  >
    <div class="flex flex-col items-center gap-4 px-6 text-center">
      <span class="relative grid size-28 place-items-center">
        <span class="absolute inset-0 animate-ping rounded-full bg-brand/30" aria-hidden="true"></span>
        <img data-incoming-avatar src="" alt="" class="relative size-28 rounded-full border-2 border-white/20 object-cover" />
      </span>
      <p data-incoming-name class="font-condensed text-3xl font-bold"></p>
      <p data-incoming-mode class="text-sm text-white/70"></p>
    </div>
    <div class="flex flex-col items-center">
      <div class="flex items-center gap-16">
        <button type="button" data-incoming-decline aria-label={m.call_decline()} class="grid size-16 cursor-pointer place-items-center rounded-full bg-white/10 transition-transform active:scale-90">
          <svg class="size-7 rotate-[135deg]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </button>
        <button type="button" data-incoming-accept aria-label={m.call_accept()} class="grid size-16 cursor-pointer place-items-center rounded-full bg-online text-neutral-950 transition-transform active:scale-90">
          <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </button>
      </div>
      <!-- Ring-spam wall: block right from the ring, two-tap confirm (same
           pattern as End & block — no native confirm()). -->
      <button
        type="button"
        data-incoming-block
        data-label={m.call_ring_block()}
        data-confirm={m.call_ring_block_confirm()}
        aria-pressed="false"
        class="mt-8 cursor-pointer rounded-full border border-white/15 bg-white/5 px-5 py-2 text-sm font-medium text-white/60 transition-[background-color,transform] active:scale-95 aria-[pressed=true]:border-brand aria-[pressed=true]:bg-brand/25 aria-[pressed=true]:text-white"
      >
        {m.call_ring_block()}
      </button>
    </div>
  </div>

  <!-- ── In-call screen (both parties) ──────────────────────────────────── -->
  <div
    data-call-screen
    hidden
    class="dark fixed inset-0 z-[71] bg-neutral-950 text-white"
    role="dialog"
    aria-label={m.call_title()}
  >
    <!-- Remote media split: video stays muted forever (muted playback is never
         autoplay-blocked), sound flows only through the audio element (primed
         at the tap gesture; iOS can't do audio via hidden <video>).
         Cover recipe: WebKit unreliably honors object-fit:cover on
         MediaStream-backed <video> (letterboxes instead — seen on iOS 27
         beta), so each video fills an overflow-hidden wrapper via centered
         min-w/min-h instead of relying on object-fit. -->
    <div data-remote-wrap hidden class="absolute inset-0 overflow-hidden">
      <video
        data-remote
        autoplay
        playsinline
        muted
        class="absolute left-1/2 top-1/2 max-w-none -translate-x-1/2 -translate-y-1/2"></video>
    </div>
    <audio data-remote-audio class="hidden"></audio>
    <!-- PiP self-view; tapping it swaps which stream fills the screen (both
         video elements are muted forever, so the swap can never echo). -->
    <div
      data-local-wrap
      hidden
      role="button"
      aria-label={m.call_swap()}
      class="absolute right-4 z-10 h-44 w-32 cursor-pointer overflow-hidden rounded-xl border border-white/20 shadow-soft-lg"
      style="top: calc(env(safe-area-inset-top) + 1rem)"
    >
      <video
        data-local
        autoplay
        playsinline
        muted
        class="absolute left-1/2 top-1/2 max-w-none -translate-x-1/2 -translate-y-1/2"></video>
    </div>

    <!-- Autoplay recovery: shown only when the browser refused un-gestured
         audio (e.g. Brave with autoplay blocked) — one tap re-plays unmuted. -->
    <button
      type="button"
      data-sound-pill
      hidden
      class="absolute left-1/2 z-20 -translate-x-1/2 cursor-pointer rounded-full bg-white/15 px-4 py-2 text-sm font-medium backdrop-blur transition-transform active:scale-95"
      style="top: calc(env(safe-area-inset-top) + 1rem)"
    >
      {m.call_tap_sound()}
    </button>

    <!-- voice mode / pre-connect: identity panel -->
    <div data-call-idpanel class="absolute inset-0 flex flex-col items-center justify-center gap-4 px-6 text-center">
      <span class="relative grid size-28 place-items-center">
        <span data-call-pulse class="absolute inset-0 animate-ping rounded-full bg-brand/25" aria-hidden="true"></span>
        <img data-call-avatar src="" alt="" class="relative hidden size-28 rounded-full border-2 border-white/20 object-cover" />
        <span data-call-initial class="relative grid size-28 place-items-center rounded-full bg-white/10 font-condensed text-5xl font-bold"></span>
      </span>
      <p data-call-name class="font-condensed text-3xl font-bold"></p>
      <p class="flex items-center gap-2 text-sm text-white/70">
        <span data-call-state-chip></span>
        <span data-call-timer class="tabular-nums"></span>
      </p>
    </div>

    <!-- controls -->
    <div
      class="absolute inset-x-0 bottom-0 flex flex-col items-center gap-3"
      style="padding-bottom: calc(env(safe-area-inset-bottom) + 1.5rem)"
    >
      <div class="flex items-center gap-4">
        <button type="button" data-ctl-mute aria-label={m.call_mute()} aria-pressed="false" class="grid size-14 cursor-pointer place-items-center rounded-full bg-white/10 backdrop-blur transition-[background-color,transform] active:scale-90 aria-pressed:bg-white aria-pressed:text-neutral-950">
          <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>
        </button>
        <button type="button" data-ctl-cam aria-label={m.call_camera()} aria-pressed="false" class="hidden size-14 cursor-pointer place-items-center rounded-full bg-white/10 backdrop-blur transition-[background-color,transform] active:scale-90 aria-pressed:bg-white aria-pressed:text-neutral-950 [&:not([hidden])]:grid">
          <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5"/><rect x="2" y="6" width="14" height="12" rx="2"/></svg>
        </button>
        <button type="button" data-ctl-flip aria-label={m.call_flip()} class="hidden size-14 cursor-pointer place-items-center rounded-full bg-white/10 backdrop-blur transition-transform active:scale-90 [&:not([hidden])]:grid">
          <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 19H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h5"/><path d="M13 5h7a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-5"/><circle cx="12" cy="12" r="3"/><path d="m18 22-3-3 3-3"/><path d="m6 2 3 3-3 3"/></svg>
        </button>
        <button type="button" data-ctl-end aria-label={m.call_end()} class="grid size-16 cursor-pointer place-items-center rounded-full bg-brand text-white transition-transform active:scale-90">
          <svg class="size-7 rotate-[135deg]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </button>
      </div>
      <!-- Her safety exit (professional only): end + block in one. Amber pill,
           its own row well clear of the hang-up/mic controls, two-tap confirm
           (data-confirm holds the confirm text; the actual teardown+block runs
           on the second tap, still inside the user gesture). -->
      <button
        type="button"
        data-ctl-endblock
        hidden
        data-label={m.call_end_block()}
        data-confirm={m.call_endblock_confirm()}
        class="mt-6 max-w-[18rem] cursor-pointer rounded-full border border-amber-400/70 bg-amber-400/15 px-5 py-2.5 text-sm font-semibold text-amber-200 backdrop-blur transition-[background-color,transform] active:scale-95 aria-[pressed=true]:border-amber-300 aria-[pressed=true]:bg-amber-400/30 aria-[pressed=true]:text-amber-50"
        aria-pressed="false"
      >
        {m.call_end_block()}
      </button>
      <p class="mt-3 text-2xs text-white/40">{m.call_no_recording()}</p>
    </div>
  </div>

  <!-- ── Failure report (screenshot-able support card, not a vanishing toast).
       Shown on every local 'failed' teardown with the content-free [call] log
       so "it didn't work" arrives with an actual diagnosis attached. -->
  <div
    data-call-error
    hidden
    class="dark fixed inset-0 z-[80] flex items-center justify-center bg-black/70 p-4 backdrop-blur-sm"
    role="alertdialog"
    aria-label={m.call_error_title()}
  >
    <div class="w-full max-w-sm rounded-2xl border border-brand/40 bg-neutral-950 p-4 text-white shadow-soft-lg">
      <p class="font-condensed text-xl font-bold text-brand">{m.call_error_title()}</p>
      <p class="mt-1 text-xs text-white/60">{m.call_error_hint()}</p>
      <pre data-call-error-log class="mt-3 max-h-60 overflow-y-auto whitespace-pre-wrap break-all rounded-lg bg-white/5 p-2 text-2xs leading-4 text-white/80"></pre>
      <div class="mt-3 flex gap-2">
        <button type="button" data-call-error-copy class="flex-1 cursor-pointer rounded-full border border-white/20 px-4 py-2 text-sm font-medium transition-transform active:scale-95">
          {m.call_error_copy()}
        </button>
        <button type="button" data-call-error-close class="flex-1 cursor-pointer rounded-full bg-white px-4 py-2 text-sm font-semibold text-neutral-950 transition-transform active:scale-95">
          {m.call_error_close()}
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Shared block confirmation (End & block + ring Block) — a real dialog on
     the native top layer, not a morphing button. -->
<Modal id="call-block-confirm" class="dark">
  <div class="p-5">
    <p data-block-confirm-text class="text-base font-semibold"></p>
    <div class="mt-4 flex gap-2">
      <button type="button" data-modal-close class="flex-1 cursor-pointer rounded-full border border-border px-4 py-2 text-sm font-medium transition-transform active:scale-95">
        {m.action_cancel()}
      </button>
      <button type="button" data-block-confirm-go class="flex-1 cursor-pointer rounded-full bg-brand px-4 py-2 text-sm font-semibold text-brand-foreground transition-transform active:scale-95">
        {m.call_ring_block()}
      </button>
    </div>
  </div>
</Modal>

<script>
  import { actions } from 'astro:actions';
  import { openChannel } from '@/app/realtime';
  import { joinCallRoom } from '@/app/callroom';
  import type { Room } from '@trystero-p2p/core';

  type CallView = {
    id: string;
    threadId: string;
    mode: 'voice' | 'video';
    state: string;
    party: 'professional' | 'client';
    peerName: string;
    profileId: string;
    avatarUrl?: string;
    answeredAt?: string;
  };
  type Ice = { iceServers: RTCIceServer[]; relayOnly: boolean };

  const RING_MS = 30_000;
  const BEAT_MS = 30_000;
  const CONNECT_MS = 25_000; // accept → connected budget before honest failure

  // Content-free diagnostics (hard rule 7: never SDP/candidate bodies) — the
  // "call died with nothing on the console" era ends here. A ring buffer of
  // the same lines feeds the on-screen failure report (screenshot → support).
  const logBuf: string[] = [];
  const pushLog = (a: unknown[]) => {
    logBuf.push(`${new Date().toISOString().slice(11, 19)} ${a.map(String).join(' ')}`);
    if (logBuf.length > 30) logBuf.shift();
  };
  const dbg = (...a: unknown[]) => {
    console.debug('[call]', ...a);
    pushLog(a);
  };
  const warn = (...a: unknown[]) => {
    console.warn('[call]', ...a);
    pushLog(a);
  };

  function initCallDock() {
    const found = document.querySelector<HTMLElement>('[data-call-dock]');
    if (!found || found.dataset.init) return;
    const root = found; // narrowed const — closures below keep the non-null type
    root.dataset.init = '1';
    const accountId = root.dataset.accountId!;
    const role = root.dataset.role!;

    const $ = <T extends HTMLElement = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const incoming = $('[data-incoming]');
    const screen = $('[data-call-screen]');
    const remoteWrap = $('[data-remote-wrap]');
    const remoteEl = $<HTMLVideoElement>('[data-remote]');
    const audioEl = $<HTMLAudioElement>('[data-remote-audio]');
    const localWrap = $('[data-local-wrap]');
    const localEl = $<HTMLVideoElement>('[data-local]');
    const soundPill = $('[data-sound-pill]');

    /** object-fit-free cover (WebKit ignores it on MediaStream video): fill
     *  the wrapper's tighter dimension, let overflow-hidden crop the other —
     *  aspect preserved, box always filled, never intrinsic-size zoom. */
    function coverFit(video: HTMLVideoElement, wrap: HTMLElement) {
      const vw = video.videoWidth;
      const vh = video.videoHeight;
      const bw = wrap.clientWidth;
      const bh = wrap.clientHeight;
      if (!vw || !vh || !bw || !bh) return;
      if (vw / vh > bw / bh) {
        video.style.height = '100%';
        video.style.width = 'auto';
      } else {
        video.style.width = '100%';
        video.style.height = 'auto';
      }
    }
    const fitVideos = () => {
      coverFit(remoteEl, remoteWrap);
      coverFit(localEl, localWrap);
    };
    // 'resize' on a video = its stream dimensions changed (first frame,
    // camera flip, phone rotation); window resize = the boxes changed.
    remoteEl.addEventListener('resize', fitVideos);
    localEl.addEventListener('resize', fitVideos);
    window.addEventListener('resize', fitVideos);

    // ── live unread dots (V0 DoD: badge moves without navigation) ─────────
    const showDots = () => {
      document.querySelectorAll<HTMLElement>('[data-unread-dot]').forEach((el) => el.classList.remove('hidden'));
    };

    // ── the one current call ──────────────────────────────────────────────
    let call: {
      view: CallView;
      ice: Ice;
      /** `call:{id}` server-truth events (DB trigger 0013). */
      channel: ReturnType<typeof openChannel> | null;
      /** trystero room — owns negotiation, ICE, restarts (src/app/callroom.ts). */
      room: Room | null;
      /** The peer's RTCPeerConnection (via room.getPeers) — state chip only. */
      pc: RTCPeerConnection | null;
      local: MediaStream | null;
      remoteAudio: MediaStream;
      remoteVideo: MediaStream;
      accepted: boolean;
      /** Local stream handed to the room (once; caller only — the callee's
       *  media rides back inside the ANSWER on the caller's transceivers). */
      sent: boolean;
      /** Caller holds its renegotiation until the callee's media is captured
       *  ('ready' action) — the offer must arrive when the callee can attach
       *  its tracks to it. Lifted by the action or a fallback timer. */
      holdLocal: boolean;
      /** Callee: 'ready' announced to the caller (once). */
      readySent: boolean;
      /** Callee → caller media-ready action (trystero data channel). */
      sendReady: ((data: string) => unknown) | null;
      /** PiP tap swaps which stream fills the screen (video mode only). */
      swapped: boolean;
      timers: number[];
      ringTimer: number | null;
      connectTimer: number | null;
      wake: { release(): Promise<void> } | null;
      done: boolean;
    } | null = null;

    const clearT = (id: number | null) => {
      if (id != null) clearTimeout(id);
    };
    const clearTimers = () => {
      if (!call) return;
      call.timers.forEach((t) => clearInterval(t));
      call.timers = [];
      clearT(call.ringTimer);
      clearT(call.connectTimer);
      call.ringTimer = call.connectTimer = null;
    };

    async function teardown(alreadyEnded = false, reason: 'hangup' | 'timeout' | 'failed' = 'hangup') {
      if (!call || call.done) return;
      const me = call;
      me.done = true;
      dbg('teardown:', reason, alreadyEnded ? '(remote/server)' : '(local)');
      clearTimers();
      // leave() tells the peer over the data channel (instant), destroys the
      // peer connections, and removes the rtc signaling channel. The delayed
      // pc.close() is belt-and-braces for a leave() that dies on a dead data
      // channel before its own peer cleanup — the grace lets the goodbye flush.
      void me.room?.leave().catch(() => {});
      setTimeout(() => me.pc?.close(), 500);
      me.channel?.close();
      me.local?.getTracks().forEach((t) => t.stop());
      void me.wake?.release().catch(() => {});
      remoteEl.srcObject = null;
      audioEl.srcObject = null;
      localEl.srcObject = null;
      remoteEl.classList.remove('-scale-x-100');
      localEl.classList.remove('-scale-x-100');
      soundPill.hidden = true;
      screen.hidden = true;
      incoming.hidden = true;
      // Free the dock BEFORE the network await — a slow/hung call.end must
      // never leave a zombie `call` silently eating the next start tap.
      call = null;
      // Local failure → the screenshot-able report card ("it didn't work"
      // must never arrive at support without a diagnosis again).
      if (reason === 'failed' && !alreadyEnded) showCallError(me, reason);
      if (!alreadyEnded) {
        try {
          await actions.call.end({ callId: me.view.id, reason });
        } catch {
          /* already terminal server-side */
        }
      }
    }

    function showCallError(me: { view: CallView }, reason: string) {
      const report = [
        new Date().toISOString(),
        `call ${me.view.id} · ${me.view.mode} · ${me.view.party} · ${reason}`,
        navigator.userAgent,
        '──',
        ...logBuf,
      ].join('\n');
      $('[data-call-error-log]').textContent = report;
      $('[data-call-error]').hidden = false;
      // Same report → Sentry, so support sees it without a screenshot.
      void actions.call
        .reportFailure({ callId: me.view.id, reason, log: report.slice(0, 4000) })
        .catch(() => {});
    }
    $('[data-call-error-close]').addEventListener('click', () => {
      $('[data-call-error]').hidden = true;
    });
    $('[data-call-error-copy]').addEventListener('click', () => {
      void navigator.clipboard?.writeText($('[data-call-error-log]').textContent ?? '').catch(() => {});
    });

    /** Shared block confirmation dialog (native top layer via Modal). */
    let onBlockConfirm: (() => void) | null = null;
    function confirmBlock(text: string, fn: () => void) {
      const dlg = document.getElementById('call-block-confirm') as HTMLDialogElement | null;
      if (!dlg) return fn(); // dialog missing — never trap the action
      const label = dlg.querySelector<HTMLElement>('[data-block-confirm-text]');
      if (label) label.textContent = text;
      onBlockConfirm = fn;
      dlg.showModal();
    }
    // Delegated: the dialog element is outside the persisted dock and gets
    // replaced on view transitions — a direct listener would orphan.
    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest?.('[data-block-confirm-go]')) return;
      (document.getElementById('call-block-confirm') as HTMLDialogElement | null)?.close();
      const fn = onBlockConfirm;
      onBlockConfirm = null;
      fn?.();
    });

    function setChip(key: 'ringing' | 'connecting' | 'connected' | 'poor' | 'reconnecting') {
      const el = $('[data-call-state-chip]');
      const map: Record<string, string | undefined> = {
        ringing: root.dataset.i18nRinging,
        connecting: root.dataset.i18nConnecting,
        connected: '',
        poor: root.dataset.i18nPoor,
        reconnecting: root.dataset.i18nReconnecting,
      };
      el.textContent = map[key] ?? '';
      // Voice keeps the identity panel; video hides it while media flows and
      // brings it BACK for any non-connected state — "Reconnecting…" must be
      // visible over the frozen remote frame, not inside a hidden panel.
      if (call?.view.mode === 'video') {
        $('[data-call-idpanel]').classList.toggle('hidden', key === 'connected');
      }
      $('[data-call-pulse]').classList.toggle('hidden', key === 'connected');
    }

    function showScreen(view: CallView) {
      $('[data-call-name]').textContent = view.peerName;
      const avatar = $<HTMLImageElement>('[data-call-avatar]');
      const initial = $('[data-call-initial]');
      // The client sees her photo; she sees his initial (clients have no photos).
      if (view.party === 'client' && view.avatarUrl) {
        avatar.src = view.avatarUrl;
        avatar.classList.remove('hidden');
        initial.classList.add('hidden');
      } else {
        avatar.classList.add('hidden');
        initial.classList.remove('hidden');
        initial.textContent = view.peerName.charAt(0).toUpperCase();
      }
      const isVideo = view.mode === 'video';
      remoteWrap.hidden = !isVideo;
      localWrap.hidden = !isVideo;
      $('[data-ctl-cam]').hidden = !isVideo;
      $('[data-ctl-flip]').hidden = !isVideo;
      $('[data-ctl-endblock]').hidden = view.party !== 'professional';
      $('[data-call-idpanel]').classList.remove('hidden');
      screen.hidden = false;
    }

    function startTimer() {
      const el = $('[data-call-timer]');
      const t0 = Date.now();
      const id = window.setInterval(() => {
        const s = Math.floor((Date.now() - t0) / 1000);
        el.textContent = `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
      }, 1000);
      call?.timers.push(id);
    }

    async function getMedia(mode: 'voice' | 'video', facing: 'user' | 'environment' = 'user') {
      return navigator.mediaDevices.getUserMedia(
        mode === 'video'
          ? { audio: true, video: { facingMode: facing, width: { ideal: 1280 }, height: { ideal: 720 } } }
          : { audio: true },
      );
    }

    /**
     * Runs INSIDE the tap gesture, before any await: playback intent lands
     * while activation is live, so remote tracks later flow into elements
     * that are already playing — autoplay policy is never re-consulted.
     */
    function primeRemoteMedia() {
      const audio = new MediaStream();
      const video = new MediaStream();
      audioEl.srcObject = audio;
      audioEl.muted = false;
      audioEl
        .play()
        .then(() => {
          soundPill.hidden = true;
        })
        .catch((e) => dbg('audio prime:', (e as Error)?.name));
      remoteEl.srcObject = video;
      void remoteEl.play().catch(() => {}); // muted video — never policy-blocked
      return { audio, video };
    }

    /** Kick paused remote elements; on refusal show the tap-for-sound pill. */
    function ensureRemotePlayback() {
      if (!call) return;
      if (audioEl.paused && call.remoteAudio.getTracks().length) {
        audioEl.muted = false;
        audioEl
          .play()
          .then(() => {
            soundPill.hidden = true;
          })
          .catch((e) => {
            warn('remote audio blocked:', (e as Error)?.name);
            soundPill.hidden = false;
          });
      }
      if (call.view.mode === 'video' && remoteEl.paused && call.remoteVideo.getTracks().length) {
        void remoteEl.play().catch((e) => warn('remote video blocked:', (e as Error)?.name));
      }
    }
    soundPill.addEventListener('click', (e) => {
      e.stopPropagation();
      soundPill.hidden = true;
      ensureRemotePlayback(); // this tap IS the gesture the policy wanted
    });
    // Any tap on the call screen doubles as the recovery gesture.
    screen.addEventListener('pointerdown', () => {
      if (!soundPill.hidden) {
        soundPill.hidden = true;
        ensureRemotePlayback();
      }
    });

    function abortStart(mediaP: Promise<MediaStream>) {
      mediaP.then((s) => s.getTracks().forEach((t) => t.stop())).catch(() => {});
      audioEl.srcObject = null;
      remoteEl.srcObject = null;
    }

    /** Route local/remote video into main vs PiP per the swap flag; mirror
     *  whichever element shows the local FRONT camera (mirror convention —
     *  remote video and the back camera are never mirrored). */
    function applyVideoLayout() {
      if (!call?.local || call.view.mode !== 'video') return;
      remoteEl.srcObject = call.swapped ? call.local : call.remoteVideo;
      localEl.srcObject = call.swapped ? call.remoteVideo : call.local;
      const mirror = facing === 'user';
      remoteEl.classList.toggle('-scale-x-100', call.swapped && mirror);
      localEl.classList.toggle('-scale-x-100', !call.swapped && mirror);
      fitVideos();
      void remoteEl.play().catch(() => {});
      void localEl.play().catch(() => {});
    }
    localWrap.addEventListener('click', () => {
      if (!call || call.done) return;
      call.swapped = !call.swapped;
      applyVideoLayout();
    });

    /** Join the trystero room — it owns offer/answer, glare, ICE, restarts. */
    function joinRtc(me: NonNullable<typeof call>) {
      const room = joinCallRoom(
        {
          appId: 'intimate',
          rtcConfig: {
            iceServers: me.ice.iceServers,
            // Her side: relay-only when TURN is live — her address never
            // appears in any candidate the client can see (VIDEO-CALLING §1.1).
            iceTransportPolicy: me.ice.relayOnly ? 'relay' : 'all',
          },
        },
        me.view.id,
        {
          // trystero's default is 10s — too tight for relay-only ICE through
          // coturn on mobile networks. Match our honest connect budget.
          handshakeTimeoutMs: CONNECT_MS,
          onJoinError: (d) => {
            if (call !== me || me.done) return;
            warn('rtc join failed:', d.error);
            alertToast(root.dataset.i18nCallFailed);
            void teardown(false, 'failed');
          },
        },
      );
      me.room = room;
      // Callee announces "my media is captured" over the data channel; only
      // then does the caller renegotiate — so its offer always arrives when
      // the callee can answer with tracks attached (see watchPeer).
      const ready = room.makeAction('ready');
      me.sendReady = (d: string) => ready.send(d);
      ready.onMessage = () => {
        if (call !== me || me.done) return;
        dbg('peer media ready');
        me.holdLocal = false;
        maybeSendLocal(me);
      };
      room.onPeerJoin = (peerId) => {
        if (call !== me || me.done) return;
        dbg('peer join');
        // A peer in the RLS-gated room IS an accept (the callee only joins
        // after the accept action) — backstop for a lost DB-trigger event,
        // so the ring timer can never kill an already-connected call.
        if (me.view.party === 'professional') onAccepted(me);
        watchPeer(me, peerId);
        maybeSendLocal(me);
        signalReady(me);
        if (me.holdLocal) {
          // Caller fallback: callee's media never materialised — offer anyway
          // (one-way call beats silence; the callee answers recvonly). 15s,
          // NOT shorter: iOS re-prompts for cam/mic each page load, and an
          // offer that lands while the prompt is open locks the callee into
          // a recvonly answer it can never upgrade (it may never offer).
          const t = window.setTimeout(() => {
            if (call === me && !me.done && me.holdLocal) {
              me.holdLocal = false;
              maybeSendLocal(me);
            }
          }, 15_000);
          me.timers.push(t);
        }
      };
      room.onPeerLeave = () => {
        if (call !== me || me.done) return;
        dbg('peer left');
        setChip('reconnecting');
        // Normal hangup: the server 'ended' event lands within ~½s and tears
        // down first (alreadyEnded). Only a peer that died without writing
        // state falls through to an honest local 'failed'.
        const t = window.setTimeout(() => {
          if (call === me && !me.done) void teardown(false, 'failed');
        }, 2000);
        me.timers.push(t);
      };
    }

    /** Callee: tell the caller our media is captured (once, peer present). */
    function signalReady(me: NonNullable<typeof call>) {
      if (me.done || me.readySent || me.view.party !== 'client') return;
      if (!me.local || !me.room || !Object.keys(me.room.getPeers()).length) return;
      me.readySent = true;
      dbg('media ready → caller');
      void me.sendReady?.('1');
    }

    /** Local stream → room, exactly once, only while a peer is present —
     *  trystero sends streams to CURRENT peers, not to future joiners. */
    function maybeSendLocal(me: NonNullable<typeof call>) {
      if (me.done || !me.local || !me.room || me.sent || me.holdLocal) return;
      if (!Object.keys(me.room.getPeers()).length) return;
      me.sent = true;
      dbg('local stream sent');
      for (const p of me.room.addStream(me.local)) void p.catch((e) => warn('addStream:', e));
    }

    /** Observe the peer connection: remote tracks in, the callee's answer-side
     *  media attach, and the state chip. Restart orchestration stays trystero's. */
    function watchPeer(me: NonNullable<typeof call>, peerId: string) {
      const pc = me.room?.getPeers()[peerId];
      if (!pc) return;
      me.pc = pc;
      // Remote media lands here (raw pc events — trystero's own pc.ontrack
      // property handler coexists and keeps serving its internals).
      pc.addEventListener('track', (e) => {
        if (call !== me || me.done) return;
        const t = e.track;
        dbg('track:', t.kind);
        (t.kind === 'audio' ? me.remoteAudio : me.remoteVideo).addTrack(t);
        t.onunmute = () => ensureRemotePlayback();
        ensureRemotePlayback();
        // Callee: ride our media back INSIDE THE ANSWER on the caller's own
        // transceivers. A WebKit callee must never create an offer — its
        // re-offer renumbers RTP extension IDs and Chromium kills the call
        // ("RTP extension ID reassignment not supported"). This runs during
        // setRemoteDescription, before trystero's createAnswer.
        if (me.view.party === 'client') {
          const tr = e.transceiver;
          const local = me.local?.getTracks().find((l) => l.kind === t.kind);
          if (tr?.sender && !tr.sender.track && local) {
            try {
              tr.direction = 'sendrecv';
            } catch {
              /* setter unsupported — replaceTrack alone still tries */
            }
            void tr.sender.replaceTrack(local).catch((err) => warn('attach:', err));
          }
        }
      });
      const sync = () => {
        if (call !== me || me.done || me.pc !== pc) return;
        const s = pc.connectionState;
        dbg('pc:', s);
        if (s === 'connected') {
          clearT(me.connectTimer);
          me.connectTimer = null;
          setChip('connected');
        } else if (s === 'disconnected' || s === 'failed') {
          setChip('reconnecting'); // trystero restarts; onPeerLeave is the exit
        }
      };
      pc.addEventListener('connectionstatechange', sync);
      // onPeerJoin fires once the data channel is open — the pc is usually
      // ALREADY 'connected', so the transition we listen for never comes.
      sync();
    }

    /**
     * The caller's accept moment, driven by the reliable DB-trigger `active`
     * event on the call topic (the callee learns of accept locally). The peers
     * connect on their own — this only moves the UI, timers and heartbeat.
     * Idempotent via `me.accepted`.
     */
    function onAccepted(me: NonNullable<typeof call>) {
      if (call !== me || me.accepted || me.done) return;
      me.accepted = true;
      dbg('accepted');
      clearT(me.ringTimer);
      me.ringTimer = null;
      setChip('connecting');
      armConnectTimeout();
      startTimer();
      beginBeat();
    }

    /**
     * Server-truth state changes (DB trigger 0013 on the call topic): how the
     * ringing caller learns of an accept or a decline, and how either side
     * learns the session was swept/terminated elsewhere. Never carries SDP.
     */
    function onCallStateEvent(p: unknown) {
      const { id, state } = p as { id: string; state: string };
      if (!call || call.view.id !== id || call.done) return;
      if (state === 'active') {
        if (call.view.party === 'professional') onAccepted(call);
        return;
      }
      if (state === 'ringing') return;
      dbg('server state:', state);
      if (state === 'declined') alertToast(root.dataset.i18nDeclined);
      void teardown(true);
    }

    /** Server-truth channel died: fatal before media connects, shrug after. */
    function onChannelStatus(s: 'ready' | 'down') {
      dbg('channel:', s);
      if (s !== 'down' || !call || call.done) return;
      if (call.pc?.connectionState === 'connected') {
        warn('signaling down mid-call — media is P2P and unaffected');
        return;
      }
      warn('signaling channel dead before connect');
      alertToast(root.dataset.i18nCallFailed);
      void teardown(false, 'failed');
    }

    function armConnectTimeout() {
      if (!call) return;
      const me = call;
      me.connectTimer = window.setTimeout(() => {
        if (call === me && !me.done && me.pc?.connectionState !== 'connected') {
          warn('connect timeout');
          alertToast(root.dataset.i18nCallFailed);
          void teardown(false, 'failed');
        }
      }, CONNECT_MS);
    }

    function beginBeat() {
      const id = window.setInterval(() => {
        if (call) void actions.call.beat({ callId: call.view.id }).catch(() => {});
      }, BEAT_MS);
      call?.timers.push(id);
    }

    async function grabWakeLock() {
      try {
        if (call) call.wake = await (navigator as any).wakeLock?.request('screen');
      } catch {
        /* not critical */
      }
    }

    function mediaFailToast(e: unknown) {
      const name = (e as Error)?.name;
      warn('getUserMedia failed:', name ?? e);
      alertToast(
        name === 'NotAllowedError' || name === 'NotFoundError'
          ? root.dataset.i18nMediaBlocked
          : root.dataset.i18nCallFailed,
      );
    }

    // ── caller flow (professional) ────────────────────────────────────────
    async function startCall(threadId: string, mode: 'voice' | 'video') {
      if (call) {
        dbg('start ignored — call in flight', call.view.id);
        return;
      }
      facing = 'user'; // getMedia opens the front camera — never inherit a past flip
      logBuf.length = 0; // fresh diagnostic trail per call
      dbg('start:', mode);
      // Synchronously inside the tap: the permission prompt opens privileged
      // (WebKit re-prompts after past denials only then) and remote playback
      // is primed. Media + ICE warm up DURING the ring — on accept the offer
      // leaves instantly, no permission prompt in the critical path.
      const mediaP = getMedia(mode);
      mediaP.catch(() => {}); // handled in the media chain below
      const remote = primeRemoteMedia();
      let res;
      try {
        res = await actions.call.start({ threadId, mode });
      } catch {
        abortStart(mediaP);
        alertToast(root.dataset.i18nCallFailed);
        return;
      }
      // Astro actions surface handler errors on res.error (no throw) — check it
      // before touching res.data, or a 500/busy would crash the dock here.
      if (res.error || !res.data) {
        abortStart(mediaP);
        alertToast(res.error?.code === 'CONFLICT' ? root.dataset.i18nBusy : root.dataset.i18nCallFailed);
        return;
      }
      const { call: view, iceServers, relayOnly } = res.data as { call: CallView; iceServers: RTCIceServer[]; relayOnly: boolean };
      call = {
        view,
        ice: { iceServers, relayOnly },
        channel: null,
        room: null,
        pc: null,
        local: null,
        remoteAudio: remote.audio,
        remoteVideo: remote.video,
        accepted: false,
        sent: false,
        holdLocal: true, // wait for the callee's 'ready' (or the fallback)
        readySent: false,
        sendReady: null,
        swapped: false,
        timers: [],
        ringTimer: null,
        connectTimer: null,
        wake: null,
        done: false,
      };
      const me = call;
      showScreen(view);
      setChip('ringing');
      void grabWakeLock();

      me.channel = openChannel(`call:${view.id}`, { call: onCallStateEvent }, onChannelStatus);
      joinRtc(me); // announce + ICE pre-warm run during the ring

      void (async () => {
        let local: MediaStream;
        try {
          local = await mediaP; // may sit on the permission prompt — ring continues
        } catch (e) {
          if (call === me && !me.done) {
            mediaFailToast(e);
            void teardown(false, 'failed');
          }
          return;
        }
        if (call !== me || me.done) {
          local.getTracks().forEach((t) => t.stop());
          return;
        }
        me.local = local;
        applyVideoLayout();
        maybeSendLocal(me);
      })();

      // 30s unanswered → timeout ("missed" card) — never fake a longer ring.
      me.ringTimer = window.setTimeout(() => {
        if (call === me && !me.accepted && !me.done) {
          dbg('ring timeout');
          void teardown(false, 'timeout');
        }
      }, RING_MS);
    }

    // ── callee flow (client) ──────────────────────────────────────────────
    let ringingId: string | null = null;

    /** Best-effort audible ring + repeating vibration while the overlay is up.
     *  WebAudio needs a prior gesture on the page (autoplay policy) — a client
     *  who has tapped anything hears it, otherwise it fails silently; vibrate
     *  covers Android regardless (iOS never exposes vibrate). */
    let stopRing: (() => void) | null = null;
    function startRingtone() {
      stopRing?.();
      let ac: AudioContext | null = null;
      try {
        ac = new AudioContext();
      } catch {
        return;
      }
      if (ac.state === 'suspended') void ac.resume().catch(() => {});
      const gain = ac.createGain();
      gain.gain.value = 0.15;
      gain.connect(ac.destination);
      const burst = () => {
        if (!ac) return;
        // Classic dual-tone ring: two 350ms bursts, half a second apart.
        for (const at of [0, 0.5]) {
          for (const f of [440, 480]) {
            const o = ac.createOscillator();
            o.frequency.value = f;
            o.connect(gain);
            o.start(ac.currentTime + at);
            o.stop(ac.currentTime + at + 0.35);
          }
        }
      };
      burst();
      (navigator as any).vibrate?.([300, 120, 300, 120, 300]);
      const iv = window.setInterval(() => {
        burst();
        (navigator as any).vibrate?.([300, 120, 300]);
      }, 2500);
      stopRing = () => {
        stopRing = null;
        clearInterval(iv);
        (navigator as any).vibrate?.(0);
        void ac?.close().catch(() => {});
        ac = null;
      };
    }

    async function showRing(callId: string) {
      if (call || ringingId) return;
      let res;
      try {
        res = await actions.call.get({ callId });
      } catch {
        return;
      }
      if (res.error || !res.data) return;
      const view = (res.data as { call: CallView }).call;
      if (view.state !== 'ringing') return;
      ringingId = callId;
      $<HTMLImageElement>('[data-incoming-avatar]').src = view.avatarUrl ?? '';
      $('[data-incoming-name]').textContent = view.peerName;
      $('[data-incoming-mode]').textContent =
        view.mode === 'video' ? root.dataset.i18nIncomingVideo! : root.dataset.i18nIncomingVoice!;
      const blockBtn = $('[data-incoming-block]');
      incoming.hidden = false;
      startRingtone();
      // Auto-dismiss when the caller's 30s timeout lands server-side.
      window.setTimeout(() => {
        if (ringingId === callId && !call) {
          incoming.hidden = true;
          ringingId = null;
          stopRing?.();
        }
      }, RING_MS + 5000);

      blockBtn.onclick = () => {
        // Confirm dialog → decline AND block — the ring-spam wall now that
        // call.start is unlimited.
        confirmBlock(blockBtn.dataset.confirm ?? '', () => {
          incoming.hidden = true;
          ringingId = null;
          stopRing?.();
          void actions.call.decline({ callId });
          void actions.messaging.setBlocked({ threadId: view.threadId, blocked: true });
        });
      };

      $('[data-incoming-accept]').onclick = async () => {
        if (call) return;
        incoming.hidden = true;
        ringingId = null;
        stopRing?.();
        facing = 'user'; // getMedia opens the front camera — never inherit a past flip
        logBuf.length = 0; // fresh diagnostic trail per call
        dbg('accept tapped:', view.mode);
        // Synchronously inside the tap (same law as startCall): the prompt is
        // privileged and playback primed BEFORE the accept round-trip.
        const mediaP = getMedia(view.mode);
        mediaP.catch(() => {}); // awaited below
        const remote = primeRemoteMedia();
        let res;
        try {
          res = await actions.call.accept({ callId });
        } catch {
          res = null;
        }
        if (!res || res.error || !res.data) {
          warn('accept action failed:', res?.error?.code);
          abortStart(mediaP);
          alertToast(root.dataset.i18nCallFailed);
          return;
        }
        const ice = res.data as Ice;
        call = {
          view: { ...view, state: 'active' },
          ice,
          channel: null,
          room: null,
          pc: null,
          local: null,
          remoteAudio: remote.audio,
          remoteVideo: remote.video,
          accepted: true,
          sent: true, // callee never addStreams — media rides the answer
          holdLocal: false,
          readySent: false,
          sendReady: null,
          swapped: false,
          timers: [],
          ringTimer: null,
          connectTimer: null,
          wake: null,
          done: false,
        };
        const me = call;
        showScreen(me.view);
        setChip('connecting');
        void grabWakeLock();
        // Channel + room join while the media prompt may still be up; the
        // caller has been announcing in the room since the ring started, so
        // the handshake begins the moment our join lands.
        me.channel = openChannel(`call:${callId}`, { call: onCallStateEvent }, onChannelStatus);
        joinRtc(me);
        armConnectTimeout();
        startTimer();
        beginBeat();
        let local: MediaStream;
        try {
          local = await mediaP;
        } catch (e) {
          mediaFailToast(e);
          void teardown(false, 'failed');
          return;
        }
        if (call !== me || me.done) {
          local.getTracks().forEach((t) => t.stop());
          return;
        }
        me.local = local;
        applyVideoLayout();
        signalReady(me);
      };
      $('[data-incoming-decline]').onclick = () => {
        incoming.hidden = true;
        ringingId = null;
        stopRing?.();
        void actions.call.decline({ callId });
      };
    }

    // ── controls ──────────────────────────────────────────────────────────
    $('[data-ctl-end]').addEventListener('click', () => void teardown());
    const endblockBtn = $('[data-ctl-endblock]');
    endblockBtn.addEventListener('click', () => {
      confirmBlock(endblockBtn.dataset.confirm ?? '', () => {
        const threadId = call?.view.threadId;
        void (async () => {
          await teardown();
          if (threadId) {
            await actions.messaging.setBlocked({ threadId, blocked: true });
            location.reload();
          }
        })();
      });
    });
    $('[data-ctl-mute]').addEventListener('click', (e) => {
      const btn = e.currentTarget as HTMLElement;
      const track = call?.local?.getAudioTracks()[0];
      if (!track) return;
      track.enabled = !track.enabled;
      btn.setAttribute('aria-pressed', String(!track.enabled));
    });
    $('[data-ctl-cam]').addEventListener('click', (e) => {
      const btn = e.currentTarget as HTMLElement;
      const track = call?.local?.getVideoTracks()[0];
      if (!track) return;
      track.enabled = !track.enabled;
      btn.setAttribute('aria-pressed', String(!track.enabled));
      localEl.classList.toggle('opacity-30', !track.enabled);
    });
    /** Swap the SENT video track via the raw sender — replaceTrack never
     *  renegotiates, which the callee side is never allowed to do. */
    function swapSentVideo(_old: MediaStreamTrack | undefined, fresh: MediaStreamTrack) {
      const sender = call?.pc?.getSenders().find((s) => s.track?.kind === 'video');
      if (sender) void sender.replaceTrack(fresh).catch((e: unknown) => warn('track swap:', e));
    }
    let facing: 'user' | 'environment' = 'user';
    let flipping = false;
    $('[data-ctl-flip]').addEventListener('click', async () => {
      if (!call?.room || !call.local || flipping) return; // ignore double-taps mid-swap
      flipping = true;
      const next = facing === 'user' ? 'environment' : 'user';
      const old = call.local.getVideoTracks()[0];
      // iOS Safari allows only ONE live capture of a given kind: the new
      // getUserMedia returns the SAME camera (or throws) unless the old video
      // track is stopped first. Stop + detach BEFORE requesting the flip.
      if (old) {
        old.stop();
        call.local.removeTrack(old);
      }
      try {
        // Video only — re-capturing audio here would briefly double the mic.
        // exact:facingMode makes iOS actually switch rather than no-op to front.
        const fresh = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: { exact: next }, width: { ideal: 1280 }, height: { ideal: 720 } },
        });
        const newTrack = fresh.getVideoTracks()[0]!;
        swapSentVideo(old, newTrack); // swap the SENT track too
        call.local.addTrack(newTrack);
        facing = next;
        // call.local is live in whichever element currently shows it — the
        // track replacement propagates; re-route only to honor a swap.
        applyVideoLayout();
      } catch (e) {
        // No opposite camera (or exact:facingMode unsupported) — fall back to a
        // plain request so the local preview + sent track aren't left dead.
        warn('flip failed:', (e as Error)?.name);
        try {
          const fresh = await navigator.mediaDevices.getUserMedia({
            video: { facingMode: facing, width: { ideal: 1280 }, height: { ideal: 720 } },
          });
          const newTrack = fresh.getVideoTracks()[0]!;
          swapSentVideo(old, newTrack);
          call.local?.addTrack(newTrack);
          applyVideoLayout();
        } catch {
          /* camera gone entirely — audio continues */
        }
      } finally {
        flipping = false;
      }
    });

    function alertToast(text?: string) {
      if (!text) return;
      const el = document.createElement('div');
      el.className =
        'fixed left-1/2 top-4 z-[80] -translate-x-1/2 rounded-full bg-foreground px-4 py-2 text-sm font-medium text-background shadow-soft-lg';
      el.style.paddingTop = 'calc(0.5rem)';
      el.textContent = text;
      document.body.appendChild(el);
      setTimeout(() => el.remove(), 3200);
    }

    // ── account channel: badges (all roles) + ring (client) ───────────────
    openChannel(`account:${accountId}`, {
      message: () => showDots(),
      call: (p) => {
        const { id, state } = p as { id: string; state: string };
        if (role !== 'client') return;
        if (state === 'ringing') void showRing(id);
        else if (ringingId === id && state !== 'active') {
          incoming.hidden = true;
          ringingId = null;
          stopRing?.();
        }
      },
    });

    // Thread header / contact rows ask the dock to place a call. The custom
    // event dispatch is synchronous, so startCall still runs inside the tap
    // gesture (getUserMedia + playback priming depend on it).
    document.addEventListener('intimate:call', (e) => {
      const { threadId, mode } = (e as CustomEvent<{ threadId: string; mode: 'voice' | 'video' }>).detail;
      void startCall(threadId, mode);
    });

    // Backgrounded → returned: the OS may have released the wake lock and
    // paused playback; both are cheap to re-assert.
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && call && !call.done) {
        void grabWakeLock();
        ensureRemotePlayback();
      }
    });

    // Leaving the page mid-call = hangup (P2P can't outlive the page).
    window.addEventListener('pagehide', () => {
      if (call) void teardown();
    });
  }

  initCallDock();
  document.addEventListener('astro:page-load', initCallDock);
</script>
