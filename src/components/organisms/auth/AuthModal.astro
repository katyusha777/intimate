---
/**
 * Register / Login modal. Misprint: underline tabs (the category-tab
 * language), sharp slab role tiles with prefillable demo identities, slab
 * fields, anaglyph CTA. Submits via the auth.* actions (mock backend behind
 * the seam) and hard-navigates so the role-aware chrome re-renders.
 * Open with data-modal-open="auth" (+ optional data-auth-tab="login|register").
 */
import * as m from '@/paraglide/messages';
import { localizePath } from '@/lib/i18n';
import Button from '@/components/atoms/Button.astro';
import Modal from '@/components/molecules/Modal.astro';
import SlabField from '@/components/molecules/SlabField.astro';

/* Segmented control: wide, button-like, unmistakable active state (ink flip). */
const tabBtn =
  'cursor-pointer py-2.5 font-condensed text-sm font-bold uppercase tracking-wide transition-colors data-[active=true]:bg-foreground data-[active=true]:text-background data-[active=false]:text-muted-foreground data-[active=false]:hover:text-foreground';
---

<Modal id="auth" class="max-w-md">
  <div class="relative p-6 md:p-8">
    <button
      type="button"
      data-modal-close
      aria-label="Close"
      class="absolute right-4 top-4 grid size-9 cursor-pointer place-items-center rounded-full text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
    >
      <i class="fa-thin fa-xmark text-lg" aria-hidden="true"></i>
    </button>

    <p class="font-condensed text-xl font-semibold tracking-tight">{m.auth_welcome()}</p>

    <!-- Tabs: segmented control (button-like, clear active state) -->
    <div class="mt-5 grid grid-cols-2 gap-1.5 border border-foreground/15 p-1.5" role="tablist">
      <button type="button" role="tab" data-tab-btn="register" data-active="true" class={tabBtn}>
        {m.nav_register()}
      </button>
      <button type="button" role="tab" data-tab-btn="login" data-active="false" class={tabBtn}>
        {m.nav_login()}
      </button>
    </div>

    <!-- Register -->
    <form data-tab-panel="register" data-auth-form="register" class="mt-6 space-y-4">
      {/* Step 1: pick the account type FIRST. The email/password only appear
          AFTER a choice, so nobody registers as the wrong type by reflex. */}
      <p class="text-center font-condensed text-sm font-semibold uppercase tracking-wide text-muted-foreground">{m.auth_pick_role()}</p>
      <div class="grid grid-cols-2 gap-3">
        <button
          type="button"
          data-role-btn="advertiser"
          data-active="false"
          class="group flex cursor-pointer flex-col items-center gap-2 border border-foreground/20 p-5 text-center transition-colors hover:border-foreground/50 data-[active=true]:border-foreground data-[active=true]:bg-foreground data-[active=true]:text-background"
        >
          <svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h3l2-2h6l2 2h3v11H4z"/><circle cx="12" cy="13" r="3.5"/></svg>
          <span class="font-condensed text-base font-bold uppercase tracking-wide">{m.role_advertiser()}</span>
          <span class="text-xs text-muted-foreground group-data-[active=true]:text-background/70">{m.role_advertiser_desc()}</span>
        </button>
        <button
          type="button"
          data-role-btn="client"
          data-active="false"
          class="group flex cursor-pointer flex-col items-center gap-2 border border-foreground/20 p-5 text-center transition-colors hover:border-foreground/50 data-[active=true]:border-foreground data-[active=true]:bg-foreground data-[active=true]:text-background"
        >
          <svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"/></svg>
          <span class="font-condensed text-base font-bold uppercase tracking-wide">{m.role_client()}</span>
          <span class="text-xs text-muted-foreground group-data-[active=true]:text-background/70">{m.role_client_desc()}</span>
        </button>
      </div>

      {/* Step 2: revealed once a role is chosen. */}
      <div data-register-fields class="reveal-wrap">
        <div class="reveal-inner space-y-4">
          <SlabField label={m.auth_email()} name="email" type="email" autocomplete="email" required />
          <SlabField label={m.auth_password()} name="password" type="password" autocomplete="new-password" required />

          <p data-auth-error class="hidden text-sm font-medium text-brand">{m.auth_error()}</p>
          {/* Existing-email message (#13) with reset + support links. */}
          <p data-auth-exists class="hidden border border-brand/40 bg-brand/5 p-3 text-sm leading-relaxed">
            {m.auth_email_exists()}{' '}
            <button type="button" data-go-reset class="cursor-pointer font-medium text-brand underline underline-offset-2">{m.auth_reset_link()}</button>{' '}
            <span>{m.auth_or_support()}</span>{' '}
            <a href={localizePath('/support/')} class="font-medium underline underline-offset-2">{m.nav_support()}</a>
          </p>
          <Button type="submit" size="lg" class="w-full">{m.auth_create_account()}</Button>
          <p class="text-center text-xs leading-relaxed text-muted-foreground">
            {m.auth_terms()}
            <br />
            <a href={localizePath('/terms/')} class="underline underline-offset-2 hover:text-foreground">{m.legal_terms()}</a>
            <span aria-hidden="true"> · </span>
            <a href={localizePath('/privacy/')} class="underline underline-offset-2 hover:text-foreground">{m.legal_privacy()}</a>
          </p>
        </div>
      </div>
    </form>

    <!-- Login -->
    <form data-tab-panel="login" data-auth-form="login" class="mt-6 hidden space-y-4">
      <SlabField label={m.auth_email()} name="email" type="email" autocomplete="email" required />
      <SlabField label={m.auth_password()} name="password" type="password" autocomplete="current-password" required />
      <div class="-mt-1 text-right">
        <button type="button" data-forgot class="cursor-pointer text-sm font-semibold text-brand underline-offset-4 hover:underline">
          {m.auth_forgot()}
        </button>
      </div>

      <p data-auth-error class="hidden text-sm font-medium text-brand">{m.auth_error()}</p>
      <p data-forgot-sent class="hidden border border-foreground/20 bg-muted p-3 text-sm leading-relaxed">
        {m.auth_reset_sent()}
      </p>
      <Button type="submit" size="lg" class="w-full">{m.nav_login()}</Button>
    </form>

    <!-- Reset-password request (#3): a DEDICATED email box, reached from the
         "forgot password" link — no longer reads the login field. -->
    <form data-tab-panel="reset" data-auth-form="reset" class="mt-6 hidden space-y-4">
      <div>
        <p class="font-condensed text-lg font-semibold">{m.reset_request_title()}</p>
        <p class="mt-1 text-sm text-muted-foreground">{m.reset_request_sub()}</p>
      </div>
      <SlabField label={m.auth_email()} name="email" type="email" autocomplete="email" required />
      <p data-reset-sent class="hidden border border-foreground/20 bg-muted p-3 text-sm leading-relaxed">
        {m.auth_reset_sent()}
      </p>
      <Button type="submit" size="lg" class="w-full">{m.reset_send()}</Button>
      <p class="text-center text-xs">
        <button type="button" data-back-login class="cursor-pointer text-muted-foreground underline-offset-2 hover:underline">
          {m.nav_login()}
        </button>
      </p>
    </form>
  </div>
</Modal>

<!-- Confirmation-sent modal: stacks ON TOP of the auth modal (native <dialog>
     top layer) so the "check your inbox" moment is unmissable, with a way
     back to fix a mistyped email. -->
<Modal id="auth-confirm" class="max-w-sm">
  <div class="p-6 text-center md:p-8">
    <p class="eyebrow">{m.auth_create_account()}</p>
    <p class="display mt-2 text-3xl">{m.auth_confirm_title()}</p>
    <p data-confirm-email class="mt-4 break-all font-condensed text-lg font-bold"></p>
    <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{m.auth_confirm_sent()}</p>
    <Button data-confirm-ok size="lg" class="mt-6 w-full">{m.auth_confirm_ok()}</Button>
    <p class="mt-4 text-center text-xs">
      <button type="button" data-change-email class="cursor-pointer text-muted-foreground underline-offset-2 hover:underline">
        {m.auth_confirm_change()}
      </button>
    </p>
  </div>
</Modal>

<style>
  /* Register step 2: collapsed until a role is chosen, then it grows in. The
     0fr→1fr grid trick animates auto height; inner clips during the transition. */
  .reveal-wrap {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;
    transition: grid-template-rows 0.32s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.25s ease;
  }
  .reveal-wrap.is-open {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;
  }
  .reveal-inner {
    min-height: 0;
    overflow: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal-wrap {
      transition: none;
    }
  }
</style>

<script>
  import { actions } from 'astro:actions';

  function selectTab(scope: HTMLElement, name: string) {
    scope.querySelectorAll<HTMLElement>('[data-tab-btn]').forEach((b) => {
      b.dataset.active = String(b.dataset.tabBtn === name);
    });
    scope.querySelectorAll<HTMLElement>('[data-tab-panel]').forEach((p) => {
      p.classList.toggle('hidden', p.dataset.tabPanel !== name);
    });
  }

  function initAuthModal() {
    const modal = document.querySelector<HTMLElement>('dialog#auth');
    if (!modal || modal.dataset.authInit) return;
    modal.dataset.authInit = '1';

    modal.querySelectorAll<HTMLElement>('[data-tab-btn]').forEach((btn) => {
      btn.addEventListener('click', () => selectTab(modal, btn.dataset.tabBtn!));
    });

    // Openers may request a specific tab. One delegated listener for the whole
    // session — resolves the CURRENT dialog at click time (pages swap the DOM).
    if (!(window as any).__authTabDelegation) {
      (window as any).__authTabDelegation = true;
      document.addEventListener('click', (e) => {
        const opener = (e.target as HTMLElement).closest?.('[data-modal-open="auth"]');
        if (!(opener instanceof HTMLElement)) return;
        const current = document.querySelector<HTMLElement>('dialog#auth');
        if (!current) return;
        if (opener.dataset.authTab) selectTab(current, opener.dataset.authTab);
        // Openers can preselect a role tile (invite links → customer, #9) —
        // reveal the fields too, since the choice is already made.
        if (opener.dataset.authRole) {
          current.querySelectorAll<HTMLElement>('[data-role-btn]').forEach((b) => {
            b.dataset.active = String(b.dataset.roleBtn === opener.dataset.authRole);
          });
          current.querySelector<HTMLElement>('[data-register-fields]')?.classList.add('is-open');
        }
      });
    }

    // Reveal step 2 (email/password) once a role is chosen — registration is
    // role-first so nobody signs up as the wrong type by reflex.
    const revealRegisterFields = (focus = false) => {
      modal.querySelector<HTMLElement>('[data-register-fields]')?.classList.add('is-open');
      if (focus) modal.querySelector<HTMLInputElement>('[data-register-fields] input[name="email"]')?.focus();
    };

    // Role tiles: select + reveal the fields.
    modal.querySelectorAll<HTMLElement>('[data-role-btn]').forEach((btn) => {
      btn.addEventListener('click', () => {
        modal.querySelectorAll<HTMLElement>('[data-role-btn]').forEach((b) => {
          b.dataset.active = String(b === btn);
        });
        revealRegisterFields(true);
      });
    });

    // Forgot password → switch to the DEDICATED reset panel (#3), carrying over
    // whatever email was typed in the login field.
    const goReset = () => {
      const loginEmail = String(new FormData(modal.querySelector<HTMLFormElement>('[data-auth-form="login"]')!).get('email') ?? '').trim();
      const registerEmail = String(new FormData(modal.querySelector<HTMLFormElement>('[data-auth-form="register"]')!).get('email') ?? '').trim();
      selectTab(modal, 'reset');
      const box = modal.querySelector<HTMLInputElement>('[data-auth-form="reset"] input[name="email"]');
      if (box) { box.value = loginEmail || registerEmail; box.focus(); }
    };
    modal.querySelector<HTMLElement>('[data-forgot]')?.addEventListener('click', goReset);
    modal.querySelector<HTMLElement>('[data-go-reset]')?.addEventListener('click', goReset);
    modal.querySelector<HTMLElement>('[data-back-login]')?.addEventListener('click', () => selectTab(modal, 'login'));

    // "Wrong address?" in the confirmation modal → back to the register form
    // with the email field focused for the fix.
    const confirmDlg = document.querySelector<HTMLDialogElement>('dialog#auth-confirm');
    // "Got it" ends the whole flow — both dialogs close, back to the page.
    confirmDlg?.querySelector<HTMLElement>('[data-confirm-ok]')?.addEventListener('click', () => {
      confirmDlg.close();
      (modal as HTMLDialogElement).close();
    });
    confirmDlg?.querySelector<HTMLElement>('[data-change-email]')?.addEventListener('click', () => {
      confirmDlg.close();
      selectTab(modal, 'register');
      const box = modal.querySelector<HTMLInputElement>('[data-auth-form="register"] input[name="email"]');
      box?.focus();
      box?.select();
    });

    // Submit via actions; hard navigation so role-aware chrome re-renders.
    modal.querySelectorAll<HTMLFormElement>('[data-auth-form]').forEach((form) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (form.dataset.loading) return;
        form.dataset.loading = '1';
        const err = form.querySelector<HTMLElement>('[data-auth-error]');
        err?.classList.add('hidden');
        form.querySelector<HTMLElement>('[data-auth-exists]')?.classList.add('hidden');
        const fd = new FormData(form);
        const locale = (document.documentElement.lang || 'en') as import('@/lib/taxonomy').Locale;
        const email = String(fd.get('email') ?? '');
        const password = String(fd.get('password') ?? '');
        const role = (modal.querySelector<HTMLElement>('[data-role-btn][data-active="true"]')
          ?.dataset.roleBtn ?? 'client') as 'advertiser' | 'client';

        // Reset-request panel (#3): send the link, always show "sent", stop.
        if (form.dataset.authForm === 'reset') {
          await actions.auth.requestReset({ email });
          form.querySelector<HTMLElement>('[data-reset-sent]')?.classList.remove('hidden');
          delete form.dataset.loading;
          return;
        }

        const call = () =>
          form.dataset.authForm === 'register'
            ? actions.auth.register({ email, password, role, locale })
            : actions.auth.login({ email, password, locale });
        try {
          const result = await call();
          if (result.error) throw result.error;
          // Existing email (#13): show the "account already exists" message.
          if ((result.data as { emailExists?: boolean } | undefined)?.emailExists) {
            form.querySelector<HTMLElement>('[data-auth-exists]')?.classList.remove('hidden');
            delete form.dataset.loading;
            return;
          }
          // Email confirmation pending: no session yet — a modal stacked over
          // the auth dialog (unmissable), showing the address it went to.
          if (!result.data?.href) {
            const dlg = document.querySelector<HTMLDialogElement>('dialog#auth-confirm');
            if (dlg) {
              const addr = dlg.querySelector<HTMLElement>('[data-confirm-email]');
              if (addr) addr.textContent = email;
              if (!dlg.open) dlg.showModal();
              // showModal auto-focuses the first button → an unwanted focus
              // ring around GOT IT (same trap ActionSheet parks). Blur it;
              // Tab still enters the dialog normally.
              (document.activeElement as HTMLElement | null)?.blur?.();
            }
            delete form.dataset.loading;
            return;
          }
          // Sync device-local favorites into the new account, then adopt the
          // merged set back (favorites from another device come along).
          try {
            const favApi = (window as any).__favs;
            if (favApi) {
              const local = [...favApi.read()];
              const synced = await actions.account.syncFavorites({ favorites: local });
              if (synced.data?.favorites) favApi.write(new Set(synced.data.favorites));
            }
          } catch {
            /* non-fatal — favorites stay local */
          }
          location.href = result.data.href;
        } catch (e) {
          console.error('[auth] failed', e);
          err?.classList.remove('hidden');
          delete form.dataset.loading;
        }
      });
    });
  }
  initAuthModal();
  document.addEventListener('astro:page-load', initAuthModal);
</script>
