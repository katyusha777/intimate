---
/**
 * The advertiser's profile editor: taxonomy-driven fields, Misprint controls
 * (slab fields, print checkboxes, service chip-rows), saved via
 * account.saveProfile. Receives the MERGED profile (base + her edits).
 */
import * as m from '@/paraglide/messages';
import { birthDateForAge, type Profile } from '@/app/models/profile';
import {
  amenityLabel,
  dayLabel,
  genderLabel,
  incallLocationLabel,
  languageLabel,
  paymentMethodLabel,
  rateDurationLabel,
  serviceCategoryLabel,
  serviceLabel,
} from '@/lib/labels';
import {
  AMENITIES,
  CITIES,
  DAYS,
  GENDERS,
  INCALL_LOCATIONS,
  LANGUAGES,
  MEETING_TYPES,
  PAYMENT_METHODS,
  RATE_DURATIONS,
  SERVICES,
  SERVICE_CATEGORIES,
} from '@/lib/taxonomy';
import Button from '@/components/atoms/Button.astro';
import Icon from '@/components/atoms/Icon.astro';
import Select from '@/components/atoms/Select.astro';
import SlabField from '@/components/molecules/SlabField.astro';

interface Props {
  profile: Profile;
}
const { profile: p } = Astro.props;

const selectedServices = new Set(p.services as readonly string[]);
// Latest DOB an 18-year-old could have (for the date input's max).
const max18 = birthDateForAge(18);
const heading = 'font-condensed text-sm font-bold uppercase tracking-wide';
const row = 'flex cursor-pointer select-none items-center gap-2.5 text-sm hover:text-foreground/70';

// Existing rate rows keyed by duration for quick prefill of the table editor.
const rateByDuration = new Map(
  (p.rates ?? []).filter((r) => r.duration !== undefined).map((r) => [r.duration, r]),
);
/** Her free-text line items (label rows), in her saved order. */
const customRows = (p.rates ?? []).filter((r) => r.duration === undefined);
const setOf = (arr: readonly string[]) => new Set(arr as readonly string[]);
const selLanguages = setOf(p.languages ?? []);
const selIncall = setOf(p.incallLocations ?? []);
const selAmenities = setOf(p.amenities ?? []);
const selPayments = setOf(p.paymentMethods ?? []);
---

<form data-profile-editor class="max-w-2xl space-y-8">
  <div class="grid gap-4 sm:grid-cols-2">
    <SlabField label={m.editor_name()} name="name" value={p.name} required />
    <SlabField
      label={m.editor_birthdate()}
      name="birthDate"
      type="date"
      value={p.birthDate}
      max={max18}
      required
    />
    <label class="block space-y-1.5">
      <span class="text-sm font-medium">{m.filter_gender()}</span>
      <Select name="gender">
        {GENDERS.map((g) => <option value={g} selected={p.gender === g}>{genderLabel(g)}</option>)}
      </Select>
    </label>
    <label class="block space-y-1.5">
      <span class="text-sm font-medium">{m.filter_city()}</span>
      <Select name="city">
        {CITIES.map((c) => <option value={c.slug} selected={p.city === c.slug}>{c.name}</option>)}
      </Select>
    </label>
  </div>

  <div class="space-y-2">
    <h3 class={heading}>{m.filter_visit()}</h3>
    <div class="flex gap-6">
      {
        MEETING_TYPES.map((t) => (
          <label class={row}>
            <input
              type="checkbox"
              name="meetingTypes"
              value={t}
              checked={(p.meetingTypes as readonly string[]).includes(t)}
              class="cbx-box"
            />
            {t === 'incall' ? m.cat_private() : m.cat_escort()}
          </label>
        ))
      }
    </div>
  </div>

  <!-- Rates table (UX-PLAN 2.1): the source of truth for priceFrom. Tick a
       duration, fill an incall and/or outcall price. Empty rows are dropped. -->
  <div class="space-y-2">
    <h3 class={heading}>{m.editor_rates()}</h3>
    <p class="text-xs text-muted-foreground">{m.editor_rates_hint()}</p>
    <!-- One shared grid for header + every row — never wraps, always aligned,
         fits a 390px screen (flexible duration column + two 5rem price cells). -->
    <div data-rates>
      <div class="grid grid-cols-[1fr_5rem_5rem] items-center gap-2 border-b border-border pb-1.5 text-2xs uppercase tracking-wide text-muted-foreground">
        <span>{m.editor_rates_duration()}</span>
        <span class="text-right">{m.rates_incall()}</span>
        <span class="text-right">{m.rates_outcall()}</span>
      </div>
      {
        RATE_DURATIONS.map((dur) => {
          const r = rateByDuration.get(dur);
          return (
            <label class="grid grid-cols-[1fr_5rem_5rem] items-center gap-2 border-b border-border py-2" data-rate-row data-duration={dur}>
              <span class="flex min-w-0 cursor-pointer items-center gap-2.5 text-sm">
                <input type="checkbox" class="cbx-box" data-rate-on checked={r !== undefined} />
                <span class="truncate">{rateDurationLabel(dur)}</span>
              </span>
              <input
                type="number"
                inputmode="numeric"
                min="0"
                step="5"
                placeholder="€"
                data-rate-incall
                value={r?.incall ?? ''}
                class="w-full border border-foreground/20 bg-transparent px-2 py-1 text-right text-sm outline-none transition-colors focus:border-foreground"
              />
              <input
                type="number"
                inputmode="numeric"
                min="0"
                step="5"
                placeholder="€"
                data-rate-outcall
                value={r?.outcall ?? ''}
                class="w-full border border-foreground/20 bg-transparent px-2 py-1 text-right text-sm outline-none transition-colors focus:border-foreground"
              />
            </label>
          );
        })
      }
    </div>

    <!-- Custom line items: her own free-text rows ("15 minutes phone call"),
         each with prices, removable and sortable (↑/↓ — array order is the
         display order on the public rates table). -->
    <div class="pt-4" data-custom-rates>
      <p class="eyebrow text-2xs text-muted-foreground">{m.editor_custom_items()}</p>
      <div class="mt-2 space-y-2" data-custom-list>
        {
          customRows.map((r) => (
            <div class="grid grid-cols-[1fr_5rem_5rem] items-center gap-2" data-custom-row>
              <div class="flex min-w-0 items-center gap-1.5">
                <input
                  type="text"
                  maxlength="60"
                  placeholder={m.editor_custom_ph()}
                  data-custom-label
                  value={r.label}
                  class="w-full min-w-0 border border-foreground/20 bg-transparent px-2 py-1 text-sm outline-none transition-colors focus:border-foreground"
                />
                <button type="button" data-act="up" aria-label={m.editor_move_up()} class="grid size-7 flex-none cursor-pointer place-items-center border border-foreground/20 text-muted-foreground transition-colors hover:border-foreground/60 hover:text-foreground">
                  <Icon name="chevron-up" class="text-xs" />
                </button>
                <button type="button" data-act="down" aria-label={m.editor_move_down()} class="grid size-7 flex-none cursor-pointer place-items-center border border-foreground/20 text-muted-foreground transition-colors hover:border-foreground/60 hover:text-foreground">
                  <Icon name="chevron-down" class="text-xs" />
                </button>
                <button type="button" data-act="remove" aria-label={m.editor_remove_item()} class="grid size-7 flex-none cursor-pointer place-items-center border border-foreground/20 text-muted-foreground transition-colors hover:border-brand hover:text-brand">
                  <Icon name="xmark" class="text-xs" />
                </button>
              </div>
              <input type="number" inputmode="numeric" min="0" step="5" placeholder="€" data-custom-incall value={r.incall ?? ''} class="w-full border border-foreground/20 bg-transparent px-2 py-1 text-right text-sm outline-none transition-colors focus:border-foreground" />
              <input type="number" inputmode="numeric" min="0" step="5" placeholder="€" data-custom-outcall value={r.outcall ?? ''} class="w-full border border-foreground/20 bg-transparent px-2 py-1 text-right text-sm outline-none transition-colors focus:border-foreground" />
            </div>
          ))
        }
      </div>
      <template data-custom-template>
        <div class="grid grid-cols-[1fr_5rem_5rem] items-center gap-2" data-custom-row>
          <div class="flex min-w-0 items-center gap-1.5">
            <input
              type="text"
              maxlength="60"
              placeholder={m.editor_custom_ph()}
              data-custom-label
              class="w-full min-w-0 border border-foreground/20 bg-transparent px-2 py-1 text-sm outline-none transition-colors focus:border-foreground"
            />
            <button type="button" data-act="up" aria-label={m.editor_move_up()} class="grid size-7 flex-none cursor-pointer place-items-center border border-foreground/20 text-muted-foreground transition-colors hover:border-foreground/60 hover:text-foreground">
              <Icon name="chevron-up" class="text-xs" />
            </button>
            <button type="button" data-act="down" aria-label={m.editor_move_down()} class="grid size-7 flex-none cursor-pointer place-items-center border border-foreground/20 text-muted-foreground transition-colors hover:border-foreground/60 hover:text-foreground">
              <Icon name="chevron-down" class="text-xs" />
            </button>
            <button type="button" data-act="remove" aria-label={m.editor_remove_item()} class="grid size-7 flex-none cursor-pointer place-items-center border border-foreground/20 text-muted-foreground transition-colors hover:border-brand hover:text-brand">
              <Icon name="xmark" class="text-xs" />
            </button>
          </div>
          <input type="number" inputmode="numeric" min="0" step="5" placeholder="€" data-custom-incall class="w-full border border-foreground/20 bg-transparent px-2 py-1 text-right text-sm outline-none transition-colors focus:border-foreground" />
          <input type="number" inputmode="numeric" min="0" step="5" placeholder="€" data-custom-outcall class="w-full border border-foreground/20 bg-transparent px-2 py-1 text-right text-sm outline-none transition-colors focus:border-foreground" />
        </div>
      </template>
      <button
        type="button"
        data-add-custom
        class="mt-2 flex cursor-pointer items-center gap-1.5 border border-foreground/20 px-3 py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:border-foreground/60 hover:text-foreground"
      >
        <Icon name="plus" class="text-xs" />
        {m.editor_add_item()}
      </button>
    </div>

    <div class="grid gap-4 pt-2 sm:grid-cols-2">
      <div>
        <SlabField label={m.gtk_deposit()} name="depositPolicy" value={p.depositPolicy ?? ''} maxlength="200" />
        <!-- You take payments yourself — an optional deposit rule you set here
             is shown (labelled as yours) on your rates card. -->
        <p class="mt-1.5 text-xs text-muted-foreground">{m.deposit_hint()}</p>
      </div>
      <SlabField label={m.editor_extras()} name="extrasNote" value={p.extrasNote ?? ''} maxlength="200" />
    </div>
  </div>

  <!-- Good-to-know (UX-PLAN 2.5): taxonomy-keyed facts filled once. Every
       checkbox group is an aligned 2-column grid; languages show the top 6
       with the long tail behind a native Show-more. -->
  <div class="space-y-4">
    <h3 class={heading}>{m.gtk_title()}</h3>
    <div class="space-y-1.5">
      <span class="eyebrow text-2xs text-muted-foreground">{m.gtk_languages()}</span>
      <div class="grid grid-cols-2 gap-x-4 gap-y-2">
        {LANGUAGES.slice(0, 6).map((l) => (
          <label class={row}>
            <input type="checkbox" name="languages" value={l} checked={selLanguages.has(l)} class="cbx-box" />
            {languageLabel(l)}
          </label>
        ))}
      </div>
      <details
        class="group/langs"
        open={LANGUAGES.slice(6).some((l) => selLanguages.has(l)) || undefined}
      >
        <summary class="flex cursor-pointer list-none items-center gap-1.5 py-1 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground [&::-webkit-details-marker]:hidden">
          <span class="group-open/langs:hidden">{m.filter_show_more()}</span>
          <span class="hidden group-open/langs:inline">{m.filter_show_less()}</span>
          <Icon name="chevron-down" class="text-xs transition-transform group-open/langs:rotate-180" />
        </summary>
        <div class="grid grid-cols-2 gap-x-4 gap-y-2 pt-1.5">
          {LANGUAGES.slice(6).map((l) => (
            <label class={row}>
              <input type="checkbox" name="languages" value={l} checked={selLanguages.has(l)} class="cbx-box" />
              {languageLabel(l)}
            </label>
          ))}
        </div>
      </details>
    </div>
    <div class="space-y-1.5">
      <span class="eyebrow text-2xs text-muted-foreground">{m.gtk_place()}</span>
      <div class="grid grid-cols-2 gap-x-4 gap-y-2">
        {INCALL_LOCATIONS.map((l) => (
          <label class={row}>
            <input type="checkbox" name="incallLocations" value={l} checked={selIncall.has(l)} class="cbx-box" />
            {incallLocationLabel(l)}
          </label>
        ))}
      </div>
    </div>
    <div class="space-y-1.5">
      <span class="eyebrow text-2xs text-muted-foreground">{m.editor_amenities()}</span>
      <div class="grid grid-cols-2 gap-x-4 gap-y-2">
        {AMENITIES.map((a) => (
          <label class={row}>
            <input type="checkbox" name="amenities" value={a} checked={selAmenities.has(a)} class="cbx-box" />
            {amenityLabel(a)}
          </label>
        ))}
      </div>
    </div>
    <div class="space-y-1.5">
      <span class="eyebrow text-2xs text-muted-foreground">{m.gtk_payment()}</span>
      <div class="grid grid-cols-2 gap-x-4 gap-y-2">
        {PAYMENT_METHODS.map((pm) => (
          <label class={row}>
            <input type="checkbox" name="paymentMethods" value={pm} checked={selPayments.has(pm)} class="cbx-box" />
            {paymentMethodLabel(pm)}
          </label>
        ))}
      </div>
    </div>
  </div>

  <div class="space-y-2">
    <h3 class={heading}>{m.editor_hours()}</h3>
    <div>
      {
        DAYS.map((day) => {
          const h = p.openingHours?.[day] ?? { closed: false, allDay: false, from: '10:00', to: '22:00' };
          return (
            <div class="border-b border-border py-2.5" data-hours-row data-day={day}>
              <!-- Line 1: day left, the two toggles right-aligned — every row's
                   checkboxes line up. Line 2: the time range (when applicable). -->
              <div class="flex items-center justify-between gap-3">
                <span class="text-sm font-medium">{dayLabel(day)}</span>
                <div class="flex flex-none items-center gap-4">
                  <label class="flex cursor-pointer select-none items-center gap-2 text-sm">
                    <input type="checkbox" checked={h.closed} class="cbx-box" data-hours-closed />
                    {m.hours_closed()}
                  </label>
                  <label class="flex cursor-pointer select-none items-center gap-2 text-sm" data-hours-openonly>
                    <input type="checkbox" checked={h.allDay} class="cbx-box" data-hours-allday />
                    {m.hours_allday()}
                  </label>
                </div>
              </div>
              <div class="mt-2 flex items-center gap-2" data-hours-times>
                <input
                  type="time"
                  data-hours-from
                  value={h.from || '10:00'}
                  class="border border-foreground/20 bg-transparent px-2 py-1 text-sm outline-none transition-colors focus:border-foreground"
                />
                <span class="text-muted-foreground" aria-hidden="true">–</span>
                <input
                  type="time"
                  data-hours-to
                  value={h.to || '22:00'}
                  class="border border-foreground/20 bg-transparent px-2 py-1 text-sm outline-none transition-colors focus:border-foreground"
                />
              </div>
            </div>
          );
        })
      }
    </div>
  </div>

  <div class="space-y-2">
    <h3 class={heading}>{m.filter_services()}</h3>
    <div>
      {
        SERVICE_CATEGORIES.map((cat) => {
          const services = SERVICES[cat];
          const count = services.filter((s) => selectedServices.has(s)).length;
          return (
            <details class="group/cat" open={count > 0 || undefined}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-2 py-2 text-sm font-medium transition-colors hover:text-foreground/70 [&::-webkit-details-marker]:hidden">
                <span class="flex items-center gap-2">
                  {serviceCategoryLabel(cat)}
                  {count > 0 && (
                    <span class="grid size-5 place-items-center bg-foreground text-2xs font-semibold text-background">
                      {count}
                    </span>
                  )}
                </span>
                <Icon name="chevron-down" class="text-xs text-muted-foreground transition-transform group-open/cat:rotate-180" />
              </summary>
              <div class="space-y-2 pb-3 pt-1">
                {services.map((s) => (
                  <label class={row}>
                    <input
                      type="checkbox"
                      name="services"
                      value={s}
                      checked={selectedServices.has(s)}
                      class="cbx-box"
                    />
                    {serviceLabel(s)}
                  </label>
                ))}
              </div>
            </details>
          );
        })
      }
    </div>
  </div>

  <label class="block space-y-1.5">
    <span class="text-sm font-medium">{m.editor_description()}</span>
    <textarea
      name="description"
      rows="5"
      maxlength="1000"
      class="w-full border border-foreground/20 bg-transparent p-3 text-base caret-brand outline-none transition-colors focus:border-foreground md:text-sm"
    >{p.description}</textarea>
  </label>

  <div class="flex items-center gap-4">
    <Button type="submit">{m.editor_save()}</Button>
    <p data-editor-saved class="hidden text-sm font-medium text-online">{m.editor_saved()} ✓</p>
    <p data-editor-error class="hidden text-sm font-medium text-brand">{m.auth_error()}</p>
  </div>
</form>

<script>
  import { actions } from 'astro:actions';

  /** Show/hide a day's controls: closed hides everything, 24h hides the times. */
  function syncHoursRow(row: HTMLElement) {
    const closed = row.querySelector<HTMLInputElement>('[data-hours-closed]')!.checked;
    const allDay = row.querySelector<HTMLInputElement>('[data-hours-allday]')!.checked;
    row.querySelector<HTMLElement>('[data-hours-openonly]')!.style.display = closed ? 'none' : '';
    row.querySelector<HTMLElement>('[data-hours-times]')!.style.display =
      closed || allDay ? 'none' : '';
  }

  function initEditor() {
    document.querySelectorAll<HTMLFormElement>('[data-profile-editor]').forEach((form) => {
      if (form.dataset.init) return;
      form.dataset.init = '1';

      // Opening-hours progressive disclosure.
      form.querySelectorAll<HTMLElement>('[data-hours-row]').forEach((r) => {
        syncHoursRow(r);
        r.querySelectorAll('[data-hours-closed],[data-hours-allday]').forEach((c) =>
          c.addEventListener('change', () => syncHoursRow(r)),
        );
      });

      // Custom line items: add / remove / reorder (DOM order = saved order).
      const customList = form.querySelector<HTMLElement>('[data-custom-list]');
      const customTpl = form.querySelector<HTMLTemplateElement>('[data-custom-template]');
      form.querySelector('[data-add-custom]')?.addEventListener('click', () => {
        if (!customList || !customTpl) return;
        customList.appendChild(customTpl.content.cloneNode(true));
        customList.querySelector<HTMLInputElement>('[data-custom-row]:last-child [data-custom-label]')?.focus();
      });
      customList?.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>('button[data-act]');
        if (!btn) return;
        const row = btn.closest('[data-custom-row]')!;
        if (btn.dataset.act === 'remove') row.remove();
        else if (btn.dataset.act === 'up' && row.previousElementSibling)
          customList.insertBefore(row, row.previousElementSibling);
        else if (btn.dataset.act === 'down' && row.nextElementSibling)
          customList.insertBefore(row.nextElementSibling, row);
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        const openingHours: Record<string, unknown> = {};
        form.querySelectorAll<HTMLElement>('[data-hours-row]').forEach((r) => {
          openingHours[r.dataset.day!] = {
            closed: r.querySelector<HTMLInputElement>('[data-hours-closed]')!.checked,
            allDay: r.querySelector<HTMLInputElement>('[data-hours-allday]')!.checked,
            from: r.querySelector<HTMLInputElement>('[data-hours-from]')!.value,
            to: r.querySelector<HTMLInputElement>('[data-hours-to]')!.value,
          };
        });
        // Rates: one row per ticked duration with at least one price. The
        // derived priceFrom (min of the table) is computed server-side.
        const rates: Array<Record<string, unknown>> = [];
        form.querySelectorAll<HTMLElement>('[data-rate-row]').forEach((r) => {
          if (!r.querySelector<HTMLInputElement>('[data-rate-on]')!.checked) return;
          const num = (sel: string) => {
            const v = r.querySelector<HTMLInputElement>(sel)!.value.trim();
            return v === '' ? undefined : Number(v);
          };
          const incall = num('[data-rate-incall]');
          const outcall = num('[data-rate-outcall]');
          if (incall === undefined && outcall === undefined) return;
          const row: Record<string, unknown> = { duration: r.dataset.duration };
          if (incall !== undefined) row.incall = incall;
          if (outcall !== undefined) row.outcall = outcall;
          rates.push(row);
        });
        // Her custom line items, in DOM order (= her chosen order). A row
        // needs a label AND at least one price; the rest is skipped quietly.
        form.querySelectorAll<HTMLElement>('[data-custom-row]').forEach((r) => {
          const label = r.querySelector<HTMLInputElement>('[data-custom-label]')!.value.trim();
          if (!label) return;
          const num = (sel: string) => {
            const v = r.querySelector<HTMLInputElement>(sel)!.value.trim();
            return v === '' ? undefined : Number(v);
          };
          const incall = num('[data-custom-incall]');
          const outcall = num('[data-custom-outcall]');
          if (incall === undefined && outcall === undefined) return;
          const row: Record<string, unknown> = { label };
          if (incall !== undefined) row.incall = incall;
          if (outcall !== undefined) row.outcall = outcall;
          rates.push(row);
        });
        const optStr = (k: string) => {
          const v = String(fd.get(k) ?? '').trim();
          return v === '' ? undefined : v;
        };
        const patch = {
          name: String(fd.get('name') ?? ''),
          birthDate: String(fd.get('birthDate') ?? ''),
          gender: String(fd.get('gender')),
          city: String(fd.get('city')),
          rates,
          depositPolicy: optStr('depositPolicy'),
          extrasNote: optStr('extrasNote'),
          meetingTypes: fd.getAll('meetingTypes').map(String),
          services: fd.getAll('services').map(String),
          languages: fd.getAll('languages').map(String),
          incallLocations: fd.getAll('incallLocations').map(String),
          amenities: fd.getAll('amenities').map(String),
          paymentMethods: fd.getAll('paymentMethods').map(String),
          openingHours,
          description: String(fd.get('description') ?? ''),
        };
        const saved = form.querySelector<HTMLElement>('[data-editor-saved]')!;
        const error = form.querySelector<HTMLElement>('[data-editor-error]')!;
        saved.classList.add('hidden');
        error.classList.add('hidden');
        const { error: err } = await actions.account.saveProfile({ patch });
        (err ? error : saved).classList.remove('hidden');
      });
    });
  }
  initEditor();
  document.addEventListener('astro:page-load', initEditor);
</script>
