---
/**
 * "Get your profile live" — the dashboard view of the onboarding journey
 * (docs/ONBOARDING.md §3). Same derived progress as the setup flow; leaving the
 * flow never loses the thread. Required steps only (hours is optional, nudged
 * later). When every step is done, the whole card becomes the Submit button.
 * Advertiser + draft only — the dashboard decides when to render this.
 */
import * as m from '@/paraglide/messages';
import { localizePath } from '@/lib/i18n';
import Button from '@/components/atoms/Button.astro';
import type { OnboardingProgress, OnboardingStepKey } from '@/lib/onboarding';

interface Props {
  progress: OnboardingProgress;
}
const { progress } = Astro.props;

// Row labels only — the flow itself is driven by the single Continue button
// (setup wizard), so rows no longer deep-link anywhere. Full key set so the
// lookup is always defined.
const LABEL: Record<OnboardingStepKey, () => string> = {
  basics: m.onb_step_basics,
  contact: m.onb_step_contact,
  rates: m.onb_step_rates,
  services: m.onb_step_services,
  photos: m.onb_step_photos,
  hours: m.onb_step_services, // optional — not listed here
  phone: m.onb_step_phone,
  id: m.onb_step_id,
};
// Required steps only (the "get live" list): basics → photos → id. Contact,
// rates, services, hours and SMS are optional — filled from the editor later.
const rows = progress.steps.filter((s) => !s.optional).map((s) => ({ done: s.done, label: LABEL[s.key] }));
const pct = Math.round((progress.requiredDone / progress.requiredTotal) * 100);
---

<div class="facts-card dark bg-neutral-950 p-6 text-white">
  <p class="eyebrow text-2xs text-white/50">{progress.requiredDone} / {progress.requiredTotal}</p>
  <p class="mt-2 font-condensed text-2xl font-bold tracking-tight">{m.onb_title()}</p>
  <p class="mt-1.5 text-sm text-white/60">{m.onb_frame()}</p>

  <!-- Progress bar — the fill IS the reward (ONBOARDING.md law 2). -->
  <div class="mt-4 h-1.5 w-full overflow-hidden rounded-full bg-white/10">
    <div class="h-full rounded-full bg-online transition-[width] duration-500" style={`width:${pct}%`}></div>
  </div>

  {/* Status only — the single button below drives the flow. Deep-linking each
      row into the editor tabs saved but never advanced onboarding (confusing);
      the setup wizard owns save-and-advance. */}
  <ul class="mt-5 space-y-1">
    {
      rows.map((row) => (
        <li class="flex items-center gap-3 py-2.5">
          <span
            class:list={[
              'grid size-6 flex-none place-items-center rounded-full border text-xs',
              row.done ? 'border-online bg-online/15 text-online' : 'border-white/25 text-white/40',
            ]}
          >
            {row.done && (
              <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
            )}
          </span>
          <span class:list={['flex-1 text-sm font-medium', row.done ? 'text-white/50 line-through' : 'text-white']}>
            {row.label()}
          </span>
        </li>
      ))
    }
  </ul>

  <div class="mt-5 border-t border-white/10 pt-5">
    {
      progress.readyToSubmit ? (
        <Fragment>
          <p class="mb-3 text-sm text-white/70">{m.onb_submit_hint()}</p>
          <Button type="button" size="lg" class="w-full" data-onb-submit>
            {m.onb_submit()}
          </Button>
          <p data-onb-error class="mt-2 hidden text-sm font-medium text-brand">{m.auth_error()}</p>
        </Fragment>
      ) : (
        // Resumes at the first incomplete step (setup/index derives it).
        <Button as="a" href={localizePath('/account/setup/')} size="lg" class="w-full">
          {m.onb_continue_setup()}
        </Button>
      )
    }
  </div>
</div>

<script>
  import { actions } from 'astro:actions';
  function initOnbSubmit() {
    const btn = document.querySelector<HTMLButtonElement>('[data-onb-submit]');
    if (!btn || btn.dataset.init) return;
    btn.dataset.init = '1';
    btn.addEventListener('click', async () => {
      if (btn.dataset.loading) return;
      btn.dataset.loading = '1';
      const { error } = await actions.account.submitProfile({});
      if (error) {
        document.querySelector('[data-onb-error]')?.classList.remove('hidden');
        delete btn.dataset.loading;
        return;
      }
      location.reload(); // → the "in review" banner takes over
    });
  }
  initOnbSubmit();
  document.addEventListener('astro:page-load', initOnbSubmit);
</script>
