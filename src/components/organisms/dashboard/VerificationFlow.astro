---
/**
 * Two-step verification (ARCHITECTURE §11): SMS via Twilio Verify (mocked)
 * and ID + selfie-with-code review (documents are NEVER stored in the mock —
 * hard rule 3: they are toxic waste; only the state transition is recorded).
 */
import * as m from '@/paraglide/messages';
import { localizePath } from '@/lib/i18n';
import type { Account } from '@/app/models/account';
import type { Session } from '@/app/models/session';
import Button from '@/components/atoms/Button.astro';
import SlabField from '@/components/molecules/SlabField.astro';

interface Props {
  session: Session;
  account: Account;
}
const { session, account } = Astro.props;

const smsDone = Boolean(account.phoneVerifiedAt);
const idState = account.idVerification;

const stepNo = 'grid size-8 flex-none place-items-center bg-foreground font-condensed text-sm font-bold text-background';
const stepDone = 'grid size-8 flex-none place-items-center bg-online font-condensed text-sm font-bold text-neutral-950';
// Verified state as a pill (feedback v7 #6 — was flat green text): rounded
// chip, online tint, check glyph.
const verifiedPill =
  'inline-flex items-center gap-1.5 rounded-full bg-online/15 px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-online';
---

<div class="max-w-xl space-y-10" data-verification>
  <!-- Step 1 · SMS -->
  <section class="space-y-4">
    <div class="flex items-center gap-3">
      <span class={smsDone ? stepDone : stepNo}>{smsDone ? '✓' : '1'}</span>
      <h2 class="font-condensed text-xl font-semibold">{m.verify_step_sms()}</h2>
      {smsDone && (
        <span class={verifiedPill}>
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
          {m.verify_verified()}
        </span>
      )}
    </div>

    {
      !smsDone && (
        <div class="space-y-3 border-l border-border pl-7">
          <div class="flex items-end gap-2" data-sms-start>
            <SlabField
              label={m.verify_phone_label()}
              name="phone"
              type="tel"
              inputmode="tel"
              placeholder="06 12345678"
              class="flex-1"
            />
            <Button size="sm" type="button" data-sms-send class="mb-1">
              {m.verify_send_code()}
            </Button>
          </div>
          {/* Slides down BELOW the phone once the code is sent — a clearly
              separate input, not a swap of the phone field. */}
          <div hidden data-sms-check class="sms-slide space-y-2">
            <p class="text-xs text-muted-foreground">{m.verify_code_sent()}</p>
            <div class="flex items-end gap-2">
              <SlabField
                label={m.verify_code_label()}
                name="code"
                inputmode="numeric"
                placeholder="000000"
                maxlength="6"
                class="flex-1"
              />
              <Button size="sm" type="button" data-sms-verify class="mb-1">
                {m.verify_check_code()}
              </Button>
            </div>
          </div>
          <p data-sms-error class="hidden text-sm font-medium text-brand">{m.auth_error()}</p>
          {/* Phone already on another account (#12) — clear message + support. */}
          <p data-sms-phone-exists class="hidden text-sm font-medium text-brand">
            {m.auth_phone_exists()}{' '}
            <a href={localizePath('/support/')} class="underline underline-offset-2">{m.nav_support()}</a>
          </p>
        </div>
      )
    }
  </section>

  <!-- Step 2 · ID -->
  <section class="space-y-4">
    <div class="flex items-center gap-3">
      <span class={idState === 'approved' ? stepDone : stepNo}>{idState === 'approved' ? '✓' : '2'}</span>
      <h2 class="font-condensed text-xl font-semibold">{m.verify_step_id()}</h2>
      {idState === 'approved' && (
        <span class={verifiedPill}>
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
          {m.verify_verified()}
        </span>
      )}
      {idState === 'pending' && <span class="text-sm font-medium text-muted-foreground">{m.verify_pending()}…</span>}
    </div>

    {
      idState === 'unverified' && (
        <div class="space-y-4 border-l border-border pl-7">
          <p class="text-sm leading-relaxed">{m.verify_id_intro()}</p>
          <label class="flex cursor-pointer flex-col items-center gap-2 border border-dashed border-foreground/30 px-3 py-8 text-center text-sm text-muted-foreground transition-colors hover:border-foreground/70 hover:text-foreground">
            <input type="file" accept="image/*" data-id-doc class="sr-only" />
            <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><circle cx="9" cy="11" r="2" /><path d="M14 9h4M14 13h4M6 17h12" /></svg>
            <span data-file-label>{m.verify_id_doc()}</span>
          </label>
          <p class="text-xs leading-relaxed text-muted-foreground">{m.verify_privacy()}</p>
          <Button type="button" data-id-submit>{m.verify_submit()}</Button>
          <p data-id-error class="hidden whitespace-pre-line text-sm font-medium text-brand"></p>
        </div>
      )
    }
    {
      idState === 'pending' && (
        <div class="space-y-4 border-l border-border pl-7">
          <p class="max-w-md text-sm leading-relaxed text-muted-foreground">{m.verify_privacy()}</p>
        </div>
      )
    }
  </section>
</div>

<style>
  /* Code field slides down when revealed (not a jarring pop). */
  .sms-slide {
    animation: sms-slide-down 0.28s cubic-bezier(0.25, 1, 0.5, 1);
  }
  @keyframes sms-slide-down {
    from {
      opacity: 0;
      transform: translateY(-0.4rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sms-slide {
      animation: none;
    }
  }
</style>

<script>
  import { actions } from 'astro:actions';
  import { reencode } from '@/lib/reencode';
  import * as m from '@/paraglide/messages';

  // Default to the Netherlands: bare/national numbers (06…, 612…) become +31;
  // an explicit + or 00 country code is respected. Server re-validates E.164.
  function toE164(raw: string): string {
    const s = raw.replace(/[\s()\-.]/g, '');
    if (s.startsWith('+')) return s;
    if (s.startsWith('00')) return '+' + s.slice(2);
    if (s.startsWith('0')) return '+31' + s.slice(1);
    return '+31' + s;
  }

  function initVerification() {
    document.querySelectorAll<HTMLElement>('[data-verification]').forEach((root) => {
      if (root.dataset.init) return;
      root.dataset.init = '1';
      const err = root.querySelector<HTMLElement>('[data-sms-error]');
      const phoneExists = root.querySelector<HTMLElement>('[data-sms-phone-exists]');

      const sendBtn = root.querySelector<HTMLButtonElement>('[data-sms-send]');
      sendBtn?.addEventListener('click', async () => {
        // Guard against the double-tap that made "first click did nothing":
        // the click IS handled, but with no busy state it read as a no-op.
        if (sendBtn.dataset.loading) return;
        err?.classList.add('hidden');
        phoneExists?.classList.add('hidden');
        const phoneInput = root.querySelector<HTMLInputElement>('[data-sms-start] input[name="phone"]')!;
        const phone = toE164(phoneInput.value);
        sendBtn.dataset.loading = '1';
        // Visible busy state — the original "first click did nothing" was a
        // no-feedback async call; dim + block until Twilio answers.
        sendBtn.style.opacity = '0.6';
        sendBtn.style.pointerEvents = 'none';
        try {
          const { error } = await actions.account.startSms({ phone });
          if (error) {
            // A CONFLICT means the number is already verified on another account.
            if ((error as { code?: string }).code === 'CONFLICT') phoneExists?.classList.remove('hidden');
            else err?.classList.remove('hidden');
            return;
          }
          // Reveal the code input BELOW the phone (phone stays visible, locked).
          phoneInput.readOnly = true;
          const check = root.querySelector<HTMLElement>('[data-sms-check]')!;
          check.hidden = false;
          check.querySelector<HTMLInputElement>('input[name="code"]')?.focus();
        } finally {
          delete sendBtn.dataset.loading;
          sendBtn.style.opacity = '';
          sendBtn.style.pointerEvents = '';
        }
      });

      const verifyBtn = root.querySelector<HTMLElement>('[data-sms-verify]');
      verifyBtn?.addEventListener('click', async () => {
        err?.classList.add('hidden');
        const code = root.querySelector<HTMLInputElement>('[data-sms-check] input[name="code"]')!.value;
        const { error } = await actions.account.checkSms({ code });
        if (error) return err?.classList.remove('hidden');
        location.reload();
      });

      // Enter in an input fires its action button (these aren't <form> submits).
      const onEnter = (sel: string, btn: HTMLElement | null | undefined) =>
        root.querySelector<HTMLInputElement>(sel)?.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') { e.preventDefault(); btn?.click(); }
        });
      onEnter('[data-sms-start] input[name="phone"]', sendBtn);
      onEnter('[data-sms-check] input[name="code"]', verifyBtn);

      // ID step: a doc chosen → submit. The file is read only to be re-encoded;
      // the ID goes to the private EU bucket (toxic waste rule). ID only now —
      // no selfie, and NOT gated on SMS (phone verification is optional).
      const doc = root.querySelector<HTMLInputElement>('[data-id-doc]');
      const submit = root.querySelector<HTMLButtonElement>('[data-id-submit]');
      // Inline style, not a Tailwind class: classes added at runtime aren't
      // compiled (Tailwind only emits what it sees in source), so a JS-toggled
      // `border-brand` would have no CSS. Inline colour is reliable.
      const markMissing = (inp: HTMLInputElement | null, missing: boolean) => {
        const label = inp?.closest<HTMLElement>('label');
        if (label) label.style.borderColor = missing ? 'var(--brand)' : '';
      };
      const sync = () => {
        const label = doc?.closest('label')?.querySelector('[data-file-label]');
        if (doc?.files?.[0]) {
          if (label) label.textContent = `✓ ${doc.files[0].name}`;
          markMissing(doc, false);
        }
      };
      doc?.addEventListener('change', sync);
      const idErr = root.querySelector<HTMLElement>('[data-id-error]');
      submit?.addEventListener('click', async () => {
        const docFile = doc?.files?.[0];
        // Validate on click and TELL the user what's missing (red), instead of a
        // silently-disabled button that gives no feedback.
        if (!docFile) {
          markMissing(doc, true);
          idErr!.textContent = m.verify_fix_missing() + '\n• ' + m.verify_need_doc();
          idErr!.classList.remove('hidden');
          return;
        }
        if (submit.dataset.loading) return;
        submit.dataset.loading = '1';
        submit.disabled = true;
        idErr?.classList.add('hidden');
        try {
          // EXIF-stripped on-device (hard rule 2); larger cap than photos so the
          // reviewer can actually read the ID. Then it's private + audit-logged.
          const docUrl = await reencode(docFile, 2000, 0.85);
          const { error } = await actions.account.submitId({ doc: docUrl });
          if (error) throw error;
          location.reload();
        } catch {
          submit.disabled = false;
          delete submit.dataset.loading;
          if (idErr) {
            idErr.textContent = m.auth_error();
            idErr.classList.remove('hidden');
          }
        }
      });
    });
  }
  initVerification();
  document.addEventListener('astro:page-load', initVerification);
</script>
