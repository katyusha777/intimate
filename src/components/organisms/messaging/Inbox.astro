---
/**
 * Inbox thread list (docs/MESSAGING.md §6). Role-aware: a client sees the
 * professional (avatar via profileId); a professional sees the client (initial
 * circle). Rows link to the thread; unread ink-dot, pin star, presence-free v1.
 */
import * as m from '@/paraglide/messages';
import type { ThreadSummary } from '@/app/models/messaging';
import { localizePath } from '@/lib/i18n';
import SafeImage from '@/components/atoms/SafeImage.astro';

interface Props {
  threads: ThreadSummary[];
  viewer: 'professional' | 'client';
}
const { threads, viewer } = Astro.props;

/** UTC fallback; the client script localizes each row to the user's timezone. */
function utcTime(iso: string): string {
  return new Date(iso).toLocaleTimeString('en-GB', {
    hour: '2-digit',
    minute: '2-digit',
    timeZone: 'UTC',
  });
}

/** Snippet key → localized copy (the data layer emits keys for request cards). */
function snippet(s: string): string {
  return s === 'msg_snippet_request' ? m.msg_snippet_request() : s;
}
---

{
  threads.length === 0 ? (
    <div class="grid place-items-center py-24 text-center">
      <svg class="size-10 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/></svg>
      <p class="mt-4 font-condensed text-lg font-bold">{m.msg_empty_title()}</p>
      <p class="mt-1 max-w-xs text-sm text-muted-foreground">{m.msg_empty_body()}</p>
    </div>
  ) : (
    <ul class="divide-y divide-border">
      {threads.map((t) => (
        <li>
          <a
            href={localizePath(`/messages/${t.id}/`)}
            class="flex items-center gap-3 py-3.5 transition-colors hover:bg-muted/50"
          >
            {viewer === 'client' ? (
              <SafeImage imageKey={t.profileId} alt={t.profileName} class="size-12 flex-none rounded-full object-cover" />
            ) : (
              <span class="grid size-12 flex-none place-items-center rounded-full bg-foreground font-condensed text-lg font-bold text-background">
                {(viewer === 'professional' ? t.clientName : t.profileName).charAt(0)}
              </span>
            )}
            <span class="min-w-0 flex-1">
              <span class="flex items-center gap-2">
                {t.pinned && viewer === 'professional' && (
                  <svg class="size-3.5 flex-none text-brand" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.4 7.4H22l-6 4.6 2.3 7.4L12 17l-6.3 4.4L8 14 2 9.4h7.6z"/></svg>
                )}
                <span class="truncate font-condensed text-base font-bold">
                  {viewer === 'professional' ? t.clientName : t.profileName}
                </span>
                {/* A pending request wants her decision — flag it (UX-PLAN 4.3). */}
                {t.state === 'pending' && (
                  <span class="flex-none rounded-full bg-brand/15 px-1.5 py-0.5 text-2xs font-bold uppercase tracking-wide text-brand">
                    {m.request_badge()}
                  </span>
                )}
              </span>
              <span class="mt-0.5 flex items-center gap-1.5 text-sm text-muted-foreground">
                <span class="truncate">{snippet(t.snippet) || m.msg_snippet_empty()}</span>
              </span>
            </span>
            <span class="flex flex-none flex-col items-end gap-1.5">
              <span class="text-2xs text-muted-foreground" data-inbox-time={t.lastMessageAt}>{utcTime(t.lastMessageAt)}</span>
              {t.unread > 0 && (
                <span class="grid min-w-5 place-items-center rounded-full bg-brand px-1.5 text-2xs font-bold text-white">
                  {t.unread}
                </span>
              )}
            </span>
          </a>
        </li>
      ))}
    </ul>
  )
}

<script>
  // Localize inbox timestamps (SSR renders UTC — the server has no user tz):
  // today → HH:MM, otherwise DD/MM.
  function localizeInbox() {
    const now = new Date();
    document.querySelectorAll<HTMLElement>('[data-inbox-time]').forEach((el) => {
      const d = new Date(el.dataset.inboxTime!);
      el.textContent =
        d.toDateString() === now.toDateString()
          ? d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
          : d.toLocaleDateString([], { day: '2-digit', month: '2-digit' });
    });
  }
  localizeInbox();
  document.addEventListener('astro:page-load', localizeInbox);
</script>
