---
/**
 * Thread view (docs/MESSAGING.md §6): SSR message log + composer, kept live by
 * the realtime seam (poll now, Supabase channel in Phase 0). Bubbles, system
 * cards, read ticks, photo messages (tap → Lightbox). Composer photo button
 * shows for the professional always, for the client only when she granted it
 * (0.3). Overflow panel holds her contact controls: pin, note, allow-photos,
 * block.
 *
 * ponytail: the poll returns only messages newer than the last seen (no photo
 * re-download) + a read watermark; the JS bubble builder mirrors the SSR markup.
 * Timestamps render as a UTC fallback then localize on the client (the server
 * has no user timezone).
 */
import * as m from '@/paraglide/messages';
import type { Thread } from '@/app/models/messaging';
import { localizePath } from '@/lib/i18n';
import SafeImage from '@/components/atoms/SafeImage.astro';
import RequestCard from '@/components/organisms/messaging/RequestCard.astro';

interface Props {
  thread: Thread;
  viewer: 'professional' | 'client';
  /** Client + professional's mode is off → text composer disabled. */
  paused: boolean;
  /** Her private set (UX-PLAN 4.4), non-empty only for a client on an unlocked thread. */
  privatePhotos?: string[];
}
const { thread, viewer, paused, privatePhotos = [] } = Astro.props;

const otherName = viewer === 'professional' ? thread.clientName : thread.profileName;
const canPhoto = viewer === 'professional' || thread.clientMediaAllowed;
const blocked = thread.state === 'blocked';
// A pending thread (request awaiting accept) or a declined (frozen) one has no
// live composer — she answers via the request card, and free-compose is gated
// on the thread being open (data layer). The DoD throttle made visible.
const composerLocked = thread.state !== 'open';

/** System card copy by key (data-layer stores keys — MESSAGING.md §6). */
const systemText = (key: string): string =>
  key === 'msg_system_media_on'
    ? m.msg_system_media_on()
    : key === 'msg_system_request_accepted'
      ? m.msg_system_request_accepted()
      : key;

/** UTC fallback; the client script localizes to the user's timezone on load. */
const utcTime = (iso: string): string =>
  new Date(iso).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'UTC' });
---

<div
  class="mx-auto flex h-[100dvh] max-w-2xl flex-col"
  data-thread-root
  data-thread-id={thread.id}
  data-viewer={viewer}
  data-can-photo={canPhoto ? '1' : ''}
  data-state={thread.state}
  data-sys-media-on={m.msg_system_media_on()}
  data-sys-request-accepted={m.msg_system_request_accepted()}
>
  <!-- Header -->
  <header class="flex flex-none items-center gap-2 border-b border-border px-3 py-2.5">
    <a
      href={localizePath('/messages/')}
      aria-label={m.msg_back()}
      class="grid size-9 flex-none place-items-center rounded-full transition-colors hover:bg-muted"
    >
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
    </a>
    {
      viewer === 'client' ? (
        <SafeImage imageKey={thread.profileId} alt={otherName} class="size-9 flex-none rounded-full object-cover" />
      ) : (
        <span class="grid size-9 flex-none place-items-center rounded-full bg-foreground font-condensed text-sm font-bold text-background">
          {otherName.charAt(0)}
        </span>
      )
    }
    <span class="min-w-0 flex-1 truncate font-condensed text-lg font-bold">{otherName}</span>

    <div class="relative" data-thread-menu>
      <button
        type="button"
        data-menu-btn
        aria-haspopup="menu"
        aria-label={m.msg_options()}
        class="grid size-9 flex-none cursor-pointer place-items-center rounded-full transition-colors hover:bg-muted"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="5" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="12" cy="19" r="1.6"/></svg>
      </button>
      <div
        data-menu-panel
        hidden
        role="menu"
        class="absolute right-0 z-40 mt-2 w-64 border border-foreground/20 bg-background py-1 shadow-soft-lg"
      >
        {
          viewer === 'professional' && (
            <>
              <label class="flex cursor-pointer items-center justify-between gap-3 px-3.5 py-2.5 text-sm hover:bg-muted">
                {m.msg_pin()}
                <input type="checkbox" data-pin checked={thread.pinned} class="sr-only" />
                <span class="switch-track" aria-hidden="true" />
              </label>
              <label class="flex cursor-pointer items-center justify-between gap-3 px-3.5 py-2.5 text-sm hover:bg-muted">
                {m.msg_allow_photos()}
                <input type="checkbox" data-allow-photos checked={thread.clientMediaAllowed} class="sr-only" />
                <span class="switch-track" aria-hidden="true" />
              </label>
              <div class="px-3.5 py-2.5">
                <p class="mb-1.5 text-2xs font-medium uppercase tracking-wide text-muted-foreground">{m.msg_note()}</p>
                <span class="slab-field block">
                  <span class="slab-field__face block">
                    <textarea
                      data-note
                      rows="2"
                      maxlength="500"
                      placeholder={m.msg_note_placeholder()}
                      class="w-full resize-none bg-transparent p-2.5 text-sm caret-brand outline-none placeholder:text-muted-foreground"
                    >{thread.note}</textarea>
                  </span>
                </span>
              </div>
              <div class="my-1 border-t border-border" />
            </>
          )
        }
        <button
          type="button"
          data-block
          class="flex w-full items-center gap-2.5 px-3.5 py-2.5 text-left text-sm text-brand transition-colors hover:bg-muted"
          role="menuitem"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m5.6 5.6 12.8 12.8"/></svg>
          {blocked ? m.msg_unblock() : m.msg_block()}
        </button>
      </div>
    </div>
  </header>

  <!-- Messages -->
  <div data-msg-scroll class="flex-1 space-y-2 overflow-y-auto overscroll-contain px-3 py-4">
    {
      privatePhotos.length > 0 && (
        // Her private set, unlocked for this client on accept (UX-PLAN 4.4).
        // Tap → shared lightbox (chat photos are private, not safe-mode gated).
        <div class="mx-auto my-2 w-full max-w-sm rounded-2xl border border-brand/40 bg-card p-3">
          <p class="eyebrow mb-2 text-2xs text-brand">{m.private_set_unlocked()}</p>
          <div class="grid grid-cols-3 gap-1.5">
            {privatePhotos.map((photo) => (
              <img
                src={photo}
                alt=""
                data-chat-photo
                class="aspect-square w-full cursor-pointer rounded-lg object-cover"
              />
            ))}
          </div>
        </div>
      )
    }
    {
      thread.messages.map((msg) =>
        msg.kind === 'system' ? (
          <div class="flex justify-center py-1" data-msg-id={msg.id} data-created={msg.createdAt}>
            <span class="rounded-full bg-muted px-3 py-1 text-center text-2xs font-medium text-muted-foreground">
              {systemText(msg.body)}
            </span>
          </div>
        ) : msg.kind === 'request' && msg.request ? (
          <div data-msg-id={msg.id} data-created={msg.createdAt}>
            <RequestCard request={msg.request} {viewer} state={thread.state} threadId={thread.id} />
          </div>
        ) : (
          <div
            class:list={['flex', msg.sender === viewer ? 'justify-end' : 'justify-start']}
            data-msg-id={msg.id}
            data-created={msg.createdAt}
          >
            <div
              class:list={[
                'max-w-[78%] overflow-hidden rounded-2xl',
                msg.sender === viewer
                  ? 'rounded-br-sm bg-foreground text-background'
                  : 'rounded-bl-sm bg-muted text-foreground',
              ]}
            >
              {msg.kind === 'photo' && msg.photo && (
                <img
                  src={msg.photo}
                  alt=""
                  data-chat-photo
                  class="block max-h-72 w-full cursor-pointer object-cover"
                />
              )}
              <div class="flex items-end gap-2 px-3 py-2">
                {msg.body && <p class="whitespace-pre-wrap break-words text-sm">{msg.body}</p>}
                <span class="ml-auto flex flex-none items-center gap-1 text-2xs opacity-60">
                  <span data-time={msg.createdAt}>{utcTime(msg.createdAt)}</span>
                  {msg.sender === viewer && <span data-tick>{msg.readAt ? '✓✓' : '✓'}</span>}
                </span>
              </div>
            </div>
          </div>
        ),
      )
    }
  </div>

  <!-- Composer -->
  {
    blocked ? (
      <div class="flex-none border-t border-border px-4 py-4 text-center text-sm text-muted-foreground">
        {m.msg_blocked_note()}
      </div>
    ) : composerLocked ? (
      // No free-compose until an accepted request (UX-PLAN 4.1). Pending →
      // waiting on her; frozen (declined) → quietly closed.
      <div class="flex-none border-t border-border px-4 py-4 text-center text-sm text-muted-foreground">
        {thread.state === 'pending' ? m.request_pending_note() : m.request_closed_note()}
      </div>
    ) : paused ? (
      <div class="flex-none border-t border-border px-4 py-4 text-center text-sm text-muted-foreground">
        {m.msg_paused_note()}
      </div>
    ) : (
      <form
        data-composer
        class="flex flex-none items-end gap-2 border-t border-border px-3 py-2.5"
        style="padding-bottom: calc(0.625rem + env(safe-area-inset-bottom))"
      >
        <label
          data-photo-btn
          class:list={[
            'grid size-10 flex-none cursor-pointer place-items-center rounded-full text-muted-foreground transition-colors hover:bg-muted hover:text-foreground',
            !canPhoto && 'hidden',
          ]}
          aria-label={m.msg_send_photo()}
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="11" r="2"/><path d="m21 17-5-5-9 7"/></svg>
          <input type="file" accept="image/*" data-photo-input class="hidden" />
        </label>
        <span class="slab-field block flex-1">
          <span class="slab-field__face flex items-center">
            <textarea
              data-input
              rows="1"
              maxlength="4000"
              placeholder={m.msg_placeholder()}
              class="max-h-32 w-full resize-none bg-transparent px-3.5 py-2.5 text-base caret-brand outline-none placeholder:text-muted-foreground md:text-sm"
            />
          </span>
        </span>
        <button
          type="submit"
          data-send
          aria-label={m.msg_send()}
          class="grid size-10 flex-none cursor-pointer place-items-center rounded-full bg-brand text-white transition-transform active:scale-90 disabled:opacity-40"
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
        </button>
      </form>
    )
  }
</div>

<script>
  import { actions } from 'astro:actions';
  import { subscribe } from '@/app/realtime';

  type Msg = {
    id: string;
    sender: 'professional' | 'client' | 'system';
    kind: 'text' | 'photo' | 'system' | 'request';
    body: string;
    photo?: string;
    createdAt: string;
    readAt?: string;
  };

  const localTime = (iso: string) =>
    new Date(iso).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

  /** Downscale + re-encode to JPEG → strips EXIF (hard rule 2). */
  async function toJpegDataUrl(file: File, max = 1000, quality = 0.82): Promise<string> {
    const bmp = await createImageBitmap(file);
    const scale = Math.min(1, max / Math.max(bmp.width, bmp.height));
    const w = Math.round(bmp.width * scale);
    const h = Math.round(bmp.height * scale);
    const canvas = document.createElement('canvas');
    canvas.width = w;
    canvas.height = h;
    canvas.getContext('2d')!.drawImage(bmp, 0, 0, w, h);
    bmp.close?.();
    return canvas.toDataURL('image/jpeg', quality);
  }

  function initThread() {
    const root = document.querySelector<HTMLElement>('[data-thread-root]');
    if (!root || root.dataset.init) return;
    root.dataset.init = '1';

    const threadId = root.dataset.threadId!;
    const viewer = root.dataset.viewer as 'professional' | 'client';
    const sysMediaOn = root.dataset.sysMediaOn || '';
    const sysRequestAccepted = root.dataset.sysRequestAccepted || '';
    const initialState = root.dataset.state || 'open';
    const scroll = root.querySelector<HTMLElement>('[data-msg-scroll]')!;

    const seen = new Set<string>();
    let lastCreatedAt = '';
    scroll.querySelectorAll<HTMLElement>('[data-msg-id]').forEach((el) => {
      seen.add(el.dataset.msgId!);
      if (el.dataset.created && el.dataset.created > lastCreatedAt) lastCreatedAt = el.dataset.created;
    });

    const atBottom = () => scroll.scrollHeight - scroll.scrollTop - scroll.clientHeight < 120;
    const toBottom = () => (scroll.scrollTop = scroll.scrollHeight);

    // Localize SSR timestamps (rendered as UTC) to the user's timezone.
    const localizeTimes = () =>
      scroll.querySelectorAll<HTMLElement>('[data-time]').forEach((el) => {
        el.textContent = localTime(el.dataset.time!);
      });

    // Build a bubble element that mirrors the SSR markup.
    function render(msg: Msg): HTMLElement {
      if (msg.kind === 'system') {
        const row = document.createElement('div');
        row.className = 'flex justify-center py-1';
        row.dataset.msgId = msg.id;
        row.dataset.created = msg.createdAt;
        const chip = document.createElement('span');
        chip.className =
          'rounded-full bg-muted px-3 py-1 text-center text-2xs font-medium text-muted-foreground';
        chip.textContent =
          msg.body === 'msg_system_media_on'
            ? sysMediaOn
            : msg.body === 'msg_system_request_accepted'
              ? sysRequestAccepted
              : msg.body;
        row.appendChild(chip);
        return row;
      }
      // A request card streaming in is rare (a request navigates/reloads) — a
      // full re-render of the card in JS isn't worth it, so reload to pick up
      // the SSR card. Return an empty placeholder; the reload replaces it.
      if (msg.kind === 'request') {
        location.reload();
        return document.createElement('div');
      }
      const own = msg.sender === viewer;
      const row = document.createElement('div');
      row.className = `flex ${own ? 'justify-end' : 'justify-start'}`;
      row.dataset.msgId = msg.id;
      row.dataset.created = msg.createdAt;
      const bubble = document.createElement('div');
      bubble.className = `max-w-[78%] overflow-hidden rounded-2xl ${
        own ? 'rounded-br-sm bg-foreground text-background' : 'rounded-bl-sm bg-muted text-foreground'
      }`;
      if (msg.kind === 'photo' && msg.photo) {
        const img = document.createElement('img');
        img.src = msg.photo;
        img.alt = '';
        img.dataset.chatPhoto = '';
        img.className = 'block max-h-72 w-full cursor-pointer object-cover';
        bubble.appendChild(img);
      }
      const meta = document.createElement('div');
      meta.className = 'flex items-end gap-2 px-3 py-2';
      if (msg.body) {
        const p = document.createElement('p');
        p.className = 'whitespace-pre-wrap break-words text-sm';
        p.textContent = msg.body;
        meta.appendChild(p);
      }
      const stamp = document.createElement('span');
      stamp.className = 'ml-auto flex flex-none items-center gap-1 text-2xs opacity-60';
      const t = document.createElement('span');
      t.dataset.time = msg.createdAt;
      t.textContent = localTime(msg.createdAt);
      stamp.appendChild(t);
      if (own) {
        const tick = document.createElement('span');
        tick.dataset.tick = '';
        tick.textContent = msg.readAt ? '✓✓' : '✓';
        stamp.appendChild(tick);
      }
      meta.appendChild(stamp);
      bubble.appendChild(meta);
      row.appendChild(bubble);
      return row;
    }

    function ingest(messages: Msg[]) {
      const wasBottom = atBottom();
      for (const msg of messages) {
        if (seen.has(msg.id)) continue;
        seen.add(msg.id);
        if (msg.createdAt > lastCreatedAt) lastCreatedAt = msg.createdAt;
        scroll.appendChild(render(msg));
      }
      if (wasBottom) toBottom();
    }

    // The other side has read my messages up to `readUpTo` → flip their ticks.
    function applyRead(readUpTo: string | null) {
      if (!readUpTo) return;
      scroll.querySelectorAll<HTMLElement>('[data-msg-id]').forEach((row) => {
        const tick = row.querySelector('[data-tick]');
        if (tick && row.dataset.created && row.dataset.created <= readUpTo) tick.textContent = '✓✓';
      });
    }

    localizeTimes();
    toBottom();

    // Composer.
    const form = root.querySelector<HTMLFormElement>('[data-composer]');
    const input = root.querySelector<HTMLTextAreaElement>('[data-input]');
    const photoInput = root.querySelector<HTMLInputElement>('[data-photo-input]');
    const photoBtn = root.querySelector<HTMLElement>('[data-photo-btn]');

    async function send(payload: { kind: 'text' | 'photo'; body?: string; photo?: string }) {
      const { data } = await actions.messaging.send({ threadId, ...payload });
      if (data?.message) ingest([data.message as Msg]);
      toBottom();
    }

    input?.addEventListener('input', () => {
      input.style.height = 'auto';
      input.style.height = `${Math.min(input.scrollHeight, 128)}px`;
    });
    input?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        form?.requestSubmit();
      }
    });
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const body = input?.value.trim();
      if (!body) return;
      input!.value = '';
      input!.style.height = 'auto';
      await send({ kind: 'text', body });
    });
    photoInput?.addEventListener('change', async () => {
      const file = photoInput.files?.[0];
      photoInput.value = '';
      if (!file) return;
      try {
        const photo = await toJpegDataUrl(file);
        await send({ kind: 'photo', photo });
      } catch {
        /* ignore bad image */
      }
    });

    // Photo lightbox (chat photos are private data-URLs, not safe-mode gated).
    scroll.addEventListener('click', (e) => {
      const img = (e.target as HTMLElement).closest<HTMLImageElement>('[data-chat-photo]');
      if (img) (window as any).__openLightbox?.([{ src: img.src, alt: '' }], 0);
    });

    // Overflow menu + contact controls.
    const menu = root.querySelector<HTMLElement>('[data-thread-menu]');
    if (menu) {
      const btn = menu.querySelector<HTMLElement>('[data-menu-btn]')!;
      const panel = menu.querySelector<HTMLElement>('[data-menu-panel]')!;
      btn.addEventListener('click', () => (panel.hidden = !panel.hidden));
      document.addEventListener('click', (e) => {
        if (!menu.contains(e.target as Node)) panel.hidden = true;
      });
      menu.querySelector('[data-pin]')?.addEventListener('change', (e) => {
        actions.messaging.setPinned({ threadId, pinned: (e.target as HTMLInputElement).checked });
      });
      menu.querySelector('[data-allow-photos]')?.addEventListener('change', (e) => {
        actions.messaging.setMediaAllowed({
          threadId,
          allowed: (e.target as HTMLInputElement).checked,
        });
      });
      const note = menu.querySelector<HTMLTextAreaElement>('[data-note]');
      note?.addEventListener('blur', () => actions.messaging.setNote({ threadId, note: note.value }));
      menu.querySelector('[data-block]')?.addEventListener('click', async () => {
        await actions.messaging.setBlocked({ threadId, blocked: true });
        location.href = `/${document.documentElement.lang || 'en'}/messages/`;
      });
    }

    // Realtime (§5): a DB-trigger broadcast on this thread fires an immediate
    // incremental fetch (new messages only + read watermark + photo-grant flag);
    // the interval is the slow fallback. Never re-downloads existing photos.
    let reloadedOnState = false;
    subscribe(async () => {
      const { data } = await actions.messaging.thread({ threadId, after: lastCreatedAt });
      const view = data?.view as
        | {
            messages: Msg[];
            readUpTo: string | null;
            clientMediaAllowed: boolean;
            privateSetUnlocked: boolean;
            state: string;
          }
        | null
        | undefined;
      if (!view) return;
      ingest(view.messages);
      applyRead(view.readUpTo);
      const canPhoto = viewer === 'professional' || view.clientMediaAllowed;
      if (photoBtn) photoBtn.classList.toggle('hidden', !canPhoto);
      // The thread's state moved while viewing (accepted → open, declined →
      // frozen, or blocked) → reload once so the composer + request card reflect
      // it (SSR renders the correct locked/open state).
      if (view.state !== initialState && !reloadedOnState) {
        reloadedOnState = true;
        location.reload();
      }
    }, { channel: `thread:${threadId}` });
  }

  initThread();
  document.addEventListener('astro:page-load', initThread);
</script>
