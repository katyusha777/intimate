---
import * as m from '@/paraglide/messages';
import { localizePath } from '@/lib/i18n';
import SafeModeToggle from '@/components/molecules/SafeModeToggle.astro';
import ThemeToggle from '@/components/molecules/ThemeToggle.astro';
import { CITIES } from '@/lib/taxonomy';
---

<!-- Footer — always dark (intimate.nl style); `dark` class scopes tokens so
     children (safe-mode toggle, text colors) render on dark correctly. -->
<footer class="dark mt-16 overflow-hidden bg-neutral-950 text-foreground">
  <!-- City ticker -->
  <div class="border-b border-white/10 py-3">
    <div class="animate-ticker flex w-max">
      {
        [0, 1].map(() => (
          <div class="flex items-center" aria-hidden="true">
            {CITIES.slice(0, 12).map((c) => (
              <span class="flex items-center gap-10 eyebrow pr-10 text-2xs text-white/40">
                {c.name}
                <span class="size-1 rounded-full bg-brand/80" />
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 md:px-6">
    <!-- Top: claim + logo -->
    <div class="grid gap-10 border-b border-white/10 py-12 lg:grid-cols-2 lg:items-center">
      <div>
        <span class="inline-flex items-center gap-2 rounded-full border border-brand/40 px-3.5 py-1.5 eyebrow text-2xs font-semibold text-white/80">
          <span class="size-1.5 rounded-full bg-brand"></span>
          Early access
        </span>
        <p class="display mt-5 text-3xl md:text-5xl">Where connections begin</p>
      </div>
      <div class="space-y-3 lg:text-right">
        <img src="/img/logo-light.svg" alt={m.app_name()} class="h-14 w-auto lg:ml-auto" />
        <p class="max-w-xs text-sm text-white/50 lg:ml-auto">
          A new platform, in active development. We're building Intimate together with you.
        </p>
      </div>
    </div>

    <!-- Link columns + contact card -->
    <div class="grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
      {
        [
          {
            title: 'Information',
            links: [
              ['About Intimate', '/about/'],
              ['Articles', '/blog/'],
              ['Forum', '/forum/'],
              ['Documentation', '/docs/'],
            ],
          },
          {
            title: 'Help',
            links: [
              ['Profile rules', '/profile-rules/'],
              ['Safety & awareness', '/safety/'],
              ['Helpdesk', '/helpdesk/'],
              ['Contact', '/contact/'],
            ],
          },
          {
            title: 'Legal',
            links: [
              ['Terms & conditions', '/terms/'],
              ['Privacy & Cookies', '/privacy/'],
            ],
          },
        ].map((col) => (
          <div>
            <p class="eyebrow flex items-center gap-3 text-white/50">
              <span class="h-px w-5 bg-white/30" aria-hidden="true" />
              {col.title}
            </p>
            <ul class="mt-4 space-y-2.5">
              {col.links.map(([label, href]) => (
                <li>
                  <a href={localizePath(href)} class="text-sm text-white/75 transition-colors hover:text-white">
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="rounded-2xl bg-white/5 p-5 ring-1 ring-white/10">
        <p class="eyebrow flex items-center gap-3 text-white/50">
          <span class="h-px w-5 bg-white/30" aria-hidden="true"></span>
          Questions?
        </p>
        <p class="mt-3 flex items-center gap-2.5">
          <span class="grid size-8 place-items-center rounded-full bg-online/90 text-neutral-950">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /></svg>
          </span>
          <span class="font-semibold">085 333 2377</span>
        </p>
        <p class="mt-2 text-xs text-white/50">WhatsApp, Mon–Fri 9:00–17:00</p>
        <div class="mt-4 bg-amber-400/10 p-3 ring-1 ring-amber-400/25">
          <p class="eyebrow text-2xs font-bold text-amber-200">
            ⚠ Not an escort agency
          </p>
          <p class="mt-1 text-xs leading-relaxed text-amber-100/70">
            We are an advertising platform — appointments are made directly with advertisers.
            We do not mediate or schedule bookings.
          </p>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="flex flex-wrap items-center justify-between gap-4 border-t border-white/10 py-6 pb-24 md:pb-6">
      <p class="flex items-center gap-3">
        <span class="rounded-full px-2.5 py-1 text-xs font-bold ring-1 ring-white/25">18+</span>
        <span class="text-sm text-white/50">© 2026 Intimate.nl. All rights reserved.</span>
      </p>
      <div class="flex items-center gap-6">
        <SafeModeToggle />
        <ThemeToggle />
        <button
          type="button"
          data-scroll-top
          class="flex items-center gap-2 rounded-full px-4 py-2 eyebrow font-semibold text-foreground ring-1 ring-white/20 transition-colors hover:bg-white/10"
        >
          Back to top
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6" /></svg>
        </button>
      </div>
    </div>
  </div>
</footer>
