---
import * as m from '@/paraglide/messages';
import { localizePath } from '@/lib/i18n';
import { SUPPORT_CONTACT } from '@/lib/contact';
import Icon from '@/components/atoms/Icon.astro';
import SafeModeToggle from '@/components/molecules/SafeModeToggle.astro';
import ThemeToggle from '@/components/molecules/ThemeToggle.astro';
---

<!-- Footer — always dark (intimate.nl style); `dark` class scopes tokens so
     children (safe-mode toggle, text colors) render on dark correctly. -->
<footer class="dark mt-10 overflow-hidden bg-neutral-950 text-foreground md:mt-16">
  <div class="mx-auto max-w-7xl px-4 md:px-6">
    <!-- Top: claim + logo -->
    <div class="grid gap-8 border-b border-white/10 py-8 md:py-12 lg:grid-cols-2 lg:items-center">
      <div>
        <span class="inline-flex items-center gap-2 border border-brand/40 px-3.5 py-1.5 eyebrow text-2xs font-semibold text-white/80">
          <span class="size-1.5 rounded-full bg-brand"></span>
          Early access
        </span>
        <p class="display mt-5 text-3xl md:text-5xl">Where connections begin</p>
      </div>
      <div class="space-y-3 lg:text-right">
        <img src="/img/logo-light.svg" alt={m.app_name()} class="h-10 w-auto md:h-14 lg:ml-auto" />
        <p class="max-w-xs text-sm text-white/50 lg:ml-auto">
          A new platform, in active development. We're building Intimate together with you.
        </p>
      </div>
    </div>

    <!-- Link columns + contact card -->
    <div class="grid grid-cols-2 gap-8 py-8 md:py-12 lg:grid-cols-4">
      {
        [
          {
            title: 'Information',
            links: [
              // START ADVERTISING lives here + in the menu (UX-PLAN 1.1) —
              // professionals find it deliberately; clients never trip over it.
              [m.cta_start_advertising(), '/account/'],
              ['About Intimate', '/about/'],
              ['Articles', '/blog/'],
              ['Forum', '/forum/'],
              ['Documentation', '/docs/'],
            ],
          },
          {
            title: 'Help',
            links: [
              ['Profile rules', '/profile-rules/'],
              ['Safety & awareness', '/safety/'],
              ['Support', '/support/'],
              ['Contact', '/contact/'],
            ],
          },
          {
            title: 'Legal',
            links: [
              ['Terms & conditions', '/terms/'],
              ['Privacy & Cookies', '/privacy/'],
            ],
          },
        ].map((col) => (
          <div>
            <p class="eyebrow flex items-center gap-3 text-white/50">
              <span class="h-px w-5 bg-white/30" aria-hidden="true" />
              {col.title}
            </p>
            <ul class="mt-4 space-y-2.5">
              {col.links.map(([label, href]) => (
                <li>
                  <a href={localizePath(href)} class="text-sm text-white/75 transition-colors hover:text-white">
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="col-span-2 border border-white/15 p-5 lg:col-span-1">
        <p class="eyebrow flex items-center gap-3 text-white/50">
          <span class="h-px w-5 bg-white/30" aria-hidden="true"></span>
          Questions?
        </p>
        <a href={SUPPORT_CONTACT.whatsapp.href} target="_blank" rel="noopener" class="mt-3 flex items-center gap-2.5">
          <Icon name="whatsapp" family="brands" class="text-xl text-online" />
          <span class="font-semibold">{SUPPORT_CONTACT.whatsapp.display}</span>
        </a>
        <a href={SUPPORT_CONTACT.telegram.href} target="_blank" rel="noopener" class="mt-2 flex items-center gap-2.5">
          <Icon name="telegram" family="brands" class="text-xl text-white/80" />
          <span class="font-semibold">{SUPPORT_CONTACT.telegram.display}</span>
        </a>
        <p class="mt-2 text-xs text-white/50">{SUPPORT_CONTACT.hours}</p>
        <div class="mt-4 border-l-2 border-amber-400/60 pl-3">
          <p class="eyebrow text-2xs font-bold text-amber-200">
            Not an escort agency
          </p>
          <p class="mt-1 text-xs leading-relaxed text-white/50">
            We are an advertising platform — appointments are made directly with advertisers.
            We do not mediate or schedule bookings.
          </p>
        </div>
      </div>
    </div>

    <!-- Bottom bar — on mobile it stacks: controls row, then the legal line, so
         nothing cramps or wraps mid-word at 390px. Desktop lays it side-by-side. -->
    <div class="flex flex-col gap-5 border-t border-white/10 py-6 pb-24 md:flex-row md:items-center md:justify-between md:pb-6">
      <!-- Controls: safe-mode + theme on one line, back-to-top full-width beneath
           on mobile (a comfortable 44pt tap target), inline on desktop. -->
      <div class="order-1 flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6 md:order-2">
        <div class="flex items-center justify-between gap-6 sm:justify-start">
          <SafeModeToggle />
          <ThemeToggle />
        </div>
        <button
          type="button"
          data-scroll-top
          class="flex cursor-pointer items-center justify-center gap-2 border border-white/20 px-4 py-2.5 eyebrow font-semibold text-foreground transition-colors hover:bg-white/10 active:scale-[0.98] sm:justify-start"
        >
          Back to top
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6" /></svg>
        </button>
      </div>

      <p class="order-2 flex items-center gap-3 md:order-1">
        <span class="flex-none border border-white/25 px-2.5 py-1 text-xs font-bold">18+</span>
        <span class="text-sm text-white/50">© 2026 Intimate.nl. All rights reserved.</span>
      </p>
    </div>
  </div>
</footer>
