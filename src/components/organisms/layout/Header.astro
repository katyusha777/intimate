---
import * as m from '@/paraglide/messages';
import type { Session } from '@/app/models/session';
import Button from '@/components/atoms/Button.astro';
import Combobox from '@/components/molecules/Combobox.astro';
import UserMenu from '@/components/molecules/UserMenu.astro';
import ThemeToggle from '@/components/molecules/ThemeToggle.astro';
import { getLocale } from '@/paraglide/runtime';
import { listingCategoryLabel } from '@/lib/labels';
import { localizePath } from '@/lib/i18n';
import { GENDER_FILTERS, type GenderFilter } from '@/app/models/profile';
import { CITIES, LISTING_CATEGORIES, type Locale } from '@/lib/taxonomy';

interface Props {
  session?: Session | null;
}
const { session = null } = Astro.props;

/** Site languages — native names, no flags. */
const LANGUAGES = [
  { value: 'nl', label: 'Nederlands' },
  { value: 'en', label: 'English' },
  { value: 'de', label: 'Deutsch' },
];

const locale = getLocale() as Locale;
const path = Astro.url.pathname;
/** Current city from the URL path (works on /{city}/, /{tab}/{city}/ …). */
const pathSegs = path.split('/').filter(Boolean);
const currentCity = CITIES.find((c) => pathSegs.includes(c.slug))?.slug;
const searchPath = localizePath('/search/');

/* Gender is a RADIO over the whole shelf (market is ~80% women → default
 * women). URL ?gender= wins, then the visitor's cookie, then women. Tab
 * clicks persist the pick client-side (script below). */
const genderPick = ([Astro.url.searchParams.get('gender'), Astro.cookies.get('gender')?.value].find(
  (g) => g && g in GENDER_FILTERS,
) ?? 'women') as GenderFilter;
const withGender = (href: string) => (genderPick === 'women' ? href : `${href}?gender=${genderPick}`);

const categories = LISTING_CATEGORIES.map((c) => ({
  label: listingCategoryLabel(c.slug),
  href: localizePath(`/${c.slugs[locale]}/`),
  active: path.startsWith(localizePath(`/${c.slugs[locale]}/`)),
}));

/* Gender tabs keep the current listing (tab + city); elsewhere → search. */
const citySeg = currentCity ? `${currentCity}/` : '';
const listingBase = `${categories.find((c) => c.active)?.href ?? searchPath}${citySeg}`;
const genderTabs = (Object.keys(GENDER_FILTERS) as GenderFilter[]).map((g) => ({
  value: g,
  label: { women: m.gender_tab_women(), men: m.gender_tab_men(), trans: m.gender_tab_trans() }[g],
  href: g === 'women' ? listingBase : `${listingBase}?gender=${g}`,
  active: g === genderPick,
}));
---

<header class="glass sticky top-0 z-40 border-b" style="padding-top: env(safe-area-inset-top)">
  <!-- Row 1: logo · AI search · articles/contact · auth -->
  <div class="mx-auto flex h-14 max-w-7xl items-center gap-3 px-4 md:h-[4.25rem] md:gap-5 md:px-6">
    <a href={localizePath("/")} aria-label={m.app_name()} class="flex flex-none items-center">
      <!-- naming follows the source files: LIGHT = light (white) lettering, DARK = dark lettering -->
      <img src="/img/logo-dark.svg" alt={m.app_name()} class="h-9 w-auto dark:hidden" />
      <img src="/img/logo-light.svg" alt={m.app_name()} class="hidden h-9 w-auto dark:block" />
    </a>

    <!-- Text menu sits BESIDE the logo — the right edge belongs to controls. -->
    <nav class="ml-4 hidden flex-none items-center gap-5 text-sm font-semibold md:flex">
      <!-- START ADVERTISING lives in the menu + footer (UX-PLAN 1.1), never
           above the fold as an account wall. -->
      <a href={localizePath("/account/")} class="transition-colors hover:text-brand">
        {m.cta_start_advertising()}
      </a>
      <a href={localizePath("/blog/")} class="transition-colors hover:text-brand">
        {m.section_articles()}
      </a>
      <a href={localizePath("/contact/")} class="transition-colors hover:text-brand">
        {m.nav_contact()}
      </a>
    </nav>

    <!-- Mobile search icon: on listing pages it opens the filter sheet
         (data-sheet-open, dialog present); anywhere else the href wins and it
         lands on the search listing (ActionSheet delegation lets the click
         through when the dialog is absent). -->
    <a
      href={searchPath}
      data-sheet-open="filters-sheet"
      aria-label={m.nav_search()}
      class="ml-auto grid size-10 flex-none cursor-pointer place-items-center rounded-full text-foreground transition-colors hover:bg-foreground/10 active:scale-95 md:hidden"
    >
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
    </a>

    <!-- Right cluster: language (bare EN ▾), theme, auth. md:ml-auto pushes it
         right once the mobile search icon (ml-auto) is hidden. -->
    <div class="flex flex-none items-center gap-2 md:ml-auto">
      <Combobox
        variant="bare"
        options={LANGUAGES}
        value={locale}
        placeholder={locale.toUpperCase()}
        triggerLabel={locale.toUpperCase()}
        target="[data-none]"
        lang
        class="hidden md:block"
      />
      <ThemeToggle />
    </div>

    <div class="flex flex-none items-center gap-4">
      {
        session ? (
          <UserMenu {session} />
        ) : (
          <>
            <button
              type="button"
              data-modal-open="auth"
              data-auth-tab="login"
              class="cursor-pointer text-sm font-semibold transition-colors hover:text-primary"
            >
              {m.nav_login()}
            </button>
            <Button size="sm" data-modal-open="auth" data-auth-tab="register">
              {m.nav_register()}
            </Button>
          </>
        )
      }
    </div>
  </div>

  <!-- Row 2: gender radio (· WOMEN  MEN  TRANS) | categories, generously
       spaced text tabs — active category carries a brand underline on the
       bar's bottom edge — and the boxed AMSTERDAM ▾ location control right. -->
  <div class="border-t border-border/60">
    <div class="mx-auto flex h-12 max-w-7xl items-stretch gap-3 px-4 md:h-13 md:px-6">
      <div
        class="flex min-w-0 flex-1 select-none items-stretch gap-5 overflow-x-auto [scrollbar-width:none] md:gap-7 [&::-webkit-scrollbar]:hidden"
      >
        <!-- Gender: single-select, default women; a click persists (cookie). -->
        <nav class="flex flex-none items-stretch gap-4 md:gap-5" aria-label={m.filter_gender()}>
          {
            genderTabs.map((g) => (
              <a
                href={g.href}
                data-gender-tab={g.value}
                aria-current={g.active ? 'true' : undefined}
                class:list={[
                  'chroma-hover flex flex-none items-center gap-1.5 font-condensed text-sm font-bold uppercase tracking-wide transition-colors active:scale-[0.97]',
                  g.active ? 'text-foreground' : 'text-foreground/55 hover:text-foreground',
                ]}
              >
                {g.active && <span class="size-1.5 rounded-full bg-brand" aria-hidden="true" />}
                {g.label}
              </a>
            ))
          }
        </nav>

        <span class="my-3.5 w-px flex-none bg-border" aria-hidden="true"></span>

        <nav
          class="flex min-w-0 flex-none items-stretch gap-5 md:gap-7"
          aria-label={m.all_categories()}
        >
          {
            categories.map((l) => (
              <a
                href={withGender(l.href)}
                aria-current={l.active ? 'page' : undefined}
                class:list={[
                  'chroma-hover relative flex flex-none items-center font-condensed text-sm font-bold uppercase tracking-wide transition-colors active:scale-[0.97]',
                  l.active ? 'text-foreground' : 'text-foreground/55 hover:text-foreground',
                ]}
              >
                {l.label}
                <span
                  class:list={[
                    'absolute inset-x-0 bottom-0 h-0.5 bg-brand transition-opacity',
                    l.active ? 'opacity-100' : 'opacity-0',
                  ]}
                  aria-hidden="true"
                />
              </a>
            ))
          }
        </nav>
      </div>

      <div class="flex flex-none items-center">
        <Combobox
          variant="box"
          options={CITIES.map((c) => ({ value: c.slug, label: c.name }))}
          value={currentCity}
          placeholder={m.filter_city()}
          anyLabel={`${m.filter_city()}: ${m.filter_any()}`}
          searchPlaceholder={m.filter_city()}
          target="[data-city-nav]"
          navBase={localizePath('/')}
          cookie="city"
        />
      </div>
    </div>
  </div>
</header>

<script>
  // Gender tab click → persist the pick (server default for the next visit).
  if (!(window as any).__genderTabs) {
    (window as any).__genderTabs = true;
    document.addEventListener('click', (e) => {
      const tab = (e.target as HTMLElement).closest?.('[data-gender-tab]') as HTMLElement | null;
      if (!tab) return;
      document.cookie = `gender=${tab.dataset.genderTab}; path=/; max-age=31536000; samesite=lax`;
    });
  }
</script>

