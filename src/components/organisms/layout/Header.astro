---
import * as m from '@/paraglide/messages';
import type { Session } from '@/app/models/session';
import AiSearchInput from '@/components/molecules/AiSearchInput.astro';
import Button from '@/components/atoms/Button.astro';
import Combobox from '@/components/molecules/Combobox.astro';
import UserMenu from '@/components/molecules/UserMenu.astro';
import { getLocale } from '@/paraglide/runtime';
import { listingCategoryLabel } from '@/lib/labels';
import { localizePath } from '@/lib/i18n';
import { CITIES, LISTING_CATEGORIES, type Locale } from '@/lib/taxonomy';

interface Props {
  session?: Session | null;
}
const { session = null } = Astro.props;

/** Site languages — native names, no flags. */
const LANGUAGES = [
  { value: 'nl', label: 'Nederlands' },
  { value: 'en', label: 'English' },
  { value: 'de', label: 'Deutsch' },
];

const locale = getLocale() as Locale;
const path = Astro.url.pathname;
/** Current city from the URL path (works on /{city}/, /{tab}/{city}/ …). */
const pathSegs = path.split('/').filter(Boolean);
const currentCity = CITIES.find((c) => pathSegs.includes(c.slug))?.slug;
const searchPath = localizePath('/search/');
const q = path.startsWith(searchPath) ? (Astro.url.searchParams.get('q') ?? '') : '';

const categories = [
  {
    label: m.cat_all(),
    href: searchPath,
    active: path.startsWith(searchPath),
  },
  ...LISTING_CATEGORIES.map((c) => ({
    label: listingCategoryLabel(c.slug),
    href: localizePath(`/${c.slugs[locale]}/`),
    active: path.startsWith(localizePath(`/${c.slugs[locale]}/`)),
  })),
];
---

<header class="glass sticky top-0 z-40 border-b" style="padding-top: env(safe-area-inset-top)">
  <!-- Row 1: logo · AI search · articles/contact · auth -->
  <div class="mx-auto flex h-14 max-w-7xl items-center gap-3 px-4 md:h-[4.25rem] md:gap-5 md:px-6">
    <a href={localizePath("/")} aria-label={m.app_name()} class="flex flex-none items-center">
      <!-- naming follows the source files: LIGHT = light (white) lettering, DARK = dark lettering -->
      <img src="/img/logo-dark.svg" alt={m.app_name()} class="h-9 w-auto dark:hidden" />
      <img src="/img/logo-light.svg" alt={m.app_name()} class="hidden h-9 w-auto dark:block" />
    </a>

    <AiSearchInput action={searchPath} value={q} class="hidden max-w-md md:block" />

    <nav class="ml-auto hidden flex-none items-center gap-5 text-sm font-semibold md:flex">
      <!-- START ADVERTISING lives in the menu + footer (UX-PLAN 1.1), never
           above the fold as an account wall. -->
      <a href={localizePath("/account/")} class="transition-colors hover:text-brand">
        {m.cta_start_advertising()}
      </a>
      <a href={localizePath("/blog/")} class="transition-colors hover:text-brand">
        {m.section_articles()}
      </a>
      <a href={localizePath("/contact/")} class="transition-colors hover:text-brand">
        {m.nav_contact()}
      </a>
    </nav>

    <div class="ml-auto flex flex-none items-center gap-4 md:ml-0">
      {
        session ? (
          <UserMenu {session} />
        ) : (
          <>
            <button
              type="button"
              data-modal-open="auth"
              data-auth-tab="login"
              class="cursor-pointer text-sm font-semibold transition-colors hover:text-primary"
            >
              {m.nav_login()}
            </button>
            <Button size="sm" data-modal-open="auth" data-auth-tab="register">
              {m.nav_register()}
            </Button>
          </>
        )
      }
    </div>
  </div>

  <!-- Row 2: main categories — text tabs, active = short underline bar — plus
       the always-visible location control on the right.
       NOT the anaglyph style: that button is unique (DESIGN §2.6). -->
  <div class="border-t border-border/60">
    <div class="mx-auto flex h-12 max-w-7xl items-stretch gap-3 px-4 md:h-14 md:px-6">
      <nav
        class="flex min-w-0 flex-1 select-none items-stretch gap-2 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        aria-label={m.all_categories()}
      >
        {
          categories.map((l) => (
            <a
              href={l.href}
              aria-current={l.active ? 'page' : undefined}
              class:list={[
                'cat-link chroma-hover relative flex flex-none items-center px-3 font-condensed text-sm font-bold uppercase tracking-wide transition-colors active:scale-[0.97]',
                l.active ? 'text-foreground' : 'text-foreground/55 hover:text-foreground',
              ]}
            >
              {l.label}
              <span
                class:list={[
                  'cat-underline absolute bottom-1.5 left-1/2 h-0.5 w-5 -translate-x-1/2 bg-foreground transition-opacity',
                  l.active ? 'opacity-100' : 'opacity-0',
                ]}
                aria-hidden="true"
              />
            </a>
          ))
        }
      </nav>
      <div class="flex flex-none items-center gap-2 border-l border-border/60 pl-3 md:pl-4">
        <!-- Language: follows the page's hreflang alternates (SEO §2 — every
             URL is locale-prefixed; localized slugs handled per page). -->
        <Combobox
          icon="globe"
          options={LANGUAGES}
          value={locale}
          placeholder={LANGUAGES.find((l) => l.value === locale)?.label ?? locale}
          target="[data-none]"
          lang
          class="hidden sm:block"
        />
        <Combobox
          icon="location-dot"
          options={CITIES.map((c) => ({ value: c.slug, label: c.name }))}
          value={currentCity}
          placeholder={m.filter_city()}
          anyLabel={`${m.filter_city()}: ${m.filter_any()}`}
          searchPlaceholder={m.filter_city()}
          target="[data-city-nav]"
          navBase={localizePath('/')}
          cookie="city"
        />
      </div>
    </div>
  </div>
</header>

<style>
  /* In motion (hover), the underline picks up the anaglyph pink/cyan split
     (text handled by the global .chroma-hover utility). */
  .cat-link:hover .cat-underline {
    opacity: 1;
    box-shadow:
      -2px 0 var(--brand),
      2px 0 #00e5ff;
  }
</style>

