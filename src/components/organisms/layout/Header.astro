---
import * as m from '@/paraglide/messages';
import Button from '@/components/atoms/Button.astro';
import { getLocale } from '@/paraglide/runtime';
import { listingCategoryLabel } from '@/lib/labels';
import { localizePath } from '@/lib/i18n';
import { LISTING_CATEGORIES, type Locale } from '@/lib/taxonomy';

const locale = getLocale() as Locale;
const path = Astro.url.pathname;
const searchPath = localizePath('/search/');
const q = path.startsWith(searchPath) ? (Astro.url.searchParams.get('q') ?? '') : '';

const categories = [
  {
    label: m.cat_all(),
    href: searchPath,
    active: path.startsWith(searchPath),
  },
  ...LISTING_CATEGORIES.map((c) => ({
    label: listingCategoryLabel(c.slug),
    href: localizePath(`/${c.slugs[locale]}/`),
    active: path.startsWith(localizePath(`/${c.slugs[locale]}/`)),
  })),
];
---

<header class="glass sticky top-0 z-40 border-b" style="padding-top: env(safe-area-inset-top)">
  <!-- Row 1: logo · AI search · articles/contact · auth -->
  <div class="mx-auto flex h-14 max-w-7xl items-center gap-3 px-4 md:h-[4.25rem] md:gap-5 md:px-6">
    <a href={localizePath("/")} aria-label={m.app_name()} class="flex flex-none items-center">
      <!-- naming follows the source files: LIGHT = light (white) lettering, DARK = dark lettering -->
      <img src="/img/logo-dark.svg" alt={m.app_name()} class="h-9 w-auto dark:hidden" />
      <img src="/img/logo-light.svg" alt={m.app_name()} class="hidden h-9 w-auto dark:block" />
    </a>

    <form action={searchPath} method="get" class="hidden w-full max-w-md md:block">
      <!-- Misprint slab field; crimson caret = the motion accent while typing. -->
      <label class="slab-field flex h-11 w-full cursor-text">
        <span class="slab-field__face flex w-full items-center gap-3 pl-4 pr-1.5">
      <i class="fa-thin fa-wand-magic-sparkles text-brand" aria-hidden="true"></i>
      <input
        type="search"
        name="q"
        value={q}
        data-ai-search
        placeholder={m.search_ai_placeholder()}
        class="w-full bg-transparent text-base caret-brand outline-none placeholder:text-muted-foreground md:text-sm [&::-webkit-search-cancel-button]:hidden"
      />
      <button
        type="submit"
        data-ai-go
        class:list={['flex h-8 flex-none items-center gap-1.5 bg-primary px-3 text-xs font-semibold text-primary-foreground transition-opacity duration-200 hover:opacity-90', !q && 'pointer-events-none opacity-0']}
      >
        <i class="fa-thin fa-sparkles" aria-hidden="true"></i>
        {m.nav_search()}
      </button>
        </span>
      </label>
    </form>

    <nav class="ml-auto hidden flex-none items-center gap-5 text-sm font-semibold md:flex">
      <a href={localizePath("/blog/")} class="transition-colors hover:text-brand">
        {m.section_articles()}
      </a>
      <a href={localizePath("/contact/")} class="transition-colors hover:text-brand">
        {m.nav_contact()}
      </a>
    </nav>

    <div class="ml-auto flex flex-none items-center gap-4 md:ml-0">
      <button
        type="button"
        data-modal-open="auth"
        data-auth-tab="login"
        class="text-sm font-semibold transition-colors hover:text-primary"
      >
        {m.nav_login()}
      </button>
      <Button size="sm" data-modal-open="auth" data-auth-tab="register">
        {m.nav_register()}
      </Button>
    </div>
  </div>

  <!-- Row 2: main categories — text tabs, active = short underline bar.
       NOT the anaglyph style: that button is unique (DESIGN §2.6). -->
  <div>
    <nav
      class="mx-auto flex h-11 max-w-7xl select-none items-stretch gap-2 overflow-x-auto px-4 [scrollbar-width:none] md:h-12 md:px-6 [&::-webkit-scrollbar]:hidden"
      aria-label={m.all_categories()}
    >
      {
        categories.map((l) => (
          <a
            href={l.href}
            aria-current={l.active ? 'page' : undefined}
            class:list={[
              'cat-link chroma-hover relative flex flex-none items-center px-3 font-condensed text-sm font-bold uppercase tracking-wide transition-colors active:scale-[0.97]',
              l.active ? 'text-foreground' : 'text-foreground/55 hover:text-foreground',
            ]}
          >
            {l.label}
            <span
              class:list={[
                'cat-underline absolute bottom-1.5 left-1/2 h-0.5 w-5 -translate-x-1/2 bg-foreground transition-opacity',
                l.active ? 'opacity-100' : 'opacity-0',
              ]}
              aria-hidden="true"
            />
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  /* In motion (hover), the underline picks up the anaglyph pink/cyan split
     (text handled by the global .chroma-hover utility). */
  .cat-link:hover .cat-underline {
    opacity: 1;
    box-shadow:
      -2px 0 var(--brand),
      2px 0 #00e5ff;
  }
</style>

<script>
  // AI search: reveal the inline button only once the user starts typing.
  function initAiSearch() {
    if (document.documentElement.dataset.aiSearchInit) return;
    document.documentElement.dataset.aiSearchInit = '1';
    document.addEventListener('input', (e) => {
      const inp = (e.target as HTMLElement).closest?.('[data-ai-search]') as HTMLInputElement | null;
      if (!inp) return;
      const btn = inp.parentElement?.querySelector('[data-ai-go]');
      if (!btn) return;
      const show = inp.value.trim().length > 0;
      btn.classList.toggle('opacity-0', !show);
      btn.classList.toggle('pointer-events-none', !show);
    });
  }
  initAiSearch();
  document.addEventListener('astro:page-load', initAiSearch);
</script>
