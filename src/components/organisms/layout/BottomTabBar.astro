---
import * as m from '@/paraglide/messages';
import { localizePath } from '@/lib/i18n';

const path = Astro.url.pathname;

const tabs = [
  {
    href: localizePath('/search/'),
    label: m.nav_search(),
    active: path.startsWith(localizePath('/search')),
    icon: '<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>',
  },
  {
    href: localizePath('/favorites/'),
    label: m.nav_favorites(),
    active: path.startsWith(localizePath('/favorites')),
    icon: '<path d="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7Z"/>',
  },
  {
    href: localizePath('/account/'),
    label: m.nav_account(),
    active: path.startsWith(localizePath('/account')),
    icon: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"/>',
  },
];
---

<!-- Floating liquid-glass dock (iOS 26 material, DESIGN §5): fits its content,
     lifted off the edges, blur + saturation + specular top highlight. -->
<nav
  transition:persist="tabbar"
  class="pointer-events-none fixed inset-x-0 z-40 flex select-none justify-center md:hidden"
  style="bottom: calc(0.875rem + var(--sab))"
  aria-label={m.nav_search()}
>
  <div class="tab-dock pointer-events-auto flex items-center gap-1 rounded-full p-1.5">
    {
      tabs.map((t) => (
        <a
          href={t.href}
          class:list={[
            'flex min-w-18 flex-col items-center gap-0.5 rounded-full px-4 py-1.5 text-2xs font-medium transition-[background-color,color,transform] active:scale-[0.92]',
            t.active ? 'bg-foreground/10 text-foreground' : 'text-muted-foreground',
          ]}
          aria-current={t.active ? 'page' : undefined}
        >
          <svg
            class="size-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={t.icon}
          />
          {t.label}
        </a>
      ))
    }
  </div>
</nav>

<style>
  /* Liquid glass: heavy blur + saturation boost, translucent canvas, a
     specular top edge and a soft drop — reads as a floating lens. */
  .tab-dock {
    background: color-mix(in oklch, var(--background) 42%, transparent);
    -webkit-backdrop-filter: blur(22px) saturate(1.7);
    backdrop-filter: blur(22px) saturate(1.7);
    border: 1px solid color-mix(in oklch, var(--foreground) 12%, transparent);
    box-shadow:
      inset 0 1px 0 0 color-mix(in oklch, white 30%, transparent),
      inset 0 -1px 0 0 rgb(0 0 0 / 0.06),
      0 10px 30px rgb(0 0 0 / 0.28);
  }
  @media (prefers-reduced-transparency: reduce) {
    .tab-dock {
      background: var(--background);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
</style>
