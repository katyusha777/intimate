---
import * as m from '@/paraglide/messages';
import type { Session } from '@/app/models/session';
import { localizePath } from '@/lib/i18n';

interface Props {
  session?: Session | null;
  /** Advertiser ID verification approved → Verify tab loses its crimson dot. */
  idVerified?: boolean;
  /** Unread messages across all threads → Messages tab dot. */
  unread?: number;
}
const { session = null, idVerified = true, unread = 0 } = Astro.props;

const path = Astro.url.pathname;
const tab = (href: string, label: string, icon: string, exact = false) => ({
  href: localizePath(href),
  label,
  active: exact ? path === localizePath(href) : path.startsWith(localizePath(href.replace(/\/$/, ''))),
  icon,
  dot: false,
  exact,
});

/* Role tab matrix (MESSAGING.md §10). The bar only swaps at login/logout, never
   mid-browse, so nobody sees it transform.
   - Professional: Dashboard · Messages · Contacts · Account (My profile → account hub)
   - Client (logged in): Search · Favorites · Messages · Account
   - Visitor: Search · Favorites · Account (favorites work logged out) */
const search = tab('/search/', m.nav_search(), '<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>');
const favorites = tab('/favorites/', m.nav_favorites(), '<path d="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7Z"/>');
const account = tab('/account/', m.nav_account(), '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"/>');
const messages = {
  ...tab('/messages/', m.msg_title(), '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/>'),
  dot: unread > 0,
};
const contacts = tab('/contacts/', m.contacts_title(), '<circle cx="9" cy="8" r="3.2"/><path d="M3.5 20c0-3.3 2.5-5.4 5.5-5.4s5.5 2.1 5.5 5.4"/><path d="M16 5.2a3 3 0 0 1 0 5.6"/><path d="M18.5 20c0-2.6-1-4.4-2.6-5.2"/>');

const tabs =
  session?.role === 'advertiser'
    ? [
        {
          ...tab('/account/', m.nav_dashboard(), '<path d="M4 13a8 8 0 1 1 16 0"/><path d="M12 13l4-4"/><path d="M2 17h20"/>', true),
          dot: !idVerified,
        },
        messages,
        contacts,
        account,
      ]
    : session
      ? [search, favorites, messages, account]
      : [search, favorites, account];
---

<!-- iOS-native tab bar, GLUED to the screen edge. The Safari gotcha: when
     the toolbar collapses, WebKit REPAINTS fixed elements at the new spot but
     HIT-TESTS them ~a toolbar-height lower (the notorious desync — no API,
     years-old WebKit bug). Defense: the LINKS themselves own all the bottom
     padding, so their tap boxes run from the icon row down to the screen
     edge — a tap registered ~44px below where you aimed still lands inside
     the same link. Bar stays compact when the toolbar is visible (env-based
     padding, no constant floor needed anymore). -->
<nav
  transition:persist="tabbar"
  class="tab-dock fixed inset-x-0 bottom-0 z-40 select-none border-t md:hidden"
  aria-label={m.nav_search()}
>
  <div class="relative mx-auto flex max-w-lg items-stretch px-2 pt-1.5">
    <!-- The glass highlight SLIDES between tabs (left/width animate) instead
         of each tab painting its own static pill. -->
    <span
      data-tab-highlight
      class="pointer-events-none absolute rounded-full bg-foreground/10 opacity-0 transition-[left,width,opacity] duration-300 ease-out"
      aria-hidden="true"></span>
    {
      tabs.map((t) => (
        <a
          href={t.href}
          data-tab
          data-tab-exact={t.exact ? '' : undefined}
          class:list={[
            'tab-hit relative flex flex-1 flex-col items-center gap-0.5 px-2 pt-1.5 text-2xs font-medium transition-[color,transform] active:scale-[0.92]',
            t.active ? 'text-foreground' : 'text-muted-foreground',
          ]}
          aria-current={t.active ? 'page' : undefined}
        >
          {t.dot && <span class="absolute right-3 top-1 size-1.5 rounded-full bg-brand" />}
          <svg
            class="size-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={t.icon}
          />
          {t.label}
        </a>
      ))
    }
  </div>
</nav>

<script>
  // The dock is transition:persist, so its server-rendered active state goes
  // stale on client-side navigation. Re-sync from the URL on every page load,
  // and glide the shared highlight pill under the active tab.
  function syncTabs() {
    const path = location.pathname;
    let activeTab: HTMLAnchorElement | null = null;
    document.querySelectorAll<HTMLAnchorElement>('[data-tab]').forEach((a) => {
      const href = new URL(a.href).pathname;
      const active = a.hasAttribute('data-tab-exact')
        ? path === href
        : path.startsWith(href.replace(/\/$/, ''));
      a.classList.toggle('text-foreground', active);
      a.classList.toggle('text-muted-foreground', !active);
      if (active) {
        a.setAttribute('aria-current', 'page');
        activeTab = a;
      } else a.removeAttribute('aria-current');
    });
    const hl = document.querySelector<HTMLElement>('[data-tab-highlight]');
    if (!hl) return;
    if (!activeTab) {
      hl.style.opacity = '0';
      return;
    }
    const el = activeTab as HTMLElement;
    // The link's tap box runs into the bottom padding (hit-test defense) —
    // the visible highlight hugs just the icon+label block.
    const pad = parseFloat(getComputedStyle(el).paddingBottom) || 0;
    hl.style.left = `${el.offsetLeft}px`;
    hl.style.top = `${el.offsetTop}px`;
    hl.style.width = `${el.offsetWidth}px`;
    hl.style.height = `${Math.max(0, el.offsetHeight - pad + 6)}px`;
    hl.style.opacity = '1';
  }
  syncTabs();
  document.addEventListener('astro:page-load', syncTabs);

  // ── Safari collapsed-toolbar defense, twice over ─────────────────────────
  // Apple exposes NO metric for the collapsed pill's tap region (safe-area
  // only covers the home indicator), so:
  // 1) DETECT the state instead: the layout viewport GROWS when the toolbar
  //    hides (window.innerHeight rises above its per-orientation minimum) →
  //    toggle a class that lifts the icons far above the pill; compact bar
  //    while the toolbar is visible.
  // 2) Don't trust `click` at all: Safari eats the synthesized click in that
  //    band but raw touchend still fires — navigate from touchend ourselves
  //    (tap-vs-scroll guarded), so the tap navigates even if Safari also
  //    expands its toolbar.
  if (!(window as any).__tabbarSafari) {
    (window as any).__tabbarSafari = true;
    const bar = () => document.querySelector<HTMLElement>('nav.tab-dock');

    let minH = Infinity;
    const measure = () => {
      const h = window.innerHeight;
      if (h < minH) minH = h;
      bar()?.classList.toggle('toolbar-collapsed', h > minH + 30);
      syncTabs(); // bar height changed → re-seat the highlight
    };
    window.addEventListener('resize', measure);
    window.visualViewport?.addEventListener('resize', measure);
    window.addEventListener('orientationchange', () => {
      minH = Infinity; // heights differ per orientation — re-learn
      setTimeout(measure, 300);
    });
    measure();

    let tx = 0;
    let ty = 0;
    document.addEventListener(
      'touchstart',
      (e) => {
        if (!(e.target as HTMLElement).closest?.('nav.tab-dock')) return;
        tx = e.touches[0]!.clientX;
        ty = e.touches[0]!.clientY;
      },
      { passive: true },
    );
    document.addEventListener(
      'touchend',
      (e) => {
        const a = (e.target as HTMLElement).closest?.('a[data-tab]') as HTMLAnchorElement | null;
        if (!a) return;
        const t = e.changedTouches[0]!;
        if (Math.abs(t.clientX - tx) > 12 || Math.abs(t.clientY - ty) > 12) return; // a scroll, not a tap
        e.preventDefault(); // suppress the (possibly-eaten) synthesized click
        a.click(); // programmatic click — Safari can't swallow it; ClientRouter handles it
      },
      { passive: false },
    );
  }
</script>

<style>
  /* The LINK carries the bottom padding: its tap box reaches the screen edge.
     Compact while Safari's toolbar is visible; when the MEASURED collapsed
     state kicks in (script above), the icons lift far above the pill's tap
     region. Standalone PWA never gets the class → always compact. */
  .tab-hit {
    padding-bottom: calc(var(--sab) + 0.625rem);
    transition: padding-bottom 0.25s ease;
  }
  nav.toolbar-collapsed .tab-hit {
    padding-bottom: calc(var(--sab) + 3.75rem);
  }

  /* Liquid glass: heavy blur + saturation boost over a translucent canvas —
     the content scrolls visibly underneath, like the native iOS tab bar. */
  .tab-dock {
    background: color-mix(in oklch, var(--background) 72%, transparent);
    -webkit-backdrop-filter: blur(22px) saturate(1.7);
    backdrop-filter: blur(22px) saturate(1.7);
    border-color: color-mix(in oklch, var(--foreground) 12%, transparent);
  }
  @media (prefers-reduced-transparency: reduce) {
    .tab-dock {
      background: var(--background);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
</style>
