---
/**
 * App-facing Skeleton — renders the `.skeleton` token (global.css): a
 * foreground-mix pulse that is visible on BOTH themes (the old vendor
 * bg-accent pulse vanished on dark surfaces). Size/shape via `class`.
 */
interface Props {
  class?: string;
  [key: string]: unknown;
}
const { class: className, ...rest } = Astro.props;
---

<div class:list={['skeleton', className]} {...rest}></div>
