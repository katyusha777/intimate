---
/**
 * Icon abstraction over Font Awesome Pro (thin + brands kit).
 * <Icon name="heart" /> · <Icon name="whatsapp" family="brands" />
 * Swapping the icon library later = re-implementing this one file.
 */
interface Props {
  name: string;
  family?: 'thin' | 'brands';
  class?: string;
  /** Accessible label; omitted → decorative (aria-hidden). */
  label?: string;
}

const { name, family = 'thin', class: className, label } = Astro.props;
---

<i
  class:list={[`fa-${family}`, `fa-${name}`, className]}
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  role={label ? 'img' : undefined}></i>
