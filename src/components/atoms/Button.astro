---
/**
 * App-facing Button — the swap-point doctrine in action: implementation lives
 * here, call sites stay untouched (previous vendor wrapper:
 * `import { Button } from '@/components/ui/button'`).
 *
 * Variants:
 *  - `default`   — the Persona-5 anaglyph (the "special" primary CTA), unchanged.
 *  - `secondary` — a CLEAN button: full border, subtle solid fill, normal radius.
 *                  Unmistakably a button — no slab-cut corners, no anaglyph.
 */
import AnaglyphButton from './AnaglyphButton.astro';

interface Props {
  variant?: 'default' | 'secondary';
  as?: 'button' | 'a';
  href?: string;
  type?: 'button' | 'submit';
  size?: 'sm' | 'default' | 'lg';
  class?: string;
  [key: string]: unknown;
}

const { variant = 'default', as, href, type = 'button', size = 'default', class: className, ...rest } = Astro.props;

// Secondary padding tracks the anaglyph size scale so the two read as siblings.
const pad =
  size === 'sm' ? 'px-4 py-2 text-sm' : size === 'lg' ? 'px-8 py-3.5 text-base' : 'px-6 py-3 text-sm';
const Tag = as ?? (href ? 'a' : 'button');
---

{
  variant === 'secondary' ? (
    <Tag
      class:list={[
        'btn-secondary inline-flex items-center justify-center gap-2 rounded-md border font-semibold transition-colors',
        pad,
        className,
      ]}
      href={href}
      type={Tag === 'button' ? type : undefined}
      {...rest}
    >
      <slot />
    </Tag>
  ) : (
    <AnaglyphButton {as} {href} {type} {size} class={className} {...rest}>
      <slot />
    </AnaglyphButton>
  )
}
