---
/**
 * App-facing Button — the swap-point doctrine in action: implementation lives
 * here, call sites stay untouched (previous vendor wrapper:
 * `import { Button } from '@/components/ui/button'`).
 *
 * THE three button types (flat lines + skews, no radii):
 *  - `default`   — PRIMARY: the Persona-5 anaglyph (skewed slab + pink/cyan).
 *  - `secondary` — the same cut ink slab WITHOUT the chromatic layers.
 *  - `tertiary`  — muted flat outline: keyline border, quiet text, square.
 */
import AnaglyphButton from './AnaglyphButton.astro';

interface Props {
  variant?: 'default' | 'secondary' | 'tertiary';
  as?: 'button' | 'a';
  href?: string;
  type?: 'button' | 'submit';
  size?: 'sm' | 'default' | 'lg';
  class?: string;
  [key: string]: unknown;
}

const { variant = 'default', as, href, type = 'button', size = 'default', class: className, ...rest } = Astro.props;

// Tertiary padding tracks the anaglyph size scale so the three read as siblings.
const pad =
  size === 'sm' ? 'px-4 py-2 text-sm' : size === 'lg' ? 'px-8 py-3.5 text-base' : 'px-6 py-3 text-sm';
const Tag = as ?? (href ? 'a' : 'button');
---

{
  variant === 'tertiary' ? (
    <Tag
      class:list={[
        'btn-tertiary inline-flex items-center justify-center gap-2 border font-semibold transition-colors',
        pad,
        className,
      ]}
      href={href}
      type={Tag === 'button' ? type : undefined}
      {...rest}
    >
      <slot />
    </Tag>
  ) : (
    <AnaglyphButton {as} {href} {type} {size} plain={variant === 'secondary'} class={className} {...rest}>
      <slot />
    </AnaglyphButton>
  )
}
