---
/**
 * The wand on mobile (UX-PLAN 6.1). A bottom `ActionSheet` opened from the
 * mobile search icon: the AI search field (typing stays optional) over three
 * one-tap example queries. Every path runs the existing `aiSearch` action via
 * `AiSearchInput`'s form — the examples just fill the field and submit, so we
 * never reinvent the parser. Assist, not hero: it lives behind an icon.
 *
 * Open with data-sheet-open="wand-sheet" (delegated by ActionSheet).
 */
import * as m from '@/paraglide/messages';
import { localizePath } from '@/lib/i18n';
import ActionSheet from '@/components/molecules/ActionSheet.astro';
import AiSearchInput from '@/components/molecules/AiSearchInput.astro';

/** Three honest example queries — the parser turns each into taxonomy +
 *  presence filters. Roles not genders (CLAUDE.md / UX-PLAN §0). */
const EXAMPLES = [m.wand_example_1(), m.wand_example_2(), m.wand_example_3()];
---

<ActionSheet id="wand-sheet" label={m.wand_title()} class="pt-1">
  <div class="space-y-5 px-4 pb-6">
    <div class="space-y-1">
      <p class="display text-xl">{m.wand_title()}</p>
      <p class="text-sm text-muted-foreground">{m.wand_subtitle()}</p>
    </div>

    <!-- Reuse the exact field + aiSearch wiring (typing optional). -->
    <AiSearchInput action={localizePath('/search/')} />

    <div class="space-y-2">
      <p class="eyebrow text-2xs text-muted-foreground">{m.wand_examples_label()}</p>
      {
        EXAMPLES.map((ex) => (
          <button
            type="button"
            data-wand-example={ex}
            class="flex w-full cursor-pointer items-center gap-3 rounded-lg border border-border bg-muted/40 px-3.5 py-3 text-left text-sm font-medium transition-colors hover:bg-muted active:scale-[0.99]"
          >
            <i class="fa-thin fa-wand-magic-sparkles flex-none text-muted-foreground" aria-hidden="true" />
            <span class="min-w-0 flex-1 truncate">{ex}</span>
            <i class="fa-thin fa-arrow-right flex-none text-muted-foreground" aria-hidden="true" />
          </button>
        ))
      }
    </div>
  </div>
</ActionSheet>

<script>
  // One-tap examples: fill the sheet's AI field and submit its form — the
  // existing AiSearchInput handler runs aiSearch, so there is no parser here.
  function initWand() {
    const sheet = document.getElementById('wand-sheet');
    if (!sheet || sheet.dataset.wandInit) return;
    sheet.dataset.wandInit = '1';
    sheet.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-wand-example]');
      if (!btn) return;
      const form = sheet.querySelector<HTMLFormElement>('form[data-ai-form]');
      const input = form?.querySelector<HTMLInputElement>('[data-ai-search]');
      if (!form || !input) return;
      input.value = btn.dataset.wandExample!;
      input.dispatchEvent(new Event('input', { bubbles: true })); // reveal GO
      form.requestSubmit();
    });
  }
  initWand();
  document.addEventListener('astro:page-load', initWand);
</script>
