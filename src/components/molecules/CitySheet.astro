---
/**
 * "Ask the city once" (UX-PLAN 1.2). First-visit bottom sheet: six cities +
 * ALL OF NL. NO geolocation — coarse by design (more private, less scary).
 *
 * The pick sets a 1-year `city` cookie and navigates to that city's shelf
 * (/{locale}/{city}/); ALL OF NL clears it and stays on the generic home. The
 * cookie only drives the redirect (middleware) — it never varies cached HTML.
 *
 * Auto-opens once, client-side, when there is no `city` cookie and the visitor
 * hasn't dismissed it. Reachable again anytime from the header location picker.
 */
import * as m from '@/paraglide/messages';
import { localizePath } from '@/lib/i18n';
import { CITIES } from '@/lib/taxonomy';
import ActionSheet from '@/components/molecules/ActionSheet.astro';

interface Props {
  /** Skip the first-visit auto-open (kitchen-sink / manual trigger only). */
  manual?: boolean;
}
const { manual = false } = Astro.props;

/** The six flagship cities the sheet offers directly. */
const TOP_CITIES = CITIES.slice(0, 6);
const home = localizePath('/');
---

<ActionSheet id="city-sheet" label={m.city_sheet_title()} class="city-sheet">
  <div class="px-4 pb-6 pt-1">
    <h2 class="font-condensed text-2xl font-semibold">{m.city_sheet_title()}</h2>
    <p class="mt-1 text-sm text-muted-foreground">{m.city_sheet_sub()}</p>

    <div class="mt-5 grid grid-cols-2 gap-2.5">
      {
        TOP_CITIES.map((c) => (
          <button
            type="button"
            data-city-pick={c.slug}
            class="flex h-14 items-center justify-center border border-foreground/20 px-3 font-condensed text-base font-semibold uppercase tracking-wide transition-colors hover:border-foreground/60 active:scale-[0.97]"
          >
            {c.name}
          </button>
        ))
      }
    </div>

    <button
      type="button"
      data-city-pick=""
      class="mt-2.5 flex h-14 w-full items-center justify-center border border-foreground/15 px-3 text-sm font-medium text-muted-foreground transition-colors hover:border-foreground/40 hover:text-foreground active:scale-[0.98]"
    >
      {m.city_sheet_all()}
    </button>
  </div>
</ActionSheet>

<script is:inline define:vars={{ home, manual }}>
  (function () {
    const YEAR = 31536000;
    function hasCity() {
      return /(?:^|;\s*)city=/.test(document.cookie);
    }
    function pick(slug) {
      if (slug) {
        document.cookie = `city=${slug}; path=/; max-age=${YEAR}; samesite=lax`;
        location.href = `${home}${slug}/`;
      } else {
        // ALL OF NL: clear the cookie, mark as answered so we don't re-ask.
        document.cookie = 'city=; path=/; max-age=0; samesite=lax';
        localStorage.setItem('city_asked', '1');
        const dlg = document.getElementById('city-sheet');
        dlg && dlg.closeSheet && dlg.closeSheet();
      }
    }
    function init() {
      document.querySelectorAll('[data-city-pick]').forEach((b) => {
        if (b.dataset.cityInit) return;
        b.dataset.cityInit = '1';
        b.addEventListener('click', () => pick(b.dataset.cityPick));
      });
      // First-visit auto-open: no chosen city, not previously dismissed.
      const dlg = document.getElementById('city-sheet');
      if (!manual && dlg && dlg.openSheet && !hasCity() && !localStorage.getItem('city_asked')) {
        // mark immediately so a reload before choosing doesn't nag twice
        localStorage.setItem('city_asked', '1');
        setTimeout(() => dlg.openSheet(), 350);
      }
    }
    init();
    document.addEventListener('astro:page-load', init);
  })();
</script>
