---
/**
 * The AI search field (Misprint slab). Owns its whole lifecycle:
 * - animated placeholder that "types" example queries (contextual-search cue)
 * - submit → aiSearch action (OpenRouter via the Worker) → navigate to the
 *   filter URL it returns; wand becomes a spinner while processing
 * - graceful fallback: action failure (or no JS) submits the plain GET ?q=
 */
import * as m from '@/paraglide/messages';

interface Props {
  action: string;
  value?: string;
  class?: string;
}
const { action, value = '', class: className } = Astro.props;
---

<form method="get" action={action} class:list={['w-full', className]} data-ai-form>
  <label class="slab-field flex h-11 w-full cursor-text">
    <span class="slab-field__face flex w-full items-center gap-3 pl-4 pr-1.5">
      <!-- icon matches the frame ink (DESIGN: input icons = border color) -->
      <i class="fa-thin fa-wand-magic-sparkles text-foreground" data-ai-wand aria-hidden="true"
      ></i>
      <i
        class="fa-thin fa-spinner-third animate-spin text-foreground"
        style="display: none"
        data-ai-spinner
        aria-hidden="true"></i>
      <input
        type="search"
        name="q"
        value={value}
        data-ai-search
        spellcheck="false"
        autocomplete="off"
        placeholder={m.search_ai_placeholder()}
        class="w-full bg-transparent text-base caret-brand outline-none placeholder:text-muted-foreground md:text-sm [&::-webkit-search-cancel-button]:hidden"
      />
      <button
        type="submit"
        data-ai-go
        class:list={[
          'slab-cut flex h-8 flex-none cursor-pointer items-center gap-1.5 bg-foreground px-3.5 font-condensed text-xs font-bold uppercase tracking-wide text-background transition-opacity duration-200 hover:opacity-90',
          !value && 'pointer-events-none opacity-0',
        ]}
      >
        <i class="fa-thin fa-sparkles" aria-hidden="true"></i>
        {m.nav_search()}
      </button>
    </span>
  </label>
</form>

<script>
  import { actions } from 'astro:actions';

  /** Example queries the placeholder "types" — the contextual-search cue. */
  const EXAMPLES = [
    'blowjob in Utrecht…',
    'trans girl in Amsterdam, online now…',
    'tantra massage under €150…',
    'GFE dinner date in Rotterdam…',
    'dominatrix who does house calls…',
  ];

  function initAiSearch() {
    document.querySelectorAll<HTMLFormElement>('form[data-ai-form]').forEach((form) => {
      if (form.dataset.init) return;
      form.dataset.init = '1';
      const input = form.querySelector<HTMLInputElement>('[data-ai-search]')!;
      const go = form.querySelector<HTMLElement>('[data-ai-go]')!;
      const wand = form.querySelector<HTMLElement>('[data-ai-wand]')!;
      const spinner = form.querySelector<HTMLElement>('[data-ai-spinner]')!;

      // -- reveal the submit button once the user types -------------------
      input.addEventListener('input', () => {
        const show = input.value.trim().length > 0;
        go.classList.toggle('opacity-0', !show);
        go.classList.toggle('pointer-events-none', !show);
      });

      // -- typing placeholder --------------------------------------------
      // The static copy stays only for no-JS / reduced-motion; the animation
      // never shows it (no flash between examples). Focus clears the field.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let ex = 0;
        let pos = 0;
        let dir = 1; // 1 typing · -1 deleting
        let paused = false;
        input.placeholder = '';
        input.addEventListener('focus', () => {
          paused = true;
          input.placeholder = '';
        });
        input.addEventListener('blur', () => {
          if (input.value === '') {
            paused = false;
            pos = 0;
            dir = 1;
          }
        });
        const tick = () => {
          if (!form.isConnected) return;
          let wait = dir === 1 ? 55 : 25;
          if (!paused && input.value === '') {
            const word = EXAMPLES[ex]!;
            pos += dir;
            input.placeholder = word.slice(0, pos);
            if (pos === word.length) {
              dir = -1;
              wait = 1600; // let them read it
            } else if (pos === 0) {
              dir = 1;
              ex = (ex + 1) % EXAMPLES.length;
              wait = 400;
            }
          }
          setTimeout(tick, wait);
        };
        setTimeout(tick, 600);
      }

      // -- AI submit ------------------------------------------------------
      form.addEventListener('submit', async (e) => {
        const query = input.value.trim();
        if (query.length < 2 || form.dataset.loading) return; // let GET handle it
        e.preventDefault();
        form.dataset.loading = '1';
        wand.style.display = 'none';
        spinner.style.display = '';
        try {
          const { data, error } = await actions.aiSearch({
            query,
            locale: (document.documentElement.lang || 'en') as 'nl' | 'en' | 'de',
          });
          if (error || !data?.href) throw error ?? new Error('no result');
          location.href = data.href;
        } catch {
          // AI unavailable → plain text search, same form, zero drama
          delete form.dataset.loading;
          form.submit();
        }
      });
    });
  }
  initAiSearch();
  document.addEventListener('astro:page-load', initAiSearch);
</script>
