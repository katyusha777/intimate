---
/**
 * Safe-mode bubble (DESIGN.md §6, Phase 5.2) — a small glass pill fixed just
 * above the mobile tab dock while safe mode is ON, reassuring the user their
 * photos are blurred and offering a one-tap "turn off". Mobile only (md:hidden);
 * desktop keeps the header/footer SafeModeToggle.
 *
 * Live, CSS-driven: the Layout safe-mode script stamps `html.safe-on` from the
 * cookie (before paint + on every toggle), so the bubble appears/disappears with
 * no reload. The "turn off" button carries `data-safe-off`, which that same
 * delegated handler reads to force safe mode OFF. Position mirrors BottomTabBar's
 * `.tab-pos` bottom calc (var(--sab)), lifted one dock-height so it rides above.
 */
import * as m from '@/paraglide/messages';
---

<div
  transition:persist="safe-bubble"
  class="safe-bubble pointer-events-none fixed inset-x-0 z-40 flex justify-center px-4 md:hidden"
  aria-live="polite"
>
  <div class="safe-bubble-pill pointer-events-auto flex items-center gap-2.5 rounded-full py-2 pl-3.5 pr-2">
    <svg class="size-4 flex-none text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M2 2 22 22" />
      <path d="M6.7 6.7A10.4 10.4 0 0 0 1 12s4 7 11 7a10 10 0 0 0 4.4-1" />
      <path d="M9.9 4.2A10.8 10.8 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.3 3.3" />
      <path d="M9.6 9.6a3 3 0 0 0 4.2 4.2" />
    </svg>
    <span class="text-2xs font-medium leading-tight text-foreground">{m.safemode_bubble()}</span>
    <button
      type="button"
      data-safe-off
      class="flex-none rounded-full bg-foreground/10 px-2.5 py-1 text-2xs font-semibold text-foreground transition-colors hover:bg-foreground/20"
    >
      {m.safemode_turn_off()}
    </button>
  </div>
</div>

<style>
  /* Hidden unless safe mode is active — html.safe-on is set by the Layout
     safe-mode script from the cookie (live, no reload). */
  html:not(.safe-on) .safe-bubble {
    display: none;
  }

  /* Ride just above the tab dock — mirror BottomTabBar's .tab-pos bottom calc,
     lifted one dock height (~4.25rem) so the two never overlap. */
  .safe-bubble {
    bottom: calc(var(--sab) + 0.875rem + 4.25rem);
  }
  @media (display-mode: standalone) {
    .safe-bubble {
      bottom: calc(var(--sab) + 0.875rem + 4.25rem);
    }
  }

  /* Liquid glass pill — same recipe as .tab-dock so the two read as one system. */
  .safe-bubble-pill {
    background: color-mix(in oklch, var(--background) 42%, transparent);
    -webkit-backdrop-filter: blur(22px) saturate(1.7);
    backdrop-filter: blur(22px) saturate(1.7);
    border: 1px solid color-mix(in oklch, var(--foreground) 12%, transparent);
    box-shadow:
      inset 0 1px 0 0 color-mix(in oklch, white 30%, transparent),
      inset 0 -1px 0 0 rgb(0 0 0 / 0.06),
      0 10px 30px rgb(0 0 0 / 0.28);
  }
  @media (prefers-reduced-transparency: reduce) {
    .safe-bubble-pill {
      background: var(--background);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
</style>
