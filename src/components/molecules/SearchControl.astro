---
/**
 * Home search affordance — ONE unmistakable target: a real search field
 * (Misprint ink slab, DESIGN §1.1) that opens the listing. The city prefix is
 * a clearly labelled part of the field, not a peer control: SSR renders the
 * national label (single cached variant), and a tiny client script swaps in
 * the visitor's saved `city` cookie (label + href) — no separate chips, no
 * "back to your city" pill.
 */
import * as m from '@/paraglide/messages';
import { localizePath } from '@/lib/i18n';
import { CITIES, type CitySlug } from '@/lib/taxonomy';

interface Props {
  /** Explicit city (city hub pages); omit for the cookie-aware national bar. */
  city?: CitySlug;
  class?: string;
}
const { city, class: className } = Astro.props;

const cityName = CITIES.find((c) => c.slug === city)?.name;
const base = city ? localizePath(`/${city}/`) : localizePath('/search/');
---

<div
  data-search-control
  data-static={city ? '' : undefined}
  data-base={localizePath('/')}
  data-city-names={JSON.stringify(Object.fromEntries(CITIES.map((c) => [c.slug, c.name])))}
  class:list={[className]}
>
  <!-- Search field: labelled city prefix + placeholder, opens the listing. -->
  <a href={base} class="slab-field block min-w-0" aria-label={m.search_open()}>
    <span class="slab-field__face flex items-center py-1.5 pl-4 pr-1.5 text-sm">
      <span class="flex-none whitespace-nowrap font-semibold">
        <span class="text-foreground/50">{m.search_city()}: </span>
        <span data-search-city>{cityName ?? m.where_netherlands()}</span>
      </span>
      <span class="mx-3 h-5 w-px flex-none bg-foreground/20" aria-hidden="true"></span>
      <span class="truncate text-foreground/50">{m.search_find_ph()}</span>
      <span class="ml-auto grid size-8 flex-none place-items-center rounded-full bg-foreground text-background">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
      </span>
    </span>
  </a>
</div>

<script>
  // Saved-city personalisation: cookie → label + href, client-only so the
  // page stays one cached variant. Skips instances with an explicit city.
  function paintSearchControls() {
    document.querySelectorAll<HTMLElement>('[data-search-control]').forEach((el) => {
      if (el.dataset.static !== undefined) return;
      const mru = /(?:^|;\s*)city=([^;]+)/.exec(document.cookie);
      const slug = mru && decodeURIComponent(mru[1]!);
      if (!slug) return;
      const names = JSON.parse(el.dataset.cityNames || '{}') as Record<string, string>;
      const name = names[slug];
      const a = el.querySelector('a');
      const label = el.querySelector('[data-search-city]');
      if (!name || !a || !label) return;
      a.setAttribute('href', `${el.dataset.base}${slug}/`);
      label.textContent = name;
    });
  }
  if (!(window as any).__searchCtl) {
    (window as any).__searchCtl = true;
    document.addEventListener('astro:page-load', paintSearchControls);
  }
  paintSearchControls();
</script>
