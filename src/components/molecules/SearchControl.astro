---
/**
 * Home search affordance — ONE unmistakable target: a real search field
 * (Misprint ink slab, DESIGN §1.1) that opens the listing for the chosen city;
 * the city is a clearly labelled prefix, not a peer word. Filters live on the
 * listing itself (sidebar/sheet) — no duplicate entry point here.
 * Zero JS: a plain <a> to the canonical listing URL; search text itself rides
 * `?q=` once real search lands (the field is a link shell until then).
 */
import * as m from '@/paraglide/messages';
import { localizePath } from '@/lib/i18n';
import { CITIES, type CitySlug } from '@/lib/taxonomy';

interface Props {
  /** Current shelf city; undefined = all of NL. Labels the search prefix. */
  city?: CitySlug;
  class?: string;
}
const { city, class: className } = Astro.props;

const cityName = CITIES.find((c) => c.slug === city)?.name;
/* Search + filters both open this listing base (city hub or the search index). */
const base = city ? localizePath(`/${city}/`) : localizePath('/search/');
---

<div class:list={['flex items-stretch gap-2', className]}>
  <!-- Search field: labelled city prefix + placeholder, opens the listing. -->
  <a href={base} class="slab-field block min-w-0 flex-1" aria-label={m.search_open()}>
    <span class="slab-field__face flex items-center py-1.5 pl-4 pr-1.5 text-sm">
      <span class="flex-none whitespace-nowrap font-semibold">
        <span class="text-foreground/50">{m.search_city()}:</span> {cityName ?? m.where_netherlands()}
      </span>
      <span class="mx-3 h-5 w-px flex-none bg-foreground/20" aria-hidden="true"></span>
      <span class="truncate text-foreground/50">{m.search_find_ph()}</span>
      <span class="ml-auto grid size-8 flex-none place-items-center rounded-full bg-foreground text-background">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
      </span>
    </span>
  </a>
</div>
