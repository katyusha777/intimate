---
/**
 * The one clean search affordance — a Misprint ink slab (DESIGN §1.1): sharp
 * ink-flip rectangle, hierarchy via ink opacity, paper die-cut for the icon.
 * Visual shell for now — opens nothing until search lands.
 */
import * as m from '@/paraglide/messages';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<button type="button" class:list={['slab-field block w-full', className]}>
  <span class="slab-field__face flex items-center py-1.5 pl-5 pr-1.5 text-sm">
    <span class="pr-4 font-semibold">{m.search_city()}</span>
    <span class="h-5 w-px bg-foreground/20" aria-hidden="true"></span>
    <span class="px-4 text-foreground/60">{m.search_availability()}</span>
    <span class="h-5 w-px bg-foreground/20" aria-hidden="true"></span>
    <span class="pl-4 pr-3 text-foreground/60">{m.search_filters()}</span>
    <span class="ml-auto grid size-8 flex-none place-items-center rounded-full bg-foreground text-background">
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
    </span>
  </span>
</button>
