---
/**
 * Floating safe-mode control (Phase 5.2) — the panic switch, always one thumb
 * away, no full-page scroll to the footer.
 *   - Mobile: a glass pill lifted just above the tab dock.
 *   - Desktop: an always-visible glass button, bottom-right.
 * Reuses `data-safe-toggle`, so the sitewide safe-mode script in Layout owns the
 * behavior (click cycles off → neutral → dev; sets aria-checked + data-safe-state).
 * Fail-closed and zero-JS-of-its-own — the shared island already runs.
 */
import Icon from '@/components/atoms/Icon.astro';
import * as m from '@/paraglide/messages';
---

<button
  type="button"
  role="switch"
  aria-checked="true"
  aria-label={m.safe_mode_cycle()}
  data-safe-toggle
  data-safe-state="neutral"
  class="safe-bar pointer-events-auto fixed z-40 flex select-none items-center gap-2 rounded-full py-2 pl-3 pr-3.5 text-2xs font-semibold uppercase tracking-wide text-foreground transition-transform active:scale-[0.94]"
>
  <!-- eye-slash when active (neutral/dev), eye when off; CSS picks by state -->
  <span class="grid place-items-center text-lg" aria-hidden="true">
    <Icon name="eye-slash" class="icon-on" />
    <Icon name="eye" class="icon-off" />
  </span>
  <span class="hidden sm:inline">{m.safe_mode()}</span>
  <span class="w-14 text-left sm:w-16">
    <span data-when="off">{m.safe_off()}</span>
    <span data-when="neutral">{m.safe_neutral()}</span>
    <span data-when="dev">{m.safe_dev()}</span>
  </span>
</button>

<style>
  /* Mobile: lifted above the tab dock, right-aligned, one thumb away.
     Desktop: the dock is hidden, so drop to the corner. */
  .safe-bar {
    right: 0.875rem;
    bottom: calc(5.5rem + var(--sab));
  }
  @media (min-width: 768px) {
    .safe-bar {
      right: 1.25rem;
      bottom: 1.25rem;
    }
  }

  /* Liquid glass to match the tab dock (DESIGN §5). */
  .safe-bar {
    background: color-mix(in oklch, var(--background) 42%, transparent);
    -webkit-backdrop-filter: blur(22px) saturate(1.7);
    backdrop-filter: blur(22px) saturate(1.7);
    border: 1px solid color-mix(in oklch, var(--foreground) 12%, transparent);
    box-shadow:
      inset 0 1px 0 0 color-mix(in oklch, white 30%, transparent),
      inset 0 -1px 0 0 rgb(0 0 0 / 0.06),
      0 10px 30px rgb(0 0 0 / 0.28);
  }
  @media (prefers-reduced-transparency: reduce) {
    .safe-bar {
      background: var(--background);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  /* Icon: eye-slash while safe mode active, plain eye when off. */
  .safe-bar .icon-on,
  .safe-bar .icon-off {
    grid-area: 1 / 1;
  }
  .safe-bar[aria-checked='true'] .icon-off,
  .safe-bar[aria-checked='false'] .icon-on {
    display: none;
  }

  /* Only the label matching the current state shows. */
  .safe-bar [data-when] {
    display: none;
  }
  .safe-bar[data-safe-state='off'] [data-when='off'],
  .safe-bar[data-safe-state='neutral'] [data-when='neutral'],
  .safe-bar[data-safe-state='dev'] [data-when='dev'] {
    display: inline;
  }
</style>
