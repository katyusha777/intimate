---
/**
 * Safe-mode control (Phase 5.2) — reachable without scrolling to the footer.
 * Flat, docked at the bottom-left (not a floating glass pill); a single icon +
 * the current state label. Reuses `data-safe-toggle`, so the sitewide safe-mode
 * script in Layout owns the behavior (click cycles off → neutral → dev; sets
 * aria-checked + data-safe-state). Fail-closed, zero-JS-of-its-own.
 */
import * as m from '@/paraglide/messages';
---

<button
  type="button"
  role="switch"
  aria-checked="true"
  aria-label={m.safe_mode_cycle()}
  data-safe-toggle
  data-safe-state="neutral"
  class="safe-bar fixed z-40 flex select-none items-center gap-2 border border-foreground/25 bg-card px-3 py-2 text-2xs font-semibold uppercase tracking-wide text-foreground shadow-sm transition-colors hover:border-foreground/50"
>
  <svg class="size-4 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M2 2 22 22" />
    <path d="M6.7 6.7A10.4 10.4 0 0 0 1 12s4 7 11 7a10 10 0 0 0 4.4-1" />
    <path d="M9.9 4.2A10.8 10.8 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.3 3.3" />
    <path d="M9.6 9.6a3 3 0 0 0 4.2 4.2" />
  </svg>
  <span>{m.safe_mode()}</span>
  <span class="w-14 text-left">
    <span data-when="off">{m.safe_off()}</span>
    <span data-when="neutral">{m.safe_neutral()}</span>
    <span data-when="dev">{m.safe_dev()}</span>
  </span>
</button>

<style>
  /* Docked flush at the bottom-left corner — the tab dock owns bottom-center. */
  .safe-bar {
    left: 0.75rem;
    bottom: calc(0.75rem + var(--sab));
  }
  @media (min-width: 768px) {
    .safe-bar {
      left: 1.25rem;
      bottom: 1.25rem;
    }
  }
  @media (prefers-reduced-transparency: reduce) {
    .safe-bar {
      box-shadow: none;
    }
  }

  /* Only the label matching the current state shows. */
  .safe-bar [data-when] {
    display: none;
  }
  .safe-bar[data-safe-state='off'] [data-when='off'],
  .safe-bar[data-safe-state='neutral'] [data-when='neutral'],
  .safe-bar[data-safe-state='dev'] [data-when='dev'] {
    display: inline;
  }
</style>
