---
/**
 * Safe-mode switch (DESIGN.md §6, Phase 5 — three-valued: off · neutral · dev).
 * The switch is ON whenever safe mode is active (neutral OR dev); a tiny state
 * label names which skin is showing. State is applied client-side by the
 * safe-mode script in Layout (cookie `safe_mode`) — it sets `aria-checked` and
 * `data-safe-state`, and clicking cycles off → neutral → dev. Cached HTML stays
 * identical for everyone; the label swaps via CSS on `data-safe-state`.
 */
import * as m from '@/paraglide/messages';
---

<button
  type="button"
  role="switch"
  aria-checked="true"
  aria-label={m.safe_mode_cycle()}
  data-safe-toggle
  data-safe-state="neutral"
  class="safe-toggle group flex min-h-11 items-center gap-2.5"
>
  <span class="text-sm text-muted-foreground">{m.safe_mode()}</span>
  <span
    class="relative h-6 w-10 flex-none rounded-full bg-input transition-colors duration-200 group-aria-checked:bg-primary"
  >
    <span
      class="absolute left-0.5 top-0.5 size-5 rounded-full bg-white shadow-sm transition-transform duration-200 ease-[cubic-bezier(0.2,0.8,0.2,1)] group-aria-checked:translate-x-4"
    ></span>
  </span>
  <span class="w-14 text-left text-2xs font-semibold uppercase tracking-wide text-muted-foreground">
    <span data-when="off">{m.safe_off()}</span>
    <span data-when="neutral">{m.safe_neutral()}</span>
    <span data-when="dev">{m.safe_dev()}</span>
  </span>
</button>

<style>
  /* Show only the label matching the current state; script sets data-safe-state. */
  .safe-toggle [data-when] {
    display: none;
  }
  .safe-toggle[data-safe-state='off'] [data-when='off'],
  .safe-toggle[data-safe-state='neutral'] [data-when='neutral'],
  .safe-toggle[data-safe-state='dev'] [data-when='dev'] {
    display: inline;
  }
</style>
