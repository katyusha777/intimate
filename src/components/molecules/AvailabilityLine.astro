---
/**
 * The one honest availability line (UX-PLAN 1.3 / 2.3): dot + text, derived
 * from availabilityState(). Cards, profile and the sticky deal card all consume
 * this — one component so a wording/format change propagates everywhere.
 *
 * Misprint rule 9: this is chrome, never touches the photo. The dot is a
 * die-cut circle; only the ONLINE dot carries the crimson-adjacent `--online`
 * green — offline states are plain ink glyphs (◐ / ○), no fake liveness.
 *
 * Variants:
 *  - `card`   — compact, white-on-ink (rides inside the card's ink slab).
 *  - `line`   — inline foreground text (profile / sticky card).
 */
import { availabilityState, type Profile } from '@/app/models/profile';
import { availabilityView } from '@/lib/labels';

interface Props {
  profile: Profile;
  variant?: 'card' | 'line';
  /** Injected for deterministic tests/screenshots; defaults to real now. */
  now?: Date;
  class?: string;
}

const { profile, variant = 'card', now, class: className } = Astro.props;
/* Label/glyph/sub via the shared helper — the /avail.json refresh (Layout)
   rebuilds these same bits client-side to keep a cached page honest, targeting
   the [data-avail-*] hooks below. */
const v = availabilityView(availabilityState(profile, now));

const muted = variant === 'card' ? 'text-white/50' : 'text-muted-foreground';
---

<span
  data-avail
  data-avail-variant={variant}
  class:list={[
    'flex items-center gap-1.5',
    variant === 'card' ? 'text-xs font-medium' : 'text-sm',
    className,
  ]}
>
  <!-- `contents` wrapper: a stable refresh target that generates no box, so the
       dot/glyph aligns exactly as an unwrapped child would. -->
  <span data-avail-mark class="contents">
    {
      v.glyph === 'dot' ? (
        <span class="size-1.5 flex-none rounded-full bg-online" aria-hidden="true" />
      ) : (
        <span class:list={['flex-none leading-none', muted]} aria-hidden="true">
          {v.glyph}
        </span>
      )
    }
  </span>
  <span data-avail-label class="truncate">{v.label}</span>
  <span data-avail-sub class:list={['truncate', muted, !v.sub && 'hidden']}>
    {v.sub ? `· ${v.sub}` : ''}
  </span>
</span>
