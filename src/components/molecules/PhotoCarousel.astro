---
/** Photo carousel, arrow-driven only (featured card, gallery). Direct swipe/
 * pan is disabled everywhere — it fights the page and rail scrolling; the
 * track only moves via the arrow buttons (programmatic scroll works on
 * overflow-hidden). */
import SafeImage from '@/components/atoms/SafeImage.astro';

interface Props {
  photos: string[];
  keyBase: string;
  alt: string;
  class?: string;
  /** Loading strategy for the first frame; the rest are always lazy. */
  loading?: 'lazy' | 'eager';
}

const { photos, keyBase, alt, class: className, loading = 'lazy' } = Astro.props;
---

<div class:list={['pc group relative isolate overflow-hidden', className]}>
  <div
    class="pc-track flex h-full overflow-x-hidden"
  >
    {
      photos.map((p, i) => (
        <SafeImage
          imageKey={`${keyBase}-${i}`}
          src={p}
          alt={`${alt} — photo ${i + 1}`}
          class="h-full w-full flex-none snap-center"
          loading={i === 0 ? loading : 'lazy'}
        />
      ))
    }
  </div>

  {
    photos.length > 1 && (
      <>
        <button
          type="button"
          data-dir="-1"
          aria-label="Previous photo"
          class="pc-btn pc-btn--l absolute left-2 top-1/2 grid size-8 -translate-y-1/2 cursor-pointer place-items-center bg-neutral-950 text-white opacity-0 transition-opacity hover:bg-neutral-800 group-hover:opacity-100"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
        </button>
        <button
          type="button"
          data-dir="1"
          aria-label="Next photo"
          class="pc-btn pc-btn--r absolute right-2 top-1/2 grid size-8 -translate-y-1/2 cursor-pointer place-items-center bg-neutral-950 text-white opacity-0 transition-opacity hover:bg-neutral-800 group-hover:opacity-100"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        </button>
      </>
    )
  }
</div>

<script>
  function initCarousels() {
    document.querySelectorAll<HTMLElement>('.pc').forEach((pc) => {
      if (pc.dataset.init) return;
      pc.dataset.init = '1';
      const track = pc.querySelector<HTMLElement>('.pc-track')!;

      pc.querySelectorAll<HTMLElement>('.pc-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          track.scrollBy({ left: Number(btn.dataset.dir) * track.clientWidth, behavior: 'smooth' });
        });
      });
    });
  }
  initCarousels();
  document.addEventListener('astro:page-load', initCarousels);
</script>

<style>
  /* Arrow buttons are mini ink slabs — cut, slightly sheared like the card slab. */
  .pc-btn--l {
    clip-path: polygon(0 3px, 100% 0, 100% 100%, 0 calc(100% - 3px));
  }
  .pc-btn--r {
    clip-path: polygon(0 0, 100% 3px, 100% calc(100% - 3px), 0 100%);
  }
</style>
