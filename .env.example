# Copy to `.env` (gitignored). Bun auto-loads it for every `bun run` script —
# dev server, drizzle-kit, tests, seeds all read from here.
# PUBLIC_* values are safe for the client bundle; everything else is server-only.
#
# SINGLE-TIER SETUP (decided 2026-08-03): one hosted Supabase project is THE
# database for now — no local Docker stack, no staging/prod split until the
# project proves itself. docs/INFRASTRUCTURE.md §1.

# --- Supabase (dashboard → Project Settings → API) ---
PUBLIC_SUPABASE_URL=https://jqrfzqbuvekhcptqcpda.supabase.co
PUBLIC_SUPABASE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...                   # server actions/admin only, NEVER client

# --- Database ---
# DATABASE_URL: drizzle-kit migrations, seeds, db tests (bun-side).
# CLOUDFLARE_..._HYPERDRIVE: what the HYPERDRIVE binding tunnels to in
# `bun run dev` (deployed Workers use the real Hyperdrive config instead).
# Host choice: direct db.<ref> host needs IPv6 (works on IPv6 networks, TLS
# fine); no IPv6 → use the "Session pooler" string (Connect dialog, IPv4).
# The dev-tunnel var NEEDS ?sslmode=require and the CLOUDFLARE_ (not the
# deprecated WRANGLER_) name — plaintext/legacy-name combos fail silently.
DATABASE_URL=postgresql://postgres:<DB-PASSWORD>@db.jqrfzqbuvekhcptqcpda.supabase.co:5432/postgres?sslmode=require
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://postgres:<DB-PASSWORD>@db.jqrfzqbuvekhcptqcpda.supabase.co:5432/postgres?sslmode=require

# --- Cloudflare (CI deploys, Images API) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGES_ACCOUNT_HASH=

# --- Video calls (ARCHITECTURE §10 — self-hosted coturn, EU VPS) ---
TURN_URLS=                                          # e.g. turns:turn.example.eu:443
TURN_SECRET=                                        # HMAC secret for time-limited per-call credentials

# --- SMS verification (Twilio Verify, ARCHITECTURE §11 — server-side only) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Integrations (fill when the feature lands) ---
OPENROUTER_API_KEY=
FIRECRAWL_API_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
INDEXNOW_KEY=
