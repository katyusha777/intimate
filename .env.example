# Copy to .dev.vars for local dev (wrangler/astro read it).
# PUBLIC_* values are safe for the client bundle; everything else is server-only.
# Tiers: dev (local Supabase) / staging / prod — see docs/INFRASTRUCTURE.md §1.

# --- Supabase (per tier) ---
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321          # dev: local stack · staging/prod: https://<ref>.supabase.co
PUBLIC_SUPABASE_KEY=sb_publishable_...              # dev: from `supabase status`
SUPABASE_SECRET_KEY=sb_secret_...                   # service role — server actions/admin only, NEVER client

# --- Database (drizzle-kit; runtime uses the HYPERDRIVE binding) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres   # dev default; staging/prod URLs per tier
WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Cloudflare (CI deploys, Images API) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGES_ACCOUNT_HASH=

# --- Video calls (ARCHITECTURE §10 — self-hosted coturn, EU VPS) ---
TURN_URLS=                                          # e.g. turns:turn.example.eu:443
TURN_SECRET=                                        # HMAC secret for time-limited per-call credentials

# --- SMS verification (Twilio Verify, ARCHITECTURE §11 — server-side only) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Integrations (fill when the feature lands) ---
OPENROUTER_API_KEY=
FIRECRAWL_API_KEY=
SENTRY_DSN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
INDEXNOW_KEY=
