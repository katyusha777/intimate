# Copy to .dev.vars for local dev (wrangler/astro read it via platformProxy).
# PUBLIC_* values are safe for the client bundle; everything else is server-only.

# --- Supabase ---
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...            # service role — server actions/admin only, NEVER client

# --- Database (drizzle-kit + local tooling; runtime uses the HYPERDRIVE binding) ---
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Point local dev's Hyperdrive binding at a real database:
WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Cloudflare (CI deploys, Images API) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGES_ACCOUNT_HASH=

# --- Integrations (fill when the feature lands) ---
OPENROUTER_API_KEY=
FIRECRAWL_API_KEY=
SENTRY_DSN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
INDEXNOW_KEY=
