# Long-lived caching for the static image sets (filenames are stable) — the
# browser cache is what makes the safe-mode src swap invisible on navigation.
/nsfwimg/*
  Cache-Control: public, max-age=31536000, immutable
/safeimg/*
  Cache-Control: public, max-age=31536000, immutable
/img/*
  Cache-Control: public, max-age=2592000
/fa/*
  Cache-Control: public, max-age=31536000, immutable
# Hero videos (2.5MB combined) shipped with NO cache TTL — repeat visits
# re-downloaded them. Rename the file if it ever changes.
/video/*
  Cache-Control: public, max-age=31536000, immutable
/icons/*
  Cache-Control: public, max-age=2592000
